-- Unit tests for the math and buffer stdlib candidates.
mod CubeForge.Test.Math do

  import Test
  alias CubeForge.Math.Vec3 as V
  alias CubeForge.Math.Mat4 as M
  alias CubeForge.F32Buf as B

  pfn near(a : Float, b : Float) : Bool do Math.abs(a -. b) < 0.0001 end

  describe "Vec3" do
    test "cross of x and y is z" do
      let c = V.cross(V.new(1.0, 0.0, 0.0), V.new(0.0, 1.0, 0.0))
      Test.assert_true(near(V.z(c), 1.0), "z component")
      Test.assert_true(near(V.x(c), 0.0) && near(V.y(c), 0.0), "x/y components")
    end
    test "normalize gives unit length" do
      Test.assert_true(near(V.length(V.normalize(V.new(3.0, 4.0, 0.0))), 1.0), "unit")
    end
  end

  describe "Mat4" do
    test "identity times identity is identity" do
      let m = M.mul(M.identity(), M.identity())
      Test.assert_true(near(M.get(m, 0, 0), 1.0) && near(M.get(m, 1, 0), 0.0) && near(M.get(m, 3, 3), 1.0), "diag")
    end
    test "translation moves a point" do
      match M.transform_point(M.translation(V.new(1.0, 2.0, 3.0)), V.new(1.0, 1.0, 1.0)) do
        CubeForge.Math.Mat4.Vec4(x, y, z, w) -> Test.assert_true(near(x, 2.0) && near(y, 3.0) && near(z, 4.0) && near(w, 1.0), "translated")
      end
    end
    test "look_at maps the target to the view axis" do
      let view = M.look_at(V.new(-12.0, 80.0, -12.0), V.new(8.0, 64.0, 8.0), V.new(0.0, 1.0, 0.0))
      match M.transform_point(view, V.new(8.0, 64.0, 8.0)) do
        CubeForge.Math.Mat4.Vec4(x, y, z, _) -> Test.assert_true(near(x, 0.0) && near(y, 0.0) && z < 0.0, "target on -z axis")
      end
    end
    test "perspective puts a point at -near on the near plane" do
      let p = M.perspective(1.0, 1.0, 0.1, 100.0)
      match M.transform_point(p, V.new(0.0, 0.0, -0.1)) do
        CubeForge.Math.Mat4.Vec4(_, _, z, w) -> Test.assert_true(near(z /. w, -1.0), "near plane -> -1")
      end
    end
  end

  describe "F32Buf" do
    test "push grows and keeps values" do
      fn fill(b, i) do if i >= 100 do b else fill(B.push(b, int_to_float(i)), i + 1) end end
      let b = fill(B.new(4), 0)
      Test.assert_eq_int(B.len(b), 100, "len")
      Test.assert_true(B.capacity(b) >= 100, "cap")
      Test.assert_true(near(B.get(b, 0), 0.0) && near(B.get(b, 99), 99.0) && near(B.get(b, 37), 37.0), "values")
    end
    test "clear keeps storage" do
      let b = B.clear(B.push3(B.new(8), 1.0, 2.0, 3.0))
      Test.assert_eq_int(B.len(b), 0, "len 0")
      Test.assert_eq_int(B.capacity(b), 8, "cap kept")
    end
  end

end
