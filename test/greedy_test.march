-- Greedy section meshing and F32Buf.append.
mod CubeForge.Test.Greedy do

  needs IO.Spawn
  needs IO.Foreign
  needs Window
  import Test
  alias CubeForge.Chunk as C
  alias CubeForge.Mesher as Mesher
  alias CubeForge.F32Buf as B

  pfn near(a : Float, b : Float) : Bool do Math.abs(a -. b) < 0.0001 end

  -- a column of source water at (5, z=5) from y0 to y1
  pfn water_col_go(c : CubeForge.Chunk.Chunk, y : Int, y1 : Int) : CubeForge.Chunk.Chunk do
    if y > y1 do c else water_col_go(C.set(c, 5, y, 5, C.water()), y + 1, y1) end
  end

  -- flat stone slab at y = 9 across the chunk
  pfn slab_go(c : CubeForge.Chunk.Chunk, i : Int) : CubeForge.Chunk.Chunk do
    if i >= 256 do c else slab_go(C.set(c, i % 16, 9, i / 16, 3), i + 1) end
  end
  -- flat mycelium-over-stone slab at y = 9
  pfn myc_slab_go(c : CubeForge.Chunk.Chunk, i : Int) : CubeForge.Chunk.Chunk do
    if i >= 256 do c else myc_slab_go(C.set(c, i % 16, 9, i / 16, C.myc_id(3, 0)), i + 1) end
  end
  -- species 1 on the west half of the chunk's columns, 2 on the east
  pfn half_go(s : NativeU8Arr, i : Int) : NativeU8Arr do
    if i >= 256 do s else half_go(NativeArray.set_u8(s, i % 16 + 128 * (i / 16), if i % 16 < 8 do 1 else 2 end), i + 1) end
  end
  -- layer of the first vertex whose face is the top
  pfn top_layer_go(b : CubeForge.F32Buf.F32Buf, v : Int, nv : Int) : Float do
    if v >= nv do -1.0
    else
      let face = Test.assert_some(B.get(b, v * CubeForge.Vertex.floats() + 7), "face")
      if Math.abs(face -. Mesher.face_top()) < 0.01 do Test.assert_some(B.get(b, v * CubeForge.Vertex.floats() + 5), "layer")
      else top_layer_go(b, v + 1, nv) end
    end
  end
  -- checkerboard of stone / dirt at y = 9
  pfn checker_go(c : CubeForge.Chunk.Chunk, i : Int) : CubeForge.Chunk.Chunk do
    if i >= 256 do c else checker_go(C.set(c, i % 16, 9, i / 16, if (i % 16 + i / 16) % 2 == 0 do 3 else 2 end), i + 1) end
  end

  -- sum of quad areas in a buffer (every 6 vertices = one quad; area from uv extents of vertex 2)
  pfn area_go(b : CubeForge.F32Buf.F32Buf, q : Int, nq : Int, acc : Float) : Float do
    if q >= nq do acc
    else
      let base = q * 6 * CubeForge.Vertex.floats()
      let uw = Test.assert_some(B.get(b, base + 2 * CubeForge.Vertex.floats() + 3), "u")
      let vh = Test.assert_some(B.get(b, base + 2 * CubeForge.Vertex.floats() + 4), "v")
      area_go(b, q + 1, nq, acc +. uw *. vh)
    end
  end
  pfn total_area(b : CubeForge.F32Buf.F32Buf) : Float do area_go(b, 0, B.len(b) / (6 * CubeForge.Vertex.floats()), 0.0) end

  pfn all_in_box(b : CubeForge.F32Buf.F32Buf, v : Int, nv : Int, x0 : Float, y0 : Float, z0 : Float) : Bool do
    if v >= nv do true
    else
      let x = Test.assert_some(B.get(b, v * CubeForge.Vertex.floats()), "x")
      let y = Test.assert_some(B.get(b, v * CubeForge.Vertex.floats() + 1), "y")
      let z = Test.assert_some(B.get(b, v * CubeForge.Vertex.floats() + 2), "z")
      if x < x0 || x > x0 +. 1.0 || y < y0 || y > y0 +. 1.0 || z < z0 || z > z0 +. 1.0 do false else all_in_box(b, v + 1, nv, x0, y0, z0) end
    end
  end
  pfn foliage_of(c : CubeForge.Chunk.Chunk, models : CubeForge.Model.Templates) : CubeForge.F32Buf.F32Buf do
    let e = C.new()
    Mesher.mesh_section_foliage(c, e, e, e, e, CubeForge.Light.new(), CubeForge.Light.new(), CubeForge.World.shown_new(8), CubeForge.Light.new(), 0, 0.0, 0.0, models, CubeForge.Mesher.no_beam_geo())
  end
  pfn nverts(b : CubeForge.F32Buf.F32Buf) : Int do B.len(b) / CubeForge.Vertex.floats() end
  pfn tverts(m : CubeForge.Model.Templates, k : Int) : Int do CubeForge.Model.floats(m, k) / CubeForge.Vertex.floats() end
  pfn is_bush_count(m : CubeForge.Model.Templates, n : Int, v : Int) : Bool do
    if v >= 4 do false else if tverts(m, CubeForge.Model.t_bush(v)) == n do true else is_bush_count(m, n, v + 1) end end
  end

  describe "model stamping" do
    test "a small mushroom stamps its species template inside its cell and hides nothing" do
      let m = CubeForge.World.default_models()
      let c = C.set(C.new(), 5, 9, 5, C.fruit_small(3))
      let b = foliage_of(c, m)
      Test.assert_eq_int(nverts(b), tverts(m, CubeForge.Model.t_mushroom(3)), "exactly the template's vertices")
      Test.assert_true(all_in_box(b, 0, nverts(b), 5.0, 9.0, 5.0), "all inside the cell")
      -- a slab under it: the slab's top still renders in the opaque pass
      let c2 = C.set(slab_go(C.new(), 0), 5, 10, 5, C.fruit_small(3))
      let e = C.new()
      let o = Mesher.mesh_section_opaque(c2, e, e, e, e, CubeForge.Light.new(), CubeForge.Light.new(), CubeForge.World.shown_new(8), CubeForge.Light.new(), 0, 0.0, 0.0, m)
      Test.assert_eq_int(nverts(o) / 6, 6, "the slab is still six merged quads: the model hides no face")
      Test.assert_eq_int(nverts(foliage_of(C.new(), m)), 0, "air stamps nothing")
    end
    test "an oak leaf on the ground is a bush; a leaf in the air is a cube" do
      let m = CubeForge.World.default_models()
      let on_ground = C.set(C.set(C.new(), 5, 9, 5, 3), 5, 10, 5, C.oak_leaves())
      Test.assert_true(is_bush_count(m, nverts(foliage_of(on_ground, m)), 0), "one of the four bush templates")
      let in_air = C.set(C.new(), 5, 10, 5, C.oak_leaves())
      Test.assert_eq_int(nverts(foliage_of(in_air, m)), 36, "a lone leaf cube: six faces")
    end
    test "fronds orient away from the trunk; the crown centre is the umbrella; a lone frond is the tuft" do
      let m = CubeForge.World.default_models()
      let e = C.new()
      let log = C.set(C.new(), 5, 9, 5, C.palm_log())
      Test.assert_eq_int(Mesher.template_of(C.set(log, 6, 9, 5, C.palm_frond()), e, e, e, e, 6, 9, 5, C.palm_frond(), 0, 0), CubeForge.Model.t_frond(0), "+x of the log points +x")
      Test.assert_eq_int(Mesher.template_of(C.set(log, 4, 9, 5, C.palm_frond()), e, e, e, e, 4, 9, 5, C.palm_frond(), 0, 0), CubeForge.Model.t_frond(2), "-x of the log points -x")
      Test.assert_eq_int(Mesher.template_of(C.set(log, 5, 9, 6, C.palm_frond()), e, e, e, e, 5, 9, 6, C.palm_frond(), 0, 0), CubeForge.Model.t_frond(1), "+z of the log points +z")
      Test.assert_eq_int(Mesher.template_of(C.set(log, 5, 10, 5, C.palm_frond()), e, e, e, e, 5, 10, 5, C.palm_frond(), 0, 0), CubeForge.Model.t_umbrella(), "above the log: umbrella")
      -- two out: beside the inner frond, no log in reach
      let two = C.set(C.set(log, 6, 9, 5, C.palm_frond()), 7, 9, 5, C.palm_frond())
      Test.assert_eq_int(Mesher.template_of(two, e, e, e, e, 7, 9, 5, C.palm_frond(), 0, 0), CubeForge.Model.t_frond(0), "two out along +x still points +x")
      -- the diagonal: fronds at -x and -z of it
      let diag = C.set(C.set(C.set(log, 6, 9, 5, C.palm_frond()), 5, 9, 6, C.palm_frond()), 6, 9, 6, C.palm_frond())
      Test.assert_eq_int(Mesher.template_of(diag, e, e, e, e, 6, 9, 6, C.palm_frond(), 0, 0), CubeForge.Model.t_frond(4), "the +x+z diagonal")
      Test.assert_eq_int(Mesher.template_of(C.set(C.new(), 5, 9, 5, C.palm_frond()), e, e, e, e, 5, 9, 5, C.palm_frond(), 0, 0), CubeForge.Model.t_tuft(), "alone: a tuft")
      -- and the stamp of a whole palm crown uses no cube faces
      let w = grass_top16_world()
      let w2 = CubeForge.Veg.plant(w, 8, 8, 69, 6, CubeForge.Trees.palm())
      let b = Mesher.mesh_section_foliage(CubeForge.World.chunk_at(w2, 0, 0), e, e, e, e, CubeForge.World.light(w2), CubeForge.World.block_light(w2), CubeForge.World.shown(w2), CubeForge.World.occupancy(w2), 4, 0.0, 0.0, m, CubeForge.Mesher.no_beam_geo())
      Test.assert_true(nverts(b) > 17 * 36, "seventeen fronds stamped as templates outweigh seventeen cubes")
    end
  end

  pfn flat_cells(c : CubeForge.Chunk.Chunk, i : Int) : CubeForge.Chunk.Chunk do
    if i >= 256 * 70 do c else flat_cells(C.set(c, i % 16, i / 256, (i / 16) % 16, 3), i + 1) end
  end
  pfn grass_go(c : CubeForge.Chunk.Chunk, i : Int) : CubeForge.Chunk.Chunk do
    if i >= 256 do c else grass_go(C.set(c, i % 16, 69, i / 16, 1), i + 1) end
  end
  pfn grass_top16_world() : CubeForge.World.World do
    CubeForge.World.of_chunk_list([grass_go(flat_cells(C.new(), 0), 0)], 1)
  end

  describe "greedy sections" do
    test "a flat slab is one quad per face direction it exposes" do
      let e = C.new()
      let b = Mesher.mesh_section_opaque(slab_go(C.new(), 0), e, e, e, e, CubeForge.Light.new(), CubeForge.Light.new(), CubeForge.World.shown_new(8), CubeForge.Light.new(), 0, 0.0, 0.0, CubeForge.World.default_models())
      -- top: 1 quad, bottom: 1 quad, four sides: 1 quad each (neighbours are empty chunks) = 6 quads
      Test.assert_eq_int(B.len(b) / (6 * CubeForge.Vertex.floats()), 6, "6 merged quads")
      Test.assert_true(near(total_area(b), 256.0 *. 2.0 +. 16.0 *. 4.0), "area matches the naive face count")
    end
    test "a checkerboard slab cannot merge its top" do
      let e = C.new()
      let b = Mesher.mesh_section_opaque(checker_go(C.new(), 0), e, e, e, e, CubeForge.Light.new(), CubeForge.Light.new(), CubeForge.World.shown_new(8), CubeForge.Light.new(), 0, 0.0, 0.0, CubeForge.World.default_models())
      -- 256 top + 256 bottom + 4 sides of 16 cells each that alternate (16 quads per side)
      Test.assert_eq_int(B.len(b) / (6 * CubeForge.Vertex.floats()), 256 + 256 + 64, "no merging across different ids")
    end
    test "greedy covers the same face area as the naive mesher" do
      let c = C.test_terrain()
      let e = C.new()
      let greedy = Mesher.mesh_section_opaque(c, e, e, e, e, CubeForge.Light.new(), CubeForge.Light.new(), CubeForge.World.shown_new(8), CubeForge.Light.new(), 4, 0.0, 0.0, CubeForge.World.default_models())
      let naive = Mesher.mesh_with_neighbors(c, e, e, e, e, 0.0, 0.0)
      -- naive: count faces of section 4 only (y in 64..79) by scanning vertex y
      Test.assert_true(total_area(greedy) > 0.0, "section 4 has faces")
      Test.assert_true(B.len(greedy) <= B.len(Mesher.opaque_buf(naive)), "greedy never has more vertices than naive")
    end
  end

  describe "F32Buf.append" do
    test "appends the live prefix and grows" do
      let a = B.push3(B.new(4), 1.0, 2.0, 3.0)
      let b = B.push3(B.push3(B.new(2), 4.0, 5.0, 6.0), 7.0, 8.0, 9.0)
      let ab = B.append(a, b)
      Test.assert_eq_int(B.len(ab), 9, "length 9")
      Test.assert_true(near(Test.assert_some(B.get(ab, 0), "0"), 1.0) && near(Test.assert_some(B.get(ab, 3), "3"), 4.0) && near(Test.assert_some(B.get(ab, 8), "8"), 9.0), "values")
    end
  end

  describe "Mesher.flow_of" do
    test "falls, flows toward the lowest neighbour, or stands still" do
      let w7 = C.id_of_level(7)
      let w4 = C.id_of_level(4)
      Test.assert_eq_int(Mesher.flow_effect(Mesher.flow_of(w7, w7, w7, w7, w7, 3)), CubeForge.Vertex.fx_still(), "all level: still")
      Test.assert_eq_int(Mesher.flow_effect(Mesher.flow_of(w7, w4, w7, w7, w7, 3)), CubeForge.Vertex.fx_dir(0), "+x lowest")
      Test.assert_eq_int(Mesher.flow_speed(Mesher.flow_of(w7, w4, w7, w7, w7, 3)), 3, "drop of three")
      Test.assert_eq_int(Mesher.flow_effect(Mesher.flow_of(w7, w7, w7, w7, 0, 3)), CubeForge.Vertex.fx_dir(6), "-z is air: that way")
      Test.assert_eq_int(Mesher.flow_effect(Mesher.flow_of(w7, w7, w7, w7, w7, 0)), CubeForge.Vertex.fx_fall(), "air below: falling")
      Test.assert_eq_int(Mesher.flow_effect(Mesher.flow_of(w7, C.water(), w7, w7, w7, 3)), CubeForge.Vertex.fx_still(), "a source beside is not lower")
    end
  end

  describe "Mesher.water_depth_go" do
    -- What the still-water depth byte is built from: water below the cell, in
    -- blocks, capped. A lone puddle block reads 0 and so is left exactly as it
    -- was before the depth tint existed.
    test "counts the water under a cell and stops at the cap" do
      let c0 = C.set(C.set(C.new(), 5, 9, 5, 3), 5, 10, 5, C.water())
      Test.assert_eq_int(Mesher.water_depth_go(c0, c0, c0, c0, c0, 5, 10, 5, 0), 0, "a single block has nothing below it")
      let c1 = water_col_go(C.set(C.new(), 5, 9, 5, 3), 10, 15)
      Test.assert_eq_int(Mesher.water_depth_go(c1, c1, c1, c1, c1, 5, 15, 5, 0), 5, "five blocks under the surface of a six-block column")
      Test.assert_eq_int(Mesher.water_depth_go(c1, c1, c1, c1, c1, 5, 12, 5, 0), 2, "and two under the third")
      let deep = water_col_go(C.set(C.new(), 5, 9, 5, 3), 10, 200)
      Test.assert_eq_int(Mesher.water_depth_go(deep, deep, deep, deep, deep, 5, 200, 5, 0), CubeForge.Vertex.depth_max(), "past the cap it reads the cap")
    end
  end


  describe "block light breaks merges" do
    test "a glow beside a slab splits the merged top face" do
      let c = slab_go(C.new(), 0)
      let e = C.new()
      let dark = Mesher.mesh_section_opaque(c, e, e, e, e, CubeForge.Light.new(), CubeForge.Light.new(), CubeForge.World.shown_new(8), CubeForge.Light.new(), 0, 0.0, 0.0, CubeForge.World.default_models())
      let lb = NativeArray.set_u8(CubeForge.Light.new(), CubeForge.Light.index(5, 10, 5), 9)
      let lit = Mesher.mesh_section_opaque(c, e, e, e, e, CubeForge.Light.new(), lb, CubeForge.World.shown_new(8), CubeForge.Light.new(), 0, 0.0, 0.0, CubeForge.World.default_models())
      Test.assert_true(Mesher.vertex_count(lit) > Mesher.vertex_count(dark), "a lit corner cannot merge with dark ones")
    end
  end


  describe "mycelium species split merges" do
    test "a slab of mycelium under two species is two top quads, not one" do
      let e = C.new()
      let c = myc_slab_go(C.new(), 0)
      let one = Mesher.mesh_section_opaque(c, e, e, e, e, CubeForge.Light.new(), CubeForge.Light.new(), CubeForge.World.shown_new(8), CubeForge.Light.new(), 0, 0.0, 0.0, CubeForge.World.default_models())
      let sps = half_go(CubeForge.World.shown_new(8), 0)
      let two = Mesher.mesh_section_opaque(c, e, e, e, e, CubeForge.Light.new(), CubeForge.Light.new(), sps, CubeForge.Light.new(), 0, 0.0, 0.0, CubeForge.World.default_models())
      Test.assert_eq_int(B.len(one) / (6 * CubeForge.Vertex.floats()), 6, "one species: six quads")
      -- the species is part of every face: top, bottom and the two sides that run
      -- along x each split in two; the east and west ends do not
      Test.assert_eq_int(B.len(two) / (6 * CubeForge.Vertex.floats()), 10, "two species: four faces split in two")
      let layer = top_layer_go(two, 0, B.len(two) / CubeForge.Vertex.floats())
      Test.assert_true(layer >= 18.0 && layer < 60.0, "a species layer on top")
      Test.assert_true(Math.abs(top_layer_go(one, 0, B.len(one) / CubeForge.Vertex.floats()) -. 3.0) < 0.01, "no species: the stone layer")
    end
  end

end
