-- Biome classification: the two axes, the elevation gate, and beach.
mod CubeForge.Test.Biome do

  needs IO.Spawn   -- capability ceiling, as in test/water_test.march
  import Test
  alias CubeForge.Biome as Biome
  alias CubeForge.Chunk as C

  -- A flat world: every column solid stone up to [h].
  pfn flat_cells(c : CubeForge.Chunk.Chunk, i : Int, h : Int) : CubeForge.Chunk.Chunk do
    if i >= 256 * h do c
    else flat_cells(C.set(c, i % 16, i / 256, (i / 16) % 16, 3), i + 1, h) end
  end
  pfn flat_chunks(i : Int, h : Int, acc : List(CubeForge.Chunk.Chunk)) : List(CubeForge.Chunk.Chunk) do
    if i < 0 do acc else flat_chunks(i - 1, h, Cons(flat_cells(C.new(), 0, h), acc)) end
  end
  pfn flat_world(h : Int) : CubeForge.World.World do
    CubeForge.World.of_chunk_list(flat_chunks(63, h, Nil), 8)
  end

  -- Inland (far from water) at sea level, so only the axes decide.
  pfn inland(t : Float, m : Float) : Int do Biome.classify(t, m, 62, 99) end


  pfn tick_k(f : CubeForge.Biome.Field, w : CubeForge.World.World, bonus : NativeF32Arr, k : Int) : CubeForge.Biome.Field do
    if k <= 0 do f else tick_k(Biome.tick(f, w, 7, 0.05, bonus, Biome.no_rows(Biome.cols(w)), 1.0), w, bonus, k - 1) end
  end

  describe "Biome.classify" do
    test "walks the Whittaker table" do
      Test.assert_eq_int(inland(0.1, 0.2), Biome.b_tundra(),    "cold dry")
      Test.assert_eq_int(inland(0.1, 0.8), Biome.b_taiga(),     "cold damp")
      Test.assert_eq_int(inland(0.5, 0.2), Biome.b_grassland(), "temperate dry")
      Test.assert_eq_int(inland(0.5, 0.8), Biome.b_forest(),    "temperate damp")
      Test.assert_eq_int(inland(0.9, 0.2), Biome.b_desert(),    "hot dry")
      Test.assert_eq_int(inland(0.9, 0.8), Biome.b_wetland(),   "hot damp")
    end

    test "elevation gate beats the axes" do
      Test.assert_eq_int(Biome.classify(0.9, 0.8, 95, 99), Biome.b_alpine(), "at the snow line")
      Test.assert_eq_int(Biome.classify(0.9, 0.8, 94, 99), Biome.b_wetland(), "one below it")
    end

    test "beach needs water adjacency AND low ground" do
      Test.assert_eq_int(Biome.classify(0.5, 0.9, 63, 1), Biome.b_beach(), "next to water, at sea level")
      Test.assert_eq_int(Biome.classify(0.5, 0.9, 70, 1), Biome.b_forest(), "next to water but high: not beach")
      Test.assert_eq_int(Biome.classify(0.5, 0.9, 63, 2), Biome.b_forest(), "low but two columns from water: not beach")
    end
  end

  describe "Biome.classify_full" do
    test "oasis is hot, damp and small water, and beats beach" do
      Test.assert_eq_int(Biome.classify_full(0.9, 0.9, 63, 1, true, false), Biome.b_oasis(), "hot pool rim at sea level: oasis, not beach")
      Test.assert_eq_int(Biome.classify_full(0.9, 0.9, 63, 1, false, false), Biome.b_beach(), "the same rim on the sea: beach")
      Test.assert_eq_int(Biome.classify_full(0.9, 0.9, 70, 5, false, false), Biome.b_wetland(), "hot damp large water: wetland")
      Test.assert_eq_int(Biome.classify_full(0.9, 0.9, 70, 5, true, false), Biome.b_oasis(), "hot damp small water: oasis")
      Test.assert_eq_int(Biome.classify_full(0.5, 0.9, 70, 5, true, false), Biome.b_forest(), "temperate: no oasis")
      Test.assert_eq_int(Biome.classify_full(0.9, 0.2, 70, 20, true, false), Biome.b_desert(), "dry: no oasis")
    end
    test "grove beats everything, alpine included" do
      Test.assert_eq_int(Biome.classify_full(0.9, 0.9, 100, 5, true, true), Biome.b_grove(), "grove on a peak")
      Test.assert_eq_int(Biome.classify_full(0.9, 0.9, 100, 5, true, false), Biome.b_alpine(), "the peak without the network")
      Test.assert_eq_int(Biome.classify(0.9, 0.9, 100, 5), Biome.b_alpine(), "classify is the no-network, large-water case")
    end
    test "ten biomes, named" do
      Test.assert_eq_int(Biome.count(), 10, "count")
      Test.assert_true(Biome.name(Biome.b_oasis()) == "oasis", "oasis")
      Test.assert_true(Biome.name(Biome.b_grove()) == "grove", "grove")
    end
  end

  describe "Biome.moisture_target" do
    test "falls linearly to zero at the reach" do
      Test.assert_true(Math.abs(Biome.moisture_target(0) -. 1.0) < 0.0001, "on the water")
      Test.assert_true(Math.abs(Biome.moisture_target(12) -. 0.5) < 0.0001, "halfway")
      Test.assert_true(Biome.moisture_target(24) < 0.0001, "at the reach")
      Test.assert_true(Biome.moisture_target(99) < 0.0001, "beyond it")
    end
  end

  describe "Biome.temp_target" do
    test "is colder higher up, and seeded" do
      let low = Biome.temp_target(40, 40, 7, 62)
      let high = Biome.temp_target(40, 40, 7, 100)
      Test.assert_true(high < low, "lapse rate")
      Test.assert_true(Math.abs(Biome.temp_target(40, 40, 7, 62) -. Biome.temp_target(40, 40, 8, 62)) > 0.0001, "seed matters")
      Test.assert_true(low >= 0.0 && low <= 1.0, "clamped")
    end
  end

  describe "Biome.build" do
    test "heightmap reads the surface" do
      let f = Biome.build(flat_world(70), 7)
      Test.assert_eq_int(Biome.height_of(f, 5, 5), 69, "top solid block of a 70-high column")
      let w2 = CubeForge.World.set_block(flat_world(70), 5, 70, 5, 3)
      Test.assert_eq_int(Biome.height_of(Biome.build(w2, 7), 5, 5), 70, "a block placed on top raises it")
    end

    test "distance to water is Chebyshev and capped at the reach" do
      let w = CubeForge.World.set_block(flat_world(70), 64, 70, 64, C.water())
      let d = Biome.distances(Biome.build(w, 7), w)
      Test.assert_eq_int(Biome.dist_of(NativeArray.get_u8(d, 64 + 128 * 64)), 0, "on the water")
      Test.assert_eq_int(Biome.dist_of(NativeArray.get_u8(d, 67 + 128 * 66)), 3, "Chebyshev: max(3, 2)")
      Test.assert_true(Biome.is_small(NativeArray.get_u8(d, 64 + 128 * 64)), "one block is a small body")
      Test.assert_true(Biome.is_small(NativeArray.get_u8(d, 67 + 128 * 66)), "and the flag rides out with the distance")
      Test.assert_eq_int(NativeArray.get_u8(d, 0), Biome.reach(), "far away is capped, with no flag")
    end

    test "a dry temperate flat world is grassland; beside a lake it is beach" do
      -- seventy columns of water: a large body, so the rim is beach and not an oasis
      let w = water_row(flat_world(63), 10, 79, 64, 63)
      let f = Biome.build(w, 7)
      Test.assert_eq_int(Biome.biome_of(f, 80, 64), Biome.b_beach(), "next to the water")
      let far = Biome.biome_of(f, 5, 5)
      Test.assert_true(far == Biome.b_grassland() || far == Biome.b_tundra() || far == Biome.b_desert(), "far away is one of the dry biomes")
    end
  end

  pfn tick_n(f : CubeForge.Biome.Field, w : CubeForge.World.World, n : Int, rate : Float) : CubeForge.Biome.Field do
    if n <= 0 do f else tick_n(Biome.tick(f, w, 7, rate, Biome.no_pulls(Biome.cols(w)), Biome.no_rows(Biome.cols(w)), 1.0), w, n - 1, rate) end
  end

  describe "Biome.note_edit" do
    test "keeps the heightmap equal to a full rescan across edits" do
      let w0 = flat_world(70)
      let f0 = Biome.build(w0, 7)
      let w1 = CubeForge.World.set_block(w0, 10, 70, 10, 3)
      let f1 = Biome.note_edit(f0, w1, 10, 70, 10, 3)
      let w2 = CubeForge.World.set_block(w1, 20, 69, 20, 0)
      let f2 = Biome.note_edit(f1, w2, 20, 69, 20, 0)
      let w3 = CubeForge.World.set_block(w2, 30, 40, 30, 0)
      let f3 = Biome.note_edit(f2, w3, 30, 40, 30, 0)
      Test.assert_eq_int(Biome.height_of(f3, 10, 10), Biome.height_of(Biome.build(w3, 7), 10, 10), "raised column agrees")
      Test.assert_eq_int(Biome.height_of(f3, 20, 20), Biome.height_of(Biome.build(w3, 7), 20, 20), "lowered column agrees")
      Test.assert_eq_int(Biome.height_of(f3, 30, 30), Biome.height_of(Biome.build(w3, 7), 30, 30), "untouched surface agrees")
    end
  end

  describe "Biome.tick" do
    test "a canal turns its banks from dry to wet, gradually" do
      let w0 = flat_world(66)
      let f0 = Biome.build(w0, 7)
      -- three blocks of water are a small body: they wet two columns, not twelve
      let before = Biome.biome_of(f0, 66, 60)
      let w1 = CubeForge.World.set_block(CubeForge.World.set_block(CubeForge.World.set_block(w0, 64, 65, 58, C.water()), 64, 65, 60, C.water()), 64, 65, 62, C.water())
      let f1 = Biome.note_edit(Biome.note_edit(Biome.note_edit(f0, w1, 64, 65, 58, C.water()), w1, 64, 65, 60, C.water()), w1, 64, 65, 62, C.water())
      let f2 = Biome.tick(f1, w1, 7, Biome.default_rate(), Biome.no_pulls(Biome.cols(w1)), Biome.no_rows(Biome.cols(w1)), 1.0)
      Test.assert_eq_int(Biome.biome_of(f2, 66, 60), before, "no snap after one tick")
      let f3 = tick_n(f2, w1, 200, 0.05)
      Test.assert_true(Biome.biome_of(f3, 66, 60) != before, "the bank changed biome")
    end

    test "levelling a peak leaves alpine" do
      let w0 = flat_world(100)
      let f0 = Biome.build(w0, 7)
      Test.assert_eq_int(Biome.biome_of(f0, 40, 40), Biome.b_alpine(), "starts alpine")
      let w1 = CubeForge.World.set_block(w0, 40, 99, 40, 0)
      let f1 = Biome.note_edit(f0, w1, 40, 99, 40, 0)
      Test.assert_eq_int(Biome.height_of(f1, 40, 40), 98, "surface dropped")
      let w2 = CubeForge.World.set_block(CubeForge.World.set_block(CubeForge.World.set_block(CubeForge.World.set_block(w1, 40, 98, 40, 0), 40, 97, 40, 0), 40, 96, 40, 0), 40, 95, 40, 0)
      let f3 = Biome.note_edit(Biome.note_edit(Biome.note_edit(Biome.note_edit(f1, w2, 40, 98, 40, 0), w2, 40, 97, 40, 0), w2, 40, 96, 40, 0), w2, 40, 95, 40, 0)
      let f4 = tick_n(f3, w2, 40, 0.05)
      Test.assert_true(Biome.biome_of(f4, 40, 40) != Biome.b_alpine(), "no longer alpine")
    end

    test "does not flap: a flipped column stays flipped" do
      let w0 = flat_world(66)
      let w1 = CubeForge.World.set_block(w0, 64, 65, 60, C.water())
      let f0 = Biome.note_edit(Biome.build(w0, 7), w1, 64, 65, 60, C.water())
      let f1 = tick_n(f0, w1, 300, 0.05)
      let b1 = Biome.biome_of(f1, 66, 60)
      let f2 = tick_n(f1, w1, 300, 0.05)
      Test.assert_eq_int(Biome.biome_of(f2, 66, 60), b1, "stable once settled")
    end
  end

  describe "Biome.precip_scale" do
    test "deserts are drier than grassland, wetlands wetter" do
      Test.assert_true(Biome.precip_scale(Biome.b_desert()) < Biome.precip_scale(Biome.b_grassland()), "desert < grassland")
      Test.assert_true(Biome.precip_scale(Biome.b_grassland()) < Biome.precip_scale(Biome.b_wetland()), "grassland < wetland")
      Test.assert_true(Biome.precip_scale(Biome.b_forest()) > 0.99 && Biome.precip_scale(Biome.b_forest()) < 1.01, "forest is the reference")
      Test.assert_true(Biome.precip_scale(Biome.b_oasis()) < Biome.precip_scale(Biome.b_grassland()), "an oasis is still in the desert")
      Test.assert_true(Biome.precip_scale(Biome.b_grove()) > 1.0, "a grove is humid")
    end
  end

  pfn apply_palette(f : CubeForge.Biome.Field, w : CubeForge.World.World, cols : List(Int)) : CubeForge.World.World do
    match cols do
      Nil -> w
      Cons(ci, rest) ->
        let x = ci % 128
        let z = ci / 128
        apply_palette(f, CubeForge.World.set_block(w, x, Biome.height_of(f, x, z), z, Biome.palette(Biome.biome_of(f, x, z), x, z)), rest)
    end
  end
  pfn all_mismatched(f : CubeForge.Biome.Field, w : CubeForge.World.World, cols : List(Int)) : Bool do
    match cols do
      Nil -> true
      Cons(ci, rest) ->
        let x = ci % 128
        let z = ci / 128
        let sfc = CubeForge.World.block_at(w, x, Biome.height_of(f, x, z), z)
        if sfc == Biome.palette(Biome.biome_of(f, x, z), x, z) do false else all_mismatched(f, w, rest) end
    end
  end

  describe "Biome.migrations" do
    test "returns only mismatched palette surfaces, within budget, and none once applied" do
      -- set_block copies a whole chunk per call (see light_test), so only re-top one chunk: x, z in 0..15
      let w = grass_top16(flat_world(66), 0, 66)
      let f = Biome.build(w, 7)
      let m = Biome.migrations(f, w, 0, 256, 5)
      Test.assert_true(List.length(m) <= 5, "budget respected")
      Test.assert_true(all_mismatched(f, w, m), "every pick disagrees with its palette")
      let w2 = apply_palette(f, w, Biome.migrations(f, w, 0, 256, 256))
      Test.assert_eq_int(List.length(Biome.migrations(f, w2, 0, 256, 256)), 0, "nothing left in that range")
    end
    test "a grove wants no surface, so its column never migrates" do
      -- column (5, 1) is index 133: inside the 256-column window the scan reads from tick 0
      let w = grass_top16(flat_world(66), 0, 66)
      let f = Biome.force_biome(Biome.build(w, 7), 128, 5, 1, Biome.b_grove())
      Test.assert_eq_int(Biome.palette(Biome.b_grove(), 5, 1), 0, "no palette block")
      Test.assert_eq_int(Biome.biome_of(f, 5, 1), Biome.b_grove(), "forced")
      Test.assert_false(List.member(Biome.migrations(f, w, 0, 256, 256), 5 + 128 * 1), "not in the migration list")
      let fd = Biome.force_biome(Biome.build(w, 7), 128, 5, 1, Biome.b_desert())
      Test.assert_true(List.member(Biome.migrations(fd, w, 0, 256, 256), 5 + 128 * 1), "though grass under a desert would migrate")
    end
    test "an oasis wants grass" do
      Test.assert_eq_int(Biome.palette(Biome.b_oasis(), 3, 3), 1, "grass")
    end
    test "stone is never a palette block; a stone surface never migrates" do
      let w = flat_world(66)
      Test.assert_eq_int(List.length(Biome.migrations(Biome.build(w, 7), w, 0, 2048, 64)), 0, "stone stays")
    end
  end

  describe "Biome.palette wetland mix" do
    test "wetland picks clay or mud per column, and stays a palette block" do
      let a = Biome.palette(Biome.b_wetland(), 0, 0)
      let b = Biome.palette(Biome.b_wetland(), 1, 0)
      Test.assert_true(a == C.clay() || a == C.mud(), "column (0,0) is clay or mud")
      Test.assert_true(b == C.clay() || b == C.mud(), "column (1,0) is clay or mud")
      Test.assert_true(Biome.is_palette_block(C.mud()), "mud is a palette block")
    end
    test "the same column is always the same pick" do
      Test.assert_eq_int(Biome.palette(Biome.b_wetland(), 42, 17), Biome.palette(Biome.b_wetland(), 42, 17), "deterministic")
    end
    test "other biomes are unaffected by the x, z parameters" do
      Test.assert_eq_int(Biome.palette(Biome.b_alpine(), 0, 0), C.gravel(), "alpine still gravel")
      Test.assert_eq_int(Biome.palette(Biome.b_alpine(), 99, 99), C.gravel(), "alpine ignores column")
    end
    test "both clay and mud actually occur across sampled columns" do
      Test.assert_true(any_clay_and_mud(0, false, false), "at least one clay and at least one mud among sampled columns")
    end
  end
  pfn any_clay_and_mud(i : Int, saw_clay : Bool, saw_mud : Bool) : Bool do
    if i >= 64 do saw_clay && saw_mud
    else
      let p = Biome.palette(Biome.b_wetland(), i, i * 3 + 1)
      any_clay_and_mud(i + 1, saw_clay || p == C.clay(), saw_mud || p == C.mud())
    end
  end
  pfn grass_top16(w : CubeForge.World.World, i : Int, h : Int) : CubeForge.World.World do
    if i >= 256 do w else grass_top16(CubeForge.World.set_block(w, i % 16, h - 1, i / 16, 1), i + 1, h) end
  end


  describe "Biome.tick with the network's climate offsets" do
    test "a moisture offset moves the eased moisture and wakes a settled column once" do
      let w = flat_world(70)
      let f0 = Biome.build(w, 7)
      let n = Biome.cols(w)
      -- inland, no water: moisture target 0; settle it first
      let f1 = tick_k(f0, w, Biome.no_pulls(n), 40)
      Test.assert_true(Biome.moist_of(f1, 40, 40) < 0.0001, "dry inland")
      Test.assert_eq_int(NativeArray.get_u8(Biome.active(f1), 40 + n * 40), 0, "settled")
      let bonus = NativeArray.set_f32(NativeArray.make_f32(2 * n * n, 0.0), 2 * (40 + n * 40) + 1, 0.19)
      -- the row flag is what wakes a settled column; the pull alone would not
      let f2 = Biome.tick(f1, w, 7, 0.05, bonus, NativeArray.set_u8(Biome.no_rows(n), 40, 1), 1.0)
      Test.assert_eq_int(NativeArray.get_u8(Biome.active(f2), 40 + n * 40), 1, "the offset woke it")
      Test.assert_true(Biome.moist_of(f2, 40, 40) > 0.04, "and moisture started moving")
      let f3 = tick_k(f2, w, bonus, 40)
      Test.assert_true(Math.abs(Biome.moist_of(f3, 40, 40) -. 0.19) < 0.0001, "settled on the offset")
      Test.assert_eq_int(NativeArray.get_u8(Biome.active(f3), 40 + n * 40), 0, "and settled again: the same offset does not keep it awake")
      Test.assert_true(Math.abs(Biome.moist_of(tick_k(f3, w, bonus, 5), 40, 40) -. 0.19) < 0.0001, "an unflagged row keeps its offset")
      Test.assert_true(Biome.moist_of(f3, 41, 40) < 0.0001, "the neighbour got no offset")
    end
  end

  -- ── The grove ─────────────────────────────────────────────────────────────
  pfn tick_net_k(f : CubeForge.Biome.Field, w : CubeForge.World.World, m : CubeForge.Myc.Net, drow : NativeU8Arr, k : Int) : CubeForge.Biome.Field do
    let n = Biome.cols(w)
    if k <= 0 do f
    else tick_net_k(Biome.tick_net(f, w, 7, 0.05, Biome.no_pulls(n), Biome.no_rows(n), 1.0, CubeForge.Myc.field_species(m), CubeForge.Myc.field_vigour(m), drow), w, m, drow, k - 1) end
  end

  describe "Biome grove" do
    test "an empty network changes nothing" do
      let w = flat_world(70)
      let n = Biome.cols(w)
      let f0 = Biome.build(w, 7)
      let a = tick_k(f0, w, Biome.no_pulls(n), 40)
      let b = tick_net_k(f0, w, CubeForge.Myc.build(n), Biome.all_rows(n), 40)
      Test.assert_eq_int(Biome.state_hash(a, n), Biome.state_hash(b, n), "tick and tick_net agree")
    end
    test "a mature patch is a grove one column inside its rim, after the hold" do
      let w = flat_world(70)
      let n = Biome.cols(w)
      let m = CubeForge.Myc.plant_patch(CubeForge.Myc.build(n), n, 40, 40, 3)
      Test.assert_true(Biome.is_grove(CubeForge.Myc.field_species(m), CubeForge.Myc.field_vigour(m), n, 40, 40), "the centre passes the 5-of-9 test")
      Test.assert_true(!Biome.is_grove(CubeForge.Myc.field_species(m), CubeForge.Myc.field_vigour(m), n, 32, 40), "the rim (5 of 9 would need a column outside the patch) does not")
      Test.assert_true(Biome.is_grove(CubeForge.Myc.field_species(m), CubeForge.Myc.field_vigour(m), n, 33, 40), "one inside the rim does")
      let f0 = Biome.build(w, 7)
      let before = Biome.biome_of(f0, 40, 40)
      Test.assert_true(before != Biome.b_grove(), "not a grove before the network is in view")
      let f1 = tick_net_k(f0, w, m, Biome.all_rows(n), 1)
      Test.assert_eq_int(Biome.biome_of(f1, 40, 40), before, "no snap on the first tick: the hold counter")
      let f2 = tick_net_k(f1, w, m, Biome.all_rows(n), Biome.hold_ticks() + 1)
      Test.assert_eq_int(Biome.biome_of(f2, 40, 40), Biome.b_grove(), "grove at the centre")
      Test.assert_eq_int(Biome.biome_of(f2, 33, 40), Biome.b_grove(), "grove one inside the rim")
      Test.assert_true(Biome.biome_of(f2, 32, 40) != Biome.b_grove(), "the rim itself is not")
      Test.assert_true(Biome.biome_of(f2, 20, 40) != Biome.b_grove(), "nor open ground")
    end
    test "a single planted column is never a grove" do
      let n = 128
      let m = CubeForge.Myc.plant(CubeForge.Myc.build(n), n, 40, 40, 3)
      Test.assert_true(!Biome.is_grove(CubeForge.Myc.field_species(m), CubeForge.Myc.field_vigour(m), n, 40, 40), "seed vigour, alone")
    end
    test "the network's dirty rows wake a settled column; without them it stays settled" do
      let w = flat_world(70)
      let n = Biome.cols(w)
      let f1 = tick_k(Biome.build(w, 7), w, Biome.no_pulls(n), 40)
      Test.assert_eq_int(NativeArray.get_u8(Biome.active(f1), 40 + n * 40), 0, "settled")
      let m = CubeForge.Myc.plant_patch(CubeForge.Myc.build(n), n, 40, 40, 3)
      let quiet = tick_net_k(f1, w, m, Biome.no_rows(n), 1)
      Test.assert_eq_int(NativeArray.get_u8(Biome.active(quiet), 40 + n * 40), 0, "no dirty rows: still settled, the network unseen")
      let woken = tick_net_k(f1, w, m, NativeArray.set_u8(Biome.no_rows(n), 40, 1), 1)
      Test.assert_eq_int(NativeArray.get_u8(Biome.active(woken), 40 + n * 40), 1, "row 40 dirty: the column is active")
      Test.assert_eq_int(NativeArray.get_u8(Biome.active(woken), 40 + n * 44), 0, "row 44 was not")
      -- a patch planted into a clean field reports its rows dirty (a fresh build
      -- starts wholly dirty), so the real wake needs nothing more than dirty_rows
      let mc = CubeForge.Myc.plant_patch(CubeForge.Myc.clean(CubeForge.Myc.build(n), n), n, 40, 40, 3)
      Test.assert_eq_int(NativeArray.get_u8(CubeForge.Myc.dirty_rows(mc, n), 40), 1, "dirty_rows marks the patch's row")
      Test.assert_eq_int(NativeArray.get_u8(CubeForge.Myc.dirty_rows(mc, n), 49), 1, "and the row beside its rim")
      Test.assert_eq_int(NativeArray.get_u8(CubeForge.Myc.dirty_rows(mc, n), 60), 0, "not a row far away")
    end
  end

  -- ── Water bodies ──────────────────────────────────────────────────────────
  pfn water_line(w : CubeForge.World.World, x : Int, z0 : Int, z1 : Int, y : Int) : CubeForge.World.World do
    if z0 > z1 do w else water_line(CubeForge.World.set_block(w, x, y, z0, C.water()), x, z0 + 1, z1, y) end
  end
  pfn water_row(w : CubeForge.World.World, x0 : Int, x1 : Int, z : Int, y : Int) : CubeForge.World.World do
    if x0 > x1 do w else water_row(CubeForge.World.set_block(w, x0, y, z, C.water()), x0 + 1, x1, z, y) end
  end
  pfn near(a : Float, b : Float) : Bool do Math.abs(a -. b) < 0.0001 end

  describe "Biome water bodies" do
    test "a long trench is a large body and wets the full reach" do
      let w = water_line(flat_world(70), 64, 30, 89, 70)
      let d = Biome.distances(Biome.build(w, 7), w)
      Test.assert_false(Biome.is_small(NativeArray.get_u8(d, 67 + 128 * 60)), "sixty columns are not small")
      Test.assert_true(near(Biome.moisture_target_of(NativeArray.get_u8(d, 67 + 128 * 60)), 0.875), "three columns out: 1 - 3/24")
    end
    test "a puddle is a small body and wets only small_reach columns" do
      let w = water_row(flat_world(70), 64, 68, 64, 70)
      let d = Biome.distances(Biome.build(w, 7), w)
      Test.assert_true(Biome.is_small(NativeArray.get_u8(d, 66 + 128 * 66)), "five columns are small")
      Test.assert_true(near(Biome.moisture_target_of(NativeArray.get_u8(d, 66 + 128 * 66)), 0.5), "two out: 1 - 2/4")
      Test.assert_true(Biome.moisture_target_of(NativeArray.get_u8(d, 66 + 128 * 68)) < 0.0001, "four out: dry")
      Test.assert_true(Biome.moisture_target_of(NativeArray.get_u8(d, 66 + 128 * 69)) < 0.0001, "five out: dry")
      Test.assert_eq_int(Biome.dist_of(NativeArray.get_u8(d, 66 + 128 * 69)), 5, "but the distance is still carried")
    end
    test "a pool touching a large body is part of it" do
      let w0 = water_row(flat_world(70), 10, 79, 20, 70)
      let w = water_row(water_row(w0, 80, 81, 20, 70), 80, 81, 21, 70)
      let d = Biome.distances(Biome.build(w, 7), w)
      Test.assert_false(Biome.is_small(NativeArray.get_u8(d, 81 + 128 * 21)), "the pool joined the body")
      Test.assert_false(Biome.is_small(NativeArray.get_u8(d, 83 + 128 * 22)), "and so did its shore")
    end
    test "an edit that adds water is seen by the next tick even though the flags already agree" do
      let w0 = flat_world(70)
      let f0 = tick_n(Biome.build(w0, 7), w0, 3, 0.05)
      let w1 = CubeForge.World.set_block(w0, 64, 70, 64, C.water())
      let f1 = Biome.note_edit(f0, w1, 64, 70, 64, C.water())
      Test.assert_true(Biome.is_wet(f1, 64, 64), "the edit set the flag")
      let f2 = Biome.tick(f1, w1, 7, 0.05, Biome.no_pulls(128), Biome.no_rows(128), 1.0)
      Test.assert_true(Biome.moist_of(f2, 66, 64) > 0.04, "the neighbour's moisture is moving: the distances were resweept")
      -- the batched path too
      let f3 = Biome.note_edits(f0, w1, Cons(Biome.pack_edit(64, 70, 64, C.water()), Nil))
      let f4 = Biome.tick(f3, w1, 7, 0.05, Biome.no_pulls(128), Biome.no_rows(128), 1.0)
      Test.assert_true(Biome.moist_of(f4, 66, 64) > 0.04, "note_edits also marks the distances stale")
    end
    test "the small-body threshold and reach are the knobs" do
      Test.assert_eq_int(Biome.small_body(), 48, "48 columns")
      Test.assert_eq_int(Biome.small_reach(), 4, "4 columns")
      Test.assert_true(near(Biome.moisture_target_of(Biome.small_bit() + 0), 1.0), "on small water")
      Test.assert_true(near(Biome.moisture_target_of(12), 0.5), "large: unchanged curve")
    end
  end

  describe "Biome export and import" do
    test "the eased axes round-trip and classify as before" do
      let w = flat_world(70)
      let n = Biome.cols(w)
      let f0 = Biome.build(w, 7)
      let bonus = NativeArray.set_f32(NativeArray.make_f32(2 * n * n, 0.0), 2 * (40 + n * 40) + 1, 0.19)
      let f1 = tick_k(f0, w, bonus, 12)
      let bytes = Biome.axes_to_bytes(f1, n, NativeArray.make_u8(4 * n * n + 5, 0), 5)
      let g = Biome.axes_of_bytes(Biome.build(w, 7), w, bytes, 5)
      Test.assert_true(Math.abs(Biome.moist_of(g, 40, 40) -. Biome.moist_of(f1, 40, 40)) < 0.0001, "moisture")
      Test.assert_true(Math.abs(Biome.temp_of(g, 40, 40) -. Biome.temp_of(f1, 40, 40)) < 0.0001, "temperature")
      Test.assert_eq_int(Biome.biome_of(g, 40, 40), Biome.biome_of(f1, 40, 40), "same biome")
      Test.assert_eq_int(NativeArray.get_u8(Biome.active(g), 40 + n * 40), 1, "active after a load, so it settles or moves on its own")
    end
  end

end
