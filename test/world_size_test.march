-- The world's size is one number, CubeForge.World.size(), and a scattering of
-- integer literals that have to agree with it.
--
-- They cannot be derived from it. A refinement predicate that calls a function
-- has no SMT translation -- `@[measure]` on the function silences the warning
-- and leaves the precondition unverified -- so Light.index's bounds, and every
-- guard that discharges them, have to be literals. Deriving them was measured:
-- 85 unverified obligations became 100.
--
-- So the agreement is asserted here instead. Raising World.size() -- the
-- MAXIMUM side, and under chunk streaming the side of the window itself --
-- fails these tests, and each one names the literal to change with it. That
-- is the whole point: the coupling is real, and it should be loud rather
-- than silent. (The C shim carries the same number as CF_WORLD_CHUNKS and
-- CF_WORLD_SIDE, and its shader's WORLD constant is a literal;
-- cf_gfx_upload_occupancy aborts if the dimensions March passes it disagree.)
mod CubeForge.WorldSizeTest do

  alias CubeForge.World as W
  alias CubeForge.Light as L
  alias CubeForge.Chunk as C

  doc "Every named mesh slot, in the order the slot map lists them."
  pfn named_slots() : List(Int) do
    Cons(CubeForge.Fauna.slot(),
    Cons(CubeForge.Fauna.demo_slot(),
    Cons(CubeForge.myc_map_slot(),
    Cons(CubeForge.readout_slot(),
    Cons(CubeForge.spray_slot(),
    Cons(CubeForge.menu_slot(),
    Cons(CubeForge.biome_map_slot(),
    Cons(CubeForge.Precip.slot(),
    Cons(CubeForge.Marker.slot(),
    Cons(CubeForge.icon_slot(),
    Cons(CubeForge.hotbar_slot(),
    Cons(CubeForge.underwater_slot(),
    Cons(CubeForge.outline_slot(),
    Cons(CubeForge.fps_slot(), Nil))))))))))))))
  end
  pfn named_in_range(xs : List(Int), lo : Int, hi : Int) : Bool do
    match xs do
      Nil -> true
      Cons(s, rest) -> s >= lo && s < hi && named_in_range(rest, lo, hi)
    end
  end
  pfn holds(xs : List(Int), v : Int) : Bool do
    match xs do
      Nil -> false
      Cons(x, rest) -> x == v || holds(rest, v)
    end
  end
  pfn any_repeat(xs : List(Int)) : Bool do
    match xs do
      Nil -> false
      Cons(x, rest) -> holds(rest, x) || any_repeat(rest)
    end
  end

  describe "world size" do
    test "the column stride matches the chunk grid" do
      Test.assert_eq_int(W.cols(), 16 * W.size(), "cols() is size() chunks of 16")
      Test.assert_eq_int(W.cols(), 192, "the literal every index bound is written as")
    end

    test "the light field's dimensions match the world" do
      Test.assert_eq_int(L.size_x(), W.cols(), "light is as wide as the world")
      Test.assert_eq_int(L.size_z(), W.cols(), "and as deep")
      Test.assert_eq_int(L.size_y(), C.size_y(), "and as tall as a chunk")
      Test.assert_eq_int(L.volume(), L.size_x() * L.size_y() * L.size_z(), "volume is the product")
      Test.assert_eq_int(L.volume(), 9437184, "the literal in index()'s result bound and new()")
    end

    test "the two layer strides are what they claim, and are not the same thing" do
      Test.assert_eq_int(L.layer(), L.size_x() * L.size_z(), "a world y layer is cols x cols")
      Test.assert_eq_int(L.chunk_layer(), C.size_x() * C.size_z(), "a chunk y layer is 16 x 16")
      -- Both were bare numbers before, 16384 and 256, and 256 is also the world
      -- height -- three different meanings sharing two spellings.
      Test.assert_true(L.layer() != L.chunk_layer(), "they are different strides")
    end

    test "the flat index agrees with the strides it is written from" do
      Test.assert_eq_int(L.index(0, 0, 0), 0, "origin")
      Test.assert_eq_int(L.index(1, 0, 0), 1, "x is the fastest axis")
      Test.assert_eq_int(L.index(0, 0, 1), L.size_x(), "z steps by a row")
      Test.assert_eq_int(L.index(0, 1, 0), L.layer(), "y steps by a layer")
      Test.assert_eq_int(L.index(L.size_x() - 1, L.size_y() - 1, L.size_z() - 1), L.volume() - 1, "the last voxel is the last slot")
    end

    test "the occupancy index covers the same field in a different order" do
      Test.assert_eq_int(L.occ_index(0, 0, 0), 0, "origin")
      Test.assert_eq_int(L.occ_index(1, 0, 0), 1, "x is the fastest axis here too")
      Test.assert_eq_int(L.occ_index(0, 1, 0), L.size_x(), "but y steps by a row")
      Test.assert_eq_int(L.occ_index(L.size_x() - 1, L.size_y() - 1, L.size_z() - 1), L.volume() - 1, "and it is the same size")
    end

    test "the marks array has a slot per chunk section" do
      -- The marks and pending arrays are indexed by mark_slot, whose two strides
      -- are the chunk count and the side. Both moved with the window.
      Test.assert_eq_int(L.mark_slot(0, 1, 0), W.size(), "a chunk row steps by the side")
      Test.assert_eq_int(L.mark_slot(0, 0, 1), W.size() * W.size(), "a section steps by the chunk count")
      Test.assert_eq_int(L.mark_slot(W.size() - 1, W.size() - 1, 15), W.size() * W.size() * 16 - 1, "the last section is the last slot")
    end

    test "a smaller world's biome field is strided by its own width" do
      -- The fixed-width fields (light, occupancy) are World.size() wide and a
      -- smaller world uses their corner; the per-column fields are allocated
      -- and indexed at the world's own width.
      let w = W.generate(4, CubeForge.Noise.with_size(5, 4), 1)
      Test.assert_eq_int(W.side(w), 4, "four chunks a side")
      let f = CubeForge.Biome.build(w, CubeForge.Noise.with_size(5, 4))
      Test.assert_eq_int(CubeForge.Biome.height_of(f, 50, 40), W.surface_y(w, 50, 40), "height_of reads the right column")
      Test.assert_eq_int(CubeForge.Biome.height_of(f, 63, 63), W.surface_y(w, 63, 63), "the far corner too")
      Test.assert_eq_int(CubeForge.Biome.side_of(CubeForge.Biome.field_biomes(f)), 64, "the field is 64 wide")
    end
    test "no named mesh slot lands in the chunk range" do
      -- The shim holds ONE array of CF_MAX_MESHES = 512 mesh slots. The first
      -- 3 * size^2 of them belong to the window -- opaque, water and foliage,
      -- one block of size^2 each -- and every slot above those is named. A name
      -- that lands inside the chunk range shares a vertex buffer with a chunk
      -- and nothing says so: the two upload over each other, and whichever
      -- keeps a vertex count after the other has replaced the buffer draws off
      -- the end of it.
      --
      -- Fauna's two slots were 242 and 243, correct while the window was 8
      -- chunks a side and the chunk meshes ended at 191. The 12-chunk window
      -- moved that boundary to 431 and made 243 water chunk 99, whose draw call
      -- took the GL driver down a few frames after the first window shift. The
      -- slot map in cube_forge.march is the list; this is the list checked.
      let chunks = 3 * W.size() * W.size()
      Test.assert_eq_int(chunks, 432, "the boundary the slot map is written around")
      Test.assert_true(named_in_range(named_slots(), chunks, 512), "every named slot is clear of the chunks and inside the shim's array")
      Test.assert_true(!any_repeat(named_slots()), "and no two names share a slot")
    end

    test "the biome field's stride is the world's" do
      -- Biome's accessors index hs/ws/bs as wx + 192 * wz, and the field is
      -- allocated at the world's runtime size. If those disagree the field reads
      -- the wrong column and nothing errors.
      Test.assert_eq_int(CubeForge.Biome.stride(), W.cols(), "the accessors' stride is the world's width")
    end
  end

end
