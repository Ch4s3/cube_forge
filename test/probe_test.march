mod CubeForge.Test.Probe do
  needs IO.Spawn
  import Test
  alias CubeForge.Light as L
  alias CubeForge.Chunk as C

  -- Count distinct (chunk, section) pairs whose light changed between two fields.
  pfn mark_go(seen : NativeIntArr, a : NativeU8Arr, b : NativeU8Arr, i : Int) : NativeIntArr do
    if i >= 4194304 do seen
    else if NativeArray.get_u8(a, i) == NativeArray.get_u8(b, i) do mark_go(seen, a, b, i + 1)
    else
      let x = i % 128
      let z = (i / 128) % 128
      let y = i / 16384
      let slot = (x / 16) + 8 * (z / 16) + 64 * (y / 16)
      mark_go(NativeArray.set_int(seen, slot, 1), a, b, i + 1)
    end end
  end
  pfn count_go(seen : NativeIntArr, i : Int, acc : Int) : Int do
    if i >= 1024 do acc else count_go(seen, i + 1, acc + NativeArray.get_int(seen, i)) end
  end

  pfn changed_sections(a : NativeU8Arr, b : NativeU8Arr) : Int do
    count_go(mark_go(NativeArray.make_int(1024, 0), a, b, 0), 0, 0)
  end

  describe "staleprobe" do
    test "how many sections go stale after one edit" do
      let w0 = CubeForge.World.relight_all(CubeForge.World.generate(8, 7, 1))
      let before = L.copy_field(CubeForge.World.light(w0), L.new())
      -- break a surface block
      let w1 = CubeForge.World.set_block(w0, 64, 70, 64, 0)
      let after = L.relight_at(CubeForge.World.light(w1), w1, 64, 70, 64)
      println("  break at (64,70,64): sections with changed light = " ++ int_to_string(changed_sections(before, after)))
      -- place a block that caps the column
      let w2 = CubeForge.World.set_block(w0, 64, 90, 64, 3)
      let after2 = L.relight_at(CubeForge.World.light(w2), w2, 64, 90, 64)
      println("  place at (64,90,64): sections with changed light = " ++ int_to_string(changed_sections(before, after2)))
      Test.assert_true(true, "probe")
    end
  end
end
