-- Terrain generator: ridged noise, determinism, SIMD/scalar agreement, material rules.
-- Helpers are module-level: `pfn` is not allowed inside `describe`/`test` (GAPS.md G59).
mod CubeForge.Test.Terrain do

  needs IO.Spawn
  import Test
  alias CubeForge.Noise as N
  alias CubeForge.Chunk as C

  pfn ridged_in_range(i : Int, lo : Float, hi : Float) : Bool do
    if i >= 400 do lo >= 0.0 && hi <= 1.0
    else
      let v = N.ridged(int_to_float(i) *. 0.37, int_to_float(i) *. 0.11, 3)
      ridged_in_range(i + 1, if v < lo do v else lo end, if v > hi do v else hi end)
    end
  end

  pfn seeds_differ(i : Int) : Bool do
    if i >= 60 do false
    else if N.height(i, i * 2, 7) != N.height(i, i * 2, 8) do true
    else seeds_differ(i + 1) end end
  end

  pfn height_span(i : Int, lo : Int, hi : Int) : Bool do
    if i >= 400 do lo < C.sea_level() && hi > C.sea_level() + 20
    else
      let h = N.height(i % 128, i / 128 * 7, 5)
      height_span(i + 1, if h < lo do h else lo end, if h > hi do h else hi end)
    end
  end

  pfn lanes_match(i : Int) : Bool do
    if i >= 40 do true
    else
      let wx = i * 3
      let wz = i * 5 + 1
      let hs = N.height_x4(wx, wz, 11)
      let l0 = float_to_int(Simd.extract_f32x4(hs, 0)) == N.height(wx, wz, 11)
      let l1 = float_to_int(Simd.extract_f32x4(hs, 1)) == N.height(wx + 1, wz, 11)
      let l2 = float_to_int(Simd.extract_f32x4(hs, 2)) == N.height(wx + 2, wz, 11)
      let l3 = float_to_int(Simd.extract_f32x4(hs, 3)) == N.height(wx + 3, wz, 11)
      if l0 && l1 && l2 && l3 do lanes_match(i + 1) else false end
    end
  end


  -- The new layers: masks stay in range, and a terrace is flat where it claims to be.
  pfn masks_in_range(i : Int) : Bool do
    if i >= 400 do true
    else
      let x = int_to_float(i) *. 1.7
      let z = int_to_float(i) *. 0.9
      let a = N.ridged_fbm(x *. 0.028, z *. 0.028, 3)
      let b = N.plateau_mask(x, z, 3)
      let c = N.river_mask(x, z, 3)
      let ok = a >= 0.0 && a <= 1.0 && b >= 0.0 && b <= 1.0 && c >= 0.0 && c <= 1.0
      if ok do masks_in_range(i + 1) else false end
    end
  end

  pfn terrace_bounded(i : Int) : Bool do
    if i >= 400 do true
    else
      let v = int_to_float(i) *. 0.37
      let d = Math.abs(N.terrace(v, 2.5) -. v)
      if d <= N.plateau_step() *. 0.5 +. 0.000001 do terrace_bounded(i + 1) else false end
    end
  end

  pfn near(a : Float, b : Float) : Bool do Math.abs(a -. b) < 0.000001 end

  -- Age: the same base seed at two ages. The noise underneath is identical; only
  -- the erosion knobs move, so heights differ but the lattice does not.
  pfn noise_age_blind(i : Int) : Bool do
    if i >= 100 do true
    else
      let x = int_to_float(i) *. 0.83
      let z = int_to_float(i) *. 0.29
      if N.value2(x, z, N.with_age(5, 0)) == N.value2(x, z, N.with_age(5, 90)) do noise_age_blind(i + 1) else false end
    end
  end
  pfn heights_differ_by_age(i : Int) : Bool do
    if i >= 200 do false
    else if N.height(i * 3 % 128, i * 7 % 128, N.with_age(7, 0)) != N.height(i * 3 % 128, i * 7 % 128, N.with_age(7, 100)) do true
    else heights_differ_by_age(i + 1) end end
  end
  pfn max_height(i : Int, seed : Int, hi : Int) : Int do
    if i >= 1024 do hi
    else
      let h = N.height(i % 32 * 4, i / 32 * 4, seed)
      max_height(i + 1, seed, if h > hi do h else hi end)
    end
  end

  describe "ridged noise" do
    test "stays within [0, 1]" do
      Test.assert_true(ridged_in_range(0, 1.0, 0.0), "ridged noise in range")
    end
  end

  describe "height" do
    test "is deterministic for a seed and differs across seeds" do
      Test.assert_eq_int(N.height(30, 40, 7), N.height(30, 40, 7), "same seed, same height")
      Test.assert_true(seeds_differ(0), "a different seed gives different terrain")
    end
    test "spans a range that brackets sea level" do
      Test.assert_true(height_span(0, 999, 0), "terrain reaches above and below sea level")
    end
  end


  describe "world age" do
    test "the age rides in the seed's high bits and round-trips" do
      Test.assert_eq_int(N.age_of(N.with_age(12345, 42)), 42, "age back out")
      Test.assert_eq_int(N.base_seed(N.with_age(12345, 42)), 12345, "base back out")
      Test.assert_eq_int(N.age_of(7), 0, "a plain seed is age 0")
      Test.assert_eq_int(N.age_of(N.with_age(7, 500)), N.max_age(), "age is clamped high")
      Test.assert_eq_int(N.age_of(N.with_age(7, -3)), 0, "and low")
      Test.assert_eq_int(N.base_seed(N.with_age(N.with_age(9, 10), 20)), 9, "re-aging replaces, it does not stack")
      Test.assert_eq_int(N.age_of(N.with_age(N.with_age(9, 10), 20)), 20, "the later age wins")
    end
    test "the noise underneath is age-blind, the terrain is not" do
      Test.assert_true(noise_age_blind(0), "value2 ignores the age bits")
      Test.assert_true(heights_differ_by_age(0), "height does not")
    end
    test "erosion grows with age" do
      Test.assert_true(N.river_depth(1.0) > N.river_depth(0.0), "valleys cut deeper")
      Test.assert_true(N.river_edge(1.0) < N.river_edge(0.0), "and wider")
      Test.assert_true(N.mountain_amp(1.0) < N.mountain_amp(0.0), "peaks wear down")
      Test.assert_true(N.terrace_sharpness(1.0) < N.terrace_sharpness(0.0), "rims slump")
      Test.assert_true(N.warp_amp(1.0) > N.warp_amp(0.0), "the land bends further")
      Test.assert_true(N.detail_weight(1.0) < N.detail_weight(0.0), "roughness smooths")
      Test.assert_true(max_height(0, N.with_age(7, 100), 0) < max_height(0, N.with_age(7, 0), 0), "an ancient world's highest point is lower than a young one's")
    end
  end

  describe "plateaus and rivers" do
    test "ridged_fbm and the plateau and river masks stay within [0, 1]" do
      Test.assert_true(masks_in_range(0), "every layer mask in range")
    end
    test "a terrace never moves a height more than half a step" do
      Test.assert_true(terrace_bounded(0), "terrace stays within half a step of the input")
    end
    test "a terrace is flat across the middle of a step and rises to the next one at its edge" do
      let s = N.plateau_step()
      Test.assert_true(near(N.terrace(3.0 *. s, 2.5), 3.0 *. s), "a step multiple is its own terrace")
      Test.assert_true(near(N.terrace(3.0 *. s +. 0.1 *. s, 2.5), 3.0 *. s), "just above the multiple is still flat")
      Test.assert_true(near(N.terrace(3.0 *. s +. 0.29 *. s, 2.5), 3.0 *. s), "flat for the first 30% of the step")
      Test.assert_true(near(N.terrace(3.0 *. s +. 0.75 *. s, 2.5), 4.0 *. s), "the top 30% has already reached the next terrace")
      Test.assert_true(N.terrace(3.5 *. s, 2.5) > 3.0 *. s && N.terrace(3.5 *. s, 2.5) < 4.0 *. s, "the middle is the ramp between them")
    end
  end

  -- The apron: chunk (0, 0)'s column at lx = 16 is chunk (16, 0)'s column at lx = 0.
  pfn seam_agrees(a : NativeIntArr, b : NativeIntArr, lz : Int) : Bool do
    if lz >= 16 + C.apron() do true
    else if C.hmap_at(a, 16, lz) == C.hmap_at(b, 0, lz) && C.hmap_at(a, 15, lz) == C.hmap_at(b, -1, lz) do seam_agrees(a, b, lz + 1)
    else false end end
  end
  pfn interior_matches(hs : NativeIntArr, i : Int) : Bool do
    if i >= 256 do true
    else if C.hmap_at(hs, i % 16, i / 16) == N.height(32 + i % 16, 48 + i / 16, 11) do interior_matches(hs, i + 1)
    else false end end
  end

  describe "chunk heightmap" do
    test "the interior is Noise.height, column for column" do
      Test.assert_true(interior_matches(C.heights(32, 48, 11), 0), "every column is its height")
    end
    test "the apron agrees with the neighbour's interior across the seam" do
      Test.assert_true(seam_agrees(C.heights(0, 0, 11), C.heights(16, 0, 11), 0 - C.apron()), "x seam, both directions")
    end
    test "slope over the array is Noise.slope" do
      let hs = C.heights(32, 48, 11)
      Test.assert_eq_int(C.slope_at(hs, 5, 7), N.slope(37, 55, 11), "an interior column")
      Test.assert_eq_int(C.slope_at(hs, 0, 15), N.slope(32, 63, 11), "a corner column reads the apron")
    end
  end

  describe "SIMD and scalar generators agree" do
    -- The 4-wide path is a separate implementation of the same formula; if they drift,
    -- `generate` and `generate_scalar` silently produce different worlds.
    test "height_x4 lanes match height for the same columns" do
      Test.assert_true(lanes_match(0), "all four lanes match the scalar height")
    end
  end

  describe "surface materials" do
    test "cliff beats altitude, and a steep shore is rock rather than beach" do
      Test.assert_eq_int(C.surface_id(120, 6), C.granite(), "steep high ground is granite, not snow")
      Test.assert_eq_int(C.surface_id(120, 0), C.snow(), "flat high ground is snow")
      Test.assert_eq_int(C.surface_id(C.sea_level(), 6), C.granite(), "steep shore is a cliff")
      Test.assert_eq_int(C.surface_id(C.sea_level(), 0), C.sand(), "flat shore is a beach")
      Test.assert_eq_int(C.surface_id(80, 0), 1, "flat mid ground is grass")
      Test.assert_eq_int(C.surface_id(C.sea_level() - 20, 0), 2, "deep bed is dirt, not sand")
    end
    test "subsurface follows the surface for sand and granite, dirt otherwise" do
      Test.assert_eq_int(C.subsurface_id(C.sand()), C.sand(), "sand over sand")
      Test.assert_eq_int(C.subsurface_id(C.granite()), C.granite(), "granite over granite")
      Test.assert_eq_int(C.subsurface_id(1), 2, "grass over dirt")
      Test.assert_eq_int(C.subsurface_id(C.snow()), 2, "snow over dirt")
    end
  end

  -- Strata: walk a column from the deep band up to the subsurface and check
  -- every block is a rock, each band is contiguous and band_thickness() tall
  -- (the first and last may be cut), and the column matches rock_id.
  pfn rocks_ok(c : CubeForge.Chunk.Chunk, wx : Int, wz : Int, seed : Int, y : Int, top : Int) : Bool do
    if y > top do true
    else
      let id = C.get(c, wx % 16, y, wz % 16)
      let rock = id == 3 || id == C.basalt() || id == C.granite() || id == C.sandstone() || id == C.shale()
      if rock && id == C.rock_id(wx, y, wz, seed) do rocks_ok(c, wx, wz, seed, y + 1, top) else false end
    end
  end
  pfn runs_ok(wx : Int, wz : Int, seed : Int, y : Int, run : Int, band : Int) : Bool do
    if y >= 200 do true
    else
      let k = C.band_of(y, C.band_offset(wx, wz, seed))
      if k == band do runs_ok(wx, wz, seed, y + 1, run + 1, band)
      else if run == 0 || run == C.band_thickness() || y < C.band_thickness() + 1 do runs_ok(wx, wz, seed, y + 1, 1, k)
      else false end end
    end
  end

  describe "rock strata" do
    test "a generated column is bedded rock between the deep band and the subsurface" do
      let c = C.generate(32, 48, 5)
      let h = N.height(37, 55, 5)
      Test.assert_true(rocks_ok(c, 37, 55, 5, C.deep_stone_depth(), h - 4), "rock only, and rock_id's rock")
      Test.assert_eq_int(C.get(c, 5, C.deep_stone_depth() - 1, 7), C.basalt(), "the deep basalt band is still under it")
      Test.assert_eq_int(C.get(c, 5, 1, 7), C.bedrock(), "and bedrock under that")
    end
    test "bands are contiguous runs of band_thickness() in a column" do
      Test.assert_true(runs_ok(37, 55, 5, 0, 0, -1), "every full band is band_thickness() tall")
    end
    test "rock_id is a function of the world column, the same from any chunk" do
      Test.assert_eq_int(C.rock_id(40, 30, 40, 9), C.rock_id(40, 30, 40, 9), "deterministic")
      Test.assert_true(C.band_material(3, 0, 0, 9) != C.bedrock(), "never bedrock")
    end
    test "sandstone and shale have their own layers and harvest as stone" do
      Test.assert_true(CubeForge.Texture.layer_for(C.sandstone()) == 89.0, "sandstone layer")
      Test.assert_true(CubeForge.Texture.layer_for(C.shale()) == 90.0, "shale layer")
      Test.assert_eq_int(CubeForge.Inventory.yield_of(C.sandstone()), 3, "sandstone yields stone")
      Test.assert_eq_int(CubeForge.Inventory.yield_of(C.shale()), 3, "shale yields stone")
    end
  end

  describe "deep stone band" do
    test "test_terrain uses basalt below deep_stone_depth, stone above it" do
      let c = C.test_terrain()
      Test.assert_eq_int(C.get(c, 0, 10, 0), C.basalt(), "below the deep stone depth is basalt")
      Test.assert_eq_int(C.get(c, 0, C.deep_stone_depth(), 0), 3, "at the depth boundary is plain stone")
      Test.assert_eq_int(C.get(c, 0, 40, 0), 3, "well above the boundary is plain stone")
      Test.assert_eq_int(C.get(c, 0, 1, 0), C.bedrock(), "still bedrock at the floor")
    end
  end

  describe "new terrain block ids" do
    test "basalt, ice and mud have distinct ids above clay" do
      Test.assert_eq_int(C.basalt(), 22, "basalt id")
      Test.assert_eq_int(C.ice(), 23, "ice id")
      Test.assert_eq_int(C.mud(), 24, "mud id")
    end
    test "each has its own texture layer" do
      Test.assert_true(CubeForge.Texture.layer_for(C.basalt()) == 17.0, "basalt layer")
      Test.assert_true(CubeForge.Texture.layer_for(C.ice()) == 18.0, "ice layer")
      Test.assert_true(CubeForge.Texture.layer_for(C.mud()) == 19.0, "mud layer")
      Test.assert_true(CubeForge.Texture.layer_for(C.basalt()) != CubeForge.Texture.layer_for(C.mud()), "basalt and mud are visually distinct")
    end
  end


  describe "Trees.spring_at_cell" do
    test "a spring column has slope and height, and a generated chunk holds it" do
      let n = count_springs(0, 0, 7, 0, 0)
      Test.assert_true(n >= 0, "ran")
      Test.assert_true(all_springs_ok(0, 7), "every spring cell is a mountainside or a valley centreline")
    end
    test "valley springs sit on the centreline, above the rise, and exist somewhere" do
      Test.assert_true(valley_springs_ok(0, 0, 0) > 0, "some seed in 0..7 has a valley spring")
      Test.assert_true(CubeForge.Noise.spring_rise(1.0) < CubeForge.Noise.spring_rise(0.0), "an old valley runs lower")
    end
  end
  -- Every valley spring (kind 2) across seeds 0..7 is on the centreline and above
  -- the rise; returns how many were seen, or -1 when one is misplaced.
  pfn valley_springs_ok(seed : Int, i : Int, seen : Int) : Int do
    if seed >= 8 do seen
    else if i >= 256 do valley_springs_ok(seed + 1, 0, seen)
    else if CubeForge.Trees.spring_kind(i % 16, i / 16, seed) != 2 do valley_springs_ok(seed, i + 1, seen)
    else
      let col = CubeForge.Trees.spring_at_cell(i % 16, i / 16, seed)
      let wx = col % 4096
      let wz = col / 4096
      let ok = CubeForge.Noise.river_at(wx, wz, seed) >= CubeForge.Noise.spring_mask()
               && CubeForge.Noise.height(wx, wz, seed) > CubeForge.Chunk.sea_level() + CubeForge.Noise.spring_rise(0.0)
      if ok do valley_springs_ok(seed, i + 1, seen + 1) else 0 - 1 end
    end end end
  end
  pfn count_springs(cx : Int, cz : Int, seed : Int, i : Int, acc : Int) : Int do
    if i >= 256 do acc else count_springs(cx, cz, seed, i + 1, if CubeForge.Trees.spring_at_cell(i % 16, i / 16, seed) >= 0 do acc + 1 else acc end) end
  end
  pfn all_springs_ok(i : Int, seed : Int) : Bool do
    if i >= 256 do true
    else
      let col = CubeForge.Trees.spring_at_cell(i % 16, i / 16, seed)
      if col < 0 do all_springs_ok(i + 1, seed)
      else
        let wx = col % 4096
        let wz = col / 4096
        let h = CubeForge.Noise.height(wx, wz, seed)
        let ch = CubeForge.Chunk.generate(wx - wx % 16, wz - wz % 16, seed)
        let block = CubeForge.Chunk.get(ch, wx % 16, h, wz % 16)
        let is_valid_spring = if h >= CubeForge.Noise.snow_line() do block == CubeForge.Chunk.ice() else CubeForge.Chunk.is_source(block) end
        let mountainside = CubeForge.Noise.slope(wx, wz, seed) >= 2 && h >= 72
        let valley = CubeForge.Noise.river_at(wx, wz, seed) >= CubeForge.Noise.spring_mask()
                     && h > CubeForge.Chunk.sea_level() + CubeForge.Noise.spring_rise(CubeForge.Noise.age_frac(seed))
                     && CubeForge.Noise.slope(wx, wz, seed) >= 1
        if (mountainside || valley) && is_valid_spring do all_springs_ok(i + 1, seed) else false end
      end
    end
  end

  describe "spring freezing" do
    test "springs at or above the snow line freeze to ice; below it, they're water" do
      Test.assert_true(all_springs_frozen_correctly(0, 0), "every sampled spring, across seeds, matches the altitude rule")
      Test.assert_true(any_spring_at_or_above_snowline(0, 0), "at least one sampled spring is at/above the snow line, so the ice branch is actually exercised")
    end
  end
  pfn all_springs_frozen_correctly(seed : Int, i : Int) : Bool do
    if seed >= 20 do true
    else if i >= 256 do all_springs_frozen_correctly(seed + 1, 0)
    else
      let col = CubeForge.Trees.spring_at_cell(i % 16, i / 16, seed)
      if col < 0 do all_springs_frozen_correctly(seed, i + 1)
      else
        let wx = col % 4096
        let wz = col / 4096
        let h = CubeForge.Noise.height(wx, wz, seed)
        let ch = CubeForge.Chunk.generate(wx - wx % 16, wz - wz % 16, seed)
        let block = CubeForge.Chunk.get(ch, wx % 16, h, wz % 16)
        let want = if h >= CubeForge.Noise.snow_line() do CubeForge.Chunk.ice() else CubeForge.Chunk.water() end
        if block == want do all_springs_frozen_correctly(seed, i + 1) else false end
      end
    end end
  end
  pfn any_spring_at_or_above_snowline(seed : Int, i : Int) : Bool do
    if seed >= 20 do false
    else if i >= 256 do any_spring_at_or_above_snowline(seed + 1, 0)
    else
      let col = CubeForge.Trees.spring_at_cell(i % 16, i / 16, seed)
      if col < 0 do any_spring_at_or_above_snowline(seed, i + 1)
      else
        let wx = col % 4096
        let wz = col / 4096
        if CubeForge.Noise.height(wx, wz, seed) >= CubeForge.Noise.snow_line() do true
        else any_spring_at_or_above_snowline(seed, i + 1) end
      end
    end end
  end
  describe "World.from_chunks" do
    test "a world rebuilt from its own chunks hashes the same" do
      let w = CubeForge.World.generate(1, 7, 1)
      let w2 = CubeForge.World.from_chunks(CubeForge.World.chunks(w), 1)
      Test.assert_eq_int(CubeForge.World.state_hash(w2), CubeForge.World.state_hash(w), "same blocks")
      Test.assert_eq_int(CubeForge.World.side(w2), 1, "side")
    end
  end

end
