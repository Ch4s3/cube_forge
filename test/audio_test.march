-- The mixer policy: every gain a real gain, snow and water muffling the world
-- monotonically, and a bar schedule that never modulates mid-phrase.
mod CubeForge.Test.Audio do

  -- Capability ceiling (GAPS G41): this test only calls pure functions, but the
  -- ceiling charges it for everything reachable through Biome.
  needs IO.Spawn
  needs IO.Clock
  needs IO.Console
  needs IO.Process
  needs IO.FileRead
  needs IO.FileWrite
  import Test
  alias CubeForge.Audio as Audio
  alias CubeForge.Biome as Biome
  alias CubeForge.Score as Score

  -- A coarse sweep of the whole input space, 1728 combinations, decoded from
  -- one index so the scan can be a single recursion.
  pfn three(k : Int) : Float do if k == 0 do 0.0 else if k == 1 do 0.5 else 1.0 end end end
  pfn combos() : Int do 1728 end
  pfn mix_at(i : Int) : CubeForge.Audio.Mix do
    Audio.mix(i % 8, three((i / 8) % 3), three((i / 24) % 3), three((i / 72) % 3),
          int_to_float((i / 216) % 2), int_to_float((i / 432) % 2), (i / 864) % 2 == 1)
  end

  pfn bad_gain(g : Float) : Bool do g < 0.0 || g > 1.0 end

  pfn gains_out_of_range(i : Int) : Int do
    if i >= combos() do -1
    else
      let m = mix_at(i)
      let bad = bad_gain(Audio.rain_of(m)) || bad_gain(Audio.wind_of(m)) || bad_gain(Audio.leaves_of(m))
                || bad_gain(Audio.water_of(m)) || bad_gain(Audio.music_of(m))
      if bad do i else gains_out_of_range(i + 1) end
    end
  end

  pfn cutoff_out_of_range(i : Int) : Int do
    if i >= combos() do -1
    else
      let c = Audio.cutoff_of(mix_at(i))
      if c < 100.0 || c > 20000.0 do i else cutoff_out_of_range(i + 1) end
    end
  end

  -- Underwater must silence the surface beds, whatever else is going on.
  pfn surface_heard_underwater(i : Int) : Int do
    if i >= combos() do -1
    else
      let m = mix_at(864 + (i % 864))
      let loud = Audio.rain_of(m) > 0.02 || Audio.wind_of(m) > 0.02 || Audio.leaves_of(m) > 0.02
      if loud do i else surface_heard_underwater(i + 1) end
    end
  end

  -- Cutoff must never rise as snow thickens.
  pfn cutoff_rises_with_snow(k : Int, prev : Float) : Int do
    if k > 100 do -1
    else
      let c = Audio.cutoff(int_to_float(k) /. 100.0, false)
      if c > prev +. 0.0001 do k else cutoff_rises_with_snow(k + 1, c) end
    end
  end

  -- The biome table must answer for every id, and answer with something the
  -- score and the synthesiser can actually use.
  pfn table_break(b : Int) : Int do
    if b >= Biome.count() do -1
    else
      let bad = Audio.mode_of(b) < 0 || Audio.mode_of(b) >= Score.mode_count()
                || Audio.transpose_of(b) < 0 || Audio.transpose_of(b) > 11
                || Audio.octave_of(b) < 4 || Audio.octave_of(b) > 6
                || Audio.bar_ticks_of(b) < 12 || Audio.bar_ticks_of(b) > 48
                || Audio.density_of(b) <= 0.0 || Audio.density_of(b) > 1.0
                || Audio.timbre_of(b) < 0 || Audio.timbre_of(b) > 4
      if bad do b else table_break(b + 1) end
    end
  end

  -- Every voice has to be somewhere a listener can hear it, in every key, in
  -- every mode, on every degree the progression can reach. A bass note under
  -- 30 Hz is a thump on a good speaker and nothing at all on a bad one, and a
  -- melody over 3 kHz is a whistle; both are what an unfolded key does.
  pfn pitch_out_of_range(i : Int) : Int do
    if i >= Biome.count() * 4 do -1
    else
      let b = i / 4
      let m = Audio.mode_of(b)
      let bar = i % 4
      let root = Score.chord_root(11, bar)
      let bass = Score.midi_of(m, Score.fold_key(Audio.transpose_of(b)), Audio.bass_octave(), Score.bass_degree(m, root))
      let pad = Score.midi_of(m, Audio.transpose_of(b), Audio.pad_octave(b), Score.pad_degree(m, root, 2))
      let mel = Score.midi_of(m, Audio.transpose_of(b), Audio.octave_of(b), Score.reg_high(m))
      -- MIDI 29 is 44 Hz and 101 is 2.8 kHz: the outside of what a three-voice
      -- texture can use at either end.
      if bass < 29 || bass > 53 || pad < 45 || pad > 84 || mel < 62 || mel > 101 do i
      else pitch_out_of_range(i + 1) end
    end
  end

  -- Walk the schedule, playing whenever a bar is due, and report the tick at
  -- which the mode or the key changed part-way through a phrase.
  pfn shift_mid_phrase(s : CubeForge.Audio.Sched, tick : Int, n : Int) : Int do
    if tick >= n do -1
    else if !Audio.due(s, tick) do shift_mid_phrase(s, tick + 1, n)
    else
      -- the biome under the listener changes every bar, as violently as it can
      let s1 = Audio.advance(s, 20, tick % Score.mode_count(), tick % 12)
      let mid = (Audio.bar_of(s) + 1) % Score.phrase_bars() != 0
      let changed = Audio.mode_of_sched(s1) != Audio.mode_of_sched(s)
                    || Audio.transpose_of_sched(s1) != Audio.transpose_of_sched(s)
      if mid && changed do tick else shift_mid_phrase(s1, tick + 1, n) end end end
  end

  -- Bars are numbered in order and the downbeat falls exactly bar_ticks apart:
  -- a bar line that drifts is the one rhythmic error an ear will not forgive.
  pfn bar_off_grid(s : CubeForge.Audio.Sched, tick : Int, n : Int, bt : Int) : Int do
    if tick >= n do -1
    else if !Audio.due(s, tick) do bar_off_grid(s, tick + 1, n, bt)
    else
      let s1 = Audio.advance(s, bt, 0, 0)
      if Audio.bar_of(s1) != Audio.bar_of(s) + 1 || Audio.next_of(s1) != Audio.next_of(s) + bt do tick
      else bar_off_grid(s1, tick + 1, n, bt) end end end
  end

  -- How many bars fall in [n] ticks at [bt] ticks a bar.
  pfn bars_in(s : CubeForge.Audio.Sched, tick : Int, n : Int, bt : Int, acc : Int) : Int do
    if tick >= n do acc
    else if !Audio.due(s, tick) do bars_in(s, tick + 1, n, bt, acc)
    else bars_in(Audio.advance(s, bt, 0, 0), tick + 1, n, bt, acc + 1) end end
  end

  describe "Audio.mix" do
    test "every gain is a real gain across the whole input space" do
      Test.assert_eq_int(gains_out_of_range(0), -1, "all 1728 combinations stay in 0..1")
    end

    test "the cutoff is always an audible frequency" do
      Test.assert_eq_int(cutoff_out_of_range(0), -1, "all 1728 combinations stay in 100..20000 Hz")
    end

    test "a cold biome in clear weather is not muffled" do
      -- snow_mix is a property of temperature, not of the sky: it reads 1.0 on
      -- a bright still day in the tundra. Nothing is falling, so nothing should
      -- be muffled.
      let still = Audio.mix(Biome.b_tundra(), 0.0, 0.3, 1.0, 0.5, 0.0, false)
      Test.assert_true(Audio.cutoff_of(still) > 15000.0, "clear cold air is as open as clear warm air")
    end

    test "muffles in proportion to the snow actually falling" do
      let light = Audio.mix(Biome.b_tundra(), 0.3, 0.3, 1.0, 0.5, 0.0, false)
      let heavy = Audio.mix(Biome.b_tundra(), 1.0, 0.3, 1.0, 0.5, 0.0, false)
      Test.assert_true(Audio.cutoff_of(heavy) < Audio.cutoff_of(light), "a blizzard is duller than a flurry")
      Test.assert_true(Audio.cutoff_of(heavy) < 6000.0, "a blizzard is properly muffled")
    end

    test "rain in a warm storm does not muffle" do
      let rainy = Audio.mix(Biome.b_wetland(), 1.0, 0.3, 0.0, 0.5, 0.0, false)
      Test.assert_true(Audio.cutoff_of(rainy) > 15000.0, "rain is loud, not dull")
    end

    test "snow silences the rain" do
      let wet = Audio.mix(Biome.b_grassland(), 1.0, 0.5, 0.0, 0.5, 0.5, false)
      let snowy = Audio.mix(Biome.b_grassland(), 1.0, 0.5, 1.0, 0.5, 0.5, false)
      Test.assert_true(Audio.rain_of(wet) > 0.3, "rain is heard in a storm")
      Test.assert_true(Audio.rain_of(snowy) < 0.001, "snow falls silently")
    end

    test "a desert stays drier than a wetland under the same storm" do
      let desert = Audio.mix(Biome.b_desert(), 1.0, 0.5, 0.0, 0.5, 0.5, false)
      let wetland = Audio.mix(Biome.b_wetland(), 1.0, 0.5, 0.0, 0.5, 0.5, false)
      Test.assert_true(Audio.rain_of(desert) < Audio.rain_of(wetland), "precip_scale reaches the mix")
    end

    test "the surface goes quiet under water" do
      Test.assert_eq_int(surface_heard_underwater(0), -1, "no surface bed survives submersion")
    end

    test "the underwater bed is only heard under water" do
      Test.assert_true(Audio.water_of(Audio.mix(Biome.b_beach(), 0.5, 0.5, 0.0, 0.5, 0.5, true)) > 0.3, "heard below")
      Test.assert_true(Audio.water_of(Audio.mix(Biome.b_beach(), 0.5, 0.5, 0.0, 0.5, 0.5, false)) < 0.001, "silent above")
    end

    test "the mountain bed needs both wind and exposure" do
      Test.assert_true(Audio.wind_of(Audio.mix(Biome.b_alpine(), 0.5, 1.0, 0.0, 1.0, 0.0, false)) > 0.3, "windy peak")
      Test.assert_true(Audio.wind_of(Audio.mix(Biome.b_alpine(), 0.5, 1.0, 0.0, 0.0, 0.0, false)) < 0.001, "windy cave is silent")
      Test.assert_true(Audio.wind_of(Audio.mix(Biome.b_alpine(), 0.5, 0.0, 0.0, 1.0, 0.0, false)) < 0.001, "still peak is silent")
    end

    test "leaves need both wind and leaves" do
      Test.assert_true(Audio.leaves_of(Audio.mix(Biome.b_forest(), 0.0, 1.0, 0.0, 0.2, 1.0, false)) > 0.3, "windy forest")
      Test.assert_true(Audio.leaves_of(Audio.mix(Biome.b_forest(), 0.0, 0.0, 0.0, 0.2, 1.0, false)) < 0.001, "still forest is silent")
      Test.assert_true(Audio.leaves_of(Audio.mix(Biome.b_desert(), 0.0, 1.0, 0.0, 0.2, 0.0, false)) < 0.001, "no leaves, no rustle")
    end
  end

  describe "Audio.exposure" do
    test "sea level is sheltered and the snow line is exposed" do
      Test.assert_true(Audio.exposure(62, 15) < 0.001, "sea level")
      Test.assert_true(Audio.exposure(95, 15) > 0.999, "snow line")
    end

    test "a cave is sheltered however high it is" do
      Test.assert_true(Audio.exposure(95, 0) < 0.001, "no sky, no wind")
      Test.assert_true(Audio.exposure(200, 0) < 0.001, "still no sky")
    end

    test "does not run away above the snow line" do
      Test.assert_true(Audio.exposure(250, 15) <= 1.0, "clamped at the top")
      Test.assert_true(Audio.exposure(0, 15) >= 0.0, "clamped at the bottom")
    end

    test "rises with height and with open sky" do
      Test.assert_true(Audio.exposure(90, 15) > Audio.exposure(70, 15), "higher is windier")
      Test.assert_true(Audio.exposure(90, 15) > Audio.exposure(90, 7), "more sky is windier")
    end
  end

  describe "Audio.leaf_fraction" do
    test "rises with the share of sampled blocks that were foliage" do
      Test.assert_true(Math.abs(Audio.leaf_fraction(0, 343) -. 0.0) < 0.001, "no leaves")
      Test.assert_true(Audio.leaf_fraction(8, 343) > Audio.leaf_fraction(4, 343), "denser is louder")
    end

    test "a real forest is loud, not a rumour" do
      -- The lattice samples a 13-block cube, 343 points, and standing under the
      -- canopy of a generated forest fills about 2.5% of it with leaves (seed
      -- 13, measured). If a bed needs a solid wall of foliage to be heard it is
      -- never heard, so full_canopy() is set from that measurement, not from
      -- what "a lot of leaves" sounds like it should mean.
      Test.assert_true(Audio.leaf_fraction(9, 343) > 0.5, "standing in a forest is at least half a canopy")
      Test.assert_true(Audio.leaf_fraction(3, 343) < 0.35, "a lone tree is not a forest")
    end

    test "saturates rather than running away in dense canopy" do
      Test.assert_true(Audio.leaf_fraction(60, 343) > 0.999, "clamped at the top")
    end

    test "survives an empty sample" do
      Test.assert_true(Math.abs(Audio.leaf_fraction(0, 0) -. 0.0) < 0.001, "no division by zero")
    end
  end

  describe "Audio bar timing" do
    test "a bar is a whole number of ticks, so the downbeat cannot drift" do
      Test.assert_true(Math.abs(Audio.bar_seconds(Biome.b_forest())
                        *. int_to_float(Audio.ticks_per_second())
                        -. int_to_float(Audio.bar_ticks_of(Biome.b_forest()))) < 0.0001,
                       "bar_seconds is bar_ticks over the tick rate, exactly")
    end

    test "eight eighths make a bar" do
      Test.assert_true(Math.abs(Audio.eighth_seconds(Biome.b_forest()) *. 8.0
                        -. Audio.bar_seconds(Biome.b_forest())) < 0.0001, "the grid closes")
    end

    test "every biome keeps a tempo somebody could follow" do
      Test.assert_true(Audio.bar_seconds(Biome.b_wetland()) > 1.5, "the fastest is not a scramble")
      Test.assert_true(Audio.bar_seconds(Biome.b_grove()) < 8.0, "the slowest is still a bar")
    end
  end

  describe "Audio.cutoff" do
    test "clear air is not filtered" do
      Test.assert_true(Audio.cutoff(0.0, false) > 15000.0, "wide open")
    end

    test "falls as the snow thickens and never rises" do
      Test.assert_eq_int(cutoff_rises_with_snow(0, 100000.0), -1, "monotonic in snow")
      Test.assert_true(Audio.cutoff(1.0, false) < 6000.0, "full snow is muffled")
    end

    test "water muffles harder than snow, and does not compound with it" do
      Test.assert_true(Audio.cutoff(0.0, true) < Audio.cutoff(1.0, false), "under water is duller than under snow")
      Test.assert_true(Math.abs(Audio.cutoff(1.0, true) -. Audio.cutoff(0.0, true)) < 0.0001, "snow adds nothing below the surface")
    end
  end

  describe "Audio biome table" do
    test "answers for every biome" do
      Test.assert_eq_int(table_break(0), -1, "every id in range")
    end

    test "every voice lands somewhere it can be heard" do
      Test.assert_eq_int(pitch_out_of_range(0), -1, "bass, chord and melody all in register")
    end

    test "different biomes really do sound different" do
      Test.assert_true(Audio.octave_of(Biome.b_alpine()) != Audio.octave_of(Biome.b_forest()), "alpine sits above forest")
      Test.assert_true(Audio.mode_of(Biome.b_desert()) != Audio.mode_of(Biome.b_grassland()), "desert and grassland are in different modes")
      Test.assert_true(Audio.density_of(Biome.b_wetland()) > Audio.density_of(Biome.b_desert()), "a wetland is busier than a desert")
      Test.assert_true(Audio.bar_ticks_of(Biome.b_wetland()) < Audio.bar_ticks_of(Biome.b_grove()), "a wetland is faster than a grove")
    end
  end

  describe "Audio.advance" do
    test "never changes mode or key mid-phrase" do
      Test.assert_eq_int(shift_mid_phrase(Audio.sched_start(0, Biome.b_forest()), 0, 6000), -1,
                         "the phrase is always finished before the biome is adopted")
    end

    test "keeps the bar line on the grid" do
      Test.assert_eq_int(bar_off_grid(Audio.sched_start(0, Biome.b_forest()), 0, 6000, 20), -1,
                         "bars in order, exactly bar_ticks apart")
    end

    test "plays bars at the requested tempo" do
      -- 6 ticks a second, so 3600 ticks is ten minutes: 180 bars of 20 ticks
      -- and 120 of 30.
      Test.assert_eq_int(bars_in(Audio.sched_start(0, Biome.b_forest()), 0, 3600, 20, 0), 180, "180 bars at 20 ticks")
      Test.assert_eq_int(bars_in(Audio.sched_start(0, Biome.b_forest()), 0, 3600, 30, 0), 120, "120 bars at 30 ticks")
    end

    test "opens in the biome it starts in" do
      let s = Audio.sched_start(0, Biome.b_desert())
      Test.assert_eq_int(Audio.mode_of_sched(s), Audio.mode_of(Biome.b_desert()), "the desert's mode from the first bar")
      Test.assert_true(Audio.phrase_start(s), "bar zero opens a phrase")
    end
  end

  describe "note shapes" do
    test "a melody note is struck and a pad note swells" do
      Test.assert_true(Audio.mel_attack() < 0.05, "the melody has an edge on it")
      Test.assert_true(Audio.pad_attack(Biome.b_forest()) > 0.5, "the chord arrives under the line, not with it")
      Test.assert_true(Audio.mel_sustain() < Audio.pad_sustain(), "a struck note decays and a held one holds")
    end

    test "a melody note stops before the next one starts" do
      Test.assert_true(Audio.mel_hold() < 1.0, "consecutive eighths are two notes, not one")
    end

    test "the chord sits under the melody and the bass under the chord" do
      Test.assert_true(Audio.pad_octave(Biome.b_forest()) < Audio.octave_of(Biome.b_forest()), "chord below melody")
      Test.assert_true(Audio.bass_octave() <= Audio.pad_octave(Biome.b_forest()), "bass below chord")
      Test.assert_true(Audio.bass_gain() > Audio.pad_gain(), "one bass note against three chord tones")
    end

    test "every voice is panned somewhere real" do
      Test.assert_true(Audio.pad_pan(0) < 0.0 && Audio.pad_pan(2) > 0.0, "the chord is spread")
      Test.assert_true(Math.abs(Audio.mel_pan(42, 3, 5)) < 0.5, "the line stays near the middle")
    end
  end

end
