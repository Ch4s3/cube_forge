-- Populations: capacity is read off the world, a shovel changes it, and the
-- counts follow. This is the rule that closes the terraforming loop, so it is
-- tested on a world that gets dug.
mod CubeForge.Test.Pop do

  needs IO.Spawn
  import Test
  alias CubeForge.Pop as Pop
  alias CubeForge.Fauna as Fa
  alias CubeForge.Biome as Biome
  alias CubeForge.World as W
  alias CubeForge.Chunk as C

  -- A flat world of stone to height [h], eight chunks a side.
  pfn flat_cells(c : CubeForge.Chunk.Chunk, i : Int, h : Int) : CubeForge.Chunk.Chunk do
    if i >= 256 * h do c else flat_cells(C.set(c, i % 16, i / 256, (i / 16) % 16, 3), i + 1, h) end
  end
  pfn flat_chunks(i : Int, h : Int, acc : List(CubeForge.Chunk.Chunk)) : List(CubeForge.Chunk.Chunk) do
    if i < 0 do acc else flat_chunks(i - 1, h, Cons(flat_cells(C.new(), 0, h), acc)) end
  end
  pfn flat_world(h : Int) : CubeForge.World.World do W.of_chunk_list(flat_chunks(63, h, Nil), 8) end

  -- Dig a square pond [d] deep with its corner at (x0, z0), [s] a side, and
  -- fill it with water sources: the surface stays at [h].
  pfn pond_go(w : CubeForge.World.World, x0 : Int, z0 : Int, s : Int, h : Int, d : Int, i : Int) : CubeForge.World.World do
    if i >= s * s * d do w
    else
      let x = x0 + i % s
      let z = z0 + (i / s) % s
      let y = h - 1 - i / (s * s)
      pond_go(W.set_block(w, x, y, z, C.water()), x0, z0, s, h, d, i + 1)
    end
  end
  pfn pond(w : CubeForge.World.World, x0 : Int, z0 : Int, s : Int, h : Int, d : Int) : CubeForge.World.World do pond_go(w, x0, z0, s, h, d, 0) end

  -- Force every column of chunk (cx, cz) to biome [b].
  pfn force_chunk(f : CubeForge.Biome.Field, cx : Int, cz : Int, b : Int, i : Int) : CubeForge.Biome.Field do
    if i >= 256 do f else force_chunk(Biome.force_biome(f, 128, 16 * cx + i % 16, 16 * cz + i / 16, b), cx, cz, b, i + 1) end
  end

  pfn run(r : CubeForge.Pop.Reg, w : CubeForge.World.World, f : CubeForge.Biome.Field, cx : Int, cz : Int, n : Int) : CubeForge.Pop.Reg do
    if n <= 0 do r else run(Pop.tick_chunk(r, w, f, cx, cz, 0.5), w, f, cx, cz, n - 1) end
  end

  describe "capacity from habitat" do
    test "a dry chunk holds no fish, and a pond in it holds Sunfin" do
      let w = flat_world(70)
      let f = Biome.build(w, 7)
      Test.assert_eq_int(Pop.capacity(w, f, 1, 1, Fa.sp_sunfin(), 0.5), 0, "nothing to swim in")
      -- A 6x6 pond, three deep: thirty-six columns in the Sunfin band (1..4).
      -- Six, not eight: the field calls a body of up to 48 columns small
      -- (Biome.small_body), and a Sunfin wants a pond, not a lake. An 8x8 pond
      -- is a lake to it, and it was right to say so.
      let w2 = pond(w, 20, 20, 6, 70, 3)
      let f2 = Biome.build(w2, 7)
      Test.assert_eq_int(Pop.depth_at(w2, f2, 22, 22), 3, "three blocks of water over the bed")
      Test.assert_true(Pop.fish_column(w2, f2, Fa.sp_sunfin(), 22, 22), "in the Sunfin band, and a small body")
      Test.assert_eq_int(Pop.capacity(w2, f2, 1, 1, Fa.sp_sunfin(), 0.5), 36 / Pop.cols_per_fish(), "thirty-six columns is two fish")
      Test.assert_eq_int(Pop.capacity(w2, f2, 1, 1, Fa.sp_deepmaw(), 0.5), 0, "and nothing for a deep-water fish")
    end

    test "a deeper pond is somebody else's water" do
      let w = pond(flat_world(70), 20, 20, 6, 70, 7)
      let f = Biome.build(w, 7)
      Test.assert_eq_int(Pop.depth_at(w, f, 22, 22), 7, "seven deep")
      Test.assert_eq_int(Pop.capacity(w, f, 1, 1, Fa.sp_sunfin(), 0.5), 0, "too deep for Sunfin (1..4)")
      Test.assert_true(Pop.capacity(w, f, 1, 1, Fa.sp_reedcarp(), 0.5) == 0, "and Reedcarp (2..6) too -- but a pond is small water and Reedcarp wants that; the depth alone excludes it")
    end

    test "a bird's capacity is its biome" do
      let w = flat_world(70)
      let f = force_chunk(Biome.build(w, 7), 2, 2, Biome.b_grassland(), 0)
      Test.assert_eq_int(Pop.capacity(w, f, 2, 2, Fa.sp_grasspipit(), 0.5), 256 / Pop.cols_per_bird(), "a whole chunk of grassland is eight pipits")
      Test.assert_eq_int(Pop.capacity(w, f, 2, 2, Fa.sp_pinecrest(), 0.5), 0, "and no forest birds")
      let f2 = force_chunk(f, 2, 2, Biome.b_forest(), 0)
      Test.assert_eq_int(Pop.capacity(w, f2, 2, 2, Fa.sp_grasspipit(), 0.5), 0, "grow the forest and the pipits' capacity goes")
      Test.assert_true(Pop.capacity(w, f2, 2, 2, Fa.sp_pinecrest(), 0.5) > 0, "and the Pinecrests' arrives")
    end

    test "a sample column is one the species would actually hold" do
      let w = pond(flat_world(70), 20, 20, 6, 70, 3)
      let f = Biome.build(w, 7)
      let c = Pop.sample_column(w, f, 1, 1, Fa.sp_sunfin())
      Test.assert_true(c >= 0, "there is one")
      Test.assert_true(Pop.fish_column(w, f, Fa.sp_sunfin(), c % 4096, c / 4096), "and it is in the pond")
      Test.assert_eq_int(Pop.sample_column(w, f, 1, 1, Fa.sp_deepmaw()), 0 - 1, "and there is none for a fish the pond cannot hold")
    end
  end

  describe "seasons" do
    test "a migrant's capacity is nothing out of season" do
      let w = flat_world(70)
      let f = force_chunk(Biome.build(w, 7), 2, 2, Biome.b_beach(), 0)
      Test.assert_true(Fa.migrant(Fa.sp_frostgull()), "the gull migrates")
      Test.assert_true(Pop.capacity(w, f, 2, 2, Fa.sp_frostgull(), 0.75) > 0, "here in its season")
      Test.assert_eq_int(Pop.capacity(w, f, 2, 2, Fa.sp_frostgull(), 0.25), 0, "and gone out of it")
      -- the heron takes the other half of the year, so the two are never here together
      Test.assert_true(!Fa.in_season(Fa.sp_marshheron(), 0.75) && Fa.in_season(Fa.sp_marshheron(), 0.25), "the heron has the other half")
    end
  end

  describe "persistence across the window" do
    test "a chunk that leaves is archived, and comes back where it was" do
      let w = pond(flat_world(70), 20, 20, 6, 70, 3)
      let f = Biome.build(w, 7)
      -- two Sunfin in chunk (1, 1) of a window at origin (0, 0)
      let r = run(Pop.new(8), w, f, 1, 1, 6)
      Test.assert_eq_int(Pop.count_of(r, 1, 1, Fa.sp_sunfin()), 2, "the school is in")
      -- the window slides two chunks east: chunk (1, 1) is now off its west edge
      let r1 = Pop.shift(r, 2, 0, 0, 0, 100)
      Test.assert_eq_int(Pop.total(r1), 0, "nothing left in the window")
      Test.assert_eq_int(Pop.archived(r1), 1, "one chunk archived")
      let rec = Pop.lookup(Pop.archive(r1), Pop.key_of(1, 1))
      Test.assert_eq_int(Pop.rec_tick(rec), 100, "under world chunk (1, 1), at the tick it left")
      -- and slides back: chunk (1, 1) comes in at local (1, 1) again
      let r2 = Pop.restore_entered(Pop.shift(r1, 0 - 2, 0, 2, 0, 100), w, f, 0 - 2, 0, 0, 0, 0.5, 100)
      Test.assert_eq_int(Pop.count_of(r2, 1, 1, Fa.sp_sunfin()), 2, "the school is back")
      Test.assert_eq_int(Pop.archived(r2), 0, "and the record is spent")
    end

    test "a chunk away for a long time catches up with the world as it is now" do
      let w = pond(flat_world(70), 20, 20, 6, 70, 3)
      let f = Biome.build(w, 7)
      -- archived EMPTY at tick 0, restored at tick 160: ten missed visits of a
      -- 64-chunk window, enough to fill a pond that holds two
      let r0 = Pop.shift(run(Pop.new(8), w, f, 1, 1, 0), 2, 0, 0, 0, 0)
      Test.assert_eq_int(Pop.archived(r0), 0, "an empty chunk is not worth a record")
      -- so archive a chunk with SOMETHING in it -- a pipit count -- and let the
      -- pond fill while it is away
      let fg = force_chunk(f, 1, 1, Biome.b_grassland(), 0)
      let rp = run(Pop.new(8), w, fg, 1, 1, 1)
      Test.assert_true(Pop.count_of(rp, 1, 1, Fa.sp_grasspipit()) > 0, "a pipit to remember the chunk by")
      Test.assert_eq_int(Pop.count_of(rp, 1, 1, Fa.sp_sunfin()), 1, "and one fish so far")
      let away = Pop.shift(rp, 2, 0, 0, 0, 0)
      let back = Pop.restore_entered(Pop.shift(away, 0 - 2, 0, 2, 0, 160), w, fg, 0 - 2, 0, 0, 0, 0.5, 160)
      Test.assert_eq_int(Pop.count_of(back, 1, 1, Fa.sp_sunfin()), 2, "the pond filled while nobody was watching")
      -- and the other way: fill the pond in while the chunk is away, and the
      -- school that comes back finds no water
      let dry = Biome.build(flat_world(70), 7)
      let gone = Pop.restore_entered(Pop.shift(away, 0 - 2, 0, 2, 0, 160), flat_world(70), dry, 0 - 2, 0, 0, 0, 0.5, 160)
      Test.assert_eq_int(Pop.count_of(gone, 1, 1, Fa.sp_sunfin()), 0, "and none survived the filling")
    end

    test "the save keys records by world chunk, so a load anywhere finds them" do
      let w = pond(flat_world(70), 20, 20, 6, 70, 3)
      let f = Biome.build(w, 7)
      -- a school at local (1, 1) of a window at origin (5, 3): world chunk (6, 4)
      let r = run(Pop.new(8), w, f, 1, 1, 6)
      let l = Pop.to_list(r, 5, 3, 42)
      let same = Pop.from_list(8, 5, 3, l)
      Test.assert_eq_int(Pop.count_of(same, 1, 1, Fa.sp_sunfin()), 2, "loaded at the same origin, it is where it was")
      -- at origin (0, 0) world chunk (6, 4) is still inside an eight-wide
      -- window, at local (6, 4): placed, not archived
      let near = Pop.from_list(8, 0, 0, l)
      Test.assert_eq_int(Pop.count_of(near, 6, 4, Fa.sp_sunfin()), 2, "loaded at a nearby origin it lands at its world position")
      -- at origin (20, 20) it is far outside, and waits
      let moved = Pop.from_list(8, 20, 20, l)
      Test.assert_eq_int(Pop.total(moved), 0, "loaded far away the window is empty")
      Test.assert_eq_int(Pop.archived(moved), 1, "and the school waits in the archive under world chunk (6, 4)")
      Test.assert_eq_int(Pop.rec_key(Pop.lookup(Pop.archive(moved), Pop.key_of(6, 4))), Pop.key_of(6, 4), "by its world key")
    end
  end

  describe "the counts follow capacity" do
    test "dig a pond and a school fills in; fill it and the school goes" do
      let w = pond(flat_world(70), 20, 20, 6, 70, 3)
      let f = Biome.build(w, 7)
      let r0 = Pop.new(8)
      Test.assert_eq_int(Pop.count_of(r0, 1, 1, Fa.sp_sunfin()), 0, "nothing at first")
      let r1 = run(r0, w, f, 1, 1, 1)
      Test.assert_eq_int(Pop.count_of(r1, 1, 1, Fa.sp_sunfin()), 1, "one a tick, on its way up")
      let r2 = run(r1, w, f, 1, 1, 10)
      Test.assert_eq_int(Pop.count_of(r2, 1, 1, Fa.sp_sunfin()), 2, "and settled at the capacity")
      -- fill the pond back in
      let wd = flat_world(70)
      let fd = Biome.build(wd, 7)
      let r3 = run(r2, wd, fd, 1, 1, 1)
      Test.assert_eq_int(Pop.count_of(r3, 1, 1, Fa.sp_sunfin()), 1, "thinning, one a tick")
      let r4 = run(r3, wd, fd, 1, 1, 5)
      Test.assert_eq_int(Pop.count_of(r4, 1, 1, Fa.sp_sunfin()), 0, "gone")
    end

    test "the registry survives the save format, and the hash sees a change" do
      let w = pond(flat_world(70), 20, 20, 6, 70, 3)
      let f = Biome.build(w, 7)
      let r = run(Pop.new(8), w, f, 1, 1, 6)
      let back = Pop.from_list(8, 0, 0, Pop.to_list(r, 0, 0, 100))
      Test.assert_eq_int(Pop.state_hash(back), Pop.state_hash(r), "round trip")
      Test.assert_eq_int(Pop.total(back), Pop.total(r), "same animals")
      Test.assert_true(Pop.state_hash(r) != Pop.state_hash(Pop.new(8)), "and an empty registry hashes differently")
    end
  end

end
