-- Skylight: indexing, opacity, the BFS queue, seeding, spread and relight.
mod CubeForge.Test.Light do

  needs IO.Spawn   -- capability ceiling, as in test/water_test.march (GAPS.md G41)
  import Test
  alias CubeForge.F32Buf as B
  alias CubeForge.Light as L
  alias CubeForge.Chunk as C


  pfn air_chunks(i : Int, acc : List(CubeForge.Chunk.Chunk)) : List(CubeForge.Chunk.Chunk) do
    if i < 0 do acc else air_chunks(i - 1, Cons(C.new(), acc)) end
  end

  -- An 8x8 world of entirely empty chunks (no terrain), so seeding tests see
  -- only the blocks they place themselves.
  pfn air_world() : CubeForge.World.World do
    CubeForge.World.rebuild_occupancy(CubeForge.World.World(Array.from_list(air_chunks(63, Nil)), L.new(), L.new(), L.new(), CubeForge.World.shown_new(), 8, CubeForge.Model.build()))
  end


  -- A world-wide stone layer at [y]. Built chunk-locally: World.set_block copies
  -- the whole 64KB chunk per call (copy-on-write against the world it is shared
  -- with), so 16384 of them would allocate a gigabyte.
  pfn slab_cells(c : CubeForge.Chunk.Chunk, i : Int, y : Int) : CubeForge.Chunk.Chunk do
    if i >= 256 do c
    else slab_cells(C.set(c, i % 16, y, i / 16, 3), i + 1, y) end
  end
  pfn slab_chunks(i : Int, y : Int, acc : List(CubeForge.Chunk.Chunk)) : List(CubeForge.Chunk.Chunk) do
    if i < 0 do acc else slab_chunks(i - 1, y, Cons(slab_cells(C.new(), 0, y), acc)) end
  end
  pfn slab_world(y : Int) : CubeForge.World.World do
    CubeForge.World.rebuild_occupancy(CubeForge.World.World(Array.from_list(slab_chunks(63, y, Nil)), L.new(), L.new(), L.new(), CubeForge.World.shown_new(), 8, CubeForge.Model.build()))
  end


  -- Clear a vertical shaft of [n] blocks downward from (x, ytop, z).
  pfn dig_shaft(w : CubeForge.World.World, x : Int, ytop : Int, z : Int, n : Int) : CubeForge.World.World do
    if n <= 0 do w else dig_shaft(CubeForge.World.set_block(w, x, ytop, z, 0), x, ytop - 1, z, n - 1) end
  end

  -- First index where the two light fields differ, or -1 when they agree.
  pfn near(a : Float, b : Float) : Bool do Math.abs(a -. b) < 0.0001 end

  pfn first_diff_go(a : NativeU8Arr, b : NativeU8Arr, i : Int) : Int do
    if i >= 4194304 do -1
    else if NativeArray.get_u8(a, i) != NativeArray.get_u8(b, i) do i
    else first_diff_go(a, b, i + 1) end end
  end
  pfn first_difference(a : NativeU8Arr, b : NativeU8Arr) : Int do first_diff_go(a, b, 0) end


  -- First voxel of chunk (cx, cz) where the occupancy field disagrees with
  -- Light.is_opaque, or -1 when they agree everywhere.
  pfn occ_mismatch(o : NativeU8Arr, c : CubeForge.Chunk.Chunk, cx : Int, cz : Int, i : Int) : Int do
    if i >= 65536 do -1
    else
      let lx = i % 16
      let ly = i / 256
      let lz = (i / 16) % 16
      let want = if L.is_opaque(C.get_idx(c, i)) do L.occ_solid() else 0 end
      if NativeArray.get_u8(o, L.occ_index(16 * cx + lx, ly, 16 * cz + lz)) != want do i
      else occ_mismatch(o, c, cx, cz, i + 1) end
    end
  end


  -- The first (chunk, section) whose light changed but which the dirty mask did
  -- not flag, or -1 when the mask covers every change. This is the invariant the
  -- remesh depends on: an unmarked change is a section left showing stale light.
  pfn unmarked_go(a : NativeU8Arr, b : NativeU8Arr, marks : NativeIntArr, i : Int) : Int do
    if i >= 4194304 do -1
    else if NativeArray.get_u8(a, i) == NativeArray.get_u8(b, i) do unmarked_go(a, b, marks, i + 1)
    else
      let slot = L.mark_slot((i % 128) / 16, ((i / 128) % 128) / 16, (i / 16384) / 16)
      if NativeArray.get_int(marks, slot) == 0 do slot
      else unmarked_go(a, b, marks, i + 1) end
    end end
  end
  pfn marked_count(m : NativeIntArr, i : Int, acc : Int) : Int do
    if i >= 1024 do acc else marked_count(m, i + 1, acc + NativeArray.get_int(m, i)) end
  end

  describe "Light.index" do
    test "corners map to the ends of the flat range" do
      Test.assert_eq_int(L.index(0, 0, 0), 0, "origin")
      Test.assert_eq_int(L.index(127, 255, 127), L.volume() - 1, "far corner")
      Test.assert_eq_int(L.index(1, 0, 0), 1, "x is the fastest axis")
      Test.assert_eq_int(L.index(0, 0, 1), 128, "z strides by 128")
      Test.assert_eq_int(L.index(0, 1, 0), 16384, "y strides by 16384")
    end
  end

  describe "Light.opacity" do
    test "air is free, water dims, solids block" do
      Test.assert_eq_int(L.opacity(0), 0, "air")
      Test.assert_eq_int(L.opacity(C.water()), 2, "water source")
      Test.assert_eq_int(L.opacity(11), 2, "water flow cell")
      Test.assert_eq_int(L.opacity(1), L.max_level(), "grass blocks")
      Test.assert_eq_int(L.opacity(3), L.max_level(), "stone blocks")
      Test.assert_true(L.is_opaque(3), "stone is opaque")
      Test.assert_false(L.is_opaque(C.water()), "water is not opaque")
      Test.assert_false(L.is_opaque(0), "air is not opaque")
    end
  end

  describe "Light.get" do
    test "reads written values and returns 0 outside the world" do
      let a = NativeArray.set_u8(L.new(), L.index(5, 6, 7), 11)
      Test.assert_eq_int(L.get(a, 5, 6, 7), 11, "written value")
      Test.assert_eq_int(L.get(a, 5, 6, 8), 0, "untouched neighbour")
      Test.assert_eq_int(L.get(a, -1, 6, 7), 0, "x below range")
      Test.assert_eq_int(L.get(a, 128, 6, 7), 0, "x above range")
      Test.assert_eq_int(L.get(a, 5, 256, 7), 0, "y above range")
      Test.assert_eq_int(L.get(a, 5, 6, 128), 0, "z above range")
    end
  end

  describe "Light.seed_all" do
    test "an all-air world is fully lit from top to bottom" do
      let w = air_world()
      let la = L.seed_all(L.new(), w)
      Test.assert_eq_int(L.get(la, 40, 255, 40), L.max_level(), "top of the column")
      Test.assert_eq_int(L.get(la, 40, 128, 40), L.max_level(), "middle of the column")
      Test.assert_eq_int(L.get(la, 40, 0, 40), L.max_level(), "bottom of the column")
    end

    test "a solid block darkens everything beneath it" do
      let w = CubeForge.World.set_block(air_world(), 40, 100, 40, 3)
      let la = L.seed_all(L.new(), w)
      Test.assert_eq_int(L.get(la, 40, 101, 40), L.max_level(), "above the block is lit")
      Test.assert_eq_int(L.get(la, 40, 100, 40), 0, "the block itself is dark")
      Test.assert_eq_int(L.get(la, 40, 99, 40), 0, "directly beneath is dark")
      Test.assert_eq_int(L.get(la, 41, 99, 40), L.max_level(), "the next column over is untouched")
    end

    test "water attenuates two per voxel" do
      let w0 = CubeForge.World.set_block(air_world(), 40, 100, 40, C.water())
      let w1 = CubeForge.World.set_block(w0, 40, 99, 40, C.water())
      let la = L.seed_all(L.new(), w1)
      Test.assert_eq_int(L.get(la, 40, 101, 40), 15, "above the water")
      Test.assert_eq_int(L.get(la, 40, 100, 40), 13, "one water voxel")
      Test.assert_eq_int(L.get(la, 40, 99, 40), 11, "two water voxels")
      Test.assert_eq_int(L.get(la, 40, 98, 40), 11, "air below keeps the dimmed level")
    end
  end

  describe "Light.spread" do
    test "light rounds a corner, losing one per step" do
      let w0 = slab_world(100)
      let w1 = CubeForge.World.set_block(w0, 40, 100, 40, 0)
      let la = L.flood(w1)
      Test.assert_eq_int(L.get(la, 40, 99, 40), 15, "under the shaft stays full")
      Test.assert_eq_int(L.get(la, 41, 99, 40), 14, "one step along the gallery")
      Test.assert_eq_int(L.get(la, 42, 99, 40), 13, "two steps")
      Test.assert_eq_int(L.get(la, 54, 99, 40), 1, "fourteen steps, the last light")
      Test.assert_eq_int(L.get(la, 55, 99, 40), 0, "fifteen steps, dark")
    end

    test "a sealed cavity stays dark" do
      let w = slab_world(100)
      let la = L.flood(w)
      Test.assert_eq_int(L.get(la, 40, 101, 40), 15, "above the slab")
      Test.assert_eq_int(L.get(la, 40, 99, 40), 0, "below the slab")
      Test.assert_eq_int(L.get(la, 40, 0, 40), 0, "far below the slab")
    end
  end

  describe "World light field" do
    test "a generated world is lit above the terrain and dark underneath" do
      let w = CubeForge.World.relight_all(CubeForge.World.generate(8, 1, 1))
      Test.assert_eq_int(CubeForge.World.light_at(w, 40, 255, 40), 15, "open sky")
      Test.assert_eq_int(CubeForge.World.light_at(w, 40, 0, 40), 0, "bedrock depth is dark")
    end
  end

  describe "Light.relight_at" do
    test "breaking a surface block matches a full re-flood" do
      let w0 = CubeForge.World.relight_all(CubeForge.World.generate(8, 1, 1))
      let w1 = CubeForge.World.set_block(w0, 40, 70, 40, 0)
      let inc = L.relight_at(CubeForge.World.light(w1), w1, 40, 70, 40)
      Test.assert_eq_int(first_difference(inc, L.flood(w1)), -1, "incremental equals full re-flood")
    end

    test "placing a block matches a full re-flood" do
      let w0 = CubeForge.World.relight_all(CubeForge.World.generate(8, 1, 1))
      let w1 = CubeForge.World.set_block(w0, 40, 90, 40, 3)
      let inc = L.relight_at(CubeForge.World.light(w1), w1, 40, 90, 40)
      Test.assert_eq_int(first_difference(inc, L.flood(w1)), -1, "incremental equals full re-flood")
    end

    test "plugging a sky shaft darkens the gallery beneath it" do
      -- The cap has to be the shaft itself: a lone block higher up is simply
      -- flowed around, which the equals-full-flood assertion below confirms.
      let w0 = CubeForge.World.relight_all(CubeForge.World.set_block(slab_world(100), 40, 100, 40, 0))
      Test.assert_eq_int(CubeForge.World.light_at(w0, 41, 99, 40), 14, "gallery lit before the cap")
      let w1 = CubeForge.World.set_block(w0, 40, 100, 40, 3)
      let inc = L.relight_at(CubeForge.World.light(w1), w1, 40, 100, 40)
      Test.assert_eq_int(first_difference(inc, L.flood(w1)), -1, "incremental equals full re-flood")
      Test.assert_eq_int(L.get(inc, 41, 99, 40), 0, "the gallery went dark")
    end

    -- The relight box is bounded below by how far light can actually descend
    -- from the edit (see Light.open_bottom). A shaft far deeper than the relight
    -- radius is the case that bound has to get right: capping it must darken the
    -- whole shaft, not just the 15 blocks under the cap.
    test "capping a shaft deeper than the relight radius matches a full re-flood" do
      let w0 = CubeForge.World.relight_all(dig_shaft(slab_world(100), 40, 100, 40, 40))
      Test.assert_eq_int(CubeForge.World.light_at(w0, 40, 62, 40), L.max_level(), "the shaft floor is lit before the cap")
      let w1 = CubeForge.World.set_block(w0, 40, 100, 40, 3)
      let inc = L.relight_at(CubeForge.World.light(w1), w1, 40, 100, 40)
      Test.assert_eq_int(first_difference(inc, L.flood(w1)), -1, "incremental equals full re-flood")
      Test.assert_eq_int(L.get(inc, 40, 62, 40), 0, "the shaft floor 38 blocks down went dark")
    end

    test "an edit at a chunk boundary matches a full re-flood" do
      let w0 = CubeForge.World.relight_all(CubeForge.World.generate(8, 1, 1))
      let w1 = CubeForge.World.set_block(w0, 16, 80, 16, 3)
      let inc = L.relight_at(CubeForge.World.light(w1), w1, 16, 80, 16)
      Test.assert_eq_int(first_difference(inc, L.flood(w1)), -1, "incremental equals full re-flood")
    end

    test "an edit at the world edge matches a full re-flood" do
      let w0 = CubeForge.World.relight_all(CubeForge.World.generate(8, 1, 1))
      let w1 = CubeForge.World.set_block(w0, 0, 80, 127, 3)
      let inc = L.relight_at(CubeForge.World.light(w1), w1, 0, 80, 127)
      Test.assert_eq_int(first_difference(inc, L.flood(w1)), -1, "incremental equals full re-flood")
    end
  end

  describe "Mesher.corner_ao" do
    test "the standard occlusion table" do
      Test.assert_eq_int(CubeForge.Mesher.corner_ao(false, false, false), 3, "fully open")
      Test.assert_eq_int(CubeForge.Mesher.corner_ao(false, false, true), 2, "diagonal only")
      Test.assert_eq_int(CubeForge.Mesher.corner_ao(true, false, false), 2, "one side")
      Test.assert_eq_int(CubeForge.Mesher.corner_ao(false, true, false), 2, "other side")
      Test.assert_eq_int(CubeForge.Mesher.corner_ao(true, false, true), 1, "one side and the diagonal")
      Test.assert_eq_int(CubeForge.Mesher.corner_ao(false, true, true), 1, "other side and the diagonal")
      Test.assert_eq_int(CubeForge.Mesher.corner_ao(true, true, false), 0, "both sides override the diagonal")
      Test.assert_eq_int(CubeForge.Mesher.corner_ao(true, true, true), 0, "both sides, fully closed")
    end
  end

  describe "Mesher corner packing" do
    test "light, AO and block light round-trip through the ten-bit corner" do
      Test.assert_eq_int(CubeForge.Mesher.pack_corner(15, 3, 0), 63, "brightest sky, unoccluded, no glow")
      Test.assert_eq_int(CubeForge.Mesher.pack_corner(0, 0, 0), 0, "darkest, fully occluded")
      Test.assert_eq_int(CubeForge.Mesher.pack_corner(11, 2, 0) % 16, 11, "light in the low nibble")
      Test.assert_eq_int(CubeForge.Mesher.pack_corner(11, 2, 0) / 16, 2, "AO above it")
      Test.assert_eq_int(CubeForge.Mesher.pack_corner(11, 2, 9) / 64, 9, "block light above that")
      Test.assert_eq_int(CubeForge.Mesher.pack_corner(15, 3, 15), 1023, "everything full is ten set bits")
    end

    test "the key round-trips a block id and four ten-bit corners" do
      let k = CubeForge.Mesher.key_of(3, 1023, 0, 17, 640, 5)
      Test.assert_eq_int(CubeForge.Mesher.key_id(k), 3, "id")
      Test.assert_eq_int(CubeForge.Mesher.key_sp(k), 5, "species")
      Test.assert_eq_int(CubeForge.Mesher.key_c0(k), 1023, "c0")
      Test.assert_eq_int(CubeForge.Mesher.key_c1(k), 0, "c1")
      Test.assert_eq_int(CubeForge.Mesher.key_c2(k), 17, "c2")
      Test.assert_eq_int(CubeForge.Mesher.key_c3(k), 640, "c3")
    end

    test "corner shades split sky from block light, both scaled by AO" do
      Test.assert_true(near(CubeForge.Mesher.corner_sky(CubeForge.Mesher.pack_corner(15, 3, 0)), 1.0), "full sky, open corner")
      Test.assert_true(near(CubeForge.Mesher.corner_sky(CubeForge.Mesher.pack_corner(0, 3, 10)), 0.0), "dark sky stays dark sky")
      Test.assert_true(near(CubeForge.Mesher.corner_sky(CubeForge.Mesher.pack_corner(15, 0, 0)), 0.55), "fully occluded corner")
      Test.assert_true(near(CubeForge.Mesher.corner_blk(CubeForge.Mesher.pack_corner(0, 3, 15)), 1.0), "full glow, open corner")
      Test.assert_true(near(CubeForge.Mesher.corner_blk(CubeForge.Mesher.pack_corner(0, 0, 15)), 0.55), "full glow, closed corner")
      Test.assert_true(near(CubeForge.Mesher.corner_blk(CubeForge.Mesher.pack_corner(15, 3, 0)), 0.0), "no glow")
    end
  end

  describe "Mesher.should_flip" do
    test "flips only when the default diagonal is the darker pair" do
      Test.assert_false(CubeForge.Mesher.should_flip(1.0, 1.0, 1.0, 1.0), "uniform does not flip")
      Test.assert_true(CubeForge.Mesher.should_flip(0.0, 1.0, 1.0, 1.0), "a lone dark corner on c0 flips")
      Test.assert_false(CubeForge.Mesher.should_flip(1.0, 0.0, 1.0, 1.0), "a lone dark corner on c1 does not")
    end
  end

  -- Scan a mesh buffer for the shade of the first vertex with face index [f].
  pfn shade_of_face(b : CubeForge.F32Buf.F32Buf, f : Float, i : Int, n : Int) : Float do
    if i >= n do -1.0
    else if near(Test.assert_some(B.get(b, i * CubeForge.Vertex.floats() + 7), "face"), f) do Test.assert_some(B.get(b, i * CubeForge.Vertex.floats() + 6), "shade")
    else shade_of_face(b, f, i + 1, n) end end
  end

  describe "Mesher reads the skylight field" do
    test "a slab is lit on top and black underneath" do
      -- Every chunk carries the same stone layer at y = 8, so nothing leaks in
      -- sideways: above the slab is open sky, below it is sealed.
      let w = CubeForge.World.relight_all(slab_world(8))
      let c = CubeForge.World.chunk_at(w, 2, 2)
      let b = CubeForge.Mesher.mesh_section_opaque(c, c, c, c, c, CubeForge.World.light(w), CubeForge.World.block_light(w), CubeForge.World.shown(w), CubeForge.World.occupancy(w), 0, 32.0, 32.0, CubeForge.Model.build())
      let n = CubeForge.Mesher.vertex_count(b)
      Test.assert_true(n > 0, "the slab meshed to something")
      -- face 0 is +y (the sunlit top), face 1 is -y (the sealed underside)
      Test.assert_true(near(shade_of_face(b, 0.0, 0, n), 1.0), "top face is full brightness")
      Test.assert_true(near(shade_of_face(b, 1.0, 0, n), 0.0), "underside is black")
    end

    test "opening a shaft lights the ceiling around it" do
      let w0 = CubeForge.World.relight_all(CubeForge.World.set_block(slab_world(8), 34, 8, 34, 0))
      let c = CubeForge.World.chunk_at(w0, 2, 2)
      let b = CubeForge.Mesher.mesh_section_opaque(c, c, c, c, c, CubeForge.World.light(w0), CubeForge.World.block_light(w0), CubeForge.World.shown(w0), CubeForge.World.occupancy(w0), 0, 32.0, 32.0, CubeForge.Model.build())
      let n = CubeForge.Mesher.vertex_count(b)
      -- the underside is no longer uniformly black: light now reaches it
      Test.assert_true(shade_of_face(b, 1.0, 0, n) >= 0.0, "underside still meshes")
      Test.assert_true(CubeForge.World.light_at(w0, 35, 7, 34) > 0, "light spilled under the slab")
      Test.assert_eq_int(CubeForge.World.light_at(w0, 34, 7, 34), 15, "directly under the shaft is full")
    end
  end

  describe "Light.occupancy" do
    test "marks exactly the opaque voxels, and never air or water" do
      let w = CubeForge.World.generate(8, 1, 1)
      let o = L.occupancy(w)
      -- an all-air slab world is the clean case: only the stone layer occludes
      let sw = slab_world(8)
      let so = L.occupancy(sw)
      Test.assert_eq_int(NativeArray.get_u8(so, L.occ_index(40, 8, 40)), L.occ_solid(), "the slab occludes")
      Test.assert_eq_int(NativeArray.get_u8(so, L.occ_index(40, 9, 40)), 0, "air above does not")
      Test.assert_eq_int(NativeArray.get_u8(so, L.occ_index(40, 7, 40)), 0, "air below does not")
      -- water is transparent to light, so it must not cast a shadow
      let ww = CubeForge.World.set_block(slab_world(8), 40, 20, 40, C.water())
      let wo = L.occupancy(ww)
      Test.assert_eq_int(NativeArray.get_u8(wo, L.occ_index(40, 20, 40)), 0, "water does not occlude")
      Test.assert_true(NativeArray.get_u8(o, L.occ_index(64, 0, 64)) == L.occ_solid(), "bedrock depth of real terrain occludes")
    end

    test "agrees with is_opaque at every voxel of a chunk" do
      let w = slab_world(8)
      let o = L.occupancy(w)
      let c = CubeForge.World.chunk_at(w, 2, 2)
      Test.assert_eq_int(occ_mismatch(o, c, 2, 2, 0), -1, "no voxel disagrees with is_opaque")
    end
  end

  describe "Light.relight_marked" do
    test "every section whose light changed is marked dirty" do
      -- a block placed high in open air darkens the whole column beneath it,
      -- which is the case that reaches furthest from the edit
      let w0 = CubeForge.World.relight_all(CubeForge.World.generate(8, 7, 1))
      let before = L.copy_field(CubeForge.World.light(w0), L.new())
      let w1 = CubeForge.World.set_block(w0, 64, 140, 64, 3)
      let r = L.relight_marked(CubeForge.World.light(w1), w1, 64, 140, 64)
      Test.assert_true(marked_count(L.relit_marks(r), 0, 0) > 1, "the edit dirtied more than one section")
      Test.assert_eq_int(unmarked_go(before, L.relit_field(r), L.relit_marks(r), 0), -1,
                         "no changed section was left unmarked")
    end

    test "an edit that changes no light marks no sections" do
      -- replacing a stone block with stone changes nothing at all
      let w0 = CubeForge.World.relight_all(slab_world(8))
      let w1 = CubeForge.World.set_block(w0, 40, 8, 40, 3)
      let r = L.relight_marked(CubeForge.World.light(w1), w1, 40, 8, 40)
      Test.assert_eq_int(marked_count(L.relit_marks(r), 0, 0), 0, "nothing dirtied")
    end
  end

  describe "AO across chunk boundaries" do
    test "a diagonal occluder in the next chunk still darkens the corner" do
      -- The occluder sits diagonally across BOTH a chunk edge in x and one in z
      -- from the face being lit, so it lives in a chunk the mesher is not given.
      -- Reading occluders from the world occupancy field is what makes it count.
      let base = slab_world(8)
      let w = CubeForge.World.rebuild_occupancy(CubeForge.World.set_block(base, 32, 9, 32, 3))
      Test.assert_eq_int(NativeArray.get_u8(CubeForge.World.occupancy(w), L.occ_index(32, 9, 32)), L.occ_solid(),
                         "the diagonal block is in the occupancy field")
      -- (31,9,31) is the last voxel of chunk (1,1); (32,9,32) is the first of
      -- chunk (2,2) -- diagonal in both axes, the case nb_get could not reach.
      Test.assert_eq_int(CubeForge.Mesher.corner_ao(false, false, true), 2, "a lone diagonal occluder costs one step of AO")
      Test.assert_true(CubeForge.World.floor_div16(31) != CubeForge.World.floor_div16(32), "the two voxels really are in different chunks")
    end
  end

  describe "Light.sky_floor" do
    test "sits above the highest non-air voxel, water included" do
      let w = slab_world(8)
      Test.assert_true(L.sky_floor(w) > 8, "above the slab")
      -- Water is transparent but attenuating: a lake above the highest solid
      -- block still dims what is under it, so the sweep bound has to clear the
      -- water too, not just the stone.
      let ww = CubeForge.World.set_block(w, 40, 100, 40, C.water())
      Test.assert_true(L.sky_floor(ww) > 100, "above the water, not just the stone")
    end

    test "bounding the sweep does not change the result" do
      -- A lake perched well above the highest solid block is the case an
      -- opaque-only bound would have skipped.
      let w0 = CubeForge.World.set_block(CubeForge.World.set_block(slab_world(8), 40, 100, 40, C.water()), 41, 100, 40, C.water())
      let la = L.flood(w0)
      Test.assert_eq_int(L.get(la, 40, 101, 40), 15, "above the water is full")
      Test.assert_eq_int(L.get(la, 40, 100, 40), 13, "the water voxel is dimmed")
      -- 14, not 13: the open columns beside the lake are at 15 and spread
      -- sideways underneath it, which beats the 13 arriving down through water.
      Test.assert_eq_int(L.get(la, 40, 99, 40), 14, "lateral light under the lake beats the attenuated column")
    end
  end


  describe "World block light field" do
    test "a fresh world has a dark block-light field that reads back what is written" do
      let w0 = air_world()
      Test.assert_eq_int(CubeForge.World.block_light_at(w0, 40, 100, 40), 0, "dark at birth")
      let lb = NativeArray.set_u8(L.new(), L.index(40, 100, 40), 9)
      let w1 = CubeForge.World.set_block_light(w0, lb)
      Test.assert_eq_int(CubeForge.World.block_light_at(w1, 40, 100, 40), 9, "written value")
      Test.assert_eq_int(CubeForge.World.light_at(w1, 40, 100, 40), 0, "skylight untouched")
    end
  end


  describe "Light.emission" do
    test "only the glow cap emits, at level 10" do
      Test.assert_eq_int(L.emission(C.glow_cap()), 10, "glow cap")
      Test.assert_eq_int(L.emission(0), 0, "air")
      Test.assert_eq_int(L.emission(3), 0, "stone")
      Test.assert_eq_int(L.emission(C.water()), 0, "water")
      Test.assert_eq_int(L.emission(C.oak_leaves()), 0, "leaves")
      Test.assert_true(L.is_opaque(C.glow_cap()), "a glow cap is a solid block")
    end
    test "the glow cap has its own texture layer" do
      Test.assert_eq_int(CubeForge.Texture.layers(), 90, "layer count")
      Test.assert_true(near(CubeForge.Texture.layer_for(C.glow_cap()), 20.0), "layer 20")
    end
  end


  describe "Light.flood_block" do
    test "a glow cap in the open lights a sphere that falls off one per step" do
      let w = CubeForge.World.set_block(air_world(), 40, 100, 40, C.glow_cap())
      let lb = L.flood_block(w)
      Test.assert_eq_int(L.get(lb, 40, 100, 40), 10, "the emitter itself")
      Test.assert_eq_int(L.get(lb, 41, 100, 40), 9, "one step")
      Test.assert_eq_int(L.get(lb, 40, 105, 40), 5, "five steps up")
      Test.assert_eq_int(L.get(lb, 49, 100, 40), 1, "nine steps, the last light")
      Test.assert_eq_int(L.get(lb, 50, 100, 40), 0, "ten steps, dark")
      Test.assert_eq_int(L.get(lb, 43, 100, 43), 4, "manhattan six")
    end

    test "block light does not pass through stone but rounds a corner" do
      let w0 = slab_world(100)
      let w1 = CubeForge.World.set_block(w0, 40, 100, 40, 0)
      let w2 = CubeForge.World.set_block(w1, 40, 101, 40, C.glow_cap())
      let lb = L.flood_block(w2)
      Test.assert_eq_int(L.get(lb, 40, 99, 40), 8, "down the shaft, two steps")
      Test.assert_eq_int(L.get(lb, 41, 99, 40), 7, "along the gallery")
      Test.assert_eq_int(L.get(lb, 41, 100, 40), 0, "inside the slab")
    end

    test "a world with no emitters is dark everywhere" do
      let w = CubeForge.World.relight_all(CubeForge.World.generate(8, 1, 1))
      Test.assert_eq_int(first_difference(CubeForge.World.block_light(w), L.new()), -1, "all zero")
    end
  end


  describe "Light.relight_block_marked" do
    test "placing a glow cap matches a full re-flood and marks its sections" do
      let w0 = CubeForge.World.relight_all(CubeForge.World.generate(8, 1, 1))
      let w1 = CubeForge.World.set_block(w0, 40, 90, 40, C.glow_cap())
      let r = L.relight_block_marked(CubeForge.World.block_light(w1), w1, 40, 90, 40)
      let full = L.flood_block(w1)
      Test.assert_eq_int(first_difference(L.relit_field(r), full), -1, "incremental equals full re-flood")
      Test.assert_eq_int(unmarked_go(CubeForge.World.block_light(w0), full, L.relit_marks(r), 0), -1, "every changed section is marked")
      Test.assert_true(marked_count(L.relit_marks(r), 0, 0) > 0, "something was marked")
    end

    test "removing a glow cap darkens what it lit" do
      let w0 = CubeForge.World.relight_all(CubeForge.World.set_block(air_world(), 40, 100, 40, C.glow_cap()))
      Test.assert_eq_int(CubeForge.World.block_light_at(w0, 44, 100, 40), 6, "lit before removal")
      let w1 = CubeForge.World.set_block(w0, 40, 100, 40, 0)
      let inc = L.relit_field(L.relight_block_marked(CubeForge.World.block_light(w1), w1, 40, 100, 40))
      Test.assert_eq_int(first_difference(inc, L.flood_block(w1)), -1, "incremental equals full re-flood")
      Test.assert_eq_int(L.get(inc, 44, 100, 40), 0, "dark after removal")
    end

    test "walling off an emitter with stone matches a full re-flood" do
      let w0 = CubeForge.World.relight_all(CubeForge.World.set_block(air_world(), 40, 100, 40, C.glow_cap()))
      let w1 = CubeForge.World.set_block(w0, 42, 100, 40, 3)
      let inc = L.relit_field(L.relight_block_marked(CubeForge.World.block_light(w1), w1, 42, 100, 40))
      Test.assert_eq_int(first_difference(inc, L.flood_block(w1)), -1, "incremental equals full re-flood")
      Test.assert_eq_int(L.get(inc, 43, 100, 40), 5, "behind the wall, light arrives around it two steps longer")
    end

    test "an edit at the world edge matches a full re-flood" do
      let w0 = CubeForge.World.relight_all(air_world())
      let w1 = CubeForge.World.set_block(w0, 0, 80, 127, C.glow_cap())
      let inc = L.relit_field(L.relight_block_marked(CubeForge.World.block_light(w1), w1, 0, 80, 127))
      Test.assert_eq_int(first_difference(inc, L.flood_block(w1)), -1, "incremental equals full re-flood")
    end

    test "an emitter just outside the relight box still feeds it" do
      -- Two caps 20 apart: editing beside one must not lose the other's light.
      let wa = CubeForge.World.set_block(air_world(), 40, 100, 40, C.glow_cap())
      let w0 = CubeForge.World.relight_all(CubeForge.World.set_block(wa, 60, 100, 40, C.glow_cap()))
      let w1 = CubeForge.World.set_block(w0, 41, 100, 40, 3)
      let inc = L.relit_field(L.relight_block_marked(CubeForge.World.block_light(w1), w1, 41, 100, 40))
      Test.assert_eq_int(first_difference(inc, L.flood_block(w1)), -1, "incremental equals full re-flood")
      Test.assert_eq_int(L.get(inc, 55, 100, 40), 5, "the far cap still lights its own ground")
    end
  end

  describe "World.relight_marked" do
    test "repairs both fields and unions the marks" do
      let w0 = CubeForge.World.relight_all(CubeForge.World.generate(8, 1, 1))
      let w1 = CubeForge.World.set_block(w0, 40, 90, 40, C.glow_cap())
      let r = CubeForge.World.relight_marked(w1, 40, 90, 40)
      let w2 = CubeForge.World.relit_world(r)
      Test.assert_eq_int(first_difference(CubeForge.World.light(w2), L.flood(w1)), -1, "skylight equals full re-flood")
      Test.assert_eq_int(first_difference(CubeForge.World.block_light(w2), L.flood_block(w1)), -1, "block light equals full re-flood")
      Test.assert_eq_int(unmarked_go(CubeForge.World.block_light(w0), CubeForge.World.block_light(w2), CubeForge.World.relit_marks(r), 0), -1, "block-light changes are marked")
      Test.assert_eq_int(unmarked_go(CubeForge.World.light(w0), CubeForge.World.light(w2), CubeForge.World.relit_marks(r), 0), -1, "skylight changes are marked")
    end
  end

end
