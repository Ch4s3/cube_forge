-- Spreading water: the pure Sim step and one WaterChunk actor round-trip.
mod CubeForge.Test.Flow do

  needs IO.Spawn
  needs IO.Console
  needs IO.Process
  needs IO.Clock
  needs IO.Foreign
  needs Window
  import Test
  alias CubeForge.Chunk as C
  alias CubeForge.Water as Water

  -- A flat stone floor at y = 70 (above sea level, so the infinite-lake rule stays out of the way).
  pfn floor_go(c : CubeForge.Chunk.Chunk, i : Int) : CubeForge.Chunk.Chunk do
    if i >= 256 do c else floor_go(C.set(c, i % 16, 70, i / 16, 3), i + 1) end
  end
  pfn floored() : CubeForge.Chunk.Chunk do floor_go(C.new(), 0) end

  pfn run_ticks(s : CubeForge.Water.Sim, n : Int) : CubeForge.Water.Sim do
    if n == 0 do s else run_ticks(Water.step_sim(Water.tick(s)), n - 1) end
  end

  describe "levels" do
    test "ids map to levels and back" do
      Test.assert_eq_int(C.level_of(C.water()), 8, "source is level 8")
      Test.assert_eq_int(C.level_of(11), 1, "id 11 is level 1")
      Test.assert_eq_int(C.id_of_level(7), 5, "level 7 is id 5")
      Test.assert_false(C.is_water(3) || C.is_water(12), "stone and 12 are not water")
    end
  end

  -- Walls around a 4x4 interior at (6..9, 71.., 6..9): nothing can leave.
  pfn wall_go(c : CubeForge.Chunk.Chunk, i : Int) : CubeForge.Chunk.Chunk do
    if i >= 16 * 16 * 4 do c
    else
      let x = i % 16
      let z = (i / 16) % 16
      let y = 71 + i / 256
      let inside = x >= 6 && x <= 9 && z >= 6 && z <= 9
      wall_go(if inside do c else C.set(c, x, y, z, 3) end, i + 1)
    end
  end
  pfn max_level(c : CubeForge.Chunk.Chunk, i : Int, acc : Int) : Int do
    if i >= 65536 do acc
    else
      let id = C.get_idx(c, i)
      let l = if C.is_water(id) && !C.is_source(id) do C.level_of(id) else 0 end
      max_level(c, i + 1, if l > acc do l else acc end)
    end
  end

  -- Every cell of the y = 71 layer holding seven units.
  pfn layer_go(c : CubeForge.Chunk.Chunk, i : Int) : CubeForge.Chunk.Chunk do
    if i >= 256 do c else layer_go(C.set(c, i % 16, 71, i / 16, C.id_of_level(7)), i + 1) end
  end
  pfn mark_layer(s : CubeForge.Water.Sim, i : Int) : CubeForge.Water.Sim do
    if i >= 256 do s else mark_layer(Water.mark(s, i % 16, 71, i / 16), i + 1) end
  end
  -- Units carried by every kind-2 entry in a reply: water in flight, not lost.
  pfn spilled_units(out : List(Int), acc : Int) : Int do
    match out do
      Nil -> acc
      Cons(v, rest) -> spilled_units(rest, if v / 4294967296 == 2 do acc + (v % 4294967296) % 256 else acc end)
    end
  end

  describe "Sim.tick" do
    test "a closed basin conserves seven placed units" do
      -- roofed: open sky evaporates thin water by design (see "evaporation")
      let c0 = C.set(roof_go(wall_go(floored(), 0), 0), 7, 71, 7, C.id_of_level(7))
      let s0 = Water.edited(Water.new_sim(c0, Water.empty_edges()), Water.idx(7, 71, 7), C.id_of_level(7))
      Test.assert_eq_int(Water.volume(s0), 7, "before any tick")
      let s1 = run_ticks(s0, 1)
      Test.assert_eq_int(Water.volume(s1), 7, "after one tick")
      let s5 = run_ticks(s1, 4)
      Test.assert_eq_int(Water.volume(s5), 7, "after five ticks")
      let s40 = run_ticks(s5, 35)
      Test.assert_eq_int(Water.volume(s40), 7, "after forty ticks")
      Test.assert_true(max_level(Water.sim_chunk(s40), 0, 0) <= 7, "no cell over seven")
    end

    test "seven units on a floor settle as seven cells of level 1 and stop" do
      -- roofed, so the shape is tested without evaporation eating the result
      let s0 = Water.edited(Water.new_sim(roof_go(C.set(floored(), 8, 71, 8, C.id_of_level(7)), 0), Water.empty_edges()), Water.idx(8, 71, 8), C.id_of_level(7))
      let s = run_ticks(s0, 40)
      let c = Water.sim_chunk(s)
      Test.assert_eq_int(Water.volume(s), 7, "volume kept")
      Test.assert_eq_int(C.count_water(c), 7, "seven cells")
      Test.assert_eq_int(max_level(c, 0, 0), 1, "all at level 1")
      Test.assert_eq_int(Water.pending(s), 0, "queue drained")
    end
    test "water falls down a shaft and pools at the bottom, volume kept" do
      -- a shaft next to the placed block: air from y = 70 down to y = 63, stone at y = 62
      let c = roof_go(C.set(C.set(C.set(floored(), 8, 71, 8, C.id_of_level(7)), 9, 70, 8, 0), 9, 62, 8, 3), 0)
      let s = run_ticks(Water.edited(Water.new_sim(c, Water.empty_edges()), Water.idx(8, 71, 8), C.id_of_level(7)), 60)
      let ch = Water.sim_chunk(s)
      Test.assert_eq_int(Water.volume(s), 7, "volume kept")
      Test.assert_true(C.is_water(C.get(ch, 9, 63, 8)), "water reached the bottom of the shaft")
      Test.assert_eq_int(C.get(ch, 9, 70, 8), 0, "nothing left hanging in the shaft")
      Test.assert_true(C.level_of(C.get(ch, 9, 63, 8)) >= 1, "it pooled there")
    end
    test "the per-tick budget leaves work queued" do
      -- a whole 16x16 layer of seven-unit cells, every one of them dirty: 256
      -- cells to process, and the budget is 250.
      let s0 = mark_layer(Water.new_sim(layer_go(floored(), 0), Water.empty_edges()), 0)
      let one = Water.tick(s0)
      Test.assert_true(Water.pending(Water.step_sim(one)) > 0, "still pending after one tick of 250 cells")
    end
  end

  -- Forward one reply's kind-1 (edge) and kind-2 (spill) entries into the
  -- neighbour, exactly as the frame loop's apply_reply does. dir_to is the
  -- direction from the sender to the receiver; the receiver sees the opposite.
  pfn forward(out : List(Int), dst : CubeForge.Water.Sim, dir_to : Int) : CubeForge.Water.Sim do
    match out do
      Nil -> dst
      Cons(v, rest) ->
        let kind = v / 4294967296
        let payload = v % 4294967296
        let dir = payload / 1048576
        let slot = (payload % 1048576) / 256
        let val = payload % 256
        let dst1 = if dir != dir_to do dst
                   else if kind == 1 do Water.edge_changed(dst, Water.opposite(dir), slot, val)
                   else if kind == 2 do Water.accept_spill(dst, Water.opposite(dir), slot, val)
                   else dst end end end
        forward(rest, dst1, dir_to)
    end
  end
  -- One tick of both sims, exchanging replies. A is west (-x) of B: A pushes in dir 2, B in dir 3.
  pfn tick_pair(a : CubeForge.Water.Sim, b : CubeForge.Water.Sim, n : Int) : List(CubeForge.Water.Sim) do
    if n == 0 do Cons(a, Cons(b, Nil))
    else
      let sa = Water.tick(a)
      let sb = Water.tick(b)
      let a1 = forward(Water.step_out(sb), Water.step_sim(sa), 3)
      let b1 = forward(Water.step_out(sa), Water.step_sim(sb), 2)
      tick_pair(a1, b1, n - 1)
    end
  end
  pfn pair_a(l : List(CubeForge.Water.Sim)) : CubeForge.Water.Sim do
    match l do
      Cons(a, _) -> a
      Nil -> Water.new_sim(C.new(), Water.empty_edges())
    end
  end
  pfn pair_b(l : List(CubeForge.Water.Sim)) : CubeForge.Water.Sim do
    match l do
      Cons(_, Cons(b, _)) -> b
      _ -> Water.new_sim(C.new(), Water.empty_edges())
    end
  end
  pfn has_spill(out : List(Int)) : Bool do
    match out do
      Nil -> false
      Cons(v, rest) -> if v / 4294967296 == 2 do true else has_spill(rest) end
    end
  end

  -- A floor that steps down one block per column toward +x from x = 8: a slope.
  pfn slope_go(c : CubeForge.Chunk.Chunk, i : Int) : CubeForge.Chunk.Chunk do
    if i >= 256 do c
    else
      let x = i % 16
      let z = i / 16
      let top = if x <= 8 do 70 else 70 - (x - 8) end
      slope_go(slope_col(c, x, z, top, 60), i + 1)
    end
  end
  pfn slope_col(c : CubeForge.Chunk.Chunk, x : Int, z : Int, top : Int, y : Int) : CubeForge.Chunk.Chunk do
    if y > top do c else slope_col(C.set(c, x, y, z, 3), x, z, top, y + 1) end
  end
  -- The basin, roofed at y = 72 so nothing inside is open to the sky.
  pfn roof_go(c : CubeForge.Chunk.Chunk, i : Int) : CubeForge.Chunk.Chunk do
    if i >= 256 do c else roof_go(C.set(c, i % 16, 72, i / 16, 3), i + 1) end
  end

  describe "springs are a trickle" do
    test "a source on a slope gives at most spring_rate() a tick" do
      let c0 = C.set(slope_go(C.new(), 0), 8, 71, 8, C.water())
      let s0 = Water.edited(Water.new_sim(c0, Water.empty_edges()), Water.idx(8, 71, 8), C.water())
      let s1 = run_ticks(s0, 1)
      Test.assert_true(Water.volume(s1) <= Water.spring_rate(), "one tick, at most the rate")
      let s10 = run_ticks(s1, 9)
      Test.assert_true(Water.volume(s10) <= 10 * Water.spring_rate(), "ten ticks, at most ten times the rate")
      Test.assert_true(Water.volume(s10) > 0, "but it does flow")
    end
  end

  describe "evaporation" do
    test "under a roof, seven units stay seven" do
      let c0 = C.set(roof_go(wall_go(floored(), 0), 0), 7, 71, 7, C.id_of_level(7))
      let s = run_ticks(Water.edited(Water.new_sim(c0, Water.empty_edges()), Water.idx(7, 71, 7), C.id_of_level(7)), 400)
      Test.assert_eq_int(Water.volume(s), 7, "roofed: conserved")
    end
    test "open to the sky, a puddle dries up" do
      let c0 = C.set(wall_go(floored(), 0), 7, 71, 7, C.id_of_level(7))
      let s = run_ticks(Water.edited(Water.new_sim(c0, Water.empty_edges()), Water.idx(7, 71, 7), C.id_of_level(7)), 800)
      Test.assert_eq_int(Water.volume(s), 0, "open: gone")
    end
  end

  describe "volume across a chunk edge" do
    test "seven units placed at x = 15 end up shared with the chunk to the east, total unchanged" do
      let ca = roof_go(C.set(floored(), 15, 71, 8, C.id_of_level(7)), 0)
      let cb = roof_go(floored(), 0)
      let a0 = Water.edited(Water.new_sim(ca, Water.load_edge(Water.empty_edges(), 2, cb)), Water.idx(15, 71, 8), C.id_of_level(7))
      let b0 = Water.new_sim(cb, Water.load_edge(Water.empty_edges(), 3, ca))
      let p1 = tick_pair(a0, b0, 1)
      Test.assert_eq_int(Water.volume(pair_a(p1)) + Water.volume(pair_b(p1)), 7, "conserved after one exchange")
      let p = tick_pair(pair_a(p1), pair_b(p1), 30)
      Test.assert_eq_int(Water.volume(pair_a(p)) + Water.volume(pair_b(p)), 7, "conserved after thirty")
      Test.assert_true(Water.volume(pair_b(p)) > 0, "some of it crossed into B")
      Test.assert_true(C.is_water(C.get(Water.sim_chunk(pair_b(p)), 0, 71, 8)) || Water.volume(pair_b(p)) > 0, "at B's west edge")
    end

    test "a stale mirror cannot lose units: the receiver keeps seven and bounces the rest" do
      -- B's cell at x = 0 already holds 6, but A was never told (mirror shows air).
      let cb = C.set(floored(), 0, 71, 8, C.id_of_level(6))
      let b0 = Water.new_sim(cb, Water.empty_edges())
      let b1 = Water.accept_spill(b0, 3, 8 + 16 * 71, 3)
      Test.assert_eq_int(C.get(Water.sim_chunk(b1), 0, 71, 8), C.id_of_level(7), "capped at seven")
      let r = Water.tick(b1)
      Test.assert_true(has_spill(Water.step_out(r)), "the overflow goes back as a spill")
      -- B's cell sits at x = 0, so its own spread also pushes west across the
      -- edge in this tick: everything not in B is in flight in the reply.
      Test.assert_eq_int(Water.volume(Water.step_sim(r)) + spilled_units(Water.step_out(r), 0), 6 + 3, "six had, three sent: kept plus in flight is nine")
    end
  end

  describe "WaterChunk actor" do
    -- `Actor.call` fails with "actor_call: not in scheduler context" under `forge test`
    -- (GAPS.md G49), so the round-trip is only exercised by the CF_AUTOFLOW script.
    test "spawn, load and edit messages are accepted" do
      let pid = Water.spawn_chunk()
      Water.send_load(pid, 0, 0, 1, 7)
      Water.send_edited(pid, Water.idx(8, 71, 8), C.water())
      run_until_idle()
      Test.assert_true(true, "no crash")
    end
  end

  -- a lake of sources filling x < 8 from y = 59 to sea level over a stone floor at y = 58,
  -- and a 3x3 pit dug at x = 9..11, z = 7..9 down to y = 59 in the land beside it (x >= 8 is stone up to 62)
  pfn lake_go(c : CubeForge.Chunk.Chunk, i : Int) : CubeForge.Chunk.Chunk do
    if i >= 16 * 16 * 5 do c
    else
      let x = i % 16
      let z = (i / 16) % 16
      let y = 58 + i / 256
      let id = if y == 58 do 3 else if x < 8 do (if y <= C.sea_level() do C.water() else 0 end) else (if y <= 62 do 3 else 0 end) end end
      lake_go(C.set(c, x, y, z, id), i + 1)
    end
  end
  pfn dig_go(c : CubeForge.Chunk.Chunk, i : Int) : CubeForge.Chunk.Chunk do
    if i >= 36 do c else dig_go(C.set(c, 9 + i % 3, 59 + (i / 3) % 4, 7 + i / 9, 0), i + 1) end
  end
  pfn mark_pit(s : CubeForge.Water.Sim, i : Int) : CubeForge.Water.Sim do
    if i >= 36 do s else mark_pit(Water.edited(s, Water.idx(9 + i % 3, 59 + (i / 3) % 4, 7 + i / 9), 0), i + 1) end
  end

  describe "lakes are infinite at sea level" do
    test "a pit connected to the lake fills with sources up to sea level" do
      -- connect the pit to the lake with a channel at x = 8, z = 8, y = 59..62
      let c0 = dig_go(lake_go(C.new(), 0), 0)
      let c1 = C.set(C.set(C.set(C.set(c0, 8, 59, 8, 0), 8, 60, 8, 0), 8, 61, 8, 0), 8, 62, 8, 0)
      let s0 = Water.edited(Water.edited(Water.edited(Water.edited(mark_pit(Water.new_sim(c1, Water.empty_edges()), 0), Water.idx(8, 59, 8), 0), Water.idx(8, 60, 8), 0), Water.idx(8, 61, 8), 0), Water.idx(8, 62, 8), 0)
      let s = run_ticks(s0, 40)
      let ch = Water.sim_chunk(s)
      Test.assert_eq_int(C.get(ch, 11, 59, 9), C.water(), "far bottom corner of the pit is a source")
      Test.assert_eq_int(C.get(ch, 10, 62, 8), C.water(), "pit is full to sea level")
      Test.assert_eq_int(C.get(ch, 10, 63, 8), 0, "nothing above sea level")
    end
  end

  describe "Raycast through water" do
    test "with water ignored the ray reaches the lake bed; otherwise it stops at the surface" do
      let w = CubeForge.World.World(Array.from_list([lake_go(C.new(), 0)]), CubeForge.Light.new(), CubeForge.Light.new(), 1)
      -- eye at (4.5, 64.5, 4.5) looking almost straight down over the lake (x < 8)
      let bed = CubeForge.Raycast.cast(w, 4.5, 64.5, 4.5, 0.0, -0.985, -0.17, 8.0, true)
      Test.assert_true(CubeForge.Raycast.is_hit(bed), "hits something")
      Test.assert_eq_int(CubeForge.Raycast.by_(bed), 58, "the stone bed")
      let surf = CubeForge.Raycast.cast(w, 4.5, 64.5, 4.5, 0.0, -0.985, -0.17, 8.0, false)
      Test.assert_eq_int(CubeForge.Raycast.by_(surf), 62, "the water surface")
    end
  end

end
