-- Save format: the header round-trips and rejects what it must.
mod CubeForge.Test.Save do

  import Test
  alias CubeForge.Save as S

  pfn near(a : Float, b : Float) : Bool do
    let d = a -. b
    d < 0.000001 && d > -0.000001
  end

  pfn floats(xs : List(Float), n : Int) : NativeFloatArr do fill_floats(NativeArray.make_float(n, 0.0), xs, 0) end
  pfn fill_floats(a : NativeFloatArr, xs : List(Float), i : Int) : NativeFloatArr do
    match xs do
      Nil -> a
      Cons(x, rest) -> fill_floats(NativeArray.set_float(a, i, x), rest, i + 1)
    end
  end

  pfn sample() : CubeForge.Save.Header do
    let p = floats(Cons(1.5, Cons(70.25, Cons(-3.0, Cons(0.0, Cons(-2.5, Cons(0.0, Cons(3.1, Cons(-0.7, Nil)))))))), 8)
    let inv = NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(NativeArray.make_int(73, 0), 0, 3), 1, 12), 72, 4)
    let wx = floats(Cons(2.0, Cons(150.0, Cons(0.7, Cons(0.3, Nil)))), 4)
    S.header_new(424242, 1757000000, p, inv, 812.5, wx)
  end

  pfn drop_go(ls : List(String), key : String, acc : String) : String do
    match ls do
      Nil -> acc
      Cons(l, rest) ->
        if String.starts_with(l, key ++ " ") do drop_go(rest, key, acc) else drop_go(rest, key, acc ++ l ++ "\n") end
    end
  end
  pfn drop_line(s : String, key : String) : String do drop_go(String.split(s, "\n"), key, "") end

  describe "Save header" do
    test "a header round-trips" do
      let h = Test.assert_ok(S.parse_header(S.encode_header(sample(), 8), 8), "parses")
      Test.assert_eq_int(S.h_seed(h), 424242, "seed")
      Test.assert_eq_int(S.h_saved_at(h), 1757000000, "saved_at")
      Test.assert_true(near(NativeArray.get_float(S.h_player(h), 1), 70.25), "player y")
      Test.assert_true(near(NativeArray.get_float(S.h_player(h), 7), -0.7), "pitch")
      Test.assert_eq_int(NativeArray.get_int(S.h_inventory(h), 1), 12, "slot 0 count")
      Test.assert_eq_int(NativeArray.get_int(S.h_inventory(h), 72), 4, "selected slot")
      Test.assert_true(near(S.h_day(h), 812.5), "day")
      Test.assert_true(near(NativeArray.get_float(S.h_weather(h), 2), 0.7), "intensity")
    end
    test "a missing key is rejected" do
      let _ = Test.assert_err(S.parse_header(drop_line(S.encode_header(sample(), 8), "day"), 8), "no day line")
      ()
    end
    test "a wrong version is rejected" do
      let s = String.replace(S.encode_header(sample(), 8), "version 1", "version 2")
      let _ = Test.assert_err(S.parse_header(s, 8), "version 2")
      ()
    end
    test "a wrong side is rejected" do
      let _ = Test.assert_err(S.parse_header(S.encode_header(sample(), 8), 4), "side 4 vs 8")
      ()
    end
    test "unknown keys are ignored" do
      let _ = Test.assert_ok(S.parse_header("colour blue\n" ++ S.encode_header(sample(), 8), 8), "extra line")
      ()
    end
    test "a malformed number is rejected" do
      let s = String.replace(S.encode_header(sample(), 8), "day 812.5", "day soon")
      let _ = Test.assert_err(S.parse_header(s, 8), "day soon")
      ()
    end
  end
end
