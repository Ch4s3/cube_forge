-- The pour: closed basins fill to their rim, open ground stays dry.
mod CubeForge.Test.Lakes do

  import Test
  alias CubeForge.Lakes as Lk

  -- An 8x8 map at 70 with a 3x3 bowl at 60 in the middle (nine columns: big
  -- enough for an outlet), a 66-high notch in its rim leading along z = 3 to
  -- the edge (the pour point), a 1-wide trench from the top edge at 65 that
  -- does not reach the bowl, and a one-column dip at (1, 6) that gets no notch.
  pfn bowl_go(hs : NativeIntArr, i : Int) : NativeIntArr do
    if i >= 64 do hs
    else
      let x = i % 8
      let z = i / 8
      let h = if x >= 2 && x <= 4 && z >= 2 && z <= 4 do 60
              else if x >= 5 && z == 3 do 66
              else if z == 0 && x == 1 do 65
              else if x == 1 && z == 6 do 64
              else 70 end end end end
      bowl_go(NativeArray.set_int(hs, i, h), i + 1)
    end
  end
  pfn bowl() : NativeIntArr do bowl_go(NativeArray.make_int(64, 0), 0) end

  -- The first lake column of a world, packed x + 4096 * z, or -1.
  pfn first_lake(lk : CubeForge.Lakes.Tile, i : Int) : Int do
    if i >= 16384 do -1
    else if NativeArray.get_u8(Lk.tile_table(lk), i) > 0 do i % 128 + 4096 * (i / 128)
    else first_lake(lk, i + 1) end end
  end
  pfn first_notch(lk : CubeForge.Lakes.Tile, i : Int) : Int do
    if i >= 16384 do -1
    else if Lk.notch_at(lk, i % 128, i / 128) do i % 128 + 4096 * (i / 128)
    else first_notch(lk, i + 1) end end
  end
  pfn sources_above_sea(c : CubeForge.Chunk.Chunk, i : Int, acc : Int) : Int do
    if i >= 65536 do acc
    else sources_above_sea(c, i + 1, if CubeForge.Chunk.is_source(CubeForge.Chunk.get_idx(c, i)) && i / 256 > CubeForge.Chunk.sea_level() do acc + 1 else acc end) end
  end

  describe "a generated lake" do
    test "a lake column holds sources from its floor to its surface and air above, and its shore is sand" do
      let seed = CubeForge.Noise.with_age(99, 50)
      let lk = Lk.levels(seed, 8)
      let col = first_lake(lk, 0)
      Test.assert_true(col >= 0, "seed 99 at age 50 has a lake")
      let wx = col % 4096
      let wz = col / 4096
      let level = Lk.level_at(lk, wx, wz)
      let c = CubeForge.Chunk.generate_lakes(wx / 16 * 16, wz / 16 * 16, seed, lk)
      Test.assert_true(level > CubeForge.Chunk.sea_level(), "an upland lake")
      Test.assert_true(CubeForge.Chunk.is_source(CubeForge.Chunk.get(c, wx % 16, level, wz % 16)), "source at the surface")
      Test.assert_eq_int(CubeForge.Chunk.get(c, wx % 16, level + 1, wz % 16), 0, "air above it")
      Test.assert_true(!CubeForge.Chunk.is_water(CubeForge.Chunk.get(c, wx % 16, level, wz % 16)) || level > CubeForge.Chunk.sea_level(), "not the sea")
    end
    test "every lake has a notch, and the notch is a block below its rim" do
      let seed = CubeForge.Noise.with_age(99, 50)
      let lk = Lk.levels(seed, 8)
      Test.assert_true(Lk.notches(lk) >= 1, "at least one outlet")
      let col = first_notch(lk, 0)
      Test.assert_true(col >= 0, "found one")
      let wx = col % 4096
      let wz = col / 4096
      let c = CubeForge.Chunk.generate_lakes(wx / 16 * 16, wz / 16 * 16, seed, lk)
      let h = CubeForge.Noise.height(wx, wz, seed)
      Test.assert_eq_int(CubeForge.Chunk.get(c, wx % 16, h, wz % 16), 0, "the rim block is gone")
      Test.assert_true(CubeForge.Chunk.get(c, wx % 16, h - 1, wz % 16) != 0, "the block under it stands")
    end
    test "a lake's interior is not a spring: the sim lists at most a handful of outlets" do
      let seed = CubeForge.Noise.with_age(99, 50)
      let lk = Lk.levels(seed, 8)
      let col = first_lake(lk, 0)
      let c = CubeForge.Chunk.generate_lakes(col % 4096 / 16 * 16, col / 4096 / 16 * 16, seed, lk)
      let s = CubeForge.Water.new_sim(c, CubeForge.Water.empty_edges())
      let lake_cells = sources_above_sea(c, 0, 0)
      Test.assert_true(lake_cells >= 8, "the chunk holds a lake of some size")
      Test.assert_true(CubeForge.Water.spring_count(s) * 4 <= lake_cells, "springs are a small fraction of the lake's cells")
    end
  end

  -- Lake columns whose surface sits at or under sea level: holes in the sea.
  pfn low_lakes(lk : CubeForge.Lakes.Tile, i : Int, acc : Int) : Int do
    if i >= 16384 do acc
    else
      let v = NativeArray.get_u8(Lk.tile_table(lk), i)
      low_lakes(lk, i + 1, if v > 0 && v <= CubeForge.Chunk.sea_level() do acc + 1 else acc end)
    end
  end
  pfn low_lakes_seeds(seed : Int, acc : Int) : Int do
    if seed >= 8 do acc else low_lakes_seeds(seed + 1, acc + low_lakes(Lk.levels(CubeForge.Noise.with_age(seed, 50), 8), 0, 0)) end
  end

  describe "tiles" do
    test "tile (0, 0) is the 128-block pour, and a far tile pours its own ground" do
      let seed = CubeForge.Noise.with_age(99, 50)
      Test.assert_eq_int(Lk.summary(Lk.tile(seed, 0, 0)), Lk.summary(Lk.levels(seed, 8)), "the same table at the origin")
      Test.assert_eq_int(Lk.tile_ox(Lk.tile(seed, 3, -2)), 384, "origin x")
      Test.assert_eq_int(Lk.tile_oz(Lk.tile(seed, 3, -2)), -256, "origin z")
      Test.assert_true(Lk.same_tile(7, 7, 0, 0) && !Lk.same_tile(8, 0, 7, 0) && Lk.same_tile(-1, -1, -8, -8), "chunks 0..7 share tile 0, -8..-1 tile -1")
      Test.assert_eq_int(Lk.tile_ox(Lk.tile_of_chunk(seed, -3, 9)), -128, "chunk -3 is in tile -1")
    end
  end

  describe "the sea" do
    test "no lake surface sits at or under sea level: the sea bed is not a basin" do
      Test.assert_eq_int(low_lakes_seeds(0, 0), 0, "lake columns at or under sea level over seeds 0..7")
    end
  end

  describe "pour" do
    test "a bowl fills to its lowest rim and nothing else is wet" do
      let lv = Lk.pour(bowl(), 8)
      Test.assert_eq_int(NativeArray.get_int(lv, 3 + 8 * 3), 66, "bowl column at the rim's level")
      Test.assert_eq_int(NativeArray.get_int(lv, 4 + 8 * 4), 66, "every bowl column the same level")
      Test.assert_eq_int(NativeArray.get_int(lv, 2 + 8 * 2), 66, "the far corner too")
      Test.assert_eq_int(NativeArray.get_int(lv, 1 + 8 * 6), 70, "a one-column dip is a lake of one")
      Test.assert_eq_int(NativeArray.get_int(lv, 64 + 1 + 8 * 5) + NativeArray.get_int(lv, 64 + 0 + 8 * 6) + NativeArray.get_int(lv, 64 + 2 + 8 * 6) + NativeArray.get_int(lv, 64 + 1 + 8 * 7), 0, "but gets no outlet")
      Test.assert_eq_int(NativeArray.get_int(lv, 5 + 8 * 3), 0, "the notch itself is dry")
      Test.assert_eq_int(NativeArray.get_int(lv, 64 + 5 + 8 * 3), 1, "and it is the pour point")
      Test.assert_eq_int(NativeArray.get_int(lv, 64 + 6 + 8 * 3), 0, "the channel beyond it is not")
      Test.assert_eq_int(NativeArray.get_int(lv, 64 + 4 + 8 * 3), 0, "nor the lake cell inside")
      Test.assert_eq_int(NativeArray.get_int(lv, 1), 0, "a trench open to the edge drains")
      Test.assert_eq_int(NativeArray.get_int(lv, 0), 0, "the border is dry")
    end
    test "a flat map has no lakes" do
      let lv = Lk.pour(NativeArray.make_int(64, 70), 8)
      Test.assert_eq_int(Lk.summary(Lk.none()), 0, "no table, no lakes")
      Test.assert_eq_int(NativeArray.get_int(lv, 27), 0, "flat is dry")
    end
    test "level_at reads the table and is 0 off it" do
      let lk = CubeForge.Lakes.Tile(0, 0, 16, NativeArray.set_u8(NativeArray.make_u8(16 * 16, 0), 5 + 16 * 7, 80))
      Test.assert_eq_int(Lk.level_at(lk, 5, 7), 80, "a lake column")
      Test.assert_eq_int(Lk.level_at(lk, 6, 7), 0, "a dry column")
      Test.assert_eq_int(Lk.level_at(lk, -1, 7), 0, "outside the tile")
      Test.assert_eq_int(Lk.level_at(Lk.none(), 5, 7), 0, "the empty tile")
      let far = CubeForge.Lakes.Tile(256, -128, 16, NativeArray.set_u8(NativeArray.make_u8(16 * 16, 0), 5 + 16 * 7, 80))
      Test.assert_eq_int(Lk.level_at(far, 261, -121), 80, "a tile at another origin reads by world column")
      Test.assert_eq_int(Lk.level_at(far, 5, 7), 0, "and not by its own")
    end
  end

end
