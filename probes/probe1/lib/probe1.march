mod Probe1 do
  needs IO.Console
  needs Ffi
  needs IO.Foreign

  extern "probe" : Cap(Ffi) do
    fn live_allocs(): Int = "march_live_allocs"
  end

  type Buf2 = Buf2(NativeF32Arr, Int)
  type Buf3 = Buf3(NativeF32Arr, Int, Int)

  -- C: variant, no length call (baseline: 0 allocs)
  @[no_alloc(warn)]
  fn push_c(b: Buf2, v: Float): Buf2 do
    match b do
      Buf2(d0, n) -> Buf2(NativeArray.set_f32(d0, n, v), n + 1)
    end
  end
  fn loop_c(b: Buf2, i: Int, n: Int): Buf2 do
    if i >= n do b else loop_c(push_c(b, int_to_float(i)), i + 1, n) end
  end

  -- F: variant, but read length_f32(d0) before the set (as a guard)
  fn push_f(b: Buf2, v: Float): Buf2 do
    match b do
      Buf2(d0, n) ->
        if n < NativeArray.length_f32(d0) do Buf2(NativeArray.set_f32(d0, n, v), n + 1)
        else b end
    end
  end
  fn loop_f(b: Buf2, i: Int, n: Int): Buf2 do
    if i >= n do b else loop_f(push_f(b, int_to_float(i)), i + 1, n) end
  end

  -- G: variant, length read into a let first
  fn push_g(b: Buf2, v: Float): Buf2 do
    match b do
      Buf2(d0, n) ->
        let cap = NativeArray.length_f32(d0)
        if n < cap do Buf2(NativeArray.set_f32(d0, n, v), n + 1) else Buf2(d0, n) end
    end
  end
  fn loop_g(b: Buf2, i: Int, n: Int): Buf2 do
    if i >= n do b else loop_g(push_g(b, int_to_float(i)), i + 1, n) end
  end

  -- H: cached capacity field, no length call
  @[no_alloc(warn)]
  fn push_h(b: Buf3, v: Float): Buf3 do
    match b do
      Buf3(d0, n, cap) ->
        if n < cap do Buf3(NativeArray.set_f32(d0, n, v), n + 1, cap) else Buf3(d0, n, cap) end
    end
  end
  fn loop_h(b: Buf3, i: Int, n: Int): Buf3 do
    if i >= n do b else loop_h(push_h(b, int_to_float(i)), i + 1, n) end
  end

  fn measure(name: String, f) : Unit do
    let base = live_allocs()
    let r = f(())
    let after = live_allocs()
    println(name ++ ": allocs=" ++ int_to_string(after - base) ++ " r=" ++ int_to_string(r))
  end

  fn main(_c: Cap(IO.Console), _f: Cap(IO.Foreign)) : Unit do
    measure("C variant no length", fn _ -> match loop_c(Buf2(NativeArray.make_f32(1000, 0.0), 0), 0, 1000) do Buf2(_, n) -> n end)
    measure("F variant + length guard inline", fn _ -> match loop_f(Buf2(NativeArray.make_f32(1000, 0.0), 0), 0, 1000) do Buf2(_, n) -> n end)
    measure("G variant + length in let", fn _ -> match loop_g(Buf2(NativeArray.make_f32(1000, 0.0), 0), 0, 1000) do Buf2(_, n) -> n end)
    measure("H variant + cached cap", fn _ -> match loop_h(Buf3(NativeArray.make_f32(1000, 0.0), 0, 1000), 0, 1000) do Buf3(_, n, _) -> n end)
  end
end
