-- ChunkMesh — a chunk's mesh as 16 vertical sections (opaque greedy + water
-- per cell). The VBO is assembled by the shim from the section buffers
-- (gfx_upload_begin + one gfx_upload_part per section), so nothing is
-- concatenated on the March side. Remeshing a block edit or a water tick
-- touches only the affected section(s).
--
-- (An earlier version concatenated sections into persistent upload buffers with
-- F32Buf.append; a buffer stored in a persistent Array is shared, so the
-- in-place append could never run — GAPS.md G54.)
mod CubeForge.ChunkMesh do

  alias CubeForge.F32Buf as B
  alias CubeForge.Mesher as Mesher
  alias CubeForge.World as World
  alias CubeForge.Vertex as Vx

  type ChunkMesh = ChunkMesh(Array.PVec(CubeForge.F32Buf.F32Buf), Array.PVec(CubeForge.F32Buf.F32Buf), Array.PVec(CubeForge.F32Buf.F32Buf))

  fn opaque_sections(m : ChunkMesh) : Array.PVec(CubeForge.F32Buf.F32Buf) do match m do ChunkMesh(o, _, _) -> o end end
  fn water_sections(m : ChunkMesh) : Array.PVec(CubeForge.F32Buf.F32Buf) do match m do ChunkMesh(_, w, _) -> w end end
  doc "Alpha-cutout foliage (leaves)."
  fn foliage_sections(m : ChunkMesh) : Array.PVec(CubeForge.F32Buf.F32Buf) do match m do ChunkMesh(_, _, f) -> f end end

  pfn total_go(secs : Array.PVec(CubeForge.F32Buf.F32Buf), i : Int, acc : Int) : Int do
    if i >= 16 do acc else total_go(secs, i + 1, acc + B.len(Array.get(secs, i))) end
  end
  doc "Total floats across the 16 sections."
  fn total_floats(secs : Array.PVec(CubeForge.F32Buf.F32Buf)) : Int do total_go(secs, 0, 0) end

  -- Sections of chunk (cx, cz) built in order 0..15.
  pfn build_sections(world : CubeForge.World.World, cx : Int, cz : Int, empty : CubeForge.Chunk.Chunk, sy : Int,
                     os : List(CubeForge.F32Buf.F32Buf), ws : List(CubeForge.F32Buf.F32Buf), fs : List(CubeForge.F32Buf.F32Buf)) : ChunkMesh do
    if sy < 0 do ChunkMesh(Array.from_list(os), Array.from_list(ws), Array.from_list(fs))
    else
      let c = World.chunk_at(world, cx, cz)
      let pick = fn (x, z) -> if World.in_bounds(world, x, z) do World.chunk_at(world, x, z) else empty end
      let n = pick(cx, cz - 1)
      let s = pick(cx, cz + 1)
      let e = pick(cx + 1, cz)
      let w = pick(cx - 1, cz)
      let ox = int_to_float(16 * cx)
      let oz = int_to_float(16 * cz)
      build_sections(world, cx, cz, empty, sy - 1,
                     Cons(Mesher.mesh_section_opaque(c, n, s, e, w, World.light(world), World.occupancy(world), sy, ox, oz), os),
                     Cons(Mesher.mesh_section_water(c, n, s, e, w, sy, ox, oz), ws),
                     Cons(Mesher.mesh_section_foliage(c, n, s, e, w, World.light(world), World.occupancy(world), sy, ox, oz), fs))
    end
  end

  doc "Mesh every section of chunk (cx, cz)."
  fn build(world : CubeForge.World.World, cx : Int, cz : Int, empty : CubeForge.Chunk.Chunk) : ChunkMesh do
    build_sections(world, cx, cz, empty, 15, Nil, Nil, Nil)
  end

  doc "Rebuild only the water pass of section [sy]."
  fn rebuild_section_water(m : ChunkMesh, world : CubeForge.World.World, cx : Int, cz : Int, sy : Int, empty : CubeForge.Chunk.Chunk) : ChunkMesh do
    rebuild_section_sel(m, world, cx, cz, sy, empty, false, true, false)
  end

  doc """
  Rebuild the chosen passes of section [sy]. An edit that cannot move a water
  cell or a leaf need not pay for those passes: the greedy mesh and its
  per-vertex light lookups are the cost, and they are per pass.

  Retexturing swaps a solid block for another of the same opacity, so it needs
  opaque alone. Growing or felling a tree needs opaque and foliage. A water cell
  appearing, moving or draining needs water alone, since opaque faces cull
  against water and air alike (Mesher.see_through).
  """
  fn rebuild_section_sel(m : ChunkMesh, world : CubeForge.World.World, cx : Int, cz : Int, sy : Int, empty : CubeForge.Chunk.Chunk,
                         do_opaque : Bool, do_water : Bool, do_foliage : Bool) : ChunkMesh do
    if sy < 0 || sy >= 16 do m
    else
      let c = World.chunk_at(world, cx, cz)
      let pick = fn (x, z) -> if World.in_bounds(world, x, z) do World.chunk_at(world, x, z) else empty end
      let n = pick(cx, cz - 1)
      let s = pick(cx, cz + 1)
      let e = pick(cx + 1, cz)
      let w = pick(cx - 1, cz)
      let ox = int_to_float(16 * cx)
      let oz = int_to_float(16 * cz)
      match m do
        ChunkMesh(os, ws, fs) ->
          ChunkMesh(if do_opaque do Array.set(os, sy, Mesher.mesh_section_opaque(c, n, s, e, w, World.light(world), World.occupancy(world), sy, ox, oz)) else os end,
                    if do_water do Array.set(ws, sy, Mesher.mesh_section_water(c, n, s, e, w, sy, ox, oz)) else ws end,
                    if do_foliage do Array.set(fs, sy, Mesher.mesh_section_foliage(c, n, s, e, w, World.light(world), World.occupancy(world), sy, ox, oz)) else fs end)
      end
    end
  end

  doc "Rebuild all three passes of one section (0..15) of chunk (cx, cz)."
  fn rebuild_section(m : ChunkMesh, world : CubeForge.World.World, cx : Int, cz : Int, sy : Int, empty : CubeForge.Chunk.Chunk) : ChunkMesh do
    rebuild_section_sel(m, world, cx, cz, sy, empty, true, true, true)
  end

  fn opaque_vertices(m : ChunkMesh) : Int do total_floats(opaque_sections(m)) / Vx.floats() end
  fn water_vertices(m : ChunkMesh) : Int do total_floats(water_sections(m)) / Vx.floats() end
  fn foliage_vertices(m : ChunkMesh) : Int do total_floats(foliage_sections(m)) / Vx.floats() end

end
