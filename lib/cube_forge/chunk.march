-- Chunk — 16 x 256 x 16 voxels in a flat NativeU8Arr, index x + 16*(z + 16*y).
-- Block ids: 0 air, 1 grass, 2 dirt, 3 stone, 4 water.
mod CubeForge.Chunk do

  type Chunk = Chunk(NativeU8Arr)

  fn size_x() : Int do 16 end
  fn size_y() : Int do 256 end
  fn size_z() : Int do 16 end
  fn volume() : Int do 65536 end

  doc "Flat index of a voxel; the refinements let Z3 discharge the bound."
  fn index(x : {Int | 0 <= _ && _ < 16}, y : {Int | 0 <= _ && _ < 256}, z : {Int | 0 <= _ && _ < 16})
      : {Int | 0 <= _ && _ < 65536} do
    x + 16 * (z + 16 * y)
  end

  fn new() : Chunk do Chunk(NativeArray.make_u8(65536, 0)) end
  doc "The chunk's backing bytes, for the save format."
  fn raw(c : Chunk) : NativeU8Arr do match c do Chunk(a) -> a end end
  doc "A chunk over [a], which must hold 65536 bytes."
  fn of_raw(a : NativeU8Arr) : Chunk do Chunk(a) end

  @[no_alloc]
  fn get(c : Chunk, x : {Int | 0 <= _ && _ < 16}, y : {Int | 0 <= _ && _ < 256}, z : {Int | 0 <= _ && _ < 16}) : Int do
    match c do Chunk(a) -> NativeArray.get_u8(a, index(x, y, z)) end
  end

  @[no_alloc]
  -- Block at (x, y, z), or 0 (air) when the coordinate is outside the chunk.
  fn get_or_air(c : Chunk, x : Int, y : Int, z : Int) : Int do
    if x < 0 || x >= 16 || y < 0 || y >= 256 || z < 0 || z >= 16 do 0
    else get(c, x, y, z) end
  end

  @[no_alloc]
  fn set(c : Chunk, x : {Int | 0 <= _ && _ < 16}, y : {Int | 0 <= _ && _ < 256}, z : {Int | 0 <= _ && _ < 16}, v : Int) : Chunk do
    match c do Chunk(a) -> Chunk(NativeArray.set_u8(a, index(x, y, z), v)) end
  end

  fn is_solid(id : Int) : Bool do id != 0 end
  doc "Blocks the player collides with: everything except air, water and small mushrooms."
  fn is_collidable(id : Int) : Bool do id != 0 && !is_water(id) && !is_fruit_small(id) end
  doc "Water source block (level 8)."
  fn water() : Int do 4 end
  doc "Ids 4..11 are water: 4 is a source (level 8), 5..11 are flow cells (levels 7..1)."
  fn is_water(id : Int) : Bool do id >= 4 && id <= 11 end
  fn is_source(id : Int) : Bool do id == 4 end
  doc "A cell a source could give into: air, or water that is not itself a source. What makes a source above sea level a SPRING rather than a lake's interior."
  fn open_for_spring(id : Int) : Bool do id == 0 || (is_water(id) && !is_source(id)) end
  fn level_of(id : Int) : Int do if is_water(id) do 12 - id else 0 end end
  fn id_of_level(l : Int) : Int do 12 - l end

  pfn count_water_go(a : NativeU8Arr, i : Int, acc : Int) : Int do
    if i >= 65536 do acc else count_water_go(a, i + 1, if is_water(NativeArray.get_u8(a, i)) do acc + 1 else acc end) end
  end
  -- Flowing water: cells that are water but not a source -- the finite units a
  -- spring has given, so a brook's length. The sea and the lakes are sources.
  pfn count_flow_go(a : NativeU8Arr, i : Int, acc : Int) : Int do
    if i >= 65536 do acc
    else
      let id = NativeArray.get_u8(a, i)
      count_flow_go(a, i + 1, if is_water(id) && !is_source(id) do acc + 1 else acc end)
    end
  end
  doc "Number of flowing (non-source) water cells in the chunk: what springs have given and evaporation not yet taken."
  fn count_flow(c : Chunk) : Int do match c do Chunk(a) -> count_flow_go(a, 0, 0) end end
  doc "Number of water cells in the chunk (test/verification helper)."
  fn count_water(c : Chunk) : Int do match c do Chunk(a) -> count_water_go(a, 0, 0) end end
  doc "Raw cell by flat index."
  fn get_idx(c : Chunk, i : Int) : Int do match c do Chunk(a) -> NativeArray.get_u8(a, i) end end
  @[no_alloc]
  fn set_idx(c : Chunk, i : Int, v : Int) : Chunk do match c do Chunk(a) -> Chunk(NativeArray.set_u8(a, i, v)) end end
  fn sea_level() : Int do 62 end
  -- Solid ids start at 12: water occupies 4..11 (a source plus 7 flow levels).
  fn sand() : Int do 12 end
  fn snow() : Int do 13 end
  doc "Granite: the rock exposed on cliff faces, distinct from the stone you mine underground."
  fn granite() : Int do 14 end
  doc "Bedrock: the world floor. Unbreakable, so nothing can be mined through into the void."
  fn bedrock() : Int do 15 end
  doc "Tree trunks and foliage. Leaves are alpha-cutout: see-through, but their shared faces are culled."
  fn oak_log() : Int do 16 end
  fn oak_leaves() : Int do 17 end
  fn pine_log() : Int do 18 end
  fn pine_leaves() : Int do 19 end
  doc "Scree above the treeline: the alpine surface."
  fn gravel() : Int do 20 end
  doc "Wetland clay."
  fn clay() : Int do 21 end
  doc "Deep volcanic rock: the material below the deep stone band."
  fn basalt() : Int do 22 end
  doc "Frozen water: generation-time only, placed instead of a spring at or above the snow line."
  fn ice() : Int do 23 end
  doc "Wetland surface variant alongside clay, picked per column."
  fn mud() : Int do 24 end
  doc "Glowing mushroom cap: the first emissive block. Placeholder until the fungus fruit blocks land; the block-light channel is verified with it."
  fn glow_cap() : Int do 25 end
  doc "Sandstone and shale: two of the rock strata's bands (see rock_id). Both harvest as stone."
  fn sandstone() : Int do 67 end
  fn shale() : Int do 68 end
  doc "Palm trunk and frond: the oasis tree. Fronds are foliage in every sense leaves are."
  fn palm_log() : Int do 65 end
  fn palm_frond() : Int do 66 end

  -- ── Mycelium: a surface block wearing the network ─────────────────────────
  -- Ids 26..46 encode base x glow: id = 26 + 3 * base_index + glow. The base
  -- is in the id so the surface can be restored when the network leaves; the
  -- glow is in the id so Light.emission stays a function of the block alone.
  -- The SPECIES is not in the id: it lives in the field, and the mesher reads
  -- it from World.shown to pick the texture. Seven bases, in index order:
  -- grass, dirt, sand, snow, gravel, clay, stone.
  fn myc_first() : Int do 26 end
  fn myc_last() : Int do 46 end
  fn is_myc(id : Int) : Bool do id >= myc_first() && id <= myc_last() end
  doc "Base index 0..6 for a base block id, or -1 when the block cannot carry mycelium."
  fn myc_index_of(base : Int) : Int do
    if base == 1 do 0 else if base == 2 do 1 else if base == sand() do 2 else if base == snow() do 3
    else if base == gravel() do 4 else if base == clay() do 5 else if base == 3 do 6 else -1 end end end end end end end
  end
  doc "The base block id for base index 0..6."
  fn myc_base_of_index(k : Int) : Int do
    if k == 0 do 1 else if k == 1 do 2 else if k == 2 do sand() else if k == 3 do snow()
    else if k == 4 do gravel() else if k == 5 do clay() else 3 end end end end end end
  end
  doc "Mycelium over [base] at glow 0..2, or 0 when the base cannot carry it."
  fn myc_id(base : Int, glow : Int) : Int do
    let k = myc_index_of(base)
    if k < 0 do 0 else myc_first() + 3 * k + glow end
  end
  fn myc_base_index(id : Int) : Int do (id - myc_first()) / 3 end
  fn myc_glow(id : Int) : Int do if is_myc(id) do (id - myc_first()) % 3 else 0 end end
  doc "The base block under a mycelium id; any other id is its own base."
  fn myc_base(id : Int) : Int do if is_myc(id) do myc_base_of_index(myc_base_index(id)) else id end end

  -- ── Fruit: mushroom bodies ───────────────────────────────────────────────
  -- Ids 47..64 encode kind x species: small 46 + sp, stem 52 + sp, cap 58 + sp.
  -- The species IS in the id here, unlike mycelium: a cap is a block the
  -- player carries away and places, and off the network it still has to glow
  -- and look like what it is.
  fn fruit_small(sp : Int) : Int do 46 + sp end
  fn fruit_stem(sp : Int) : Int do 52 + sp end
  fn fruit_cap(sp : Int) : Int do 58 + sp end
  fn is_fruit_small(id : Int) : Bool do id >= 47 && id <= 52 end
  fn is_fruit_stem(id : Int) : Bool do id >= 53 && id <= 58 end
  fn is_fruit_cap(id : Int) : Bool do id >= 59 && id <= 64 end
  fn is_fruit(id : Int) : Bool do id >= 47 && id <= 64 end
  doc "The species of a fruit block, or 0."
  fn fruit_species(id : Int) : Int do if is_fruit(id) do (id - 47) % 6 + 1 else 0 end end
  doc "Alpha-cutout blocks: leaves and small mushrooms. Meshed in the cutout pass and see-through for face culling and light."
  fn is_cutout(id : Int) : Bool do is_foliage(id) || is_fruit_small(id) end
  fn is_log(id : Int) : Bool do id == oak_log() || id == pine_log() || id == palm_log() end
  fn is_foliage(id : Int) : Bool do id == oak_leaves() || id == pine_leaves() || id == palm_frond() end

  doc "Blocks the player cannot break."
  fn is_unbreakable(id : Int) : Bool do id == bedrock() end
  doc "Thickness of the bedrock floor, at y = 0 .. bedrock_depth() - 1."
  fn bedrock_depth() : Int do 3 end

  doc "Below this depth, the deep stone band is basalt instead of plain stone."
  fn deep_stone_depth() : Int do 24 end

  doc """
  Surface block for a column of height [h] whose steepest neighbour differs by
  [slope]. Ordered so a rock face beats altitude, and a cliff beats a beach.
  """
  fn surface_id(h : Int, slope : Int) : Int do surface_id_at(h, slope, sea_level()) end
  doc "surface_id against a local water level: a lake's shore is sand and its bed dirt exactly as the sea's are."
  fn surface_id_at(h : Int, slope : Int, level : Int) : Int do
    if slope >= CubeForge.Noise.cliff_slope() do granite()
    else if h >= CubeForge.Noise.snow_line() do snow()
    else if h <= level + 1 && h >= level - 5 && slope <= 1 do sand()
    else if h < level - 5 do 2      -- lake and sea bed below the sandy shallows
    else 1 end end end end
  end

  doc "Block directly beneath the surface (4 deep); stone below that."
  fn subsurface_id(surface : Int) : Int do
    if surface == sand() do sand() else if surface == granite() do granite() else 2 end end
  end
  doc """
  The subsurface of a generated column: sand and granite follow their surface;
  on a floodplain ([river] at Noise.plain_edge or more) the river's sediment,
  mud where the floor is wet (at or under sea level + 1) and clay where it is
  dry; dirt elsewhere. The surface stays the biome's; sediment lies under it,
  on riverbank faces and under the spade.
  """
  fn sediment_id(surface : Int, river : Float, h : Int, level : Int, seed : Int) : Int do
    if surface == sand() || surface == granite() do subsurface_id(surface)
    else if river >= CubeForge.Noise.plain_edge(CubeForge.Noise.age_frac(seed)) do (if h <= level + 1 do mud() else clay() end)
    else 2 end end
  end

  -- ── M2 test terrain: a bumpy surface so every face direction is exercised ──
  pfn height_at(x : Int, z : Int) : Int do
    let fx = int_to_float(x)
    let fz = int_to_float(z)
    64 + float_to_int(3.0 *. Math.sin(fx *. 0.5) +. 2.0 *. Math.cos(fz *. 0.7)) + (if (x + z) % 7 == 0 do 2 else 0 end)
  end

  -- ── Rock strata ─────────────────────────────────────────────────────────────
  -- Under the four-block subsurface the rock is bedded: bands band_thickness()
  -- blocks tall, dipping a few degrees across the world (a fixed tilt from the
  -- seed) and folded gently by a low-frequency warp, so a cliff shows bands at
  -- an angle and two cliffs do not show the same stripes. The material of a
  -- band is a hash of its index and a 64-block region, so the sequence changes
  -- across the map. A material rule only: nothing here moves a height.
  doc "Blocks per band."
  fn band_thickness() : Int do 4 end
  doc "The per-column offset the bands are read against: tilt plus warp, in blocks. One noise sample per column."
  fn band_offset(wx : Int, wz : Int, seed : Int) : Float do
    let tilt_x = (CubeForge.Noise.hash2(3, 7, seed + 1202) -. 0.5) *. 0.16
    let tilt_z = (CubeForge.Noise.hash2(11, 5, seed + 1203) -. 0.5) *. 0.16
    tilt_x *. int_to_float(wx) +. tilt_z *. int_to_float(wz)
      +. 6.0 *. (CubeForge.Noise.value2(int_to_float(wx) *. 0.02, int_to_float(wz) *. 0.02, seed + 1200) -. 0.5)
  end
  doc "Band index of height [y] in a column with band offset [off]."
  fn band_of(y : Int, off : Float) : Int do
    float_to_int(Math.floor((int_to_float(y) +. off) /. int_to_float(band_thickness())))
  end
  doc "The rock of band [k] in region (rx, rz): stone 55%, basalt 20%, granite 10%, sandstone 7.5%, shale 7.5%. Never bedrock."
  fn band_material(k : Int, rx : Int, rz : Int, seed : Int) : Int do
    let h = CubeForge.Noise.hash2(k * 31 + rx, rz * 17 + k, seed + 1201)
    if h < 0.55 do 3 else if h < 0.75 do basalt() else if h < 0.85 do granite()
    else if h < 0.925 do sandstone() else shale() end end end end
  end
  doc "The rock at (wx, y, wz): band_material of the band the column's offset puts [y] in. What fills a column between its subsurface and the deep stone band."
  fn rock_id(wx : Int, y : Int, wz : Int, seed : Int) : Int do
    band_material(band_of(y, band_offset(wx, wz, seed)), wx / 64, wz / 64, seed)
  end

  -- Fill terrain up to [top] with [surface] on top, [sub] for four beneath it,
  -- the strata below that (bedded rock by band; the deep basalt band and the
  -- bedrock floor keep their depths), then water from top+1 up to sea level.
  -- The band and its material are carried down the column and rehashed only
  -- when the band changes: one hash per band crossed, not per block.
  pfn fill_column_strata(c : Chunk, x : Int, z : Int, y : Int, top : Int, surface : Int, sub : Int,
                         off : Float, rx : Int, rz : Int, seed : Int, band : Int, rock : Int, level : Int) : Chunk do
    if y > top do fill_water(c, x, z, top + 1, level)
    else
      let k = band_of(y, off)
      let rock1 = if k == band do rock else band_material(k, rx, rz, seed) end
      let id = if y < bedrock_depth() do bedrock()
               else if y == top do surface
               else if y > top - 4 do sub
               else if y < deep_stone_depth() do basalt()
               else rock1 end end end end
      fill_column_strata(set(c, x, y, z, id), x, z, y + 1, top, surface, sub, off, rx, rz, seed, k, rock1, level)
    end
  end
  doc "A generated column: [surface], four of [sub], then the strata of world column (wx, wz); water from the top to [level] (sea level, or a lake's surface)."
  fn fill_column_world(c : Chunk, x : Int, z : Int, wx : Int, wz : Int, seed : Int, top : Int, surface : Int, sub : Int, level : Int) : Chunk do
    fill_column_strata(c, x, z, 0, top, surface, sub, band_offset(wx, wz, seed), wx / 64, wz / 64, seed, -99999, 3, level)
  end

  -- Fill terrain up to [top] with [surface] on top and [sub] just beneath it, then
  -- water from top+1 up to sea level. The M2 test terrain: plain stone, no strata.
  pfn fill_column_mat(c : Chunk, x : Int, z : Int, y : Int, top : Int, surface : Int, sub : Int) : Chunk do
    if y > top do fill_water(c, x, z, top + 1, sea_level())
    else
      let id = if y < bedrock_depth() do bedrock()
               else if y == top do surface
               else if y > top - 4 do sub
               else if y < deep_stone_depth() do basalt()
               else 3 end end end end
      fill_column_mat(set(c, x, y, z, id), x, z, y + 1, top, surface, sub)
    end
  end

  -- Grass/dirt column, for the M2 test terrain.
  pfn fill_column(c : Chunk, x : Int, z : Int, y : Int, top : Int) : Chunk do
    fill_column_mat(c, x, z, y, top, 1, 2)
  end

  -- One generated column: height and slope decide the materials.
  pfn fill_terrain_column(c : Chunk, x : Int, z : Int, wx : Int, wz : Int, seed : Int, h : Int) : Chunk do
    let sfc = surface_id(h, CubeForge.Noise.slope(wx, wz, seed))
    fill_column_world(c, x, z, wx, wz, seed, h, sfc, sediment_id(sfc, CubeForge.Noise.river_at(wx, wz, seed), h, sea_level(), seed), sea_level())
  end

  -- Source blocks from [y] up to [level]: the sea, or a lake.
  pfn fill_water(c : Chunk, x : Int, z : Int, y : Int, level : Int) : Chunk do
    if y > level do c else fill_water(set(c, x, y, z, water()), x, z, y + 1, level) end
  end

  pfn fill_go(c : Chunk, i : Int) : Chunk do
    if i >= 256 do c
    else
      let x = i % 16
      let z = i / 16
      fill_go(fill_column(c, x, z, 0, height_at(x, z)), i + 1)
    end
  end

  doc "A chunk filled with the M2 test terrain."
  fn test_terrain() : Chunk do fill_go(new(), 0) end

  -- ── M4: fill from the noise heightmap ───────────────────────────────────
  -- The heightmap is computed ONCE per chunk, with an apron of apron() columns
  -- on every side, and every per-column rule (slope now; talus, sediment and
  -- the shore test later) reads it. Before, each column asked Noise.height
  -- five times -- once for itself and four for its neighbours inside
  -- Noise.slope -- and that was the whole of the world build.
  --
  -- The array is filled by the SCALAR Noise.height, not height_x4. Measured
  -- on the layered generator, the 4-wide path is five times slower per chunk
  -- and does not scale across workers: every F32x4 temporary is a heap box,
  -- and the layered height makes hundreds of them per call (RESULTS.md).
  -- height_x4 stays as the benchmark and the lanes test's reference. One
  -- path also means a chunk and its neighbour agree on shared columns
  -- exactly, and the surface materials agree with Noise.slope everywhere.
  doc "Columns of heightmap kept beyond the chunk on every side: talus_reach() at its widest, plus the one column slope needs around the piled ring."
  fn apron() : Int do 4 end
  doc "Side of the heightmap array: 16 + 2 * apron(). A literal, like the world's strides."
  fn heights_side() : Int do 24 end
  doc "Index of local column (lx, lz), each in [-apron(), 16 + apron()), in a heightmap array."
  fn height_index(lx : Int, lz : Int) : Int do (lx + apron()) + heights_side() * (lz + apron()) end
  doc "Height of local column (lx, lz) from a chunk heightmap (see heights). height_at is the M2 test terrain."
  fn hmap_at(hs : NativeIntArr, lx : Int, lz : Int) : Int do NativeArray.get_int(hs, height_index(lx, lz)) end

  pfn heights_go(hs : NativeIntArr, wx0 : Int, wz0 : Int, seed : Int, i : Int) : NativeIntArr do
    if i >= heights_side() * heights_side() do hs
    else
      let lx = i % heights_side() - apron()
      let lz = i / heights_side() - apron()
      heights_go(NativeArray.set_int(hs, i, CubeForge.Noise.height(wx0 + lx, wz0 + lz, seed)), wx0, wz0, seed, i + 1)
    end
  end
  doc "The heightmap of the chunk at world origin (wx0, wz0) with its apron."
  fn heights(wx0 : Int, wz0 : Int, seed : Int) : NativeIntArr do
    heights_go(NativeArray.make_int(heights_side() * heights_side(), 0), wx0, wz0, seed, 0)
  end

  -- ── Talus ───────────────────────────────────────────────────────────────────
  -- A cliff sheds rock, and it piles at the foot at the angle it comes to rest.
  -- A column under a face gets a pile of gravel whose depth grows with the
  -- world's age: none in a young world, three blocks when ancient. The pile
  -- is the surface (gravel over gravel), so the cliff's foot is a short ramp
  -- of scree rather than a right angle, and it reads the heightmap, so it is a
  -- pure function of the world column like every other rule.
  doc "How far (columns) a cliff sheds: the adjacent column until the world is old, two columns when ancient. Reach 2 at mid-age put scree on a seventh of the world."
  fn talus_reach(a : Float) : Int do if a >= 0.75 do 2 else 1 end end
  doc "The deepest pile, in blocks: 0 young, 1 mid-age, 3 ancient."
  fn talus_depth(a : Float) : Int do float_to_int(3.0 *. a) end
  doc "Blocks of rise per column at which rock rests: a neighbour this much higher per column away sheds nothing."
  fn talus_angle() : Int do 2 end
  doc "The least drop that sheds: one more than cliff_slope(), so a single terrace lip stays clean and a face piles. At cliff_slope() itself a fifth of the world was scree."
  fn talus_min_drop() : Int do CubeForge.Noise.cliff_slope() + 1 end

  -- The largest drop onto (lx, lz) from the ring within [r], less the angle
  -- of rest for every column of distance beyond the first (the adjacent
  -- face sheds straight down). k walks the (2r + 1)^2 offsets.
  pfn drop_go(hs : NativeIntArr, lx : Int, lz : Int, h : Int, r : Int, k : Int, best : Int) : Int do
    let side = 2 * r + 1
    if k >= side * side do best
    else
      let dx = k % side - r
      let dz = k / side - r
      let dist = Math.max_int(abs_int(dx), abs_int(dz))
      let d = if dist == 0 do 0 else hmap_at(hs, lx + dx, lz + dz) - h - (dist - 1) * talus_angle() end
      drop_go(hs, lx, lz, h, r, k + 1, if d > best do d else best end)
    end
  end
  doc """
  Blocks of gravel piled on local column (lx, lz) at age fraction [a]: 0
  unless something within talus_reach(a) stands talus_min_drop() or more above
  it after the angle of rest, then (drop - 2) / 2 capped at talus_depth(a).
  """
  fn pile_at(hs : NativeIntArr, lx : Int, lz : Int, a : Float) : Int do
    let depth = talus_depth(a)
    if depth <= 0 do 0
    else
      let drop = drop_go(hs, lx, lz, hmap_at(hs, lx, lz), talus_reach(a), 0, 0)
      if drop < talus_min_drop() do 0 else Math.min_int(depth, (drop - 2) / 2) end
    end
  end

  -- The PILED heightmap: height plus pile for the chunk and a one-column ring,
  -- laid out with piled_index. Slope and the surface rules read this one, so a
  -- pile counts as ground for its neighbours too.
  fn piled_side() : Int do 18 end
  fn piled_index(lx : Int, lz : Int) : Int do (lx + 1) + piled_side() * (lz + 1) end
  doc "Piled height of local column (lx, lz) in [-1, 17)."
  fn piled_at(ps : NativeIntArr, lx : Int, lz : Int) : Int do NativeArray.get_int(ps, piled_index(lx, lz)) end
  pfn piled_go(hs : NativeIntArr, ps : NativeIntArr, a : Float, i : Int) : NativeIntArr do
    if i >= piled_side() * piled_side() do ps
    else
      let lx = i % piled_side() - 1
      let lz = i / piled_side() - 1
      piled_go(hs, NativeArray.set_int(ps, i, hmap_at(hs, lx, lz) + pile_at(hs, lx, lz, a)), a, i + 1)
    end
  end
  doc "The piled heightmap over [hs] at age fraction [a]."
  fn piled(hs : NativeIntArr, a : Float) : NativeIntArr do
    piled_go(hs, NativeArray.make_int(piled_side() * piled_side(), 0), a, 0)
  end

  pfn abs_int(v : Int) : Int do if v < 0 do 0 - v else v end end
  doc "Largest height difference between local column (lx, lz) and its four neighbours, from the heightmap: Noise.slope over the array."
  fn slope_at(hs : NativeIntArr, lx : Int, lz : Int) : Int do
    let h = hmap_at(hs, lx, lz)
    let d0 = abs_int(hmap_at(hs, lx + 1, lz) - h)
    let d1 = abs_int(hmap_at(hs, lx - 1, lz) - h)
    let d2 = abs_int(hmap_at(hs, lx, lz + 1) - h)
    let d3 = abs_int(hmap_at(hs, lx, lz - 1) - h)
    Math.max_int(Math.max_int(d0, d1), Math.max_int(d2, d3))
  end
  doc "slope_at over the piled heightmap."
  fn piled_slope_at(ps : NativeIntArr, lx : Int, lz : Int) : Int do
    let h = piled_at(ps, lx, lz)
    let d0 = abs_int(piled_at(ps, lx + 1, lz) - h)
    let d1 = abs_int(piled_at(ps, lx - 1, lz) - h)
    let d2 = abs_int(piled_at(ps, lx, lz + 1) - h)
    let d3 = abs_int(piled_at(ps, lx, lz - 1) - h)
    Math.max_int(Math.max_int(d0, d1), Math.max_int(d2, d3))
  end

  -- ── Climate-shaped ground ───────────────────────────────────────────────
  -- Dunes are sand through (the biome finds sand and keeps it); a glacier
  -- column is filled with ice from its carved floor back up to the relief,
  -- gravel at the tongue's warm end (a moraine); a bog is a wet flat near
  -- sea level with mud and clay and one column in bog_pit() dug to a pool.
  doc "A dune column: the dune mask at or above this."
  fn dune_min() : Float do 0.35 end
  doc "One column in this many of a bog is a pool."
  fn bog_pit() : Int do 7 end
  doc "Fraction of bog columns that are mud rather than clay, on the same fixed hash Biome.wetland_surface uses, so a dug bank matches its surface."
  fn bog_surface(x : Int, z : Int) : Int do
    if CubeForge.Noise.hash2(x, z, 91537) < 0.4 do mud() else clay() end
  end
  doc "Is a column bog: at or within three of sea level, flat, on a river's plain, and not under a lake."
  fn is_bog(h : Int, slope : Int, river : Float, lake : Int, seed : Int) : Bool do
    lake == 0 && h >= sea_level() && h <= sea_level() + 3 && slope <= 1
      && river >= CubeForge.Noise.plain_edge(CubeForge.Noise.age_frac(seed))
  end
  doc "Is a bog column one of its pools."
  fn bog_pool(wx : Int, wz : Int, seed : Int) : Bool do
    CubeForge.Noise.hash2(wx, wz, seed + 1400) *. int_to_float(bog_pit()) < 1.0
  end
  -- Ice from [y] up to [top]: the glacier's fill.
  pfn fill_ice(c : Chunk, x : Int, z : Int, y : Int, top : Int) : Chunk do
    if y > top || y >= 255 do c else fill_ice(set(c, x, y, z, ice()), x, z, y + 1, top) end
  end

  -- A column with a pile is gravel over gravel: the pile IS the surface, and
  -- its slope is read from the piled map, so the foot of a cliff is scree at
  -- a walkable angle while the face above it keeps its granite.
  pfn fill_noise_go(c : Chunk, i : Int, hs : NativeIntArr, ps : NativeIntArr, wx0 : Int, wz0 : Int, seed : Int, lk : CubeForge.Lakes.Tile) : Chunk do
    if i >= 256 do c
    else
      let x = i % 16
      let z = i / 16
      let top = piled_at(ps, x, z)
      let piled_up = top > hmap_at(hs, x, z)
      -- the water level this column is under: a lake's surface, or the sea's
      let lake = CubeForge.Lakes.level_at(lk, wx0 + x, wz0 + z)
      let level = if lake > 0 do lake else sea_level() end
      let wx = wx0 + x
      let wz = wz0 + z
      let river = CubeForge.Noise.river_at(wx, wz, seed)
      let slope = piled_slope_at(ps, x, z)
      let bog = is_bog(top, slope, river, lake, seed)
      let pool = bog && bog_pool(wx, wz, seed)
      -- a lake's pour point is dug one block down: the notch its outlet runs over
      let notch = CubeForge.Lakes.notch_at(lk, wx, wz)
      let dune = !piled_up && !bog && CubeForge.Noise.dune_mask_at(wx, wz, seed) >= dune_min()
      let glacier = !piled_up && lake == 0 && CubeForge.Noise.glacier_at(wx, wz, seed)
      let moraine = glacier && CubeForge.Noise.moraine_at(wx, wz, seed)
      let top1 = if pool do sea_level() - 1 else if notch do top - 1 else top end end
      let sfc = if piled_up || moraine do gravel()
                else if dune do sand()
                else if bog && !pool do bog_surface(wx, wz)
                else surface_id_at(top1, slope, level) end end end
      let sub = if piled_up || moraine do gravel()
                else if dune do sand()
                else if bog do mud()
                else sediment_id(sfc, river, top1, level, seed) end end end
      let c1 = fill_column_world(c, x, z, wx, wz, seed, top1, sfc, sub, level)
      let c2 = if glacier && !moraine do fill_ice(c1, x, z, top1 + 1, CubeForge.Noise.relief(wx, wz, seed)) else c1 end
      fill_noise_go(c2, i + 1, hs, ps, wx0, wz0, seed, lk)
    end
  end

  doc "Generate the chunk whose world origin is (wx0, wz0) from the noise heightmap, with no lakes (see generate_lakes)."
  fn generate(wx0 : Int, wz0 : Int, seed : Int) : Chunk do generate_lakes(wx0, wz0, seed, CubeForge.Lakes.none()) end

  doc "Generate the chunk at (wx0, wz0) against the lake tile [lk] (Lakes.tile_of_chunk, or Lakes.levels for a bounded world): lake columns fill to their surface, and no tree or bush stands under one."
  fn generate_lakes(wx0 : Int, wz0 : Int, seed : Int, lk : CubeForge.Lakes.Tile) : Chunk do
    let hs = heights(wx0, wz0, seed)
    let ps = piled(hs, CubeForge.Noise.age_frac(seed))
    -- the caves are carved last: through the strata, under the trees, never
    -- through water. The structure POIs are stamped after the carve, so a worm
    -- cannot eat an arch, and after planting, so an arch is not overgrown.
    CubeForge.Poi.carve(CubeForge.Caves.carve(plant_lakes(fill_noise_go(new(), 0, hs, ps, wx0, wz0, seed, lk), wx0, wz0, seed, lk), wx0, wz0, seed, lk), wx0, wz0, seed)
  end

  -- ── Vegetation ──────────────────────────────────────────────────────────────
  -- A tree near a chunk edge spills its canopy into the neighbour, so a chunk
  -- must draw every tree whose CELL lies within the widest canopy radius of it.
  -- Placement is a pure function of the cell, so both chunks write identical
  -- blocks for the part of a tree they share.

  pfn floor_div(a : Int, b : Int) : Int do if a >= 0 do a / b else (a - b + 1) / b end end

  -- Write one tree's blocks that land inside this chunk.
  pfn stamp_tree(c : Chunk, wx0 : Int, wz0 : Int, tx : Int, tz : Int, base : Int, trunk : Int, species : Int, i : Int) : Chunk do
    -- the tree occupies a 9x9 column footprint around its trunk, trunk + 2 tall
    if i >= 9 * 9 * 12 do c
    else
      let x = tx - 4 + i % 9
      let z = tz - 4 + (i / 9) % 9
      let y = base + 1 + i / 81
      let lx = x - wx0
      let lz = z - wz0
      if lx < 0 || lx >= 16 || lz < 0 || lz >= 16 || y < 0 || y >= 256 do
        stamp_tree(c, wx0, wz0, tx, tz, base, trunk, species, i + 1)
      else
        let id = CubeForge.Trees.block_of_tree(tx, tz, base, trunk, species, x, y, z)
        -- only grow into air, so a tree never eats terrain or another trunk
        let c1 = if id != 0 && get(c, lx, y, lz) == 0 do set(c, lx, y, lz, id) else c end
        stamp_tree(c1, wx0, wz0, tx, tz, base, trunk, species, i + 1)
      end
    end
  end

  pfn stamp_bush(c : Chunk, wx0 : Int, wz0 : Int, bx : Int, bz : Int, base : Int, i : Int) : Chunk do
    if i >= 9 do c
    else
      let x = bx - 1 + i % 3
      let z = bz - 1 + i / 3
      let lx = x - wx0
      let lz = z - wz0
      let centre = i == 4
      let keep = centre || (x + z + i) % 3 != 0
      if lx < 0 || lx >= 16 || lz < 0 || lz >= 16 || !keep do stamp_bush(c, wx0, wz0, bx, bz, base, i + 1)
      else
        let y = base + 1
        let c1 = if y < 256 && get(c, lx, y, lz) == 0 do set(c, lx, y, lz, oak_leaves()) else c end
        stamp_bush(c1, wx0, wz0, bx, bz, base, i + 1)
      end
    end
  end

  -- Every tree cell overlapping this chunk expanded by the canopy radius.
  -- A cell's tree or bush is skipped when its column is under a lake: the cell
  -- test is pure in the cell, and the lake table is the same in every chunk,
  -- so both chunks a canopy spans agree.
  pfn plant_trees_go(c : Chunk, wx0 : Int, wz0 : Int, seed : Int, i : Int, cx0 : Int, cz0 : Int, span : Int, lk : CubeForge.Lakes.Tile) : Chunk do
    if i >= span * span do c
    else
      let cx = cx0 + i % span
      let cz = cz0 + i / span
      let col = CubeForge.Trees.tree_at_cell(cx, cz, seed)
      if col < 0 || CubeForge.Lakes.level_at(lk, col % 4096, col / 4096) > 0 do plant_trees_go(c, wx0, wz0, seed, i + 1, cx0, cz0, span, lk)
      else
        let tx = col % 4096
        let tz = col / 4096
        let base = CubeForge.Noise.height(tx, tz, seed)
        let trunk = CubeForge.Trees.trunk_height(tx, tz, seed)
        let species = CubeForge.Trees.species_at(base)
        plant_trees_go(stamp_tree(c, wx0, wz0, tx, tz, base, trunk, species, 0), wx0, wz0, seed, i + 1, cx0, cz0, span, lk)
      end
    end
  end

  pfn plant_bushes_go(c : Chunk, wx0 : Int, wz0 : Int, seed : Int, i : Int, cx0 : Int, cz0 : Int, span : Int, lk : CubeForge.Lakes.Tile) : Chunk do
    if i >= span * span do c
    else
      let cx = cx0 + i % span
      let cz = cz0 + i / span
      let col = CubeForge.Trees.bush_at_cell(cx, cz, seed)
      if col < 0 || CubeForge.Lakes.level_at(lk, col % 4096, col / 4096) > 0 do plant_bushes_go(c, wx0, wz0, seed, i + 1, cx0, cz0, span, lk)
      else
        let bx = col % 4096
        let bz = col / 4096
        plant_bushes_go(stamp_bush(c, wx0, wz0, bx, bz, CubeForge.Noise.height(bx, bz, seed), 0), wx0, wz0, seed, i + 1, cx0, cz0, span, lk)
      end
    end
  end

  doc "Plant the trees and bushes that reach into the chunk at world origin (wx0, wz0), with no lakes."
  fn plant(c : Chunk, wx0 : Int, wz0 : Int, seed : Int) : Chunk do plant_lakes(c, wx0, wz0, seed, CubeForge.Lakes.none()) end
  doc "plant against the world's lake table: nothing is planted under a lake."
  fn plant_lakes(c : Chunk, wx0 : Int, wz0 : Int, seed : Int, lk : CubeForge.Lakes.Tile) : Chunk do
    let r = CubeForge.Trees.max_radius()
    let ts = CubeForge.Trees.cell_size()
    let tc0 = floor_div(wx0 - r, ts)
    let tcz0 = floor_div(wz0 - r, ts)
    let tspan = floor_div(wx0 + 15 + r, ts) - tc0 + 1
    let bs = CubeForge.Trees.bush_cell_size()
    let bc0 = floor_div(wx0 - 1, bs)
    let bcz0 = floor_div(wz0 - 1, bs)
    let bspan = floor_div(wx0 + 16, bs) - bc0 + 1
    plant_springs_go(plant_bushes_go(plant_trees_go(c, wx0, wz0, seed, 0, tc0, tcz0, tspan, lk), wx0, wz0, seed, 0, bc0, bcz0, bspan, lk), wx0, wz0, seed, 0, floor_div(wx0, ts), floor_div(wz0, ts), floor_div(wx0 + 15, ts) - floor_div(wx0, ts) + 1)
  end

  -- A spring is one source block at the surface of its cell's column. Only cells
  -- whose column lies in this chunk: a spring never straddles an edge.
  pfn plant_springs_go(c : Chunk, wx0 : Int, wz0 : Int, seed : Int, i : Int, cx0 : Int, cz0 : Int, span : Int) : Chunk do
    if i >= span * span do c
    else
      let col = CubeForge.Trees.spring_at_cell(cx0 + i % span, cz0 + i / span, seed)
      if col < 0 do plant_springs_go(c, wx0, wz0, seed, i + 1, cx0, cz0, span)
      else
        let lx = col % 4096 - wx0
        let lz = col / 4096 - wz0
        let h = CubeForge.Noise.height(col % 4096, col / 4096, seed)
        let sid = if h >= CubeForge.Noise.snow_line() do ice() else water() end
        let c1 = if lx < 0 || lx >= 16 || lz < 0 || lz >= 16 || h < 1 || h >= 255 do c else set(c, lx, h, lz, sid) end
        plant_springs_go(c1, wx0, wz0, seed, i + 1, cx0, cz0, span)
      end
    end
  end

  -- Scalar reference generator (same terrain), for timing the 4-wide path against.
  pfn fill_scalar_go(c : Chunk, i : Int, wx0 : Int, wz0 : Int, seed : Int) : Chunk do
    if i >= 256 do c
    else
      let x = i % 16
      let z = i / 16
      fill_scalar_go(fill_terrain_column(c, x, z, wx0 + x, wz0 + z, seed, CubeForge.Noise.height(wx0 + x, wz0 + z, seed)), i + 1, wx0, wz0, seed)
    end
  end
  fn generate_scalar(wx0 : Int, wz0 : Int, seed : Int) : Chunk do plant(fill_scalar_go(new(), 0, wx0, wz0, seed), wx0, wz0, seed) end

end