-- Trees — oak, pine and palm trees and bushes, placed as a pure function of
-- world coordinates. Species: 0 oak, 1 pine, 2 palm. Generation plants oaks and
-- pines by height; palms come only through Veg growth in an oasis.
--
-- Chunks generate independently, but a tree near a chunk edge spills its canopy
-- into the neighbour. Rather than communicate, placement is derived from a hash
-- of the tree CELL: the world is divided into fixed cells, each cell holds at
-- most one tree at a hashed position, and a chunk draws every tree whose cell
-- lies within `max_radius()` of it. Two neighbouring chunks therefore derive
-- byte-identical trees for the blocks they share (see trees_test).
mod CubeForge.Trees do

  needs IO.Process   -- CF_SPRING_DENSITY

  alias CubeForge.Chunk as C
  alias CubeForge.Noise as N

  doc "Side of a tree cell, in blocks: at most one tree per cell, so trees are spaced."
  fn cell_size() : Int do 8 end
  doc "Side of a bush cell: bushes are denser than trees."
  fn bush_cell_size() : Int do 5 end
  doc "Widest canopy radius; a chunk must consider tree cells this far outside it."
  fn max_radius() : Int do 3 end
  doc "Above this height oaks give way to pines."
  fn treeline() : Int do 84 end

  -- A hash in [0, 1) for a cell and a purpose, independent of the terrain hash.
  pfn cell_hash(cx : Int, cz : Int, seed : Int, salt : Int) : Float do
    N.hash2(cx * 7919 + salt * 104729, cz * 6271 + salt * 15485863, seed + 5081)
  end

  -- ── Which cells hold a tree ─────────────────────────────────────────────────

  doc """
  Trunk column of the tree in cell (cx, cz), packed as x + 4096 * z, or -1 when
  the cell has no tree. Depends only on the cell and the seed, never on which
  chunk is asking.
  """
  fn tree_at_cell(cx : Int, cz : Int, seed : Int) : Int do
    let density = cell_hash(cx, cz, seed, 1)
    -- ~45% of cells hold a tree; the rest stay open ground
    if density > 0.45 do -1
    else
      let ox = float_to_int(cell_hash(cx, cz, seed, 2) *. int_to_float(cell_size()))
      let oz = float_to_int(cell_hash(cx, cz, seed, 3) *. int_to_float(cell_size()))
      let wx = cx * cell_size() + ox
      let wz = cz * cell_size() + oz
      if plantable(wx, wz, seed) do wx + 4096 * wz else -1 end
    end
  end

  doc "The trunk column a cell would use if it held a tree, packed x + 4096 * z. What tree_at_cell picks before it asks whether the ground allows it; growth after generation plants only here, so trees stay spaced and a column is a candidate at most once."
  fn cell_trunk(cx : Int, cz : Int, seed : Int) : Int do
    let ox = float_to_int(cell_hash(cx, cz, seed, 2) *. int_to_float(cell_size()))
    let oz = float_to_int(cell_hash(cx, cz, seed, 3) *. int_to_float(cell_size()))
    (cx * cell_size() + ox) + 4096 * (cz * cell_size() + oz)
  end
  doc "The cell's density draw in [0, 1): a cell holds a tree when this is below its biome's density."
  fn cell_density(cx : Int, cz : Int, seed : Int) : Float do cell_hash(cx, cz, seed, 1) end

  doc "Springs per mille of 8-block cells, before the ground test. CF_SPRING_DENSITY."
  fn spring_density() : Int do Env.get_int("CF_SPRING_DENSITY", 100) end

  doc "Valley springs per mille of cells whose trunk column is on a river centreline. CF_VALLEY_SPRING_DENSITY."
  fn valley_spring_density() : Int do Env.get_int("CF_VALLEY_SPRING_DENSITY", 500) end

  doc """
  What spring the cell (cx, cz) holds at its trunk column: 0 none, 1 a
  mountainside spring (slope at least two, ground at 72 or higher), 2 a
  valley spring (on a river centreline -- Noise.river_at at spring_mask() or
  more -- above sea level by Noise.spring_rise, with some slope to run down).
  Each has its own density draw. The biome field does not exist at
  generation, so height, slope and the river mask stand in, as they do for
  pines. A chain of valley springs down one channel is a brook: each is a
  trickle that evaporation ends in a dozen cells, and the next takes over.
  """
  fn spring_kind(cx : Int, cz : Int, seed : Int) : Int do
    let col = cell_trunk(cx, cz, seed)
    let wx = col % 4096
    let wz = col / 4096
    let h = N.height(wx, wz, seed)
    let slope = N.slope(wx, wz, seed)
    let mountain = cell_hash(cx, cz, seed, 6) *. 1000.0 < int_to_float(spring_density()) && slope >= 2 && h >= 72
    let valley = cell_hash(cx, cz, seed, 7) *. 1000.0 < int_to_float(valley_spring_density())
                 && N.river_at(wx, wz, seed) >= N.spring_mask()
                 && h > C.sea_level() + N.spring_rise(N.age_frac(seed)) && slope >= 1
    if mountain do 1 else if valley do 2 else 0 end end
  end

  doc "Trunk-style column of the spring in cell (cx, cz), packed x + 4096 * z, or -1 (see spring_kind)."
  fn spring_at_cell(cx : Int, cz : Int, seed : Int) : Int do
    if spring_kind(cx, cz, seed) == 0 do 0 - 1 else cell_trunk(cx, cz, seed) end
  end

  doc "A column can hold a plant only on flat grass above the water line."
  fn plantable(wx : Int, wz : Int, seed : Int) : Bool do
    let h = N.height(wx, wz, seed)
    let slope = N.slope(wx, wz, seed)
    -- grass only: never sand, snow, granite or under water
    C.surface_id(h, slope) == 1 && h > C.sea_level() && slope <= 1
  end

  doc "Tree species ids."
  fn oak() : Int do 0 end
  fn pine() : Int do 1 end
  fn palm() : Int do 2 end
  doc "Species for a trunk at height [h] at generation: pine above the treeline, oak below."
  fn species_at(h : Int) : Int do if h >= treeline() do pine() else oak() end end
  doc "The species a log id belongs to: 0 oak, 1 pine, 2 palm. A non-log is oak."
  fn species_of_log(id : Int) : Int do
    if id == C.pine_log() do pine() else if id == C.palm_log() do palm() else oak() end end
  end
  doc "Trunk logs Veg grows for a species: oaks 5, pines 7, palms 6."
  fn grown_trunk(species : Int) : Int do if species == pine() do 7 else if species == palm() do 6 else 5 end end end

  doc "Trunk height for the tree at (wx, wz)."
  fn trunk_height(wx : Int, wz : Int, seed : Int) : Int do
    let h = N.height(wx, wz, seed)
    if species_at(h) == pine() do 6 + float_to_int(cell_hash(wx, wz, seed, 4) *. 3.0)
    else 4 + float_to_int(cell_hash(wx, wz, seed, 5) *. 3.0) end
  end

  -- ── Canopy shape ────────────────────────────────────────────────────────────
  -- Both shapes are described as a predicate over the offset from the trunk top,
  -- so the same function answers "is there a leaf here" for any chunk.

  doc """
  Block a tree contributes at world (x, y, z), or 0. [tx, tz] is the trunk column,
  [base] the ground height it stands on. Pure, so any chunk can ask about any tree.
  """
  fn block_of_tree(tx : Int, tz : Int, base : Int, trunk : Int, species : Int, x : Int, y : Int, z : Int) : Int do
    let dx = x - tx
    let dz = z - tz
    let dy = y - base
    if dx == 0 && dz == 0 && dy >= 1 && dy <= trunk do
      if species == pine() do C.pine_log() else if species == palm() do C.palm_log() else C.oak_log() end end
    else
      let leaf = if species == pine() do pine_leaf_at(dx, dy, dz, trunk)
                 else if species == palm() do palm_frond_at(dx, dy, dz, trunk)
                 else oak_leaf_at(dx, dy, dz, trunk) end end
      if leaf do (if species == pine() do C.pine_leaves() else if species == palm() do C.palm_frond() else C.oak_leaves() end end) else 0 end
    end
  end

  -- Palm: a bare trunk with a small spread head. Twelve fronds ring the trunk
  -- top one and two out (|dx| + |dz| in 1..2), and a plus of five sits one above.
  pfn palm_frond_at(dx : Int, dy : Int, dz : Int, trunk : Int) : Bool do
    let d = abs_i(dx) + abs_i(dz)
    if dy == trunk do d >= 1 && d <= 2
    else if dy == trunk + 1 do d <= 1
    else false end end
  end

  -- Oak: a rounded blob centred just below the trunk top.
  pfn oak_leaf_at(dx : Int, dy : Int, dz : Int, trunk : Int) : Bool do
    let cy = dy - (trunk - 1)
    let r = abs_i(dx) + abs_i(dz) + abs_i(cy) * 2
    dy >= trunk - 2 && dy <= trunk + 1 && r <= 4 && !(abs_i(dx) == 2 && abs_i(dz) == 2)
  end

  -- Pine: a narrow cone, widest low and tapering to a tip.
  pfn pine_leaf_at(dx : Int, dy : Int, dz : Int, trunk : Int) : Bool do
    if dy < 2 || dy > trunk + 1 do false
    else
      -- radius shrinks with height, and every other layer is pulled in for a tiered look
      let up = trunk + 1 - dy
      let radius = if up <= 0 do 0 else if up >= 5 do 2 else (up + 1) / 2 end end
      let ring = if dy % 2 == 0 do radius else radius - 1 end
      abs_i(dx) + abs_i(dz) <= ring
    end
  end

  pfn abs_i(v : Int) : Int do if v < 0 do 0 - v else v end end

  -- ── Bushes ──────────────────────────────────────────────────────────────────

  doc "Fraction of bush cells that hold a bush at generation, on grass."
  fn bush_density() : Float do 0.22 end
  doc "The bush cell's density draw, compared against a biome's bush density."
  fn bush_cell_density(cx : Int, cz : Int, seed : Int) : Float do cell_hash(cx, cz, seed, 11) end
  doc "The one column of bush cell (cx, cz) a bush may stand on, packed x + 4096 * z. Shared by generation and Veg so growth is spaced the same way."
  fn bush_cell_column(cx : Int, cz : Int, seed : Int) : Int do
    let ox = float_to_int(cell_hash(cx, cz, seed, 12) *. int_to_float(bush_cell_size()))
    let oz = float_to_int(cell_hash(cx, cz, seed, 13) *. int_to_float(bush_cell_size()))
    (cx * bush_cell_size() + ox) + 4096 * (cz * bush_cell_size() + oz)
  end

  doc "Bush column in bush cell (cx, cz), packed x + 4096 * z, or -1."
  fn bush_at_cell(cx : Int, cz : Int, seed : Int) : Int do
    if bush_cell_density(cx, cz, seed) >= bush_density() do -1
    else
      let col = bush_cell_column(cx, cz, seed)
      if plantable(col % 4096, col / 4096, seed) do col else -1 end
    end
  end

end
