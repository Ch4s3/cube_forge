-- Veg — vegetation growing and decaying with the biome field.
--
-- Trees are generated as a pure function of the seed (trees.march) and that
-- function is left alone: if it read a mutable biome, every tree in a drifting
-- region would pop in and out as chunks remesh. Ongoing change goes through
-- here instead: a column grows a tree only at its cell's canonical trunk
-- column, so growth is spaced and idempotent, and a tree decays -- trunk
-- first, then orphaned leaves -- where its biome no longer supports it.
mod CubeForge.Veg do

  alias CubeForge.Biome as Biome
  alias CubeForge.Chunk as C
  alias CubeForge.Trees as Trees
  alias CubeForge.World as W

  doc "Biomes that hold trees at all."
  fn wants_trees(b : Int) : Bool do b == Biome.b_forest() || b == Biome.b_taiga() || b == Biome.b_wetland() end
  doc "Fraction of 8-block cells that hold a tree, per biome. Forest matches generation's 0.45."
  fn density(b : Int) : Float do
    if b == Biome.b_forest() do 0.45 else if b == Biome.b_taiga() do 0.25 else if b == Biome.b_wetland() do 0.15 else 0.0 end end end
  end
  doc "Pines in the taiga, oaks everywhere else that has trees."
  fn pine_for(b : Int) : Bool do b == Biome.b_taiga() end
  doc "How far around a trunk decay looks for orphaned leaves: the widest canopy plus one."
  fn decay_radius() : Int do Trees.max_radius() + 1 end

  fn is_log(id : Int) : Bool do id == C.oak_log() || id == C.pine_log() end

  -- Column (x, z) is its cell's canonical trunk column and the cell's density draw
  -- is under the biome's density.
  -- Nested, not `&&`: `&&` evaluates both sides (GAPS G33), and the scan runs
  -- this over 2048 columns a tick, where the trunk test rejects all but one in
  -- a few hundred. The density noise is only worth computing for a trunk column.
  pfn cell_says_tree(x : Int, z : Int, seed : Int, b : Int) : Bool do
    let cx = x / Trees.cell_size()
    let cz = z / Trees.cell_size()
    if Trees.cell_trunk(cx, cz, seed) == x + 4096 * z do Trees.cell_density(cx, cz, seed) < density(b)
    else false end
  end

  doc "Can a tree grow at column (x, z) now: its biome wants one, the cell says so, the surface is the biome's own ground with air above, it is dry and above the sea, and nothing stands there yet."
  -- Nested rather than a chain of `&&`: `&&` does not short-circuit (GAPS G33),
  -- so the flat version ran the noise call and both block_at lookups for every
  -- one of the 2048 columns a tick scans, nearly all of which the first test
  -- already rejected. Cheapest and most selective tests first.
  fn can_grow(f : CubeForge.Biome.Field, w : CubeForge.World.World, seed : Int, x : Int, z : Int) : Bool do
    let b = Biome.biome_of(f, x, z)
    if !wants_trees(b) do false
    else
      let h = Biome.height_of(f, x, z)
      if h <= C.sea_level() do false
      else if !cell_says_tree(x, z, seed, b) do false
      else if W.block_at(w, x, h, z) != Biome.palette(b) do false
      else if W.block_at(w, x, h + 1, z) != 0 do false
      else !Biome.is_wet(f, x, z) end end end end
    end
  end

  doc "Should the tree rooted at column (x, z) decay: a log stands on the surface's ground and the biome does not want trees. The heightmap sees a tree's top as the surface, so the ground is found by walking down through the tree."
  -- Nested for the same reason as can_grow (G33): trunk_base walks up to
  -- thirteen block_at down the column, and the biome test rejects it outright
  -- everywhere a tree could never have stood.
  fn can_decay(f : CubeForge.Biome.Field, w : CubeForge.World.World, x : Int, z : Int) : Bool do
    let b = Biome.biome_of(f, x, z)
    if wants_trees(b) do false
    else trunk_base(w, x, z, Biome.height_of(f, x, z)) >= 0 end
  end

  doc "The y of the ground under the tree whose trunk is in column (x, z), searching down from [top]; -1 if no log sits on solid ground within a trunk's height."
  fn trunk_base(w : CubeForge.World.World, x : Int, z : Int, top : Int) : Int do trunk_go(w, x, z, top, 0) end
  pfn trunk_go(w : CubeForge.World.World, x : Int, z : Int, y : Int, n : Int) : Int do
    if n > 12 || y <= 0 do 0 - 1
    else
      let id = W.block_at(w, x, y, z)
      let below = W.block_at(w, x, y - 1, z)
      if is_log(id) && below != 0 && !is_log(below) && !C.is_foliage(below) do y - 1
      else trunk_go(w, x, z, y - 1, n + 1) end
    end
  end

  pfn scan_go(f : CubeForge.Biome.Field, w : CubeForge.World.World, seed : Int, n : Int, i : Int, left : Int, budget : Int, acc : List(Int)) : List(Int) do
    if left <= 0 || budget <= 0 do acc
    else
      let ci = i % (n * n)
      let x = ci % n
      let z = ci / n
      -- growth packs the column as-is; decay packs it with bit 30 set
      if can_grow(f, w, seed, x, z) do scan_go(f, w, seed, n, i + 1, left - 1, budget - 1, Cons(ci, acc))
      else if can_decay(f, w, x, z) do scan_go(f, w, seed, n, i + 1, left - 1, budget - 1, Cons(ci + 1073741824, acc))
      else scan_go(f, w, seed, n, i + 1, left - 1, budget, acc) end end
    end
  end

  doc "Columns to act on this tick: growth entries are column indices, decay entries have bit 30 set. At most [budget], scanning [scan] columns from where tick [tick] leaves off."
  fn candidates(f : CubeForge.Biome.Field, w : CubeForge.World.World, seed : Int, tick : Int, scan : Int, budget : Int) : List(Int) do
    let n = Biome.cols(w)
    scan_go(f, w, seed, n, (tick * scan) % (n * n), scan, budget, Nil)
  end
  fn is_decay(entry : Int) : Bool do entry >= 1073741824 end
  fn column_of(entry : Int) : Int do if is_decay(entry) do entry - 1073741824 else entry end end

  -- ── World edits: the tree's blocks ─────────────────────────────────────────
  doc "Stamp a tree of [trunk] logs rooted on ground [base] at (tx, tz), only into air. Returns the world."
  fn plant(w : CubeForge.World.World, tx : Int, tz : Int, base : Int, trunk : Int, pine : Bool) : CubeForge.World.World do
    plant_go(w, tx, tz, base, trunk, pine, 0)
  end
  pfn plant_go(w : CubeForge.World.World, tx : Int, tz : Int, base : Int, trunk : Int, pine : Bool, i : Int) : CubeForge.World.World do
    if i >= 81 * (trunk + 2) do w
    else
      let x = tx - 4 + i % 9
      let z = tz - 4 + (i / 9) % 9
      let y = base + 1 + i / 81
      let id = Trees.block_of_tree(tx, tz, base, trunk, pine, x, y, z)
      let w1 = if id != 0 && y < 256 && W.block_at(w, x, y, z) == 0 do W.set_occupied(W.set_block(w, x, y, z, id), x, y, z, CubeForge.Light.occludes(id)) else w end
      plant_go(w1, tx, tz, base, trunk, pine, i + 1)
    end
  end

  doc "Fell the tree rooted at (x, base, z): the logs, then exactly the leaves its own shape says it owns. Not World.decay_leaves -- that searches a (2r+1)^3 box for a log around every leaf in a (2r+1)^3 box, up to five million reads per tree, and took seconds. A tree of known trunk and species is ~730 predicate checks. Where two canopies overlap a few shared leaves go with the felled tree; the standing one keeps its trunk and the rest."
  fn fell(w : CubeForge.World.World, x : Int, z : Int, base : Int) : CubeForge.World.World do
    let pine = W.block_at(w, x, base + 1, z) == C.pine_log()
    match fell_logs(w, x, z, base + 1) do
      Felled(w1, ty) -> unleaf_go(w1, x, z, base, ty - base, pine, 0)
    end
  end
  type Felled = Felled(CubeForge.World.World, Int)
  pfn fell_logs(w : CubeForge.World.World, x : Int, z : Int, y : Int) : Felled do
    if y >= 256 || !is_log(W.block_at(w, x, y, z)) do Felled(w, y - 1)
    else fell_logs(W.set_occupied(W.set_block(w, x, y, z, 0), x, y, z, false), x, z, y + 1) end
  end
  pfn unleaf_go(w : CubeForge.World.World, tx : Int, tz : Int, base : Int, trunk : Int, pine : Bool, i : Int) : CubeForge.World.World do
    if i >= 81 * (trunk + 2) do w
    else
      let x = tx - 4 + i % 9
      let z = tz - 4 + (i / 9) % 9
      let y = base + 1 + i / 81
      let want = Trees.block_of_tree(tx, tz, base, trunk, pine, x, y, z)
      let w1 = if y < 256 && C.is_foliage(want) && W.block_at(w, x, y, z) == want do W.set_occupied(W.set_block(w, x, y, z, 0), x, y, z, false) else w end
      unleaf_go(w1, tx, tz, base, trunk, pine, i + 1)
    end
  end

end
