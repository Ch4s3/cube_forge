-- Raycast — Amanatides & Woo voxel traversal from a point along a direction.
-- Returns the first solid block within [max_dist] and the face it was entered
-- through (as an axis-aligned normal), or a miss. A variant, not a tuple.
mod CubeForge.Raycast do

  alias CubeForge.World as W

  -- hit?, block x y z, face normal nx ny nz
  type Hit = Hit(Bool, Int, Int, Int, Int, Int, Int)

  fn miss() : Hit do Hit(false, 0, 0, 0, 0, 0, 0) end
  fn is_hit(h : Hit) : Bool do match h do Hit(b, _, _, _, _, _, _) -> b end end
  fn bx(h : Hit) : Int do match h do Hit(_, x, _, _, _, _, _) -> x end end
  fn by_(h : Hit) : Int do match h do Hit(_, _, y, _, _, _, _) -> y end end
  fn bz(h : Hit) : Int do match h do Hit(_, _, _, z, _, _, _) -> z end end
  fn nx(h : Hit) : Int do match h do Hit(_, _, _, _, a, _, _) -> a end end
  fn ny(h : Hit) : Int do match h do Hit(_, _, _, _, _, b, _) -> b end end
  fn nz(h : Hit) : Int do match h do Hit(_, _, _, _, _, _, c) -> c end end

  pfn sign(d : Float) : Int do if d > 0.0 do 1 else if d < 0.0 do -1 else 0 end end end

  -- Distance along the ray to the next voxel boundary on one axis, and the per-step increment.
  pfn t_delta(d : Float) : Float do if d == 0.0 do 1000000000.0 else Math.abs(1.0 /. d) end end
  pfn t_max0(o : Float, d : Float) : Float do
    if d > 0.0 do (Math.floor(o) +. 1.0 -. o) /. d
    else if d < 0.0 do (o -. Math.floor(o)) /. (0.0 -. d)
    else 1000000000.0 end end
  end

  pfn step(w : CubeForge.World.World, x : Int, y : Int, z : Int,
           sx : Int, sy : Int, sz : Int, tmx : Float, tmy : Float, tmz : Float,
           tdx : Float, tdy : Float, tdz : Float, max_t : Float, last_nx : Int, last_ny : Int, last_nz : Int, n : Int) : Hit do
    if n > 256 do miss()
    else if W.solid_at(w, x, y, z) do Hit(true, x, y, z, last_nx, last_ny, last_nz)
    else
      -- advance along the axis whose boundary is nearest
      if tmx < tmy && tmx < tmz do
        if tmx > max_t do miss() else step(w, x + sx, y, z, sx, sy, sz, tmx +. tdx, tmy, tmz, tdx, tdy, tdz, max_t, 0 - sx, 0, 0, n + 1) end
      else if tmy < tmz do
        if tmy > max_t do miss() else step(w, x, y + sy, z, sx, sy, sz, tmx, tmy +. tdy, tmz, tdx, tdy, tdz, max_t, 0, 0 - sy, 0, n + 1) end
      else
        if tmz > max_t do miss() else step(w, x, y, z + sz, sx, sy, sz, tmx, tmy, tmz +. tdz, tdx, tdy, tdz, max_t, 0, 0, 0 - sz, n + 1) end
      end end
    end end
  end

  doc "First solid block along the ray from (ox, oy, oz) in direction (dx, dy, dz), within max_dist."
  fn cast(w : CubeForge.World.World, ox : Float, oy : Float, oz : Float, dx : Float, dy : Float, dz : Float, max_dist : Float) : Hit do
    step(w, float_to_int(Math.floor(ox)), float_to_int(Math.floor(oy)), float_to_int(Math.floor(oz)),
         sign(dx), sign(dy), sign(dz),
         t_max0(ox, dx), t_max0(oy, dy), t_max0(oz, dz),
         t_delta(dx), t_delta(dy), t_delta(dz), max_dist, 0, 0, 0, 0)
  end

end
