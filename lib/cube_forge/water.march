-- Water — finite-spread simulation. Pure step over a `Sim` (chunk + neighbour
-- edge mirrors + dirty queue), wrapped by one `WaterChunk` actor per chunk.
--
-- Actor boundary rules (learned from specs/lang/actors.md, see GAPS.md G44):
-- messages may not carry native arrays, so an actor never receives a chunk. It
-- regenerates its own chunk from (cx, cz, seed) on WLoad, mirrors its four
-- neighbours' edge columns from messages, and replies to WTick with a packed
-- List(Int) of changes the frame loop applies to the world it renders.
--
-- Packed reply entries: kind * 2^32 + payload
--   kind 0  cell change      payload = idx * 256 + id            (idx = x + 16*(z + 16*y))
--   kind 1  edge cell change payload = dir * 2^20 + slot * 256 + id  (neighbour must update its mirror)
--   kind 2  (reserved; spills are pull-based via edge mirrors now)
--   kind 3  more work queued payload = remaining count
-- dir: 0 = -z, 1 = +z, 2 = +x, 3 = -x. slot = x + 16*y for z-edges, z + 16*y for x-edges.
mod CubeForge.Water do

  needs IO.Spawn
  needs IO.Process   -- Env reads for CF_SPRING_RATE and CF_EVAP

  alias CubeForge.Chunk as C

  -- chunk, edge mirrors (4 * 4096), queue ring (65536), queue head, queue count, dirty bitmap (65536),
  -- reply entries queued outside a tick (overflow bounced back by accept_spill), drained by the next tick,
  -- springs: idx of every source ABOVE sea level, marked once per tick so a spring gives exactly spring_rate() a tick
  -- wake: cells to mark at the start of the next tick -- thin cells that survived their evaporation draw
  type Sim = Sim(CubeForge.Chunk.Chunk, NativeU8Arr, NativeIntArr, Int, Int, NativeU8Arr, List(Int), List(Int), List(Int))

  fn kind_cell() : Int do 0 end
  fn kind_edge() : Int do 4294967296 end
  fn kind_spill() : Int do 8589934592 end
  fn kind_pending() : Int do 12884901888 end
  doc "kind 4: water landed in a cell with air beneath it -- a drop's foot, for spray. payload = idx."
  fn kind_drop() : Int do 17179869184 end
  fn max_cells_per_tick() : Int do 250 end
  doc "Units a source may give per processing, summed over its neighbours. A source is a spring, and a spring is a trickle: uncapped it gives 8-16 a tick and no evaporation rate balances that. CF_SPRING_RATE."
  fn spring_rate() : Int do Env.get_int("CF_SPRING_RATE", 1) end
  doc "One in this many processings of a thin, sky-exposed cell evaporates it. CF_EVAP."
  fn evap() : Int do Env.get_int("CF_EVAP", 16) end

  fn new_sim(c : CubeForge.Chunk.Chunk, edges : NativeU8Arr) : Sim do
    Sim(c, edges, NativeArray.make_int(65536, 0), 0, 0, NativeArray.make_u8(65536, 0), Nil, springs_in(c, 0, Nil), Nil)
  end

  fn empty_edges() : NativeU8Arr do NativeArray.make_u8(4 * 4096, 0) end

  -- ── Springs ──────────────────────────────────────────────────────────────────
  -- A source above sea level is a spring. Lake sources (at or below it) are
  -- left to the on-demand rule; there are thousands and they converge.
  pfn is_spring_at(i : Int, id : Int) : Bool do C.is_source(id) && i / 256 > C.sea_level() end
  pfn springs_in(c : CubeForge.Chunk.Chunk, i : Int, acc : List(Int)) : List(Int) do
    if i >= 65536 do acc
    else springs_in(c, i + 1, if is_spring_at(i, C.get_idx(c, i)) do Cons(i, acc) else acc end) end
  end
  pfn springs_upd(sp : List(Int), i : Int, old : Int, new : Int) : List(Int) do
    let was = is_spring_at(i, old)
    let now = is_spring_at(i, new)
    if was == now do sp
    else if now do Cons(i, sp)
    else remove_go(sp, i, Nil) end end
  end
  pfn remove_go(sp : List(Int), i : Int, acc : List(Int)) : List(Int) do
    match sp do
      Nil -> acc
      Cons(j, rest) -> remove_go(rest, i, if j == i do acc else Cons(j, acc) end)
    end
  end
  -- Marked once at the top of every tick, and never by a neighbour (see mark):
  -- that is what makes spring_rate() a per-tick rate rather than a
  -- per-processing one.
  pfn mark_springs(s : Sim, sp : List(Int)) : Sim do
    match sp do
      Nil -> s
      Cons(i, rest) -> mark_springs(mark_force(s, i), rest)
    end
  end

  fn sim_chunk(s : Sim) : CubeForge.Chunk.Chunk do match s do Sim(c, _, _, _, _, _, _, _, _) -> c end end

  doc "Units of water in the chunk: level_of summed over every non-source water cell. Sources are infinite and do not count; this is the conservation invariant."
  fn volume(s : Sim) : Int do volume_go(sim_chunk(s), 0, 0) end
  pfn volume_go(c : CubeForge.Chunk.Chunk, i : Int, acc : Int) : Int do
    if i >= 65536 do acc
    else
      let id = C.get_idx(c, i)
      volume_go(c, i + 1, if C.is_water(id) && !C.is_source(id) do acc + C.level_of(id) else acc end)
    end
  end
  fn pending(s : Sim) : Int do match s do Sim(_, _, _, _, n, _, _, _, _) -> n end end

  -- ── Edge mirrors ─────────────────────────────────────────────────────────────
  fn edge_slot(dir : Int, x : Int, y : Int, z : Int) : Int do
    if dir <= 1 do x + 16 * y else z + 16 * y end
  end
  fn opposite(dir : Int) : Int do int_xor(dir, 1) end

  doc "Copy the neighbour chunk's facing column into the mirror for [dir]."
  fn load_edge(edges : NativeU8Arr, dir : Int, nb : CubeForge.Chunk.Chunk) : NativeU8Arr do
    load_edge_go(edges, dir, nb, 0)
  end
  pfn load_edge_go(edges : NativeU8Arr, dir : Int, nb : CubeForge.Chunk.Chunk, i : Int) : NativeU8Arr do
    if i >= 4096 do edges
    else
      let a = i % 16
      let y = i / 16
      -- the neighbour's cell that touches us: -z neighbour's z = 15 row, +z's z = 0, +x's x = 0, -x's x = 15
      let v = if dir == 0 do C.get(nb, a, y, 15) else if dir == 1 do C.get(nb, a, y, 0)
              else if dir == 2 do C.get(nb, 0, y, a) else C.get(nb, 15, y, a) end end end
      load_edge_go(NativeArray.set_u8(edges, dir * 4096 + i, v), dir, nb, i + 1)
    end
  end

  -- ── Cell access with neighbours ───────────────────────────────────────────────
  pfn cell(c : CubeForge.Chunk.Chunk, edges : NativeU8Arr, x : Int, y : Int, z : Int) : Int do
    if y < 0 do 3 else if y >= 256 do 0
    else if z < 0 do NativeArray.get_u8(edges, 0 * 4096 + x + 16 * y)
    else if z >= 16 do NativeArray.get_u8(edges, 1 * 4096 + x + 16 * y)
    else if x >= 16 do NativeArray.get_u8(edges, 2 * 4096 + z + 16 * y)
    else if x < 0 do NativeArray.get_u8(edges, 3 * 4096 + z + 16 * y)
    else C.get(c, x, y, z) end end end end end end
  end

  fn idx(x : Int, y : Int, z : Int) : Int do x + 16 * (z + 16 * y) end

  -- ── Dirty queue ──────────────────────────────────────────────────────────────
  doc "Mark cell (x, y, z) dirty if it is inside the chunk; deduplicated by the bitmap."
  fn mark(s : Sim, x : Int, y : Int, z : Int) : Sim do
    if x < 0 || x >= 16 || y < 0 || y >= 256 || z < 0 || z >= 16 do s
    else
      match s do
        Sim(c, e, q, qh, qn, bm, po, sp, wk) ->
          let i = idx(x, y, z)
          if NativeArray.get_u8(bm, i) == 1 || qn >= 65536 do Sim(c, e, q, qh, qn, bm, po, sp, wk)
          else if y > C.sea_level() && C.is_source(C.get_idx(c, i)) do Sim(c, e, q, qh, qn, bm, po, sp, wk)   -- springs: only mark_force, once a tick
          else Sim(c, e, NativeArray.set_int(q, (qh + qn) % 65536, i), qh, qn + 1, NativeArray.set_u8(bm, i, 1), po, sp, wk) end end
      end
    end
  end

  -- The queue push without the spring guard: for mark_springs and the wake list.
  pfn mark_force(s : Sim, i : Int) : Sim do
    match s do
      Sim(c, e, q, qh, qn, bm, po, sp, wk) ->
        if NativeArray.get_u8(bm, i) == 1 || qn >= 65536 do s
        else Sim(c, e, NativeArray.set_int(q, (qh + qn) % 65536, i), qh, qn + 1, NativeArray.set_u8(bm, i, 1), po, sp, wk) end
    end
  end
  pfn mark_list(s : Sim, l : List(Int)) : Sim do
    match l do
      Nil -> s
      Cons(i, rest) -> mark_list(mark_force(s, i), rest)
    end
  end

  fn mark_neighbors(s : Sim, x : Int, y : Int, z : Int) : Sim do
    s |> mark(x + 1, y, z) |> mark(x - 1, y, z) |> mark(x, y + 1, z) |> mark(x, y - 1, z) |> mark(x, y, z + 1) |> mark(x, y, z - 1)
  end

  -- ── Writes that also report ───────────────────────────────────────────────────
  -- A step result: the sim plus the packed change list. A variant, not a tuple (GAPS.md G29).
  type Step = Step(Sim, List(Int))
  fn step_sim(st : Step) : Sim do match st do Step(s, _) -> s end end
  fn step_out(st : Step) : List(Int) do match st do Step(_, o) -> o end end

  pfn set_cell(st : Step, x : Int, y : Int, z : Int, id : Int) : Step do
    match st do
      Step(s, out) ->
        match s do
          Sim(c, e, q, qh, qn, bm, po, sp, wk) ->
            let i = idx(x, y, z)
            let s1 = mark_neighbors(Sim(C.set_idx(c, i, id), e, q, qh, qn, bm, po, springs_upd(sp, i, C.get_idx(c, i), id), wk), x, y, z)
            let out1 = Cons(kind_cell() + i * 256 + id, out)
            let out2 = if z == 0 do Cons(kind_edge() + 0 * 1048576 + edge_slot(0, x, y, z) * 256 + id, out1) else out1 end
            let out3 = if z == 15 do Cons(kind_edge() + 1 * 1048576 + edge_slot(1, x, y, z) * 256 + id, out2) else out2 end
            let out4 = if x == 15 do Cons(kind_edge() + 2 * 1048576 + edge_slot(2, x, y, z) * 256 + id, out3) else out3 end
            let out5 = if x == 0 do Cons(kind_edge() + 3 * 1048576 + edge_slot(3, x, y, z) * 256 + id, out4) else out4 end
            Step(s1, out5)
        end
    end
  end

  pfn step_sim_chunk(st : Step) : CubeForge.Chunk.Chunk do sim_chunk(step_sim(st)) end

  -- ── The rules (push) ──────────────────────────────────────────────────────
  -- Water above sea level is a VOLUME: ids 5..11 hold levels 7..1 in units, and
  -- processing a cell moves units out of it -- down first, then sideways across
  -- a difference of at least two. Nothing is created. A source (id 4) is the one
  -- exception: it gives as if it held 8 and is never decremented. That is the
  -- sea, and it is also a spring.
  pfn in_chunk(x : Int, y : Int, z : Int) : Bool do x >= 0 && x < 16 && y >= 0 && y < 256 && z >= 0 && z < 16 end
  -- Which of our four faces a neighbour outside the chunk lies across.
  pfn face_of(x : Int, z : Int) : Int do if z < 0 do 0 else if z >= 16 do 1 else if x >= 16 do 2 else 3 end end end end

  -- Move [u] units from (sx, sy, sz), which holds [l] (8 for a source), into (dx, dy, dz).
  pfn give(st : Step, sx : Int, sy : Int, sz : Int, l : Int, src : Bool, dx : Int, dy : Int, dz : Int, u : Int) : Step do
    if u <= 0 do st
    else
      let st1 = if src do st else set_cell(st, sx, sy, sz, if l - u <= 0 do 0 else C.id_of_level(l - u) end) end
      if in_chunk(dx, dy, dz) do
        let r = C.get(step_sim_chunk(st1), dx, dy, dz)
        if C.is_source(r) do st1                                            -- the sea absorbs it
        else
          let rl = if C.is_water(r) do C.level_of(r) else 0 end
          -- The receiver must be processed next, to fall or spread what it was
          -- given. set_cell marks a written cell's NEIGHBOURS, which covers the
          -- receiver only when the giver is itself written -- and a source never
          -- is. A spring's receivers filled to 7 and then nothing moved again.
          match set_cell(st1, dx, dy, dz, C.id_of_level(if rl + u > 7 do 7 else rl + u end)) do
            Step(s2, o2) ->
              -- Falling onto a cell with nothing under it is a drop: report it
              -- so the frame loop can put spray there.
              -- nested, not &&: it does not short-circuit (GAPS.md G33), and dy - 1 can be -1
              let drop = if dy < sy && dy > 0 do C.get(sim_chunk(s2), dx, dy - 1, dz) == 0 else false end
              Step(mark(s2, dx, dy, dz), if drop do Cons(kind_drop() + idx(dx, dy, dz), o2) else o2 end)
          end
        end
      else if dy < 0 || dy >= 256 do st1
      else
        -- Across an edge: the units leave this chunk in a kind-2 spill. The
        -- neighbour's accept_spill adds them and bounces any overflow back.
        let dir = face_of(dx, dz)
        match st1 do Step(s, out) -> Step(s, Cons(kind_spill() + dir * 1048576 + edge_slot(dir, sx, sy, sz) * 256 + u, out)) end
      end end
    end
  end

  -- Level a horizontal neighbour presents to a giver: air is 0; solids and
  -- sources take nothing sideways (-1 means "skip").
  -- Open to the sky: nothing but air from [y] to the top of the world. Only
  -- thin cells ask, once a tick, so the scan is cheap.
  pfn open_above(c : CubeForge.Chunk.Chunk, e : NativeU8Arr, x : Int, y : Int, z : Int) : Bool do
    if y >= 256 do true else if cell(c, e, x, y, z) != 0 do false else open_above(c, e, x, y + 1, z) end end
  end
  pfn defer(s : Sim, i : Int) : Sim do
    match s do Sim(c, e, q, qh, qn, bm, po, sp, wk) -> Sim(c, e, q, qh, qn, bm, po, sp, Cons(i, wk)) end
  end

  pfn side_level(c : CubeForge.Chunk.Chunk, e : NativeU8Arr, x : Int, y : Int, z : Int) : Int do
    let n = cell(c, e, x, y, z)
    if n == 0 do 0 else if C.is_water(n) && !C.is_source(n) do C.level_of(n) else 0 - 1 end end
  end

  -- Spread sideways from (x, y, z) holding [l]: neighbours in fixed order, each
  -- taking (l - n) / 2 when it is at least two below. Returns the step and the
  -- units left, packed as Step; the remaining level is re-read from the cell.
  pfn spread(st : Step, x : Int, y : Int, z : Int, l : Int, src : Bool, k : Int, cap : Int) : Step do
    if k >= 4 || l < 2 || cap <= 0 do st
    else
      let dx = if k == 0 do 1 else if k == 1 do 0 - 1 else 0 end end
      let dz = if k == 2 do 1 else if k == 3 do 0 - 1 else 0 end end
      let c = step_sim_chunk(st)
      let e = match step_sim(st) do Sim(_, ed, _, _, _, _, _, _, _) -> ed end
      let n = side_level(c, e, x + dx, y, z + dz)
      if n >= 0 && n < l - 1 do
        let u0 = (l - n) / 2
        let u = if u0 > cap do cap else u0 end
        spread(give(st, x, y, z, l, src, x + dx, y, z + dz, u), x, y, z, if src do l else l - u end, src, k + 1, cap - u)
      else spread(st, x, y, z, l, src, k + 1, cap) end
    end
  end

  -- Lakes are infinite: at or below sea level, a cell touching a source (beside it, or
  -- under one) becomes a source itself, so a dug pit connected to a lake fills to the
  -- lake's level. Above sea level only the conserving rule applies.
  pfn source_neighbour(c : CubeForge.Chunk.Chunk, e : NativeU8Arr, x : Int, y : Int, z : Int) : Bool do
    y <= C.sea_level() && (C.is_source(cell(c, e, x + 1, y, z)) || C.is_source(cell(c, e, x - 1, y, z))
      || C.is_source(cell(c, e, x, y, z + 1)) || C.is_source(cell(c, e, x, y, z - 1)) || C.is_source(cell(c, e, x, y + 1, z)))
  end

  -- Process one dirty cell: push its units down, then sideways.
  pfn process(st : Step, x : Int, y : Int, z : Int, salt : Int) : Step do
    let c = step_sim_chunk(st)
    let e = match step_sim(st) do Sim(_, ed, _, _, _, _, _, _, _) -> ed end
    let id = C.get(c, x, y, z)
    if id != 0 && !C.is_water(id) do st
    else if !C.is_source(id) && source_neighbour(c, e, x, y, z) do set_cell(st, x, y, z, C.water())
    else if id == 0 do st
    else
      let src = C.is_source(id)
      let l = if src do 8 else C.level_of(id) end
      -- Evaporation: a thin cell open to the air loses its last unit, one time
      -- in evap(). This is what turns a spring's endless trickle into a brook
      -- of fixed length instead of a valley filling forever, and what dries a
      -- stray puddle. Deterministic: the draw is a hash of the cell and the
      -- queue position, not a clock.
      let thin = !src && l == 1 && open_above(c, e, x, y + 1, z)
      if thin && CubeForge.Noise.hash2(idx(x, y, z), salt, 77) *. int_to_float(evap()) < 1.0 do set_cell(st, x, y, z, 0)
      else
      -- A thin cell that survived is woken next tick -- not re-marked now, or it
      -- would be drawn again and again within this tick and dry in one. One
      -- draw per tick is the rate the knob promises.
      let st = if thin do (match st do Step(s0, o0) -> Step(defer(s0, idx(x, y, z)), o0) end) else st end
      -- fall first
      let cap = if src do spring_rate() else 99 end
      let b = cell(c, e, x, y - 1, z)
      let fell = if b == 0 do (if l > 7 do 7 else l end)
                 else if C.is_source(b) do (if src do 0 else l end)
                 else if C.is_water(b) && C.level_of(b) < 7 do (if l < 7 - C.level_of(b) do l else 7 - C.level_of(b) end)
                 else 0 end end end
      let fell1 = if fell > cap do cap else fell end
      let st1 = give(st, x, y, z, l, src, x, y - 1, z, fell1)
      let left = if src do 8 else l - fell1 end
      spread(st1, x, y, z, left, src, 0, cap - fell1)
      end
    end end end
  end


  -- Pop and process up to [budget] dirty cells.
  pfn run(st : Step, budget : Int) : Step do
    match st do
      Step(s, out) ->
        match s do
          Sim(c, e, q, qh, qn, bm, po, sp, wk) ->
            if budget == 0 || qn == 0 do Step(Sim(c, e, q, qh, qn, bm, po, sp, wk), out)
            else
              let i = NativeArray.get_int(q, qh)
              let s1 = Sim(c, e, q, (qh + 1) % 65536, qn - 1, NativeArray.set_u8(bm, i, 0), po, sp, wk)
              let x = i % 16
              let y = i / 256
              let z = (i / 16) % 16
              run(process(Step(s1, out), x, y, z, qh), budget - 1)
            end
        end
    end
  end

  doc "One tick: process up to max_cells_per_tick dirty cells. Returns the new sim and the packed change list."
  fn tick(s : Sim) : Step do
    -- Entries queued outside a tick (bounced overflow) go out first; accepted
    -- units changed a cell the frame loop has not seen, so report those too.
    let queued = match s do Sim(_, _, _, _, _, _, po, _, _) -> po end
    let sp = springs(s)
    let s0 = match s do Sim(c, e, q, qh, qn, bm, _, _, wk) -> mark_list(mark_springs(Sim(c, e, q, qh, qn, bm, Nil, sp, Nil), sp), wk) end
    match run(Step(s0, queued), max_cells_per_tick()) do
      Step(s1, out) ->
        -- Springs give again next tick and woken cells draw again next tick, so
        -- a chunk holding either must stay flagged even when its queue drained:
        -- the frame loop only ticks flagged chunks, and nothing else would wake it.
        let live = pending(s1) + List.length(sp) + wake_count(s1)
        Step(s1, if live > 0 do Cons(kind_pending() + live, out) else out end)
    end
  end
  pfn wake_count(s : Sim) : Int do match s do Sim(_, _, _, _, _, _, _, _, wk) -> List.length(wk) end end
  doc "Springs above sea level in this chunk, for the frame loop and tests."
  fn springs(s : Sim) : List(Int) do match s do Sim(_, _, _, _, _, _, _, sp, _) -> sp end end

  doc "A neighbour pushed [u] units across the edge facing [dir] into our cell at [slot]. Add them, capped at 7; any overflow goes straight back as a spill the other way, queued for our next reply, so no unit is ever lost to a stale mirror."
  fn accept_spill(s : Sim, dir : Int, slot : Int, u : Int) : Sim do
    let a = slot % 16
    let y = slot / 16
    let x = if dir == 2 do 15 else if dir == 3 do 0 else a end end
    let z = if dir == 0 do 0 else if dir == 1 do 15 else a end end
    match s do
      Sim(c, e, q, qh, qn, bm, po, sp, wk) ->
        let id = C.get(c, x, y, z)
        if C.is_source(id) do s                                   -- the sea absorbs it
        else if id != 0 && !C.is_water(id) do
          -- solid on our side (the giver's mirror was stale): send it all back
          Sim(c, e, q, qh, qn, bm, Cons(kind_spill() + dir * 1048576 + slot * 256 + u, po), sp, wk)
        else
          let have = if id == 0 do 0 else C.level_of(id) end
          let room = 7 - have
          let take = if u < room do u else room end
          let po1 = if u > take do Cons(kind_spill() + dir * 1048576 + slot * 256 + (u - take), po) else po end
          let c1 = if take > 0 do C.set(c, x, y, z, C.id_of_level(have + take)) else c end
          mark(mark_neighbors(Sim(c1, e, q, qh, qn, bm, po1, sp, wk), x, y, z), x, y, z)
        end end
    end
  end

  doc "A neighbour's edge cell changed: update the mirror for [dir] and mark our adjacent cell dirty."
  fn edge_changed(s : Sim, dir : Int, slot : Int, id : Int) : Sim do
    match s do
      Sim(c, e, q, qh, qn, bm, po, sp, wk) ->
        let a = slot % 16
        let y = slot / 16
        let x = if dir == 2 do 15 else if dir == 3 do 0 else a end end
        let z = if dir == 0 do 0 else if dir == 1 do 15 else a end end
        mark(Sim(c, NativeArray.set_u8(e, dir * 4096 + slot, id), q, qh, qn, bm, po, sp, wk), x, y, z)
    end
  end

  doc "The player edited cell [i] to [id]: set it and mark it and its neighbours dirty."
  fn edited(s : Sim, i : Int, id : Int) : Sim do
    let x = i % 16
    let y = i / 256
    let z = (i / 16) % 16
    match s do
      Sim(c, e, q, qh, qn, bm, po, sp, wk) -> mark(mark_neighbors(Sim(C.set_idx(c, i, id), e, q, qh, qn, bm, po, springs_upd(sp, i, C.get_idx(c, i), id), wk), x, y, z), x, y, z)
    end
  end

  -- ── The actor ────────────────────────────────────────────────────────────────
  type WTickReq = WTickReq

  -- Handler bodies live here (the actor lint asks handlers to delegate).
  pfn handle_tick(reply_to, s : Sim) : Sim do
    match tick(s) do
      Step(s1, out) ->
        Actor.reply(reply_to, out)
        s1
    end
  end

  pfn load_sim(cx : Int, cz : Int, n : Int, seed : Int) : Sim do
    let c = C.generate(16 * cx, 16 * cz, seed)
    let nb = fn (x, z) -> if x >= 0 && x < n && z >= 0 && z < n do C.generate(16 * x, 16 * z, seed) else C.new() end
    let e0 = load_edge(empty_edges(), 0, nb(cx, cz - 1))
    let e1 = load_edge(e0, 1, nb(cx, cz + 1))
    let e2 = load_edge(e1, 2, nb(cx + 1, cz))
    new_sim(c, load_edge(e2, 3, nb(cx - 1, cz)))
  end

  actor WaterChunk do
    state { sim : Sim, cx : Int, cz : Int }
    init { sim: new_sim(C.new(), empty_edges()), cx: 0, cz: 0 }

    -- call handler first (tag 0): run one tick, reply with the packed change list
    on WTick(reply_to) do
      { state with sim: handle_tick(reply_to, state.sim) }
    end

    -- regenerate this chunk and its neighbours' edge columns from the seed
    on WLoad(cx : Int, cz : Int, n : Int, seed : Int) do
      { sim: load_sim(cx, cz, n, seed), cx: cx, cz: cz }
    end

    on WEdited(i : Int, id : Int) do
      { state with sim: edited(state.sim, i, id) }
    end

    on WSpill(dir : Int, slot : Int, level : Int) do
      { state with sim: accept_spill(state.sim, dir, slot, level) }
    end

    on WEdgeCell(dir : Int, slot : Int, id : Int) do
      { state with sim: edge_changed(state.sim, dir, slot, id) }
    end
  end

  -- Message constructors are only in scope inside this module (GAPS.md G46), and only AFTER the actor declaration in file order, so the
  -- frame loop drives the actor through these wrappers.
  fn spawn_chunk() do spawn(WaterChunk) end
  fn send_load(pid, cx : Int, cz : Int, n : Int, seed : Int) : Unit do
    let _ = send(pid, WLoad(cx, cz, n, seed))
    ()
  end
  fn send_edited(pid, i : Int, id : Int) : Unit do
    let _ = send(pid, WEdited(i, id))
    ()
  end
  fn send_spill(pid, dir : Int, slot : Int, level : Int) : Unit do
    let _ = send(pid, WSpill(dir, slot, level))
    ()
  end
  fn send_edge_cell(pid, dir : Int, slot : Int, id : Int) : Unit do
    let _ = send(pid, WEdgeCell(dir, slot, id))
    ()
  end
  doc "Run one tick on the actor and return its packed change list."
  fn call_tick(pid) : Result(List(Int), String) do Actor.call(pid, WTickReq, 2000) end


end
