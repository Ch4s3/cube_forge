-- Biome — a derived, mutable climate field, one entry per world column.
--
-- Temperature and moisture (the Whittaker pair) plus an elevation gate. The
-- field is recomputed WHOLE every tick: 16,384 columns is small enough that the
-- light field's incremental machinery would be waste, and it means a player
-- edit needs no special handling anywhere.
mod CubeForge.Biome do

  alias CubeForge.Noise as N

  -- height, water flag, eased temperature, eased moisture, biome id, hold counter, temperature base
  -- The base is the seeded noise octave per column: it never changes, so it is
  -- computed once at build rather than 16,384 times per tick.
  type Field = Field(NativeU8Arr, NativeU8Arr, NativeFloatArr, NativeFloatArr, NativeU8Arr, NativeU8Arr, NativeFloatArr)

  doc "Biome ids. The order is the Whittaker table read row by row, then the two gated ones."
  fn b_tundra() : Int do 0 end
  fn b_taiga() : Int do 1 end
  fn b_grassland() : Int do 2 end
  fn b_forest() : Int do 3 end
  fn b_desert() : Int do 4 end
  fn b_wetland() : Int do 5 end
  fn b_beach() : Int do 6 end
  fn b_alpine() : Int do 7 end

  fn name(id : Int) : String do
    if id == 0 do "tundra" else if id == 1 do "taiga" else if id == 2 do "grassland"
    else if id == 3 do "forest" else if id == 4 do "desert" else if id == 5 do "wetland"
    else if id == 6 do "beach" else "alpine" end end end end end end end
  end

  doc "Columns from water at which moisture reaches zero."
  fn reach() : Int do 24 end
  doc "Temperature lost per block above sea level."
  fn lapse() : Float do 0.012 end
  doc "Surface height at and above which a column is alpine, whatever the axes say."
  fn alpine_line() : Int do 95 end
  doc "Columns beside water this low are beach."
  fn beach_max_height() : Int do 64 end

  pfn clamp01(v : Float) : Float do if v < 0.0 do 0.0 else if v > 1.0 do 1.0 else v end end end

  doc "Moisture 0..1 for a column [dist] away from the nearest water: linear, zero at the reach."
  fn moisture_target(dist : Int) : Float do
    clamp01(1.0 -. int_to_float(dist) /. int_to_float(reach()))
  end

  doc "Temperature 0..1: one low-frequency octave (regions, not noise -- see Noise.ruggedness for why one octave), minus the lapse for height above sea level."
  fn temp_target(wx : Int, wz : Int, seed : Int, h : Int) : Float do
    temp_from_base(temp_base(wx, wz, seed), h)
  end
  doc "The seeded octave alone, before the lapse: what the field caches."
  fn temp_base(wx : Int, wz : Int, seed : Int) : Float do
    N.value2(int_to_float(wx) *. 0.018, int_to_float(wz) *. 0.018, seed + 1700)
  end
  fn temp_from_base(base : Float, h : Int) : Float do
    clamp01(base -. lapse() *. int_to_float(h - N.sea_level()))
  end

  doc "The Whittaker lookup with two gates in front of it. Thresholds: cold below 0.33, hot from 0.66; damp from 0.5."
  fn classify(temp : Float, moist : Float, h : Int, dist_water : Int) : Int do
    if h >= alpine_line() do b_alpine()
    else if dist_water <= 1 && h <= beach_max_height() do b_beach()
    else
      let damp = moist >= 0.5
      if temp < 0.33 do (if damp do b_taiga() else b_tundra() end)
      else if temp < 0.66 do (if damp do b_forest() else b_grassland() end)
      else (if damp do b_wetland() else b_desert() end) end end
    end end
  end


  alias CubeForge.World as W
  alias CubeForge.Chunk as C

  fn cols(w : CubeForge.World.World) : Int do W.side(w) * 16 end

  -- Highest non-air block in a column, scanning down from [top]. 0 if none.
  pfn surface_go(w : CubeForge.World.World, wx : Int, wz : Int, y : Int) : Int do
    if y <= 0 do 0
    else if W.block_at(w, wx, y, wz) != 0 do y
    else surface_go(w, wx, wz, y - 1) end end
  end

  -- Water at the surface, or one above it.
  pfn wet_at(w : CubeForge.World.World, wx : Int, wz : Int, h : Int) : Bool do
    C.is_water(W.block_at(w, wx, h, wz)) || C.is_water(W.block_at(w, wx, h + 1, wz))
  end

  pfn scan_go(w : CubeForge.World.World, n : Int, top : Int, i : Int,
              hs : NativeU8Arr, ws : NativeU8Arr) : Field do
    if i >= n * n do Field(hs, ws, NativeArray.make_float(n * n, 0.0), NativeArray.make_float(n * n, 0.0), NativeArray.make_u8(n * n, 0), NativeArray.make_u8(n * n, 0), NativeArray.make_float(n * n, 0.0))
    else
      let h = surface_go(w, i % n, i / n, top)
      scan_go(w, n, top, i + 1, NativeArray.set_u8(hs, i, h), NativeArray.set_u8(ws, i, if wet_at(w, i % n, i / n, h) do 1 else 0 end))
    end
  end

  -- ── Distance to water: a level sweep, the light-field idiom ─────────────
  -- Not a queue. A queue and its distance array wrapped in a cell gave both a
  -- refcount of 2, so every push copied 640 KB: twenty passes cost 10.8 GB
  -- (GAPS G68). This is level_go from light.march instead: one array, threaded
  -- through every write, never wrapped, reads borrowed. Level lv marks the
  -- unvisited 8-neighbours of every column at distance lv as lv + 1. Edges are
  -- unit cost, so the first visit is the exact Chebyshev distance. Unvisited
  -- columns keep reach(), which is also the cap -- the two are the same value.
  pfn seed_go(ws : NativeU8Arr, n : Int, i : Int, d : NativeU8Arr) : NativeU8Arr do
    if i >= n * n do d
    else if NativeArray.get_u8(ws, i) == 1 do seed_go(ws, n, i + 1, NativeArray.set_u8(d, i, 0))
    else seed_go(ws, n, i + 1, d) end end
  end

  -- dx, dz for neighbour k of 8: the 3x3 ring minus the centre, row by row.
  pfn ndx(k : Int) : Int do
    let kk = if k >= 4 do k + 1 else k end
    kk % 3 - 1
  end
  pfn ndz(k : Int) : Int do
    let kk = if k >= 4 do k + 1 else k end
    kk / 3 - 1
  end

  -- Mark the unvisited neighbours of (x, z) with [nd].
  pfn mark8(d : NativeU8Arr, n : Int, x : Int, z : Int, nd : Int, k : Int) : NativeU8Arr do
    if k >= 8 do d
    else
      let nx = x + ndx(k)
      let nz = z + ndz(k)
      if nx < 0 || nz < 0 || nx >= n || nz >= n do mark8(d, n, x, z, nd, k + 1)
      else
        let j = nx + n * nz
        if NativeArray.get_u8(d, j) == reach() do mark8(NativeArray.set_u8(d, j, nd), n, x, z, nd, k + 1)
        else mark8(d, n, x, z, nd, k + 1) end
      end
    end
  end

  pfn level_go(d : NativeU8Arr, n : Int, lv : Int, i : Int) : NativeU8Arr do
    if i >= n * n do d
    else if NativeArray.get_u8(d, i) != lv do level_go(d, n, lv, i + 1)
    else level_go(mark8(d, n, i % n, i / n, lv + 1, 0), n, lv, i + 1) end end
  end

  pfn sweep_go(d : NativeU8Arr, n : Int, lv : Int) : NativeU8Arr do
    if lv >= reach() - 1 do d
    else sweep_go(level_go(d, n, lv, 0), n, lv + 1) end
  end

  doc "Chebyshev distance to the nearest water column, capped at reach(). A fresh array every call, threaded through every write (GAPS G68)."
  fn distances(f : Field, w : CubeForge.World.World) : NativeU8Arr do
    let n = cols(w)
    match f do
      Field(_, ws, _, _, _, _, _) -> sweep_go(seed_go(ws, n, 0, NativeArray.make_u8(n * n, reach())), n, 0)
    end
  end

  -- Classify every column from its targets, writing the eased axes AT target
  -- (a fresh world starts fully classified; easing is for changes).
  -- Sources arrive as plain parameters, matched out of the Field ONCE by the
  -- caller: destructuring the variant inside the loop re-bumps every inner
  -- array's refcount per iteration, which is what level_go in light.march
  -- avoids and what turned each write into a whole-array copy here.
  pfn classify_all(hs : NativeU8Arr, seed : Int, d : NativeU8Arr, n : Int, i : Int,
                   ta : NativeFloatArr, ma : NativeFloatArr, bs : NativeU8Arr, tb : NativeFloatArr) : Field do
    if i >= n * n do Field(hs, NativeArray.make_u8(0, 0), ta, ma, bs, NativeArray.make_u8(n * n, 0), tb)
    else
      let h = NativeArray.get_u8(hs, i)
      let dist = NativeArray.get_u8(d, i)
      let base = temp_base(i % n, i / n, seed)
      let t = temp_from_base(base, h)
      let m = moisture_target(dist)
      let b = classify(t, m, h, dist)
      classify_all(hs, seed, d, n, i + 1, NativeArray.set_float(ta, i, t), NativeArray.set_float(ma, i, m), NativeArray.set_u8(bs, i, b), NativeArray.set_float(tb, i, base))
    end
  end

  doc "Build the field from a world: scan every column's surface and water, then classify."
  fn build(w : CubeForge.World.World, seed : Int) : Field do
    let n = cols(w)
    let f0 = scan_go(w, n, CubeForge.Light.sky_floor(w), 0, NativeArray.make_u8(n * n, 0), NativeArray.make_u8(n * n, 0))
    let d = distances(f0, w)
    match f0 do
      Field(hs, ws, _, _, _, _, _) ->
        match classify_all(hs, seed, d, n, 0, NativeArray.make_float(n * n, 0.0), NativeArray.make_float(n * n, 0.0), NativeArray.make_u8(n * n, 0), NativeArray.make_float(n * n, 0.0)) do
          Field(hs1, _, ta, ma, bs, hold, tb) -> Field(hs1, ws, ta, ma, bs, hold, tb)
        end
    end
  end

  fn height_of(f : Field, wx : Int, wz : Int) : Int do
    match f do Field(hs, _, _, _, _, _, _) -> NativeArray.get_u8(hs, wx + 128 * wz) end
  end
  fn biome_of(f : Field, wx : Int, wz : Int) : Int do
    match f do Field(_, _, _, _, bs, _, _) -> NativeArray.get_u8(bs, wx + 128 * wz) end
  end
  fn field_biomes(f : Field) : NativeU8Arr do match f do Field(_, _, _, _, bs, _, _) -> bs end end


  fn default_rate() : Float do 1.0 /. 10800.0 end
  fn hold_ticks() : Int do 30 end

  pfn copy_go(src : NativeU8Arr, dst : NativeU8Arr, i : Int, n : Int) : NativeU8Arr do
    if i >= n do dst else copy_go(src, NativeArray.set_u8(dst, i, NativeArray.get_u8(src, i)), i + 1, n) end
  end
  pfn copy_u8(a : NativeU8Arr, n : Int) : NativeU8Arr do copy_go(a, NativeArray.make_u8(n, 0), 0, n) end

  doc "A block changed at (x, y, z). Only that column's surface and water flag can change, and only if the edit is at or above the current surface -- O(1) apart from the copy the Scene's shared reference forces (GAPS G68)."
  fn note_edit(f : Field, w : CubeForge.World.World, x : Int, y : Int, z : Int, id : Int) : Field do
    let n = cols(w)
    if x < 0 || z < 0 || x >= n || z >= n do f
    else
      match f do
        Field(hs, ws, ta, ma, bs, hold, tb) ->
          let i = x + n * z
          let cur = NativeArray.get_u8(hs, i)
          let h1 = if y > cur && id != 0 do y
                   else if y == cur && id == 0 do surface_go(w, x, z, y - 1)
                   else cur end end
          let hs1 = NativeArray.set_u8(copy_u8(hs, n * n), i, h1)
          let ws1 = NativeArray.set_u8(copy_u8(ws, n * n), i, if wet_at(w, x, z, h1) do 1 else 0 end)
          Field(hs1, ws1, ta, ma, bs, hold, tb)
      end
    end
  end

  pfn ease(cur : Float, target : Float, rate : Float) : Float do
    let d = target -. cur
    if d > rate do cur +. rate else if d < 0.0 -. rate do cur -. rate else target end end
  end

  pfn tick_go(hs : NativeU8Arr, ta0 : NativeFloatArr, ma0 : NativeFloatArr, bs0 : NativeU8Arr, hold0 : NativeU8Arr, tb : NativeFloatArr,
              seed : Int, rate : Float, d : NativeU8Arr, n : Int, i : Int,
              ta : NativeFloatArr, ma : NativeFloatArr, bs : NativeU8Arr, hold : NativeU8Arr) : Field do
    if i >= n * n do Field(hs, NativeArray.make_u8(0, 0), ta, ma, bs, hold, tb)
    else
      let h = NativeArray.get_u8(hs, i)
      let dist = NativeArray.get_u8(d, i)
      let t = ease(NativeArray.get_float(ta0, i), temp_from_base(NativeArray.get_float(tb, i), h), rate)
      let m = ease(NativeArray.get_float(ma0, i), moisture_target(dist), rate)
      let raw = classify(t, m, h, dist)
      let cur = NativeArray.get_u8(bs0, i)
      -- The hold counter: flip only after hold_ticks() consecutive disagreements,
      -- so a column parked on a threshold cannot alternate every tick.
      let hc = if raw == cur do 0 else NativeArray.get_u8(hold0, i) + 1 end
      let b1 = if hc >= hold_ticks() do raw else cur end
      let hc1 = if b1 == raw do 0 else hc end
      tick_go(hs, ta0, ma0, bs0, hold0, tb, seed, rate, d, n, i + 1,
              NativeArray.set_float(ta, i, t), NativeArray.set_float(ma, i, m),
              NativeArray.set_u8(bs, i, b1), NativeArray.set_u8(hold, i, hc1))
    end
  end


  -- Water moves on its own (the water actors spread it every tick), so the
  -- water flag is rescanned whole every tick rather than hooked at each edit:
  -- two reads per column off the heightmap, 32k reads, and no site can forget.
  pfn water_go(w : CubeForge.World.World, hs : NativeU8Arr, n : Int, i : Int, ws : NativeU8Arr) : NativeU8Arr do
    if i >= n * n do ws
    else water_go(w, hs, n, i + 1, NativeArray.set_u8(ws, i, if wet_at(w, i % n, i / n, NativeArray.get_u8(hs, i)) do 1 else 0 end)) end
  end

  doc "Rescan the surface of every column in the (2r+1)-square around (x, z): for edits that change many columns at once, such as leaf decay."
  fn rescan_box(f : Field, w : CubeForge.World.World, x : Int, z : Int, r : Int) : Field do
    let n = cols(w)
    match f do
      Field(hs, ws, ta, ma, bs, hold, tb) ->
        Field(box_go(w, n, CubeForge.Light.sky_floor(w), x - r, z - r, x + r, z + r, x - r, z - r, copy_u8(hs, n * n)), ws, ta, ma, bs, hold, tb)
    end
  end
  pfn box_go(w : CubeForge.World.World, n : Int, top : Int, x0 : Int, z0 : Int, x1 : Int, z1 : Int, x : Int, z : Int, hs : NativeU8Arr) : NativeU8Arr do
    if z > z1 do hs
    else if x > x1 do box_go(w, n, top, x0, z0, x1, z1, x0, z + 1, hs)
    else if x < 0 || z < 0 || x >= n || z >= n do box_go(w, n, top, x0, z0, x1, z1, x + 1, z, hs)
    else box_go(w, n, top, x0, z0, x1, z1, x + 1, z, NativeArray.set_u8(hs, x + n * z, surface_go(w, x, z, top))) end end end
  end

  doc "One tick: rescan water, recompute distances, ease both axes toward their targets by [rate], reclassify behind the hold counter. Writes fresh arrays."
  fn tick(f : Field, w : CubeForge.World.World, seed : Int, rate : Float) : Field do
    let n = cols(w)
    let f1 = match f do Field(hs, _, ta, ma, bs, hold, tb) -> Field(hs, water_go(w, hs, n, 0, NativeArray.make_u8(n * n, 0)), ta, ma, bs, hold, tb) end
    let d = distances(f1, w)
    match f1 do
      Field(hs, ws, ta0, ma0, bs0, hold0, tb) ->
        match tick_go(hs, ta0, ma0, bs0, hold0, tb, seed, rate, d, n, 0,
                      NativeArray.make_float(n * n, 0.0), NativeArray.make_float(n * n, 0.0),
                      NativeArray.make_u8(n * n, 0), NativeArray.make_u8(n * n, 0)) do
          Field(hs1, _, ta, ma, bs, hold, tb1) -> Field(hs1, ws, ta, ma, bs, hold, tb1)
        end
    end
  end


  doc "Eased temperature / moisture / water flag / distance-cap for one column, for diagnostics."
  fn debug_axes(f : Field, wx : Int, wz : Int) : String do
    match f do
      Field(_, ws, ta, ma, _, _, _) ->
        let i = wx + 128 * wz
        "temp " ++ float_to_string(NativeArray.get_float(ta, i)) ++ " moist " ++ float_to_string(NativeArray.get_float(ma, i)) ++ " wet " ++ int_to_string(NativeArray.get_u8(ws, i))
    end
  end

end
