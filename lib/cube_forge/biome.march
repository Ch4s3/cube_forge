-- Biome — a derived, mutable climate field, one entry per world column.
--
-- Temperature and moisture (the Whittaker pair) plus an elevation gate. The
-- field is recomputed WHOLE every tick: 16,384 columns is small enough that the
-- light field's incremental machinery would be waste, and it means a player
-- edit needs no special handling anywhere.
mod CubeForge.Biome do

  alias CubeForge.Noise as N

  -- height, water flag, eased temperature, eased moisture, biome id, hold counter,
  -- temperature base, distance to water, active flag
  -- The base is the seeded noise octave per column: it never changes, so it is
  -- computed once at build rather than 16,384 times per tick.
  --
  -- The last two carry the tick's dirty set. A column is ACTIVE when something
  -- could still change there: an edit moved its surface, its distance to water
  -- moved, or it is part-way through easing. Everything else is settled -- both
  -- axes exactly at target and the classification agreed -- and a settled column
  -- cannot change until one of those wakes it. Keeping the distances from the
  -- previous tick is what makes the moisture half of that test a comparison
  -- rather than a recomputation.
  type Field = Field(NativeU8Arr, NativeU8Arr, NativeFloatArr, NativeFloatArr, NativeU8Arr, NativeU8Arr, NativeFloatArr, NativeU8Arr, NativeU8Arr)

  doc "Biome ids. The order is the Whittaker table read row by row, then the two gated ones."
  fn b_tundra() : Int do 0 end
  fn b_taiga() : Int do 1 end
  fn b_grassland() : Int do 2 end
  fn b_forest() : Int do 3 end
  fn b_desert() : Int do 4 end
  fn b_wetland() : Int do 5 end
  fn b_beach() : Int do 6 end
  fn b_alpine() : Int do 7 end
  doc "Hot and damp beside a SMALL body of water: a well in the desert, ringed by palms."
  fn b_oasis() : Int do 8 end
  doc "Ground the mycelium network holds outright: established in five of nine columns."
  fn b_grove() : Int do 9 end
  fn count() : Int do 10 end

  fn name(id : Int) : String do
    if id == 0 do "tundra" else if id == 1 do "taiga" else if id == 2 do "grassland"
    else if id == 3 do "forest" else if id == 4 do "desert" else if id == 5 do "wetland"
    else if id == 6 do "beach" else if id == 7 do "alpine" else if id == 8 do "oasis" else "grove" end end end end end end end end end
  end

  doc "Columns from water at which moisture reaches zero."
  fn reach() : Int do 24 end
  doc "Temperature lost per block above sea level (Noise.lapse: the height paths read the same climate)."
  fn lapse() : Float do N.lapse() end
  doc "Surface height at and above which a column is alpine, whatever the axes say."
  fn alpine_line() : Int do 95 end
  doc "Columns beside water this low are beach."
  fn beach_max_height() : Int do 64 end
  doc "A body of water at or under this many columns is small: a pool or a brook, not a lake or the sea."
  fn small_body() : Int do 48 end
  doc "Columns from a small body at which moisture reaches zero. A well in the desert wets a ring, not a marsh."
  fn small_reach() : Int do 4 end
  doc "The distance byte's top bit: set when the nearest water is a small body. Distances stay under 128."
  fn small_bit() : Int do 128 end
  doc "Vigour at and above which a column counts as established for the grove: the fruiting line."
  fn grove_vigour() : Float do CubeForge.Myc.fruit_vigour() end
  doc "Established columns in a 3x3 (itself included) that make a grove: one column inside the patch's edge."
  fn grove_neighbours() : Int do 5 end
  doc "A distance byte saying the kept distances no longer match the water flags: an edit moved a flag since the last sweep. Never produced by the sweep itself (distances stay under 128 and the flag adds 128, so 255 is free)."
  fn stale() : Int do 255 end
  doc "The distance in a distance byte."
  fn dist_of(v : Int) : Int do v % 128 end
  doc "Whether a distance byte says the nearest water is small."
  fn is_small(v : Int) : Bool do v >= 128 end

  pfn clamp01(v : Float) : Float do if v < 0.0 do 0.0 else if v > 1.0 do 1.0 else v end end end

  doc "Moisture 0..1 for a column [dist] away from a large body of water: linear, zero at the reach."
  fn moisture_target(dist : Int) : Float do
    clamp01(1.0 -. int_to_float(dist) /. int_to_float(reach()))
  end
  doc "Moisture 0..1 from a distance byte: the large-body curve, or the small_reach() curve when the small bit is set."
  fn moisture_target_of(v : Int) : Float do
    let r = if is_small(v) do small_reach() else reach() end
    clamp01(1.0 -. int_to_float(dist_of(v)) /. int_to_float(r))
  end

  doc "Temperature 0..1: one low-frequency octave (regions, not noise -- see Noise.ruggedness for why one octave), minus the lapse for height above sea level. Noise.temperature, so the generator's dunes and glaciers read the climate the field will have."
  fn temp_target(wx : Int, wz : Int, seed : Int, h : Int) : Float do N.temperature(wx, wz, seed, h) end
  doc "The seeded octave alone, before the lapse: what the field caches."
  fn temp_base(wx : Int, wz : Int, seed : Int) : Float do N.temp_base(wx, wz, seed) end
  fn temp_from_base(base : Float, h : Int) : Float do N.temp_from_base(base, int_to_float(h)) end

  doc "The Whittaker lookup with the gates in front of it, for a column with no small water and no network. Thresholds: cold below 0.33, hot from 0.66; damp from 0.5."
  fn classify(temp : Float, moist : Float, h : Int, dist_water : Int) : Int do
    classify_full(temp, moist, h, dist_water, false, false)
  end

  doc """
  The full lookup. Gates in order: grove (the network is established here,
  whatever else is true), alpine, oasis (hot, damp, and the nearest water is a
  small body -- before beach, so a low pool rim in the desert is palms, not
  sand), beach, then the Whittaker table.
  """
  fn classify_full(temp : Float, moist : Float, h : Int, dist_water : Int, small : Bool, grove : Bool) : Int do
    let damp = moist >= 0.5
    if grove do b_grove()
    else if h >= alpine_line() do b_alpine()
    else if temp >= 0.66 && damp && small do b_oasis()
    else if dist_water <= 1 && h <= beach_max_height() do b_beach()
    else
      if temp < 0.33 do (if damp do b_taiga() else b_tundra() end)
      else if temp < 0.66 do (if damp do b_forest() else b_grassland() end)
      else (if damp do b_wetland() else b_desert() end) end end
    end end end end
  end


  alias CubeForge.World as W
  alias CubeForge.Chunk as C

  fn cols(w : CubeForge.World.World) : Int do W.side(w) * 16 end

  doc """
  The stride the Field's accessors index by. The field is allocated at the
  world's runtime size (cols(w) above); this is the compile-time width the
  accessors are written against, and world_size_test asserts they agree. It is a
  literal for the same reason Light.index's bounds are -- see World.cols.
  """
  fn stride() : Int do 192 end
  -- Every accessor indexes by side_of, NOT by stride: a field built for a
  -- narrower world (a test's eight chunks, a smaller save) is narrower, and
  -- reading it at the compile-time width lands on the wrong column. Three
  -- readers -- water_dist_at, water_reach_at and trend_at -- used stride and
  -- were correct only while it happened to equal the world's own width. Widening
  -- the window to twelve chunks made them read eight columns off, which showed
  -- up as a pond that fish could not find.
  doc "The width of a field from one of its arrays: the world's columns per side. The accessors index by this, so a field built for a 64-wide world reads right."
  fn side_of(hs : NativeU8Arr) : Int do float_to_int(Math.sqrt(int_to_float(NativeArray.length_u8(hs))) +. 0.5) end

  -- Highest non-air block in a column, scanning down from [top]. 0 if none.
  pfn surface_go(w : CubeForge.World.World, wx : Int, wz : Int, y : Int) : Int do
    if y <= 0 do 0
    else if W.block_at(w, wx, y, wz) != 0 do y
    else surface_go(w, wx, wz, y - 1) end end
  end

  -- Water at the surface, or one above it.
  pfn wet_at(w : CubeForge.World.World, wx : Int, wz : Int, h : Int) : Bool do
    C.is_water(W.block_at(w, wx, h, wz)) || C.is_water(W.block_at(w, wx, h + 1, wz))
  end

  pfn scan_go(w : CubeForge.World.World, n : Int, top : Int, i : Int,
              hs : NativeU8Arr, ws : NativeU8Arr) : Field do
    if i >= n * n do Field(hs, ws, NativeArray.make_float(n * n, 0.0), NativeArray.make_float(n * n, 0.0), NativeArray.make_u8(n * n, 0), NativeArray.make_u8(n * n, 0), NativeArray.make_float(n * n, 0.0), NativeArray.make_u8(n * n, reach()), NativeArray.make_u8(n * n, 0))
    else
      let h = surface_go(w, i % n, i / n, top)
      scan_go(w, n, top, i + 1, NativeArray.set_u8(hs, i, h), NativeArray.set_u8(ws, i, if wet_at(w, i % n, i / n, h) do 1 else 0 end))
    end
  end

  -- ── Distance to water: a level sweep, the light-field idiom ─────────────
  -- Not a queue. A queue and its distance array wrapped in a cell gave both a
  -- refcount of 2, so every push copied 640 KB: twenty passes cost 10.8 GB
  -- (GAPS G68). This is level_go from light.march instead: one array, threaded
  -- through every write, never wrapped, reads borrowed. Level lv marks the
  -- unvisited 8-neighbours of every column at distance lv as lv + 1. Edges are
  -- unit cost, so the first visit is the exact Chebyshev distance. Unvisited
  -- columns keep reach(), which is also the cap -- the two are the same value.
  -- ── Water bodies: connected components of the water flags ───────────────
  -- lab: NativeIntArr(n * n + 1). A water column starts as its own index + 1,
  -- every other column 0, and slot n * n counts the writes of the current
  -- round. A round is min-propagation (each water column takes the least label
  -- in its 3x3) then pointer jumping (lab[i] = lab[lab[i] - 1]); rounds run
  -- until one writes nothing, and every body then carries its least column
  -- index. One threaded array, reads before the write (the mark8 shape): a
  -- queue is out (GAPS G63), and pointer jumping keeps the rounds to a handful
  -- even for the sea.
  pfn label_seed_go(ws : NativeU8Arr, n : Int, i : Int, lab : NativeIntArr) : NativeIntArr do
    if i >= n * n do lab
    else if NativeArray.get_u8(ws, i) == 1 do label_seed_go(ws, n, i + 1, NativeArray.set_int(lab, i, i + 1))
    else label_seed_go(ws, n, i + 1, lab) end end
  end
  pfn min8_go(lab : NativeIntArr, n : Int, x : Int, z : Int, k : Int, best : Int) : Int do
    if k >= 8 do best
    else
      let nx = x + ndx(k)
      let nz = z + ndz(k)
      if nx < 0 || nz < 0 || nx >= n || nz >= n do min8_go(lab, n, x, z, k + 1, best)
      else
        let l = NativeArray.get_int(lab, nx + n * nz)
        min8_go(lab, n, x, z, k + 1, if l != 0 && l < best do l else best end)
      end
    end
  end
  pfn relabel_go(lab : NativeIntArr, n : Int, i : Int) : NativeIntArr do
    if i >= n * n do lab
    else
      let l = NativeArray.get_int(lab, i)
      if l == 0 do relabel_go(lab, n, i + 1)
      else
        let m = min8_go(lab, n, i % n, i / n, 0, l)
        if m < l do
          let c = NativeArray.get_int(lab, n * n)
          relabel_go(NativeArray.set_int(NativeArray.set_int(lab, i, m), n * n, c + 1), n, i + 1)
        else relabel_go(lab, n, i + 1) end
      end
    end
  end
  pfn jump_go(lab : NativeIntArr, n : Int, i : Int) : NativeIntArr do
    if i >= n * n do lab
    else
      let l = NativeArray.get_int(lab, i)
      if l == 0 do jump_go(lab, n, i + 1)
      else
        let r = NativeArray.get_int(lab, l - 1)
        if r < l do
          let c = NativeArray.get_int(lab, n * n)
          jump_go(NativeArray.set_int(NativeArray.set_int(lab, i, r), n * n, c + 1), n, i + 1)
        else jump_go(lab, n, i + 1) end
      end
    end
  end
  -- The same pass scanned backward: the forward pass carries a label toward
  -- +x and +z within one pass, the backward one toward -x and -z, so a body
  -- without holes settles in a round or two rather than one per column of span.
  pfn relabel_back_go(lab : NativeIntArr, n : Int, i : Int) : NativeIntArr do
    if i < 0 do lab
    else
      let l = NativeArray.get_int(lab, i)
      if l == 0 do relabel_back_go(lab, n, i - 1)
      else
        let m = min8_go(lab, n, i % n, i / n, 0, l)
        if m < l do
          let c = NativeArray.get_int(lab, n * n)
          relabel_back_go(NativeArray.set_int(NativeArray.set_int(lab, i, m), n * n, c + 1), n, i - 1)
        else relabel_back_go(lab, n, i - 1) end
      end
    end
  end
  pfn rounds_go(lab : NativeIntArr, n : Int) : NativeIntArr do
    let lab1 = jump_go(relabel_back_go(relabel_go(NativeArray.set_int(lab, n * n, 0), n, 0), n, n * n - 1), n, 0)
    let c = NativeArray.get_int(lab1, n * n)
    if c == 0 do lab1 else rounds_go(lab1, n) end
  end
  doc "Body labels for the water flags: for each water column, one plus the least column index in its 8-connected body; 0 elsewhere. Length n * n + 1."
  fn bodies(ws : NativeU8Arr, n : Int) : NativeIntArr do
    rounds_go(label_seed_go(ws, n, 0, NativeArray.make_int(n * n + 1, 0)), n)
  end
  -- Columns per body, indexed by the body's root (its least column index).
  pfn counts_go(ws : NativeU8Arr, lab : NativeIntArr, n : Int, i : Int, counts : NativeIntArr) : NativeIntArr do
    if i >= n * n do counts
    else if NativeArray.get_u8(ws, i) == 1 do
      let root = NativeArray.get_int(lab, i) - 1
      let c = NativeArray.get_int(counts, root)
      counts_go(ws, lab, n, i + 1, NativeArray.set_int(counts, root, c + 1))
    else counts_go(ws, lab, n, i + 1, counts) end end
  end
  doc "The size of the body column [i] belongs to, or 0 when it is not water."
  fn body_size(ws : NativeU8Arr, lab : NativeIntArr, counts : NativeIntArr, i : Int) : Int do
    if NativeArray.get_u8(ws, i) == 1 do NativeArray.get_int(counts, NativeArray.get_int(lab, i) - 1) else 0 end
  end

  -- Seed the sweep: a water column is at distance 0, flagged when its body is small.
  pfn seed_go(ws : NativeU8Arr, lab : NativeIntArr, counts : NativeIntArr, n : Int, i : Int, d : NativeU8Arr) : NativeU8Arr do
    if i >= n * n do d
    else if NativeArray.get_u8(ws, i) == 1 do
      let small = NativeArray.get_int(counts, NativeArray.get_int(lab, i) - 1) <= small_body()
      seed_go(ws, lab, counts, n, i + 1, NativeArray.set_u8(d, i, if small do small_bit() else 0 end))
    else seed_go(ws, lab, counts, n, i + 1, d) end end
  end

  -- dx, dz for neighbour k of 8: the 3x3 ring minus the centre, row by row.
  pfn ndx(k : Int) : Int do
    let kk = if k >= 4 do k + 1 else k end
    kk % 3 - 1
  end
  pfn ndz(k : Int) : Int do
    let kk = if k >= 4 do k + 1 else k end
    kk / 3 - 1
  end

  -- Mark the unvisited neighbours of (x, z) with [nd]: the distance plus the
  -- marker's small bit, so the flag travels with the distance. Unvisited is a
  -- distance of reach() with no flag; the sweep never writes reach() itself.
  pfn mark8(d : NativeU8Arr, n : Int, x : Int, z : Int, nd : Int, k : Int) : NativeU8Arr do
    if k >= 8 do d
    else
      let nx = x + ndx(k)
      let nz = z + ndz(k)
      if nx < 0 || nz < 0 || nx >= n || nz >= n do mark8(d, n, x, z, nd, k + 1)
      else
        let j = nx + n * nz
        if NativeArray.get_u8(d, j) == reach() do mark8(NativeArray.set_u8(d, j, nd), n, x, z, nd, k + 1)
        else mark8(d, n, x, z, nd, k + 1) end
      end
    end
  end

  pfn level_go(d : NativeU8Arr, n : Int, lv : Int, i : Int) : NativeU8Arr do
    if i >= n * n do d
    else
      let v = NativeArray.get_u8(d, i)
      if dist_of(v) != lv do level_go(d, n, lv, i + 1)
      else level_go(mark8(d, n, i % n, i / n, lv + 1 + (if is_small(v) do small_bit() else 0 end), 0), n, lv, i + 1) end
    end
  end

  pfn sweep_go(d : NativeU8Arr, n : Int, lv : Int) : NativeU8Arr do
    if lv >= reach() - 1 do d
    else sweep_go(level_go(d, n, lv, 0), n, lv + 1) end
  end

  doc "Chebyshev distance to the nearest water column, capped at reach(), with small_bit() set where that water is a small body (see dist_of, is_small). A fresh array every call, threaded through every write (GAPS G68)."
  fn distances(f : Field, w : CubeForge.World.World) : NativeU8Arr do
    let n = cols(w)
    match f do
      Field(_, ws, _, _, _, _, _, _, _) ->
        let lab = bodies(ws, n)
        let counts = counts_go(ws, lab, n, 0, NativeArray.make_int(n * n, 0))
        sweep_go(seed_go(ws, lab, counts, n, 0, NativeArray.make_u8(n * n, reach())), n, 0)
    end
  end

  -- Classify every column from its targets, writing the eased axes AT target
  -- (a fresh world starts fully classified; easing is for changes).
  -- Sources arrive as plain parameters, matched out of the Field ONCE by the
  -- caller: destructuring the variant inside the loop re-bumps every inner
  -- array's refcount per iteration, which is what level_go in light.march
  -- avoids and what turned each write into a whole-array copy here.
  -- The temperature octave is read at the WORLD column (the window's block
  -- origin plus the local column), so the climate is the ground's, not the
  -- window's, and a shift finds the same temperature where it left it.
  pfn classify_all(hs : NativeU8Arr, seed : Int, d : NativeU8Arr, n : Int, i : Int,
                   ta : NativeFloatArr, ma : NativeFloatArr, bs : NativeU8Arr, tb : NativeFloatArr, wox : Int, woz : Int) : Field do
    if i >= n * n do Field(hs, NativeArray.make_u8(0, 0), ta, ma, bs, NativeArray.make_u8(n * n, 0), tb, d, NativeArray.make_u8(n * n, 0))
    else
      let h = NativeArray.get_u8(hs, i)
      let dv = NativeArray.get_u8(d, i)
      let base = temp_base(wox + i % n, woz + i / n, seed)
      let t = temp_from_base(base, h)
      let m = moisture_target_of(dv)
      let b = classify_full(t, m, h, dist_of(dv), is_small(dv), false)
      classify_all(hs, seed, d, n, i + 1, NativeArray.set_float(ta, i, t), NativeArray.set_float(ma, i, m), NativeArray.set_u8(bs, i, b), NativeArray.set_float(tb, i, base), wox, woz)
    end
  end

  doc "Build the field from a world: scan every column's surface and water, then classify."
  fn build(w : CubeForge.World.World, seed : Int) : Field do
    let n = cols(w)
    let f0 = scan_go(w, n, CubeForge.Light.sky_floor(w), 0, NativeArray.make_u8(n * n, 0), NativeArray.make_u8(n * n, 0))
    let d = distances(f0, w)
    match f0 do
      Field(hs, ws, _, _, _, _, _, _, _) ->
        match classify_all(hs, seed, d, n, 0, NativeArray.make_float(n * n, 0.0), NativeArray.make_float(n * n, 0.0), NativeArray.make_u8(n * n, 0), NativeArray.make_float(n * n, 0.0), W.world_x(w, 0), W.world_z(w, 0)) do
          Field(hs1, _, ta, ma, bs, hold, tb, ds, act) -> Field(hs1, ws, ta, ma, bs, hold, tb, ds, act)
        end
    end
  end

  -- ── Shifting the window ────────────────────────────────────────────────
  -- The window slid by (dx, dz) chunks: column (x, z) is what was at
  -- (x + 16dx, z + 16dz). The overlap moves by one blit per row per array
  -- (nine arrays, 128 rows); only the columns that came in are visited one
  -- by one: scanned and given their targets as a fresh build would
  -- (temperature from the world column, moisture dry until the distances are
  -- swept), their distance marked stale so tick_begin resweeps, and set
  -- active so the tick classifies them.
  pfn shift_u8_rows(src : NativeU8Arr, dst : NativeU8Arr, n : Int, sx : Int, sz : Int, z : Int) : NativeU8Arr do
    if z >= n do dst
    else
      let zs = z + sz
      let len = n - (if sx < 0 do 0 - sx else sx end)
      let xs0 = if sx > 0 do sx else 0 end
      let xd0 = if sx > 0 do 0 else 0 - sx end
      if zs < 0 || zs >= n do shift_u8_rows(src, dst, n, sx, sz, z + 1)
      else shift_u8_rows(src, CubeForge.Ffi.Window.u8_blit(dst, z * n + xd0, src, zs * n + xs0, len), n, sx, sz, z + 1) end
    end
  end
  pfn shift_f64_rows(src : NativeFloatArr, dst : NativeFloatArr, n : Int, sx : Int, sz : Int, z : Int) : NativeFloatArr do
    if z >= n do dst
    else
      let zs = z + sz
      let len = n - (if sx < 0 do 0 - sx else sx end)
      let xs0 = if sx > 0 do sx else 0 end
      let xd0 = if sx > 0 do 0 else 0 - sx end
      if zs < 0 || zs >= n do shift_f64_rows(src, dst, n, sx, sz, z + 1)
      else shift_f64_rows(src, CubeForge.Ffi.Window.f64_blit(dst, z * n + xd0, src, zs * n + xs0, len), n, sx, sz, z + 1) end
    end
  end
  -- A column's surface and wetness read from its chunk directly: the world's
  -- block lookup costs a chunk fetch per block, and a band is 2,048 columns
  -- of up to a hundred blocks each (GAPS G64: fetch the chunk once).
  pfn surface_in(c : CubeForge.Chunk.Chunk, lx : Int, lz : Int, y : Int) : Int do
    if y <= 0 do 0
    else if C.get(c, lx, y, lz) != 0 do y
    else surface_in(c, lx, lz, y - 1) end end
  end
  pfn wet_in(c : CubeForge.Chunk.Chunk, lx : Int, lz : Int, h : Int) : Bool do
    C.is_water(C.get(c, lx, h, lz)) || (h < 255 && C.is_water(C.get(c, lx, h + 1, lz)))
  end
  -- The band that came in, in columns: [bx0, bx1] x [bz0, bz1] of the window.
  pfn band_go(f : Field, w : CubeForge.World.World, n : Int, top : Int, seed : Int, bx0 : Int, bx1 : Int, bz0 : Int, bz1 : Int, x : Int, z : Int) : Field do
    if z > bz1 do f
    else if x > bx1 do band_go(f, w, n, top, seed, bx0, bx1, bz0, bz1, bx0, z + 1)
    else
      match f do
        Field(hs, ws, ta, ma, bs, hold, tb, ds, act) ->
          let i = x + n * z
          let c = W.chunk_at(w, x / 16, z / 16)
          let h = surface_in(c, x % 16, z % 16, top)
          let base = temp_base(W.world_x(w, x), W.world_z(w, z), seed)
          let t = temp_from_base(base, h)
          band_go(Field(NativeArray.set_u8(hs, i, h), NativeArray.set_u8(ws, i, if wet_in(c, x % 16, z % 16, h) do 1 else 0 end),
                        NativeArray.set_float(ta, i, t), NativeArray.set_float(ma, i, 0.0),
                        NativeArray.set_u8(bs, i, classify(t, 0.0, h, reach())), NativeArray.set_u8(hold, i, 0),
                        NativeArray.set_float(tb, i, base), NativeArray.set_u8(ds, i, stale()), NativeArray.set_u8(act, i, 1)),
                  w, n, top, seed, bx0, bx1, bz0, bz1, x + 1, z)
      end
    end end
  end
  doc "The field moved by ([dx], [dz]) chunks over the shifted world [w]; the band that came in is scanned and woken."
  fn shift(f : Field, w : CubeForge.World.World, dx : Int, dz : Int, seed : Int) : Field do
    let n = cols(w)
    let sx = 16 * dx
    let sz = 16 * dz
    -- the band's columns: the strip the shift exposed
    let bx0 = if dx > 0 do n - 16 else 0 end
    let bx1 = if dx < 0 do 15 else n - 1 end
    let bz0 = if dz > 0 do n - 16 else 0 end
    let bz1 = if dz < 0 do 15 else n - 1 end
    match f do
      Field(hs, ws, ta, ma, bs, hold, tb, ds, act) ->
        let f1 = Field(shift_u8_rows(hs, NativeArray.make_u8(n * n, 0), n, sx, sz, 0), shift_u8_rows(ws, NativeArray.make_u8(n * n, 0), n, sx, sz, 0),
                       shift_f64_rows(ta, NativeArray.make_float(n * n, 0.0), n, sx, sz, 0), shift_f64_rows(ma, NativeArray.make_float(n * n, 0.0), n, sx, sz, 0),
                       shift_u8_rows(bs, NativeArray.make_u8(n * n, 0), n, sx, sz, 0), shift_u8_rows(hold, NativeArray.make_u8(n * n, 0), n, sx, sz, 0),
                       shift_f64_rows(tb, NativeArray.make_float(n * n, 0.0), n, sx, sz, 0), shift_u8_rows(ds, NativeArray.make_u8(n * n, reach()), n, sx, sz, 0),
                       shift_u8_rows(act, NativeArray.make_u8(n * n, 0), n, sx, sz, 0))
        -- scan down from the band's own top, not the world's sky floor
        band_go(f1, w, n, CubeForge.Light.band_top(w, bx0 / 16, bx1 / 16, bz0 / 16, bz1 / 16), seed, bx0, bx1, bz0, bz1, bx0, bz0)
    end
  end

  fn height_of(f : Field, wx : Int, wz : Int) : Int do
    match f do Field(hs, _, _, _, _, _, _, _, _) -> NativeArray.get_u8(hs, wx + side_of(hs) * wz) end
  end
  fn biome_of(f : Field, wx : Int, wz : Int) : Int do
    match f do Field(_, _, _, _, bs, _, _, _, _) -> NativeArray.get_u8(bs, wx + side_of(bs) * wz) end
  end
  fn field_biomes(f : Field) : NativeU8Arr do match f do Field(_, _, _, _, bs, _, _, _, _) -> bs end end


  fn default_rate() : Float do 1.0 /. 10800.0 end
  fn hold_ticks() : Int do 30 end

  pfn copy_go(src : NativeU8Arr, dst : NativeU8Arr, i : Int, n : Int) : NativeU8Arr do
    if i >= n do dst else copy_go(src, NativeArray.set_u8(dst, i, NativeArray.get_u8(src, i)), i + 1, n) end
  end
  pfn copy_u8(a : NativeU8Arr, n : Int) : NativeU8Arr do copy_go(a, NativeArray.make_u8(n, 0), 0, n) end

  doc "A block changed at (x, y, z). Only that column's surface and water flag can change, and only if the edit is at or above the current surface -- O(1) apart from the copy the Scene's shared reference forces (GAPS G68)."
  fn note_edit(f : Field, w : CubeForge.World.World, x : Int, y : Int, z : Int, id : Int) : Field do
    let n = cols(w)
    if x < 0 || z < 0 || x >= n || z >= n do f
    else
      match f do
        Field(hs, ws, ta, ma, bs, hold, tb, ds, act) ->
          let i = x + n * z
          let cur = NativeArray.get_u8(hs, i)
          let h1 = if y > cur && id != 0 do y
                   else if y == cur && id == 0 do surface_go(w, x, z, y - 1)
                   else cur end end
          let hs1 = NativeArray.set_u8(copy_u8(hs, n * n), i, h1)
          let wet1 = if wet_at(w, x, z, h1) do 1 else 0 end
          let ws1 = NativeArray.set_u8(copy_u8(ws, n * n), i, wet1)
          -- a water flag that moved makes the kept distances stale (see stale())
          let ds1 = if wet1 != NativeArray.get_u8(ws, i) do NativeArray.set_u8(copy_u8(ds, n * n), i, stale()) else ds end
          -- the surface moved, so this column's temperature target moved: wake it
          Field(hs1, ws1, ta, ma, bs, hold, tb, ds1, NativeArray.set_u8(copy_u8(act, n * n), i, 1))
      end
    end
  end

  -- ── Batched edits ───────────────────────────────────────────────────────
  -- note_edit copies both the heightmap and the water flags -- 32 KB -- because
  -- the Scene holds the field too (GAPS G68). Retexturing pays that twice per
  -- column, so a 32-column tick did 64 whole-array copies, 11 ms. These do one
  -- copy of each for the whole batch.
  --
  -- Each edit is one column and touches only its own entry, so applying them
  -- against the world AFTER all the block writes gives what a fold of note_edit
  -- against each intermediate world gives: heights and the water flag both read
  -- only the column being edited.
  doc "Pack a single-column edit for note_edits: x and z under 192, y and id under 256."
  -- Written from stride() rather than the literal, so the x divisor cannot
  -- drift from the x multiplier when the window's side moves (see World.pack_cell).
  fn pack_edit(x : Int, y : Int, z : Int, id : Int) : Int do ((x * stride() + z) * 256 + y) * 256 + id end
  pfn edit_id(v : Int) : Int do v % 256 end
  pfn edit_y(v : Int) : Int do (v / 256) % 256 end
  pfn edit_z(v : Int) : Int do (v / 65536) % stride() end
  pfn edit_x(v : Int) : Int do v / (65536 * stride()) end

  -- One array threaded, the rest borrowed: the light.march idiom. Wrapping the
  -- two arrays in a variant to return both at once would give each a refcount of
  -- 2 and copy them on every write (GAPS G68), so this is two passes.
  pfn heights_go(w : CubeForge.World.World, n : Int, cells : List(Int), hs : NativeU8Arr) : NativeU8Arr do
    match cells do
      Nil -> hs
      Cons(v, rest) ->
        let x = edit_x(v)
        let z = edit_z(v)
        if x < 0 || z < 0 || x >= n || z >= n do heights_go(w, n, rest, hs)
        else
          let y = edit_y(v)
          let id = edit_id(v)
          let i = x + n * z
          let cur = NativeArray.get_u8(hs, i)
          let h1 = if y > cur && id != 0 do y
                   else if y == cur && id == 0 do surface_go(w, x, z, y - 1)
                   else cur end end
          heights_go(w, n, rest, NativeArray.set_u8(hs, i, h1))
        end
    end
  end
  pfn wets_go(w : CubeForge.World.World, n : Int, cells : List(Int), hs : NativeU8Arr, ws : NativeU8Arr) : NativeU8Arr do
    match cells do
      Nil -> ws
      Cons(v, rest) ->
        let x = edit_x(v)
        let z = edit_z(v)
        if x < 0 || z < 0 || x >= n || z >= n do wets_go(w, n, rest, hs, ws)
        else
          let i = x + n * z
          wets_go(w, n, rest, hs, NativeArray.set_u8(ws, i, if wet_at(w, x, z, NativeArray.get_u8(hs, i)) do 1 else 0 end))
        end
    end
  end

  -- Wake every column a batch of edits touched.
  pfn wake_go(n : Int, cells : List(Int), act : NativeU8Arr) : NativeU8Arr do
    match cells do
      Nil -> act
      Cons(v, rest) ->
        let x = edit_x(v)
        let z = edit_z(v)
        if x < 0 || z < 0 || x >= n || z >= n do wake_go(n, rest, act)
        else wake_go(n, rest, NativeArray.set_u8(act, x + n * z, 1)) end
    end
  end

  -- Wake every column in a box (the shape box_go rescans).
  pfn wake_box_go(n : Int, x0 : Int, z0 : Int, x1 : Int, z1 : Int, x : Int, z : Int, act : NativeU8Arr) : NativeU8Arr do
    if z > z1 do act
    else if x > x1 do wake_box_go(n, x0, z0, x1, z1, x0, z + 1, act)
    else if x < 0 || z < 0 || x >= n || z >= n do wake_box_go(n, x0, z0, x1, z1, x + 1, z, act)
    else wake_box_go(n, x0, z0, x1, z1, x + 1, z, NativeArray.set_u8(act, x + n * z, 1)) end end end
  end

  -- Mark the kept distances stale at every edited column whose water flag moved.
  pfn stale_go(n : Int, cells : List(Int), ws0 : NativeU8Arr, ws1 : NativeU8Arr, ds : NativeU8Arr) : NativeU8Arr do
    match cells do
      Nil -> ds
      Cons(v, rest) ->
        let x = edit_x(v)
        let z = edit_z(v)
        if x < 0 || z < 0 || x >= n || z >= n do stale_go(n, rest, ws0, ws1, ds)
        else
          let i = x + n * z
          if NativeArray.get_u8(ws0, i) != NativeArray.get_u8(ws1, i) do stale_go(n, rest, ws0, ws1, NativeArray.set_u8(ds, i, stale()))
          else stale_go(n, rest, ws0, ws1, ds) end
        end
    end
  end

  doc "Apply a batch of single-column edits (see pack_edit) to the field, copying its arrays once for the whole batch rather than once per edit."
  fn note_edits(f : Field, w : CubeForge.World.World, cells : List(Int)) : Field do
    let n = cols(w)
    match f do
      Field(hs, ws, ta, ma, bs, hold, tb, ds, act) ->
        let hs1 = heights_go(w, n, cells, copy_u8(hs, n * n))
        let ws1 = wets_go(w, n, cells, hs1, copy_u8(ws, n * n))
        let ds1 = stale_go(n, cells, ws, ws1, copy_u8(ds, n * n))
        Field(hs1, ws1, ta, ma, bs, hold, tb, ds1, wake_go(n, cells, copy_u8(act, n * n)))
    end
  end

  pfn ease(cur : Float, target : Float, rate : Float) : Float do
    let d = target -. cur
    if d > rate do cur +. rate else if d < 0.0 -. rate do cur -. rate else target end end
  end

  -- Skips settled columns, and writes into the field's own arrays rather than
  -- fresh ones: the first write copies (the Scene shares them, GAPS G68) and the
  -- rest land in place, so a tick that changes nothing copies nothing. Reads come
  -- from the same arrays being written, which is the same answer -- each column
  -- is read at its own index before it is written.
  pfn clampb(v : Float, cap : Float) : Float do if v < 0.0 -. cap do 0.0 -. cap else if v > cap do cap else v end end end

  -- Established columns in the 3x3 of (x, z), the field's edge clipping the box.
  pfn established_go(sps : NativeU8Arr, vg : NativeF32Arr, n : Int, x : Int, z : Int, k : Int, acc : Int) : Int do
    if k >= 9 do acc
    else
      let nx = x + k % 3 - 1
      let nz = z + k / 3 - 1
      if nx < 0 || nz < 0 || nx >= n || nz >= n do established_go(sps, vg, n, x, z, k + 1, acc)
      else
        let j = nx + n * nz
        let est = if NativeArray.get_u8(sps, j) == 0 do false else NativeArray.get_f32(vg, j) >= grove_vigour() end
        established_go(sps, vg, n, x, z, k + 1, if est do acc + 1 else acc end)
      end
    end
  end
  doc "Is column (x, z) a grove: at least grove_neighbours() of its 3x3 hold a species at grove_vigour() or more."
  fn is_grove(sps : NativeU8Arr, vg : NativeF32Arr, n : Int, x : Int, z : Int) : Bool do
    -- the centre first: a column with nothing on it is never a grove, and
    -- that rejects almost every column before the eight neighbour reads
    if NativeArray.get_u8(sps, x + n * z) == 0 do false
    else established_go(sps, vg, n, x, z, 0, 0) >= grove_neighbours() end
  end

  -- Is column i looked at this tick? Active columns and rows whose network pulls
  -- moved, as before. A row the network is dirty in is looked at only where the
  -- grove test disagrees with the stored biome: the network eases vigour for
  -- hundreds of ticks after a planting, and evaluating every column of every
  -- such row for all of that was 5 ms a tick. Once the two agree the column
  -- is settled again and stays so until they differ, which they can only do
  -- in a dirty row. Nested, not `&&`: G33.
  pfn must_look(act : NativeU8Arr, prow : NativeU8Arr, drow : NativeU8Arr, sps : NativeU8Arr, vg : NativeF32Arr, bs : NativeU8Arr, n : Int, i : Int) : Bool do
    if NativeArray.get_u8(act, i) != 0 do true
    else if NativeArray.get_u8(prow, i / n) != 0 do true
    else if NativeArray.get_u8(drow, i / n) == 0 do false
    else is_grove(sps, vg, n, i % n, i / n) != (NativeArray.get_u8(bs, i) == b_grove()) end end end
  end

  pfn tick_go(hs : NativeU8Arr, tb : NativeFloatArr, rate : Float, d : NativeU8Arr, pulls : NativeF32Arr, prow : NativeU8Arr, scale : Float,
              sps : NativeU8Arr, vg : NativeF32Arr, drow : NativeU8Arr, n : Int, i : Int, stop : Int,
              ta : NativeFloatArr, ma : NativeFloatArr, bs : NativeU8Arr, hold : NativeU8Arr, act : NativeU8Arr) : Field do
    if i >= stop do Field(hs, NativeArray.make_u8(0, 0), ta, ma, bs, hold, tb, NativeArray.make_u8(0, 0), act)
    else if !must_look(act, prow, drow, sps, vg, bs, n, i) do tick_go(hs, tb, rate, d, pulls, prow, scale, sps, vg, drow, n, i + 1, stop, ta, ma, bs, hold, act)
    else
      let h = NativeArray.get_u8(hs, i)
      let dv = NativeArray.get_u8(d, i)
      -- the network's offset: its raw pull scaled by CF_MYC_FEEDBACK and capped
      let cap = CubeForge.Myc.cap()
      let bt = clampb(NativeArray.get_f32(pulls, 2 * i) *. scale, cap)
      let bm = clampb(NativeArray.get_f32(pulls, 2 * i + 1) *. scale, cap)
      let tt = clamp01(temp_from_base(NativeArray.get_float(tb, i), h) +. bt)
      let mt = clamp01(moisture_target_of(dv) +. bm)
      let t = ease(NativeArray.get_float(ta, i), tt, rate)
      let m = ease(NativeArray.get_float(ma, i), mt, rate)
      let raw = classify_full(t, m, h, dist_of(dv), is_small(dv), is_grove(sps, vg, n, i % n, i / n))
      let cur = NativeArray.get_u8(bs, i)
      -- The hold counter: flip only after hold_ticks() consecutive disagreements,
      -- so a column parked on a threshold cannot alternate every tick.
      let hc = if raw == cur do 0 else NativeArray.get_u8(hold, i) + 1 end
      let b1 = if hc >= hold_ticks() do raw else cur end
      let hc1 = if b1 == raw do 0 else hc end
      -- Settled: both axes sit exactly on their targets (ease assigns the target
      -- itself once it is within a step, so this is exact) and the hold counter
      -- is clear, which means the stored biome IS the classification of these
      -- axes. Nothing here can move again until an edit, a distance change, or
      -- the network's pull on this row moving.
      let settled = if t == tt do (if m == mt do hc1 == 0 else false end) else false end
      let act1 = NativeArray.set_u8(act, i, if settled do 0 else 1 end)
      tick_go(hs, tb, rate, d, pulls, prow, scale, sps, vg, drow, n, i + 1, stop,
              NativeArray.set_float(ta, i, t), NativeArray.set_float(ma, i, m),
              NativeArray.set_u8(bs, i, b1), NativeArray.set_u8(hold, i, hc1), act1)
    end end
  end

  -- A column whose distance to water changed has a new moisture target.
  pfn mark_dist_go(d : NativeU8Arr, ds0 : NativeU8Arr, n : Int, i : Int, act : NativeU8Arr) : NativeU8Arr do
    if i >= n * n do act
    else if NativeArray.get_u8(d, i) != NativeArray.get_u8(ds0, i) do mark_dist_go(d, ds0, n, i + 1, NativeArray.set_u8(act, i, 1))
    else mark_dist_go(d, ds0, n, i + 1, act) end end
  end


  -- Water moves on its own (the water actors spread it every tick), so the
  -- water flag is rescanned whole every tick rather than hooked at each edit:
  -- two reads per column off the heightmap, 32k reads, and no site can forget.
  --
  -- Walked chunk by chunk, not column by column in world coordinates. Both do
  -- the same 32k voxel reads and write the same flags, but W.block_at re-runs
  -- Array.get on the chunk trie for EVERY read; hoisting that to one lookup per
  -- 256 columns took this pass from 19 ms to under 2 -- it was the whole of the
  -- 20 ms biome tick. Same idiom as light.march's per-chunk walks.
  pfn water_chunk_go(c : CubeForge.Chunk.Chunk, hs : NativeU8Arr, n : Int, cx : Int, cz : Int, j : Int, ws : NativeU8Arr) : NativeU8Arr do
    if j >= 256 do ws
    else
      let lx = j % 16
      let lz = j / 16
      let i = (16 * cx + lx) + n * (16 * cz + lz)
      let h = NativeArray.get_u8(hs, i)
      let wet = C.is_water(C.get_or_air(c, lx, h, lz)) || C.is_water(C.get_or_air(c, lx, h + 1, lz))
      water_chunk_go(c, hs, n, cx, cz, j + 1, NativeArray.set_u8(ws, i, if wet do 1 else 0 end))
    end
  end
  pfn water_go(w : CubeForge.World.World, hs : NativeU8Arr, n : Int, ci : Int, ws : NativeU8Arr) : NativeU8Arr do
    let cn = n / 16
    if ci >= cn * cn do ws
    else water_go(w, hs, n, ci + 1, water_chunk_go(W.chunk_at(w, ci % cn, ci / cn), hs, n, ci % cn, ci / cn, 0, ws)) end
  end

  doc """
  Rescan the surface of every column in the (2r+1)-square around (x, z): for edits
  that change many columns at once, such as leaf decay. [top] must be at or above
  the highest block the edit wrote; each column starts its downward scan from the
  higher of [top] and the height already stored for it, so an edit that only
  removes blocks can pass 0.

  It does NOT call Light.sky_floor. That walks every chunk down from y=255 --
  2.1 million voxel reads, 21.5 ms -- to return a constant, which made a box
  over one column cost as much as a box over the world (RESULTS: the 80 ms tick).
  """
  fn rescan_box(f : Field, w : CubeForge.World.World, x : Int, z : Int, r : Int, top : Int) : Field do
    let n = cols(w)
    match f do
      Field(hs, ws, ta, ma, bs, hold, tb, ds, act) ->
        Field(box_go(w, n, top, x - r, z - r, x + r, z + r, x - r, z - r, copy_u8(hs, n * n)), ws, ta, ma, bs, hold, tb, ds,
              wake_box_go(n, x - r, z - r, x + r, z + r, x - r, z - r, copy_u8(act, n * n)))
    end
  end
  pfn box_go(w : CubeForge.World.World, n : Int, top : Int, x0 : Int, z0 : Int, x1 : Int, z1 : Int, x : Int, z : Int, hs : NativeU8Arr) : NativeU8Arr do
    if z > z1 do hs
    else if x > x1 do box_go(w, n, top, x0, z0, x1, z1, x0, z + 1, hs)
    else if x < 0 || z < 0 || x >= n || z >= n do box_go(w, n, top, x0, z0, x1, z1, x + 1, z, hs)
    else
      let stored = NativeArray.get_u8(hs, x + n * z)
      let from = if top > stored do top else stored end
      box_go(w, n, top, x0, z0, x1, z1, x + 1, z, NativeArray.set_u8(hs, x + n * z, surface_go(w, x, z, from)))
    end end end
  end

  doc """
  One tick: rescan water, recompute distances, ease both axes toward their
  targets by [rate] -- targets that carry the network's raw [pulls] (two f32
  per column, see Myc.pulls) scaled by [scale] and capped, with [prow] naming
  the rows whose pulls moved -- and reclassify behind the hold counter.

  Only ACTIVE columns are eased and reclassified. A settled column -- both axes
  on target, hold counter clear -- cannot change until something wakes it, and
  the three things that can are all accounted for: an edit through note_edit,
  note_edits or rescan_box, each of which wakes what it touched, and a change in
  the distance to water, which this compares against the distances the previous
  tick kept. Before this, every tick eased and reclassified all 16,384 columns
  to discover that almost none of them had moved.
  """
  fn tick(f : Field, w : CubeForge.World.World, seed : Int, rate : Float, pulls : NativeF32Arr, prow : NativeU8Arr, scale : Float) : Field do
    tick_slice(tick_begin(f, w), w, rate, pulls, prow, scale, 0, cols(w) * cols(w))
  end
  doc "The whole tick with the network in view (see tick_slice_net): for tests."
  fn tick_net(f : Field, w : CubeForge.World.World, seed : Int, rate : Float, pulls : NativeF32Arr, prow : NativeU8Arr, scale : Float,
              sps : NativeU8Arr, vg : NativeF32Arr, drow : NativeU8Arr) : Field do
    tick_slice_net(tick_begin(f, w), w, rate, pulls, prow, scale, 0, cols(w) * cols(w), sps, vg, drow)
  end

  doc """
  The whole-map half of a tick: rescan the water flags, recompute the distance
  field, and wake every column whose distance moved. Nothing is eased here.

  Split from the sweep because these three are O(map) and the sweep is O(awake),
  and the two want different schedules: this runs once at the head of a period,
  the sweep is spread across the period's frames a slice at a time.
  """
  fn tick_begin(f : Field, w : CubeForge.World.World) : Field do
    let n = cols(w)
    -- The distances (and the bodies behind them) are a function of the water
    -- flags alone, so when this period's flags equal the flags the kept
    -- distances were swept from -- last period's, and no edit has moved one
    -- since (stale()) -- the kept distances are the answer, and the sweep and
    -- the body labelling are skipped. Settled water is the common case;
    -- flowing water pays the full cost.
    match f do
      Field(hs, ws0, ta, ma, bs, hold, tb, ds0, act) ->
        let ws = water_go(w, hs, n, 0, NativeArray.make_u8(n * n, 0))
        let same = same_u8(ws0, ws, ds0, n * n, 0)
        let d = if same do ds0 else distances(Field(hs, ws, ta, ma, bs, hold, tb, ds0, act), w) end
        Field(hs, ws, ta, ma, bs, hold, tb, d, mark_dist_go(d, ds0, n, 0, act))
    end
  end

  doc """
  Ease and reclassify the awake columns in [from, from + count), against the
  distances tick_begin left in the field, with no network in view. See
  tick_slice_net.
  """
  fn tick_slice(f : Field, w : CubeForge.World.World, rate : Float, pulls : NativeF32Arr, prow : NativeU8Arr, scale : Float, from : Int, count : Int) : Field do
    let n = cols(w)
    tick_slice_net(f, w, rate, pulls, prow, scale, from, count, no_species(n), no_vigour(n), no_rows(n))
  end

  doc """
  Ease and reclassify the awake columns in [from, from + count), against the
  distances tick_begin left in the field.

  A period sweeps the whole map in slices, so each column is still visited
  exactly once per period and the ease rate and the hold counter are unchanged.
  What moves is only WHEN in the period a column is looked at, which matters
  solely for an edit landing mid-period: the column ahead of the cursor sees it
  this period, the one behind it next period. The sweep costs what the awake set
  costs, and the fungus climate feedback keeps some four thousand columns awake,
  so it is worth spreading.

  The network in view: [sps] and [vg] are Myc.field_species and
  Myc.field_vigour, read to find groves, and [drow] is Myc.dirty_rows, whose
  rows are looked at where the grove test disagrees with the stored biome. The
  biome reads the network as it stood at the end of the previous period; the
  network then reads the climate the sweep eased. The grove cannot feed back:
  the network never reads the biome id.
  """
  fn tick_slice_net(f : Field, w : CubeForge.World.World, rate : Float, pulls : NativeF32Arr, prow : NativeU8Arr, scale : Float, from : Int, count : Int,
                    sps : NativeU8Arr, vg : NativeF32Arr, drow : NativeU8Arr) : Field do
    let n = cols(w)
    let lo = if from < 0 do 0 else if from > n * n do n * n else from end end
    let hi = if lo + count > n * n do n * n else lo + count end
    match f do
      Field(hs, ws, ta0, ma0, bs0, hold0, tb, ds, act0) ->
        match tick_go(hs, tb, rate, ds, pulls, prow, scale, sps, vg, drow, n, lo, hi, ta0, ma0, bs0, hold0, act0) do
          Field(hs1, _, ta, ma, bs, hold, tb1, _, act1) -> Field(hs1, ws, ta, ma, bs, hold, tb1, ds, act1)
        end
    end
  end

  -- Equal flags, and no stale distance anywhere.
  pfn same_u8(a : NativeU8Arr, b : NativeU8Arr, ds : NativeU8Arr, n : Int, i : Int) : Bool do
    if i >= n do true
    else if NativeArray.get_u8(a, i) != NativeArray.get_u8(b, i) do false
    else if NativeArray.get_u8(ds, i) == stale() do false
    else same_u8(a, b, ds, n, i + 1) end end end
  end

  doc "Pulls saying the network does nothing, for callers without one and for tests: zeros, with no row moved."
  fn no_pulls(n : Int) : NativeF32Arr do NativeArray.make_f32(2 * n * n, 0.0) end
  fn no_rows(n : Int) : NativeU8Arr do NativeArray.make_u8(n, 0) end
  fn all_rows(n : Int) : NativeU8Arr do NativeArray.make_u8(n, 1) end
  doc "An empty network, for callers without one and for tests: no species, no vigour."
  fn no_species(n : Int) : NativeU8Arr do NativeArray.make_u8(n * n, 0) end
  fn no_vigour(n : Int) : NativeF32Arr do NativeArray.make_f32(n * n, 0.0) end


  -- ── Save and load: the eased axes ────────────────────────────────────────
  -- Four bytes per column: temperature then moisture, each 16-bit fixed point
  -- (1/65535, below anything the game can show). The rest of the field is
  -- rebuilt from the world: heights, water, distances, the temperature base.
  pfn put16(out : NativeU8Arr, off : Int, v : Float) : NativeU8Arr do
    let q = float_to_int(clamp01(v) *. 65535.0 +. 0.5)
    NativeArray.set_u8(NativeArray.set_u8(out, off, q % 256), off + 1, q / 256)
  end
  pfn get16(b : NativeU8Arr, off : Int) : Float do
    int_to_float(NativeArray.get_u8(b, off) + 256 * NativeArray.get_u8(b, off + 1)) /. 65535.0
  end
  pfn export_go(ta : NativeFloatArr, ma : NativeFloatArr, n2 : Int, i : Int, out : NativeU8Arr, off : Int) : NativeU8Arr do
    if i >= n2 do out
    else export_go(ta, ma, n2, i + 1, put16(put16(out, off + 4 * i, NativeArray.get_float(ta, i)), off + 4 * i + 2, NativeArray.get_float(ma, i)), off) end
  end
  doc "Write the eased axes into [out] at [off], four bytes per column."
  fn axes_to_bytes(f : Field, n : Int, out : NativeU8Arr, off : Int) : NativeU8Arr do
    match f do Field(_, _, ta, ma, _, _, _, _, _) -> export_go(ta, ma, n * n, 0, out, off) end
  end
  pfn import_go(b : NativeU8Arr, off : Int, hs : NativeU8Arr, d : NativeU8Arr, n : Int, i : Int,
                ta : NativeFloatArr, ma : NativeFloatArr, bs : NativeU8Arr) : Field do
    if i >= n * n do Field(hs, NativeArray.make_u8(0, 0), ta, ma, bs, NativeArray.make_u8(0, 0), NativeArray.make_float(0, 0.0), d, NativeArray.make_u8(0, 0))
    else
      let t = get16(b, off + 4 * i)
      let m = get16(b, off + 4 * i + 2)
      let cls = classify(t, m, NativeArray.get_u8(hs, i), NativeArray.get_u8(d, i))
      import_go(b, off, hs, d, n, i + 1, NativeArray.set_float(ta, i, t), NativeArray.set_float(ma, i, m), NativeArray.set_u8(bs, i, cls))
    end
  end
  doc "A built field with its eased axes replaced from [b] at [off] and every column reclassified from them and set active, so it settles or moves on from where the save left it."
  fn axes_of_bytes(f : Field, w : CubeForge.World.World, b : NativeU8Arr, off : Int) : Field do
    let n = cols(w)
    match f do
      Field(hs, ws, _, _, _, _, tb, ds, _) ->
        match import_go(b, off, hs, ds, n, 0, NativeArray.make_float(n * n, 0.0), NativeArray.make_float(n * n, 0.0), NativeArray.make_u8(n * n, 0)) do
          Field(_, _, ta, ma, bs, _, _, _, _) -> Field(hs, ws, ta, ma, bs, NativeArray.make_u8(n * n, 0), tb, ds, NativeArray.make_u8(n * n, 1))
        end
    end
  end

  doc """
  Release a field the caller is done with, array by array. A field cell that
  dies by a bare decrement is freed shallowly by this toolchain -- no deep drop
  is synthesized for it (GAPS G79) -- and its nine arrays leak, 350 KB every
  frame the biome slice ran. Destructuring extracts the arrays as bindings,
  and a binding that dies is released properly.
  """
  fn release(f : Field) : Int do
    match f do Field(hs, ws, ta, ma, bs, hold, tb, ds, act) -> NativeArray.length_u8(hs) + NativeArray.length_u8(ws) + NativeArray.length_float(ta) + NativeArray.length_float(ma) + NativeArray.length_u8(bs) + NativeArray.length_u8(hold) + NativeArray.length_float(tb) + NativeArray.length_u8(ds) + NativeArray.length_u8(act) end
  end

  doc "Eased temperature / moisture / water flag / distance-cap for one column, for diagnostics."
  fn debug_axes(f : Field, wx : Int, wz : Int) : String do
    match f do
      Field(_, ws, ta, ma, _, _, _, _, _) ->
        let i = wx + side_of(ws) * wz
        "temp " ++ float_to_string(NativeArray.get_float(ta, i)) ++ " moist " ++ float_to_string(NativeArray.get_float(ma, i)) ++ " wet " ++ int_to_string(NativeArray.get_u8(ws, i))
    end
  end


  doc "Eased temperature 0..1 of one column."
  fn temp_of(f : Field, wx : Int, wz : Int) : Float do
    match f do Field(hs, _, ta, _, _, _, _, _, _) -> NativeArray.get_float(ta, wx + side_of(hs) * wz) end
  end
  doc "Eased moisture 0..1 of one column."
  fn moist_of(f : Field, wx : Int, wz : Int) : Float do
    match f do Field(hs, _, _, ma, _, _, _, _, _) -> NativeArray.get_float(ma, wx + side_of(hs) * wz) end
  end
  doc "The eased temperature array, one entry per column: the climate the mycelium field reads."
  fn temps(f : Field) : NativeFloatArr do match f do Field(_, _, ta, _, _, _, _, _, _) -> ta end end
  doc "The eased moisture array, one entry per column."
  fn moists(f : Field) : NativeFloatArr do match f do Field(_, _, _, ma, _, _, _, _, _) -> ma end end
  doc "Columns from this one to the nearest water, capped at reach(). The moisture input the player can change by digging."
  fn water_dist_at(f : Field, wx : Int, wz : Int) : Int do
    match f do Field(_, _, _, _, _, _, _, ds, _) -> dist_of(NativeArray.get_u8(ds, wx + side_of(ds) * wz)) end
  end

  doc """
  The reach the nearest water actually has here: reach() for a large body,
  small_reach() for a small one.

  The survey shows this beside the distance, because the distance alone lies. A
  column twelve from a pond reads WATER 12 with MOIST 0 and looks like a broken
  rule; WATER 12 REACH 4 says exactly why it is dry and what would fix it. Two
  numbers, no prose, and the small-body rule teaches itself.
  """
  fn water_reach_at(f : Field, wx : Int, wz : Int) : Int do
    match f do
      Field(_, _, _, _, _, _, _, ds, _) ->
        if is_small(NativeArray.get_u8(ds, wx + side_of(ds) * wz)) do small_reach() else reach() end
    end
  end

  doc """
  The biome this column is HEADING for: classify at the targets rather than at
  the eased axes. Equal to biome_of once the column has settled, and different
  while it is on its way -- which is the whole of what the survey's trend line
  reports.

  It deliberately does not consult the hold counter. The two answer different
  questions: this is a destination the axes reach over minutes at the ease rate,
  the counter is a thirty-tick debounce at arrival, under three seconds. A column
  that is grassland and becoming forest is both of those things at once.

  The targets are computed exactly as tick_go computes them, network pulls
  included, so the answer is the one the tick will actually arrive at rather
  than an approximation of it.
  """
  fn trend_at(f : Field, pulls : NativeF32Arr, scale : Float, sps : NativeU8Arr, vg : NativeF32Arr, n : Int, wx : Int, wz : Int) : Int do
    match f do
      Field(hs, _, _, _, _, _, tb, ds, _) ->
        let i = wx + side_of(ds) * wz
        let h = NativeArray.get_u8(hs, i)
        let dv = NativeArray.get_u8(ds, i)
        let cap = CubeForge.Myc.cap()
        let tt = clamp01(temp_from_base(NativeArray.get_float(tb, i), h) +. clampb(NativeArray.get_f32(pulls, 2 * i) *. scale, cap))
        let mt = clamp01(moisture_target_of(dv) +. clampb(NativeArray.get_f32(pulls, 2 * i + 1) *. scale, cap))
        classify_full(tt, mt, h, dist_of(dv), is_small(dv), is_grove(sps, vg, n, wx, wz))
    end
  end

  doc "The active flags, one entry per column: 1 where the last tick eased the climate or an edit woke the column. What the mycelium tick must look at whatever its own dirty set says."
  fn active(f : Field) : NativeU8Arr do match f do Field(_, _, _, _, _, _, _, _, act) -> act end end

  doc "How much of a storm actually falls here, as a multiplier on the particle count. Deserts stay dry under the same storm that soaks a wetland; the sea and the mountains sit in between."
  fn precip_scale(id : Int) : Float do
    if id == b_desert() do 0.15
    else if id == b_tundra() do 0.5
    else if id == b_beach() do 0.8
    else if id == b_grassland() do 0.9
    else if id == b_alpine() do 0.9
    else if id == b_wetland() do 1.3
    else if id == b_oasis() do 0.3
    else if id == b_grove() do 1.1
    else 1.0 end end end end end end end end
  end


  -- ── Surface palette and migration ─────────────────────────────────────────
  doc "Fraction of wetland columns that pick mud over clay."
  pfn mud_fraction() : Float do 0.4 end
  doc "Arbitrary fixed seed for the clay/mud split: decorative, not tied to the world seed."
  pfn wetland_mix_seed() : Int do 91537 end

  doc "Clay or mud for one wetland column, mixed by a fixed per-column hash."
  pfn wetland_surface(x : Int, z : Int) : Int do
    if N.hash2(x, z, wetland_mix_seed()) < mud_fraction() do C.mud() else C.clay() end
  end

  doc "The surface block a biome wants, or 0 for none: a grove's surface is the network's mycelium block, which the migration never touches. Granite is absent on purpose: cliff faces stay on the slope rule in every biome."
  fn palette(id : Int, x : Int, z : Int) : Int do
    if id == b_grove() do 0
    else if id == b_tundra() do C.snow()
    else if id == b_taiga() do 2                       -- dirt
    else if id == b_desert() || id == b_beach() do C.sand()
    else if id == b_wetland() do wetland_surface(x, z)
    else if id == b_alpine() do C.gravel()
    else 1 end end end end end end                     -- grass: grassland, forest, oasis
  end

  doc "Only these ever migrate: the natural surface blocks. Granite, stone, water, logs, leaves and bedrock are never rewritten."
  fn is_palette_block(id : Int) : Bool do
    id == 1 || id == 2 || id == C.sand() || id == C.snow() || id == C.gravel() || id == C.clay() || id == C.mud()
  end

  pfn migrations_go(f : Field, w : CubeForge.World.World, n : Int, i : Int, left : Int, budget : Int, acc : List(Int)) : List(Int) do
    if left <= 0 || budget <= 0 do acc
    else
      let ci = i % (n * n)
      let x = ci % n
      let z = ci / n
      let h = height_of(f, x, z)
      let wet = match f do Field(_, ws, _, _, _, _, _, _, _) -> NativeArray.get_u8(ws, ci) == 1 end
      let sfc = W.block_at(w, x, h, z)
      let want = palette(biome_of(f, x, z), x, z)
      if h > 0 && !wet && want != 0 && is_palette_block(sfc) && sfc != want do migrations_go(f, w, n, i + 1, left - 1, budget - 1, Cons(ci, acc))
      else migrations_go(f, w, n, i + 1, left - 1, budget, acc) end
    end
  end

  doc "Column indices whose surface should become their biome's palette block: scans [scan] columns starting where tick [tick] leaves off (a stateless cursor), returns at most [budget]. Dry columns only, palette blocks only."
  fn migrations(f : Field, w : CubeForge.World.World, tick : Int, scan : Int, budget : Int) : List(Int) do
    let n = cols(w)
    migrations_go(f, w, n, (tick * scan) % (n * n), scan, budget, Nil)
  end


  doc "The field with column (x, z) forced to biome [id]: for tests that need a biome the terrain would not give. Copies the array (GAPS G68)."
  fn force_biome(f : Field, n : Int, x : Int, z : Int, id : Int) : Field do
    match f do
      Field(hs, ws, ta, ma, bs, hold, tb, ds, act) -> Field(hs, ws, ta, ma, NativeArray.set_u8(copy_u8(bs, n * n), x + n * z, id), hold, tb, ds, act)
    end
  end

  doc "The column's water flag."
  fn is_wet(f : Field, wx : Int, wz : Int) : Bool do
    match f do Field(_, ws, _, _, _, _, _, _, _) -> NativeArray.get_u8(ws, wx + side_of(ws) * wz) == 1 end
  end

  -- A rolling hash of the field's discrete state: heights, water flags and biome
  -- ids. The eased axes are floats and are deliberately left out -- this is an
  -- oracle for "the world evolved the same way", and a float's last bit is not
  -- that. March has no scalar xor, so this is Horner rather than FNV.
  pfn hash_u8(a : NativeU8Arr, n : Int, i : Int, h : Int) : Int do
    if i >= n do h
    else hash_u8(a, n, i + 1, (h * 131 + NativeArray.get_u8(a, i)) % 1073741789) end
  end
  doc "A hash of the field's heights, water flags and biome ids: an oracle for regression tests over the whole field."
  fn state_hash(f : Field, n : Int) : Int do
    match f do
      Field(hs, ws, _, _, bs, _, _, _, _) ->
        hash_u8(bs, n * n, 0, hash_u8(ws, n * n, 0, hash_u8(hs, n * n, 0, 7)))
    end
  end

end
