-- Marker — a small flat quad floating well above any possible terrain height,
-- so it draws correctly with ordinary depth testing: nothing is ever above it,
-- so it is always visible from a top-down camera even when the player is
-- underground. Rebuilt in place at the player's (x, z) each frame the map
-- view is shown.
mod CubeForge.Marker do

  alias CubeForge.F32Buf as B
  alias CubeForge.Vertex as Vx

  doc "Height the marker floats at (above the 256-voxel-tall world)."
  fn y() : Float do 260.0 end
  fn half_size() : Float do 1.5 end

  pfn v(b : CubeForge.F32Buf.F32Buf, x : Float, y : Float, z : Float, r : Float, g : Float, bl : Float) : CubeForge.F32Buf.F32Buf do
    b |> B.push3(x, y, z) |> B.push(r) |> B.push(g) |> B.push(bl) |> B.push(1.0) |> B.push(0.0) |> B.push(Vx.plain())
  end

  doc "Rebuild [b] (cleared in place) with a flat marker quad centred over (px, pz)."
  fn build(b : CubeForge.F32Buf.F32Buf, px : Float, pz : Float) : CubeForge.F32Buf.F32Buf do
    let y0 = y()
    let x0 = px -. half_size()
    let x1 = px +. half_size()
    let z0 = pz -. half_size()
    let z1 = pz +. half_size()
    -- winding matches the mesher's top face (visible looking down -Y): (x0,z0)->(x0,z1)->(x1,z1)->(x1,z0)
    B.clear(b)
    |> v(x0, y0, z0, 1.0, 0.15, 0.1) |> v(x0, y0, z1, 1.0, 0.15, 0.1) |> v(x1, y0, z1, 1.0, 0.15, 0.1)
    |> v(x0, y0, z0, 1.0, 0.15, 0.1) |> v(x1, y0, z1, 1.0, 0.15, 0.1) |> v(x1, y0, z0, 1.0, 0.15, 0.1)
  end

  fn vertex_count() : Int do 6 end
  fn slot() : Int do 250 end

end
