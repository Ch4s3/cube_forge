-- Poi — the half of a point of interest that a heightmap cannot express.
--
-- Landform POIs are terms in `Noise.height` (see `Noise.butte_of` and
-- `Noise.arch_of`, and the POI design, section 2): a rarity mask times a shape,
-- evaluated per column, probing nothing expensive. That is what gets a feature
-- its surface materials, its strata, its talus, its trees -- everything the
-- generator does to ground.
--
-- But a heightmap has exactly one surface per column, so it cannot have a HOLE
-- in it. The natural arch is a fin of land (the landform) with an opening
-- punched through it (here). Both halves read the same hashed site from
-- `Noise`, so they cannot disagree about where the arch is or how big it is.
--
-- The carve runs after the chunk is filled, planted and its caves cut, and it
-- removes only ground: never water, so a river under an arch stays a river, and
-- never bedrock.
mod CubeForge.Poi do

  alias CubeForge.Noise as N
  alias CubeForge.Chunk as C

  doc "How far outside a chunk an arch cell may sit and still cut into it: the opening's half-width plus the fin's half-thickness, rounded up."
  fn arch_reach() : Int do 26 end

  pfn floor_div(a : Int, b : Int) : Int do if a >= 0 do a / b else (a - b + 1) / b end end

  doc "May the carve take this block: anything but air, water and bedrock. Trees standing where the opening goes are removed along with the rock under them."
  fn carvable(id : Int) : Bool do
    if id == 0 do false else if id == C.bedrock() do false else !C.is_water(id) end end
  end

  -- One column of the opening: clear from the floor up to where the ellipse
  -- closes. The opening stands ON the ground the fin grew from, so its floor is
  -- `height_base` -- the terrain before any point of interest touched it.
  pfn hole_y_go(c : CubeForge.Chunk.Chunk, x : Int, z : Int, y : Int, y1 : Int) : CubeForge.Chunk.Chunk do
    if y > y1 do c
    else
      let c1 = if y < 1 || y >= 256 do c
               else if !carvable(C.get(c, x, y, z)) do c
               else C.set(c, x, y, z, 0) end end
      hole_y_go(c1, x, z, y + 1, y1)
    end
  end

  -- Every column of the chunk against one arch: 256 columns is cheaper to walk
  -- than the arch's own footprint, and it needs no clipping.
  pfn hole_col_go(c : CubeForge.Chunk.Chunk, wx0 : Int, wz0 : Int, seed : Int,
                  cx : Int, cz : Int, i : Int, yf : Int) : CubeForge.Chunk.Chunk do
    if i >= 256 do c
    else
      let x = i % 16
      let z = i / 16
      let u = N.arch_u(cx, cz, seed, wx0 + x, wz0 + z)
      let v = N.arch_v(cx, cz, seed, wx0 + x, wz0 + z)
      let hw = int_to_float(N.arch_hole_w(cx, cz, seed))
      let hh = int_to_float(N.arch_hole_h(cx, cz, seed))
      -- through the whole fin and a little past it, so the opening is a hole
      -- rather than a pair of alcoves
      let t = int_to_float(N.arch_fin(cx, cz, seed)) +. 2.0
      let q = 1.0 -. (u /. hw) *. (u /. hw)
      if Math.abs(v) > t do hole_col_go(c, wx0, wz0, seed, cx, cz, i + 1, yf)
      else if q <= 0.0 do hole_col_go(c, wx0, wz0, seed, cx, cz, i + 1, yf)
      else
        -- the ellipse's height at this offset along the fin
        let top = yf + float_to_int(hh *. Math.sqrt(q))
        hole_col_go(hole_y_go(c, x, z, yf, top), wx0, wz0, seed, cx, cz, i + 1, yf)
      end end
    end
  end

  pfn arch_cell_go(c : CubeForge.Chunk.Chunk, wx0 : Int, wz0 : Int, seed : Int, cx : Int, cz : Int, scale : Float) : CubeForge.Chunk.Chunk do
    if !N.arch_here(cx, cz, seed, scale) do c
    else hole_col_go(c, wx0, wz0, seed, cx, cz, 0, N.height_base(N.arch_sx(cx, cz, seed), N.arch_sz(cx, cz, seed), seed) + 1) end
  end

  pfn stamp_go(c : CubeForge.Chunk.Chunk, wx0 : Int, wz0 : Int, seed : Int, i : Int, cx0 : Int, cz0 : Int, nx : Int, nz : Int, scale : Float) : CubeForge.Chunk.Chunk do
    if i >= nx * nz do c
    else
      stamp_go(arch_cell_go(c, wx0, wz0, seed, cx0 + i % nx, cz0 + i / nx, scale),
               wx0, wz0, seed, i + 1, cx0, cz0, nx, nz, scale)
    end
  end

  doc "Cut every structure point of interest that reaches into the chunk at (wx0, wz0). At Noise.arch_cell() 160 and arch_reach() 26 that is at most a 2x2 of cells."
  fn stamp(c : CubeForge.Chunk.Chunk, wx0 : Int, wz0 : Int, seed : Int) : CubeForge.Chunk.Chunk do
    let scale = N.poi_scale()
    if scale <= 0.0 do c
    else
      let r = arch_reach()
      let a = N.arch_cell()
      let cx0 = floor_div(wx0 - r, a)
      let cz0 = floor_div(wz0 - r, a)
      -- the two spans are computed separately: at a 160-block cell and 16-block
      -- chunks they are not always the same number
      stamp_go(c, wx0, wz0, seed, 0, cx0, cz0,
               floor_div(wx0 + 15 + r, a) - cx0 + 1, floor_div(wz0 + 15 + r, a) - cz0 + 1, scale)
    end
  end

end
