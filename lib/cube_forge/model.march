-- Model — small things drawn as sculptures inside their cell.
--
-- A shape is an 8x8x8 grid of palette indices (0 empty), built procedurally
-- here the way texture.march builds every texture. Each shape is greedy-meshed
-- ONCE into a template: ordinary 9-float vertices with cell-local positions in
-- [0, 1], a uv pointing at one texel of the palette layer, shade 1. The
-- mesher stamps a template into a cell by adding the cell's origin and writing
-- the cell's shade (Mesher.stamp). Every template lives in one Templates value -- a float
-- blob with offsets -- that rides in the World beside the shown species, so
-- the mesher reaches it without a new parameter on every remesh call.
--
-- World state never changes: block ids, items, icons, saves, collision and
-- light are what they were. This is skin.
mod CubeForge.Model do

  alias CubeForge.F32Buf as B
  alias CubeForge.Vertex as Vx
  alias CubeForge.Species as S

  doc "Sub-cubes along a cell edge."
  fn size() : Int do 8 end
  doc "Flat index of a sub-cube, x fastest, then z, then y: the chunk's order."
  fn idx(x : Int, y : Int, z : Int) : Int do x + 8 * (z + 8 * y) end

  -- ── Template ids ──────────────────────────────────────────────────────────
  doc "Templates: mushroom sp 1..6 -> 0..5, frond dir 0..7 -> 6..13, frond umbrella 14, frond tuft 15, bush variant 0..3 -> 16..19, crystal variant 0..3 -> 20..23."
  fn count() : Int do 24 end
  fn t_mushroom(sp : Int) : Int do sp - 1 end
  fn t_frond(dir : Int) : Int do 6 + dir end
  fn t_umbrella() : Int do 14 end
  fn t_tuft() : Int do 15 end
  fn t_bush(variant : Int) : Int do 16 + variant end
  doc "Crystal blades, four leans. A selenite beam is a shaft, not a cube: at one block per crystal the caverns read as a stack of boxes, and this is what the model layer is for."
  fn t_crystal(variant : Int) : Int do 20 + variant end

  doc "Face caps, per shape, that the tests hold every template under."
  fn face_cap(k : Int) : Int do if k <= 5 do 160 else if k <= 15 do 120 else if k <= 19 do 100 else 120 end end end end

  -- ── The palette: one texture layer, texel k is colour k ─────────────────
  doc "The texture layer whose 256 texels are the model colours."
  fn palette_layer() : Float do 91.0 end
  doc "uv of the centre of palette texel k."
  fn palette_u(k : Int) : Float do (int_to_float(k % 16) +. 0.5) /. 16.0 end
  fn palette_v(k : Int) : Float do (int_to_float(k / 16) +. 0.5) /. 16.0 end

  -- 1..6 species caps, 7..12 their gills, then stem, soil, frond and bush tones.
  fn c_cap(sp : Int) : Int do sp end
  fn c_gill(sp : Int) : Int do 6 + sp end
  fn c_stem() : Int do 13 end
  fn c_stem_shade() : Int do 14 end
  fn c_soil_dark() : Int do 15 end
  fn c_soil_light() : Int do 16 end
  fn c_frond() : Int do 17 end
  fn c_frond_dark() : Int do 18 end
  fn c_midrib() : Int do 19 end
  fn c_bush() : Int do 20 end
  fn c_bush_light() : Int do 21 end
  fn c_bush_stem() : Int do 22 end
  -- Fauna. Animals are Model templates too (CubeForge.Fauna builds them with
  -- `template_n`), so their colours live in the same palette layer.
  -- The two accents every animal shares. A species' own three tones are
  -- generated (CubeForge.Fauna.palette_base and up), not listed here: sixteen
  -- species is a table, and forty-eight literals in this chain is not one.
  fn c_beak() : Int do 26 end
  fn c_eye() : Int do 30 end
  doc "Selenite: milky cream, and its brighter tip, above the fauna's range (32 + 3 x 18 species). Naica's crystals are gypsum with a warm cast, not the blue-green a crystal is usually drawn as."
  fn c_crystal() : Int do 86 end
  fn c_crystal_pale() : Int do 87 end

  doc "Palette colour k, red channel."
  fn colour_r(k : Int) : Int do
    if k >= 1 && k <= 6 do S.colour_r(k)
    else if k >= 7 && k <= 12 do S.colour_r(k - 6) * 6 / 10
    else if k == 13 do 235 else if k == 14 do 200 else if k == 15 do 70 else if k == 16 do 100
    else if k == 17 do 84 else if k == 18 do 60 else if k == 19 do 130
    else if k == 20 do 62 else if k == 21 do 90 else if k == 22 do 90
    else if k == 23 do 150 else if k == 24 do 118 else if k == 25 do 226 else if k == 26 do 54
    else if k == 27 do 226 else if k == 28 do 236 else if k == 29 do 240 else if k == 30 do 24
    else if k == 86 do 244 else if k == 87 do 248
    else 0 end end end end end end end end end end end end end end end end end end end end end end
  end
  fn colour_g(k : Int) : Int do
    if k >= 1 && k <= 6 do S.colour_g(k)
    else if k >= 7 && k <= 12 do S.colour_g(k - 6) * 6 / 10
    else if k == 13 do 225 else if k == 14 do 190 else if k == 15 do 48 else if k == 16 do 72
    else if k == 17 do 150 else if k == 18 do 115 else if k == 19 do 190
    else if k == 20 do 128 else if k == 21 do 160 else if k == 22 do 64
    else if k == 23 do 112 else if k == 24 do 86 else if k == 25 do 214 else if k == 26 do 44
    else if k == 27 do 134 else if k == 28 do 146 else if k == 29 do 236 else if k == 30 do 20
    else if k == 86 do 240 else if k == 87 do 250
    else 0 end end end end end end end end end end end end end end end end end end end end end end
  end
  fn colour_b(k : Int) : Int do
    if k >= 1 && k <= 6 do S.colour_b(k)
    else if k >= 7 && k <= 12 do S.colour_b(k - 6) * 6 / 10
    else if k == 13 do 200 else if k == 14 do 165 else if k == 15 do 38 else if k == 16 do 50
    else if k == 17 do 62 else if k == 18 do 45 else if k == 19 do 90
    else if k == 20 do 54 else if k == 21 do 70 else if k == 22 do 40
    else if k == 23 do 72 else if k == 24 do 56 else if k == 25 do 196 else if k == 26 do 36
    else if k == 27 do 62 else if k == 28 do 52 else if k == 29 do 226 else if k == 30 do 18
    else if k == 86 do 226 else if k == 87 do 244
    else 0 end end end end end end end end end end end end end end end end end end end end end end
  end

  -- ── Grids of any side ─────────────────────────────────────────────────────
  -- Block models are 8 sub-cubes a side; that is a good size for a mushroom
  -- sitting in a cell and too coarse for an animal, where an eighth of a block
  -- is the thinnest a wing can be and everything reads as a slab. So the grid
  -- builders and the greedy pass below take a side, and the 8-cube versions are
  -- the special case the block models use. See CubeForge.Fauna.grid.
  doc "Flat index of a sub-cube in a grid [n] a side."
  fn idx_n(n : Int, x : Int, y : Int, z : Int) : Int do x + n * (z + n * y) end
  doc "An empty grid [n] a side."
  fn empty_n(n : Int) : NativeU8Arr do NativeArray.make_u8(n * n * n, 0) end
  doc "Set one sub-cube of a grid [n] a side, ignoring anything outside it."
  fn put_n(g : NativeU8Arr, n : Int, x : Int, y : Int, z : Int, k : Int) : NativeU8Arr do
    if x < 0 || y < 0 || z < 0 || x >= n || y >= n || z >= n do g else NativeArray.set_u8(g, idx_n(n, x, y, z), k) end
  end
  doc "Read one sub-cube of a grid [n] a side; outside it reads empty."
  fn cell_n(g : NativeU8Arr, n : Int, x : Int, y : Int, z : Int) : Int do
    if x < 0 || y < 0 || z < 0 || x >= n || y >= n || z >= n do 0 else NativeArray.get_u8(g, idx_n(n, x, y, z)) end
  end
  pfn lo(a : Int, b : Int) : Int do if a < b do a else b end end
  pfn hi(a : Int, b : Int) : Int do if a < b do b else a end end

  doc """
  Fill the box [x0, x1] x [y0, y1] x [z0, z1] of a grid [n] a side.

  The bounds are SORTED, not required in order. An inverted range used to be an
  empty one -- the cell count came out zero or negative and the loop wrote
  nothing -- and that silence cost three real bugs in the fauna bodies: a tail
  sweeping toward -z whose connector arrived descending, and two birds whose
  wing taper crossed itself on a short body, all of which produced a body that
  built cleanly and was simply missing a part. A caller that hands over a
  reversed range means the box between the two, and gets it.
  """
  fn box_n(g : NativeU8Arr, n : Int, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int, k : Int) : NativeU8Arr do
    let xa = lo(x0, x1)
    let xb = hi(x0, x1)
    let ya = lo(y0, y1)
    let yb = hi(y0, y1)
    let za = lo(z0, z1)
    let zb = hi(z0, z1)
    box_n_go(g, n, xa, ya, za, xb, yb, zb, k, 0, (xb - xa + 1) * (yb - ya + 1) * (zb - za + 1))
  end
  pfn box_n_go(g : NativeU8Arr, n : Int, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int, k : Int, i : Int, cnt : Int) : NativeU8Arr do
    if i >= cnt do g
    else
      let w = x1 - x0 + 1
      let d = z1 - z0 + 1
      box_n_go(put_n(g, n, x0 + i % w, y0 + i / (w * d), z0 + (i / w) % d, k), n, x0, y0, z0, x1, y1, z1, k, i + 1, cnt)
    end
  end

  -- ── Shapes ────────────────────────────────────────────────────────────────
  fn empty() : NativeU8Arr do NativeArray.make_u8(512, 0) end

  doc "Set one sub-cube, ignoring anything outside the grid. Public because CubeForge.Fauna builds its bodies from the same primitives."
  fn put(g : NativeU8Arr, x : Int, y : Int, z : Int, k : Int) : NativeU8Arr do
    if x < 0 || y < 0 || z < 0 || x >= 8 || y >= 8 || z >= 8 do g else NativeArray.set_u8(g, idx(x, y, z), k) end
  end
  doc "Fill the box [x0, x1] x [y0, y1] x [z0, z1]."
  fn box(g : NativeU8Arr, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int, k : Int) : NativeU8Arr do
    box_go(g, x0, y0, z0, x1, y1, z1, k, 0, (x1 - x0 + 1) * (y1 - y0 + 1) * (z1 - z0 + 1))
  end
  pfn box_go(g : NativeU8Arr, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int, k : Int, i : Int, n : Int) : NativeU8Arr do
    if i >= n do g
    else
      let w = x1 - x0 + 1
      let d = z1 - z0 + 1
      box_go(put(g, x0 + i % w, y0 + i / (w * d), z0 + (i / w) % d, k), x0, y0, z0, x1, y1, z1, k, i + 1, n)
    end
  end

  doc "A small mushroom of species [sp]: a two-wide soil patch, a tapering stem, a round cap with gills under it."
  fn mushroom(sp : Int) : NativeU8Arr do
    let g0 = box(box(empty(), 3, 0, 3, 4, 0, 4, c_soil_dark()), 3, 0, 4, 3, 0, 4, c_soil_light())
    let g1 = box(box(g0, 3, 1, 3, 4, 1, 4, c_stem_shade()), 3, 2, 3, 4, 3, 4, c_stem())
    -- the cap: gills as its underside layer, then a rounded body
    let g2 = box(g1, 2, 4, 2, 5, 4, 5, c_gill(sp))
    let g3 = box(g2, 1, 5, 1, 6, 5, 6, c_cap(sp))
    -- round the widest layer: knock the four corners out
    let g4 = put(put(put(put(g3, 1, 5, 1, 0), 6, 5, 1, 0), 1, 5, 6, 0), 6, 5, 6, 0)
    box(box(g4, 2, 6, 2, 5, 6, 5, c_cap(sp)), 3, 7, 3, 4, 7, 4, c_cap(sp))
  end

  -- The blade's height along its length: rises at the trunk side, droops outward.
  pfn blade_y(t : Int) : Int do 7 - t * t / 12 end
  pfn blade_colour(t : Int, w : Int) : Int do
    if w == 0 do c_midrib() else if t % 2 == 0 do c_frond() else c_frond_dark() end end
  end
  -- One sub-cube of a blade for direction [dir], length step t (0 at the trunk
  -- side), width step w (-1..1). Axis directions run along x or z three wide;
  -- diagonals run along both, the width offset perpendicular to the run.
  pfn blade_cell(g : NativeU8Arr, dir : Int, t : Int, w : Int) : NativeU8Arr do
    let y = blade_y(t)
    let k = blade_colour(t, w)
    if dir == 0 do put(g, t, y, 3 + w, k)
    else if dir == 1 do put(g, 3 + w, y, t, k)
    else if dir == 2 do put(g, 7 - t, y, 3 + w, k)
    else if dir == 3 do put(g, 3 + w, y, 7 - t, k)
    else if dir == 4 do put(g, t + w, y, t - w, k)
    else if dir == 5 do put(g, 7 - t + w, y, t + w, k)
    else if dir == 6 do put(g, 7 - t + w, y, 7 - t - w, k)
    else put(g, t + w, y, 7 - t + w, k) end end end end end end end
  end
  pfn blade_go(g : NativeU8Arr, dir : Int, i : Int) : NativeU8Arr do
    if i >= 24 do g else blade_go(blade_cell(g, dir, i / 3, i % 3 - 1), dir, i + 1) end
  end
  doc "A palm frond pointing in [dir] (0..3 the axes +x, +z, -x, -z; 4..7 the diagonals +x+z, -x+z, -x-z, +x-z), the trunk on the far side."
  fn frond(dir : Int) : NativeU8Arr do blade_go(empty(), dir, 0) end

  -- Four short blades from the centre, one per axis, for the crown centre.
  pfn umbrella_go(g : NativeU8Arr, i : Int) : NativeU8Arr do
    if i >= 16 do g
    else
      let d = i / 4
      let t = i % 4
      let y = 7 - t
      let k = if t == 3 do c_frond_dark() else c_frond() end
      let g1 = if d == 0 do box(g, 4 + t, y, 3, 4 + t, y, 4, k)
               else if d == 1 do box(g, 3, y, 4 + t, 4, y, 4 + t, k)
               else if d == 2 do box(g, 3 - t, y, 3, 3 - t, y, 4, k)
               else box(g, 3, y, 3 - t, 4, y, 3 - t, k) end end end
      umbrella_go(g1, i + 1)
    end
  end
  doc "The crown centre: an umbrella of four short blades over the trunk top."
  fn frond_umbrella() : NativeU8Arr do umbrella_go(empty(), 0) end

  doc "A frond with nothing to hang from: a drooping tuft."
  fn frond_tuft() : NativeU8Arr do
    let g0 = box(empty(), 3, 5, 3, 4, 7, 4, c_frond_dark())
    -- four arms two out at y 6, tips three out at y 5
    let g1 = box(box(box(box(g0, 1, 6, 3, 2, 6, 4, c_frond()), 5, 6, 3, 6, 6, 4, c_frond()), 3, 6, 1, 4, 6, 2, c_frond()), 3, 6, 5, 4, 6, 6, c_frond())
    box(box(box(box(g1, 0, 5, 3, 0, 5, 4, c_midrib()), 7, 5, 3, 7, 5, 4, c_midrib()), 3, 5, 0, 4, 5, 0, c_midrib()), 3, 5, 7, 4, 5, 7, c_midrib())
  end

  -- A bush: a low mound of overlapping leaf plates on a short stem, wider at
  -- the middle than the top, offset by variant so a clump does not repeat.
  -- Plates are one sub-cube thick and touch, so the greedy pass merges their
  -- shared faces away and the mound stays well under its face cap.
  pfn plate_go(g : NativeU8Arr, v : Int, i : Int) : NativeU8Arr do
    if i >= 4 do g
    else
      -- half-widths per layer: 1, 2, 1, 0 (a 2x2 cap) -- a rounded mound. Five
      -- layers read no better and cost a third more vertices world-wide.
      let hw = if i == 0 do 1 else if i == 1 do 2 else if i == 2 do 1 else 0 end end end
      let y = 1 + i
      -- the mound leans with the variant: its centre slides one sub-cube
      let cx = 3 + (if v % 2 == 1 && i >= 2 do 1 else 0 end)
      let cz = 3 + (if v >= 2 && i >= 2 do 1 else 0 end)
      let k = if (i + v) % 2 == 0 do c_bush() else c_bush_light() end
      let g1 = box(g, cx - hw, y, cz - hw, cx + 1 + hw, y, cz + 1 + hw, k)
      -- bite a corner out of the wide layers so the outline is not a square
      let g2 = if hw == 2 do put(put(g1, cx - hw, y, cz - hw, 0), cx + 1 + hw, y, cz + 1 + hw, 0) else g1 end
      plate_go(g2, v, i + 1)
    end
  end
  doc "A bush leaf block as a low leafy mound, variant 0..3."
  fn bush(variant : Int) : NativeU8Arr do
    plate_go(box(empty(), 3, 0, 3, 4, 0, 4, c_bush_stem()), variant, 0)
  end

  -- ── Crystal blades ───────────────────────────────────────────────────────
  -- Naica's selenite: long shafts leaning across each other, not cubes. A blade
  -- is drawn by walking its length and laying a square down at each step,
  -- tapering to a point, so the whole thing is one line of code per beam.

  -- A blade from (bx, bz) on the floor to (tx, tz) at height [h], tapering.
  pfn beam_go(g : NativeU8Arr, bx : Int, bz : Int, tx : Int, tz : Int, h : Int, t : Int) : NativeU8Arr do
    if t > h do g
    else
      let x = bx + (tx - bx) * t / h
      let z = bz + (tz - bz) * t / h
      -- two thick for the first two thirds, one at the point
      let w = if t * 3 < h * 2 do 1 else 0 end
      let k = if t * 4 < h * 3 do c_crystal() else c_crystal_pale() end
      beam_go(box(g, x - w, t, z - w, x, t, z, k), bx, bz, tx, tz, h, t + 1)
    end
  end

  doc "A cluster of selenite blades, variant 0..3: a long lean and a short one across it, so a run of cells reads as beams crossing rather than a row of spikes."
  fn crystal(v : Int) : NativeU8Arr do
    let bx = if v == 0 do 2 else if v == 1 do 5 else if v == 2 do 2 else 4 end end end
    let bz = if v == 0 do 2 else if v == 1 do 2 else if v == 2 do 5 else 4 end end end
    let tx = if v == 0 do 6 else if v == 1 do 2 else if v == 2 do 6 else 4 end end end
    let tz = if v == 0 do 6 else if v == 1 do 6 else if v == 2 do 3 else 7 end end end
    let a = beam_go(empty(), bx, bz, tx, tz, 7, 0)
    if v == 3 do a else beam_go(a, 6 - bx, 6 - bz, 6 - tx, 5 - tz, 5, 0) end
  end

  doc "The grid for template id [k]."
  fn shape(k : Int) : NativeU8Arr do
    if k <= 5 do mushroom(k + 1)
    else if k <= 13 do frond(k - 6)
    else if k == 14 do frond_umbrella()
    else if k == 15 do frond_tuft()
    else if k <= 19 do bush(k - 16)
    else crystal(k - 20) end end end end end
  end

  -- ── Templates: greedy over the 8x8x8 grid, once ─────────────────────────
  -- Directions as the mesher numbers them: 0 +y, 1 -y, 2 +x, 3 -x, 4 +z, 5 -z.
  pfn dox(d : Int) : Int do if d == 2 do 1 else if d == 3 do 0 - 1 else 0 end end end
  pfn doy(d : Int) : Int do if d == 0 do 1 else if d == 1 do 0 - 1 else 0 end end end
  pfn doz(d : Int) : Int do if d == 4 do 1 else if d == 5 do 0 - 1 else 0 end end end
  fn cell(g : NativeU8Arr, x : Int, y : Int, z : Int) : Int do
    if x < 0 || y < 0 || z < 0 || x >= 8 || y >= 8 || z >= 8 do 0 else NativeArray.get_u8(g, idx(x, y, z)) end
  end
  -- Grid coordinates of mask cell (u, v) in slice a of direction d.
  pfn gx(d : Int, a : Int, u : Int, _v : Int) : Int do if d <= 1 do u else if d <= 3 do a else u end end end
  pfn gy(d : Int, a : Int, _u : Int, v : Int) : Int do if d <= 1 do a else v end end
  pfn gz(d : Int, a : Int, u : Int, v : Int) : Int do if d <= 1 do v else if d <= 3 do u else a end end end
  -- The colour of the face at (u, v) in the slice, or 0 when there is none.
  pfn face_at(g : NativeU8Arr, n : Int, d : Int, a : Int, u : Int, v : Int) : Int do
    let x = gx(d, a, u, v)
    let y = gy(d, a, u, v)
    let z = gz(d, a, u, v)
    let k = cell_n(g, n, x, y, z)
    if k == 0 do 0
    else if cell_n(g, n, x + dox(d), y + doy(d), z + doz(d)) != 0 do 0
    else k end end
  end
  -- ── The greedy pass, over the shape's bounding box ────────────────────────
  -- The sweep is 6n slices of n x n mask cells, and a body fills a fraction of
  -- its grid -- an animal is maybe a third of it, and the slices past its nose
  -- and beyond its wingtips are empty. Scanning them is the whole cost at a
  -- fine grid: at 64 cells a side the 54 fauna templates took 2.4 seconds of
  -- startup, against 0.3 at 32.
  --
  -- So the box holding every filled cell is found once, and both the fill and
  -- the greedy walk stay inside it. Mask cells outside are never written and
  -- never read, so they stay 0 from the allocation.
  type Box = Box(Int, Int, Int, Int, Int, Int)
  fn box_x0(b : Box) : Int do match b do Box(v, _, _, _, _, _) -> v end end
  fn box_x1(b : Box) : Int do match b do Box(_, v, _, _, _, _) -> v end end
  fn box_y0(b : Box) : Int do match b do Box(_, _, v, _, _, _) -> v end end
  fn box_y1(b : Box) : Int do match b do Box(_, _, _, v, _, _) -> v end end
  fn box_z0(b : Box) : Int do match b do Box(_, _, _, _, v, _) -> v end end
  fn box_z1(b : Box) : Int do match b do Box(_, _, _, _, _, v) -> v end end

  pfn bbox_go(g : NativeU8Arr, n : Int, i : Int, b : Box) : Box do
    if i >= n * n * n do b
    else if NativeArray.get_u8(g, i) == 0 do bbox_go(g, n, i + 1, b)
    else
      let x = i % n
      let z = (i / n) % n
      let y = i / (n * n)
      match b do
        Box(x0, x1, y0, y1, z0, z1) ->
          bbox_go(g, n, i + 1, Box(if x < x0 do x else x0 end, if x > x1 do x else x1 end,
                                   if y < y0 do y else y0 end, if y > y1 do y else y1 end,
                                   if z < z0 do z else z0 end, if z > z1 do z else z1 end))
      end
    end end
  end
  doc "The smallest box holding every filled cell of a grid [n] a side. Empty grids come back inverted, which every loop below reads as nothing to do."
  fn bbox(g : NativeU8Arr, n : Int) : Box do bbox_go(g, n, 0, Box(n, 0 - 1, n, 0 - 1, n, 0 - 1)) end

  -- The slice axis and the two mask axes, per direction: d 0/1 slice y over
  -- (x, z); d 2/3 slice x over (z, y); d 4/5 slice z over (x, y).
  pfn axis_lo(b : Box, which : Int) : Int do
    if which == 0 do box_x0(b) else if which == 1 do box_y0(b) else box_z0(b) end end
  end
  pfn axis_hi(b : Box, which : Int) : Int do
    if which == 0 do box_x1(b) else if which == 1 do box_y1(b) else box_z1(b) end end
  end
  pfn slice_axis(d : Int) : Int do if d <= 1 do 1 else if d <= 3 do 0 else 2 end end end
  pfn u_axis(d : Int) : Int do if d <= 1 do 0 else if d <= 3 do 2 else 0 end end end
  pfn v_axis(d : Int) : Int do if d <= 1 do 2 else 1 end end

  pfn fill_row(g : NativeU8Arr, n : Int, d : Int, a : Int, v : Int, u : Int, uhi : Int, mask : NativeIntArr) : NativeIntArr do
    if u > uhi do mask
    else fill_row(g, n, d, a, v, u + 1, uhi, NativeArray.set_int(mask, u + n * v, face_at(g, n, d, a, u, v))) end
  end
  pfn fill_go(g : NativeU8Arr, n : Int, d : Int, a : Int, ulo : Int, uhi : Int, v : Int, vhi : Int, mask : NativeIntArr) : NativeIntArr do
    if v > vhi do mask
    else fill_go(g, n, d, a, ulo, uhi, v + 1, vhi, fill_row(g, n, d, a, v, ulo, uhi, mask)) end
  end
  pfn run_w(mask : NativeIntArr, n : Int, uhi : Int, u : Int, v : Int, k : Int, wd : Int) : Int do
    if u + wd > uhi do wd
    else if NativeArray.get_int(mask, u + wd + n * v) == k do run_w(mask, n, uhi, u, v, k, wd + 1) else wd end end
  end
  pfn row_ok(mask : NativeIntArr, n : Int, u : Int, v : Int, k : Int, wd : Int, j : Int) : Bool do
    if j >= wd do true
    else if NativeArray.get_int(mask, u + j + n * v) == k do row_ok(mask, n, u, v, k, wd, j + 1) else false end end
  end
  pfn run_h(mask : NativeIntArr, n : Int, vhi : Int, u : Int, v : Int, k : Int, wd : Int, h : Int) : Int do
    if v + h > vhi do h
    else if row_ok(mask, n, u, v + h, k, wd, 0) do run_h(mask, n, vhi, u, v, k, wd, h + 1) else h end end
  end
  pfn clear_go(mask : NativeIntArr, n : Int, u : Int, v : Int, wd : Int, h : Int, j : Int) : NativeIntArr do
    if j >= wd * h do mask else clear_go(NativeArray.set_int(mask, u + j % wd + n * (v + j / wd), 0), n, u, v, wd, h, j + 1) end
  end

  fn face_float(d : Int) : Float do int_to_float(d) end
  pfn vert(b : CubeForge.F32Buf.F32Buf, x : Float, y : Float, z : Float, k : Int, d : Int) : CubeForge.F32Buf.F32Buf do
    -- a crystal blade lights its own faces with its own colour (Vertex.fx_selflit)
    B.push_vertex(b, x, y, z, palette_u(k), palette_v(k), palette_layer(), 1.0, face_float(d), if k == c_crystal() || k == c_crystal_pale() do Vx.selflit() else Vx.plain() end)
  end
  pfn quad(b : CubeForge.F32Buf.F32Buf, x0 : Float, y0 : Float, z0 : Float, x1 : Float, y1 : Float, z1 : Float,
           x2 : Float, y2 : Float, z2 : Float, x3 : Float, y3 : Float, z3 : Float, k : Int, d : Int) : CubeForge.F32Buf.F32Buf do
    b |> vert(x0, y0, z0, k, d) |> vert(x1, y1, z1, k, d) |> vert(x2, y2, z2, k, d)
      |> vert(x0, y0, z0, k, d) |> vert(x2, y2, z2, k, d) |> vert(x3, y3, z3, k, d)
  end
  -- One merged rectangle, wound as Mesher.emit_rect winds each direction, at 1/n scale.
  pfn emit(b : CubeForge.F32Buf.F32Buf, n : Int, d : Int, a : Int, u : Int, v : Int, wd : Int, h : Int, k : Int) : CubeForge.F32Buf.F32Buf do
    let s = 1.0 /. int_to_float(n)
    let fa = int_to_float(a) *. s
    let fa1 = fa +. s
    let fu = int_to_float(u) *. s
    let fv = int_to_float(v) *. s
    let fu1 = fu +. int_to_float(wd) *. s
    let fv1 = fv +. int_to_float(h) *. s
    if d == 0 do quad(b, fu, fa1, fv, fu, fa1, fv1, fu1, fa1, fv1, fu1, fa1, fv, k, d)
    else if d == 1 do quad(b, fu, fa, fv, fu1, fa, fv, fu1, fa, fv1, fu, fa, fv1, k, d)
    -- d 2/3: a = x, u = z, v = y
    else if d == 2 do quad(b, fa1, fv, fu, fa1, fv1, fu, fa1, fv1, fu1, fa1, fv, fu1, k, d)
    else if d == 3 do quad(b, fa, fv, fu1, fa, fv1, fu1, fa, fv1, fu, fa, fv, fu, k, d)
    -- d 4/5: a = z, u = x, v = y
    else if d == 4 do quad(b, fu1, fv, fa1, fu1, fv1, fa1, fu, fv1, fa1, fu, fv, fa1, k, d)
    else quad(b, fu, fv, fa, fu, fv1, fa, fu1, fv1, fa, fu1, fv, fa, k, d) end end end end end
  end

  type Greedy = Greedy(CubeForge.F32Buf.F32Buf, NativeIntArr)
  pfn greedy_row(g : Greedy, n : Int, d : Int, a : Int, ulo : Int, uhi : Int, vhi : Int, u : Int, v : Int) : Greedy do
    if u > uhi do g
    else
      match g do
        Greedy(b, mask) ->
          let k = NativeArray.get_int(mask, u + n * v)
          if k == 0 do greedy_row(Greedy(b, mask), n, d, a, ulo, uhi, vhi, u + 1, v)
          else
            let wd = run_w(mask, n, uhi, u, v, k, 1)
            let h = run_h(mask, n, vhi, u, v, k, wd, 1)
            greedy_row(Greedy(emit(b, n, d, a, u, v, wd, h, k), clear_go(mask, n, u, v, wd, h, 0)), n, d, a, ulo, uhi, vhi, u + 1, v)
          end
      end
    end
  end
  pfn greedy_go(g : Greedy, n : Int, d : Int, a : Int, ulo : Int, uhi : Int, v : Int, vhi : Int) : Greedy do
    if v > vhi do g
    else greedy_go(greedy_row(g, n, d, a, ulo, uhi, vhi, ulo, v), n, d, a, ulo, uhi, v + 1, vhi) end
  end
  pfn slices_go(g : Greedy, grid : NativeU8Arr, n : Int, bb : Box, d : Int, a : Int, ahi : Int) : Greedy do
    if a > ahi do g
    else
      let ulo = axis_lo(bb, u_axis(d))
      let uhi = axis_hi(bb, u_axis(d))
      let vlo = axis_lo(bb, v_axis(d))
      let vhi = axis_hi(bb, v_axis(d))
      match g do
        Greedy(b, mask) ->
          slices_go(greedy_go(Greedy(b, fill_go(grid, n, d, a, ulo, uhi, vlo, vhi, mask)), n, d, a, ulo, uhi, vlo, vhi),
                    grid, n, bb, d, a + 1, ahi)
      end
    end
  end
  -- Slices are walked within [m, n - 1 - m]: the cells of a margin (see
  -- template_inner) are neighbours, read by face_at and never emitting.
  pfn dirs_go(g : Greedy, grid : NativeU8Arr, n : Int, bb : Box, d : Int, m : Int) : Greedy do
    if d >= 6 do g
    else
      -- A face can sit one slice OUTSIDE the filled box, on the far side of the
      -- outermost cell, so each axis is walked one past its bound.
      let alo = axis_lo(bb, slice_axis(d)) - 1
      let ahi = axis_hi(bb, slice_axis(d)) + 1
      dirs_go(slices_go(g, grid, n, bb, d, if alo < m do m else alo end, if ahi >= n - m do n - 1 - m else ahi end), grid, n, bb, d + 1, m)
    end
  end
  doc "Greedy-mesh a grid [n] a side into a template: vertices in the 10-float layout, positions in [0, 1], shade 1."
  fn template_n(grid : NativeU8Arr, n : Int) : CubeForge.F32Buf.F32Buf do
    match dirs_go(Greedy(B.new(1024), NativeArray.make_int(n * n, 0)), grid, n, bbox(grid, n), 0, 0) do
      Greedy(b, _) -> b
    end
  end
  pfn clamp_box(bb : Box, lo : Int, hi : Int) : Box do
    match bb do
      Box(x0, x1, y0, y1, z0, z1) ->
        Box(if x0 < lo do lo else x0 end, if x1 > hi do hi else x1 end,
            if y0 < lo do lo else y0 end, if y1 > hi do hi else y1 end,
            if z0 < lo do lo else z0 end, if z1 > hi do hi else z1 end)
    end
  end
  doc """
  Greedy-mesh the INNER cells of a grid [n] a side, those at least [m] in from
  every side; the outer [m] cells are the neighbours of the inner ones and
  only cull faces. This is how a crystal beam block is cut against the beam
  blocks around it (Poi.beam_grid): a face on the block's boundary that the
  next block's sub-cubes cover is not emitted, where a plain template would
  emit both blocks' faces there, back to back. Positions are still over the
  whole grid, [0, 1]: place with F32Buf.stamp_xf at scale n / (n - 2m) about
  the grid's centre, which is the inner cube's centre too.
  """
  fn template_inner(grid : NativeU8Arr, n : Int, m : Int) : CubeForge.F32Buf.F32Buf do
    match dirs_go(Greedy(B.new(1024), NativeArray.make_int(n * n, 0)), grid, n, clamp_box(bbox(grid, n), m, n - 1 - m), 0, m) do
      Greedy(b, _) -> b
    end
  end
  doc "Greedy-mesh an 8-cube grid: the block models' size."
  fn template(grid : NativeU8Arr) : CubeForge.F32Buf.F32Buf do template_n(grid, size()) end

  -- ── The set: every template in one blob ─────────────────────────────────
  -- All templates: a float blob and count() + 1 offsets into it.
  type Templates = Templates(NativeF32Arr, NativeIntArr, NativeF32Arr)   -- template blob, offsets, the texture layer table the shim reads (World.default_models fills it)

  pfn build_go(k : Int, blob : CubeForge.F32Buf.F32Buf, offs : NativeIntArr) : Templates do
    if k >= count() do
      let n = B.len(blob)
      Templates(B.storage(blob), NativeArray.set_int(offs, count(), n), NativeArray.make_f32(1, 0.0))
    else
      let n = B.len(blob)
      build_go(k + 1, B.append(blob, template(shape(k))), NativeArray.set_int(offs, k, n))
    end
  end
  doc "Build every template. Done once, when a World is made."
  fn build() : Templates do build_go(0, B.new(4096), NativeArray.make_int(count() + 1, 0)) end

  doc "First float of template k in the blob."
  fn offset(s : Templates, k : Int) : Int do match s do Templates(_, o, _) -> NativeArray.get_int(o, k) end end
  doc "Floats in template k."
  fn floats(s : Templates, k : Int) : Int do match s do Templates(_, o, _) -> NativeArray.get_int(o, k + 1) - NativeArray.get_int(o, k) end end
  doc "Float i of the blob."
  fn at(s : Templates, i : Int) : Float do match s do Templates(d, _, _) -> NativeArray.get_f32(d, i) end end
  fn blob(s : Templates) : NativeF32Arr do match s do Templates(d, _, _) -> d end end
  doc "The texture layer table the shim's quad emitter reads: layer_for_face(id, d) at id * 6 + d for ids 0..255, then Texture.myc_layer(k, sp) at 1536 + k * 6 + (sp - 1). Texture builds it; World.default_models puts it here."
  fn layers(s : Templates) : NativeF32Arr do match s do Templates(_, _, l) -> l end end
  fn with_layers(s : Templates, l : NativeF32Arr) : Templates do match s do Templates(d, o, _) -> Templates(d, o, l) end end
  doc "Quads in template k."
  fn faces(s : Templates, k : Int) : Int do floats(s, k) / (6 * Vx.floats()) end

end
