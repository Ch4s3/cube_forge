-- Mat4 — 4x4 float matrix, column-major (m[col*4 + row]), GL convention.
-- Storage is a NativeFloatArr(16) wrapped in a single-constructor variant.
-- Every operation allocates one fresh 16-float array; there is no in-place
-- matrix arithmetic without a mutable-buffer API (GAPS.md G13/G18).
mod CubeForge.Math.Mat4 do

  alias CubeForge.Math.Vec3 as V

  type Mat4 = Mat4(NativeFloatArr)

  fn raw(m : Mat4) : NativeFloatArr do match m do Mat4(a) -> a end end

  fn get(m : Mat4, col : Int, row : Int) : Float do
    match m do Mat4(a) -> NativeArray.get_float(a, col * 4 + row) end
  end

  fn identity() : Mat4 do
    let a = NativeArray.make_float(16, 0.0)
    let a1 = NativeArray.set_float(a, 0, 1.0)
    let a2 = NativeArray.set_float(a1, 5, 1.0)
    let a3 = NativeArray.set_float(a2, 10, 1.0)
    Mat4(NativeArray.set_float(a3, 15, 1.0))
  end

  fn from_list(xs : List(Float)) : Mat4 do Mat4(NativeArray.from_list_float(xs)) end

  -- out[c][r] = sum_k a[k][r] * b[c][k]
  pfn mul_cell(a : NativeFloatArr, b : NativeFloatArr, c : Int, r : Int) : Float do
    NativeArray.get_float(a, 0 * 4 + r) *. NativeArray.get_float(b, c * 4 + 0)
    +. NativeArray.get_float(a, 1 * 4 + r) *. NativeArray.get_float(b, c * 4 + 1)
    +. NativeArray.get_float(a, 2 * 4 + r) *. NativeArray.get_float(b, c * 4 + 2)
    +. NativeArray.get_float(a, 3 * 4 + r) *. NativeArray.get_float(b, c * 4 + 3)
  end

  pfn mul_fill(a : NativeFloatArr, b : NativeFloatArr, out : NativeFloatArr, i : Int) : NativeFloatArr do
    if i >= 16 do out
    else mul_fill(a, b, NativeArray.set_float(out, i, mul_cell(a, b, i / 4, i % 4)), i + 1) end
  end

  doc "Matrix product a * b (apply b first, then a)."
  fn mul(a : Mat4, b : Mat4) : Mat4 do
    match (a, b) do
      (Mat4(pa), Mat4(pb)) -> Mat4(mul_fill(pa, pb, NativeArray.make_float(16, 0.0), 0))
    end
  end

  doc "Right-handed perspective projection (GL clip space, z in [-1, 1])."
  fn perspective(fov_y_rad : Float, aspect : Float, near : Float, far : Float) : Mat4 do
    let f = 1.0 /. Math.tan(fov_y_rad /. 2.0)
    let a = NativeArray.make_float(16, 0.0)
    let a1 = NativeArray.set_float(a, 0, f /. aspect)
    let a2 = NativeArray.set_float(a1, 5, f)
    let a3 = NativeArray.set_float(a2, 10, (far +. near) /. (near -. far))
    let a4 = NativeArray.set_float(a3, 11, -1.0)
    let a5 = NativeArray.set_float(a4, 14, (2.0 *. far *. near) /. (near -. far))
    Mat4(a5)
  end

  doc "View matrix looking from [eye] towards [target] with [up]."
  fn look_at(eye : CubeForge.Math.Vec3.Vec3, target : CubeForge.Math.Vec3.Vec3, up : CubeForge.Math.Vec3.Vec3) : Mat4 do
    let f = V.normalize(V.sub(target, eye))
    let s = V.normalize(V.cross(f, up))
    let u = V.cross(s, f)
    let a = NativeArray.make_float(16, 0.0)
    let a1 = NativeArray.set_float(a, 0, V.x(s))
    let a2 = NativeArray.set_float(a1, 4, V.y(s))
    let a3 = NativeArray.set_float(a2, 8, V.z(s))
    let a4 = NativeArray.set_float(a3, 1, V.x(u))
    let a5 = NativeArray.set_float(a4, 5, V.y(u))
    let a6 = NativeArray.set_float(a5, 9, V.z(u))
    let a7 = NativeArray.set_float(a6, 2, 0.0 -. V.x(f))
    let a8 = NativeArray.set_float(a7, 6, 0.0 -. V.y(f))
    let a9 = NativeArray.set_float(a8, 10, 0.0 -. V.z(f))
    let a10 = NativeArray.set_float(a9, 12, 0.0 -. V.dot(s, eye))
    let a11 = NativeArray.set_float(a10, 13, 0.0 -. V.dot(u, eye))
    let a12 = NativeArray.set_float(a11, 14, V.dot(f, eye))
    Mat4(NativeArray.set_float(a12, 15, 1.0))
  end

  fn translation(v : CubeForge.Math.Vec3.Vec3) : Mat4 do
    match identity() do
      Mat4(a) ->
        let a1 = NativeArray.set_float(a, 12, V.x(v))
        let a2 = NativeArray.set_float(a1, 13, V.y(v))
        Mat4(NativeArray.set_float(a2, 14, V.z(v)))
    end
  end

  doc "Transform a point (w = 1) and return (x, y, z, w)."
  fn transform_point(m : Mat4, p : CubeForge.Math.Vec3.Vec3) : (Float, Float, Float, Float) do
    match m do
      Mat4(a) ->
        let px = V.x(p)
        let py = V.y(p)
        let pz = V.z(p)
        let c = fn r -> NativeArray.get_float(a, 0 + r) *. px +. NativeArray.get_float(a, 4 + r) *. py
                        +. NativeArray.get_float(a, 8 + r) *. pz +. NativeArray.get_float(a, 12 + r)
        (c(0), c(1), c(2), c(3))
    end
  end

  pfn to_f32_fill(src : NativeFloatArr, dst : NativeF32Arr, i : Int) : NativeF32Arr do
    if i >= 16 do dst
    else to_f32_fill(src, NativeArray.set_f32(dst, i, NativeArray.get_float(src, i)), i + 1) end
  end

  doc "Write the 16 entries into [dst] (a NativeF32Arr of length >= 16) for GPU upload; in place at rc == 1."
  fn write_f32(m : Mat4, dst : NativeF32Arr) : NativeF32Arr do
    match m do Mat4(a) -> to_f32_fill(a, dst, 0) end
  end

end
