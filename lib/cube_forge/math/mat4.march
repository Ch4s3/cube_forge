-- Mat4 — 4x4 float matrix, column-major (m[col*4 + row]), GL convention.
-- Storage is a bare NativeFloatArr(16). It was a single-constructor variant
-- `Mat4(NativeFloatArr)`, but that is a newtype in the compiled backend and a
-- newtype scrutinee that is an owned temporary is never freed (GAPS.md G30),
-- so the wrapper is gone and the type name is just documentation.
-- Every operation allocates one fresh 16-float array; there is no in-place
-- matrix arithmetic without a mutable-buffer API (GAPS.md G13).
mod CubeForge.Math.Mat4 do

  alias CubeForge.Math.Vec3 as V

  type Vec4 = Vec4(Float, Float, Float, Float)
  fn x4(v : Vec4) : Float do match v do Vec4(a, _, _, _) -> a end end
  fn y4(v : Vec4) : Float do match v do Vec4(_, b, _, _) -> b end end
  fn z4(v : Vec4) : Float do match v do Vec4(_, _, c, _) -> c end end
  fn w4(v : Vec4) : Float do match v do Vec4(_, _, _, d) -> d end end

  fn raw(m : NativeFloatArr) : NativeFloatArr do m end

  fn get(m : NativeFloatArr, col : Int, row : Int) : Float do
    NativeArray.get_float(m, col * 4 + row)
  end

  fn identity() : NativeFloatArr do
    let a = NativeArray.make_float(16, 0.0)
    let a1 = NativeArray.set_float(a, 0, 1.0)
    let a2 = NativeArray.set_float(a1, 5, 1.0)
    let a3 = NativeArray.set_float(a2, 10, 1.0)
    NativeArray.set_float(a3, 15, 1.0)
  end

  fn from_list(xs : List(Float)) : NativeFloatArr do NativeArray.from_list_float(xs) end

  -- out[c][r] = sum_k a[k][r] * b[c][k]
  @[no_alloc]
  pfn mul_cell(a : NativeFloatArr, b : NativeFloatArr, c : Int, r : Int) : Float do
    NativeArray.get_float(a, 0 * 4 + r) *. NativeArray.get_float(b, c * 4 + 0)
    +. NativeArray.get_float(a, 1 * 4 + r) *. NativeArray.get_float(b, c * 4 + 1)
    +. NativeArray.get_float(a, 2 * 4 + r) *. NativeArray.get_float(b, c * 4 + 2)
    +. NativeArray.get_float(a, 3 * 4 + r) *. NativeArray.get_float(b, c * 4 + 3)
  end

  pfn mul_fill(a : NativeFloatArr, b : NativeFloatArr, out : NativeFloatArr, i : Int) : NativeFloatArr do
    if i >= 16 do out
    else mul_fill(a, b, NativeArray.set_float(out, i, mul_cell(a, b, i / 4, i % 4)), i + 1) end
  end

  doc "Matrix product a * b (apply b first, then a)."
  fn mul(a : NativeFloatArr, b : NativeFloatArr) : NativeFloatArr do
    mul_fill(a, b, NativeArray.make_float(16, 0.0), 0)
  end

  doc "Right-handed orthographic projection (GL clip space, z in [-1, 1])."
  fn orthographic(left : Float, right : Float, bottom : Float, top : Float, near : Float, far : Float) : NativeFloatArr do
    let a = NativeArray.make_float(16, 0.0)
    let a1 = NativeArray.set_float(a, 0, 2.0 /. (right -. left))
    let a2 = NativeArray.set_float(a1, 5, 2.0 /. (top -. bottom))
    let a3 = NativeArray.set_float(a2, 10, -2.0 /. (far -. near))
    let a4 = NativeArray.set_float(a3, 12, 0.0 -. (right +. left) /. (right -. left))
    let a5 = NativeArray.set_float(a4, 13, 0.0 -. (top +. bottom) /. (top -. bottom))
    let a6 = NativeArray.set_float(a5, 14, 0.0 -. (far +. near) /. (far -. near))
    NativeArray.set_float(a6, 15, 1.0)
  end

  doc "Right-handed perspective projection (GL clip space, z in [-1, 1])."
  fn perspective(fov_y_rad : Float, aspect : Float, near : Float, far : Float) : NativeFloatArr do
    let f = 1.0 /. Math.tan(fov_y_rad /. 2.0)
    let a = NativeArray.make_float(16, 0.0)
    let a1 = NativeArray.set_float(a, 0, f /. aspect)
    let a2 = NativeArray.set_float(a1, 5, f)
    let a3 = NativeArray.set_float(a2, 10, (far +. near) /. (near -. far))
    let a4 = NativeArray.set_float(a3, 11, -1.0)
    NativeArray.set_float(a4, 14, (2.0 *. far *. near) /. (near -. far))
  end

  doc "View matrix looking from [eye] towards [target] with [up]."
  fn look_at(eye : CubeForge.Math.Vec3.Vec3, target : CubeForge.Math.Vec3.Vec3, up : CubeForge.Math.Vec3.Vec3) : NativeFloatArr do
    let f = V.normalize(V.sub(target, eye))
    let s = V.normalize(V.cross(f, up))
    let u = V.cross(s, f)
    let a = NativeArray.make_float(16, 0.0)
    let a1 = NativeArray.set_float(a, 0, V.x(s))
    let a2 = NativeArray.set_float(a1, 4, V.y(s))
    let a3 = NativeArray.set_float(a2, 8, V.z(s))
    let a4 = NativeArray.set_float(a3, 1, V.x(u))
    let a5 = NativeArray.set_float(a4, 5, V.y(u))
    let a6 = NativeArray.set_float(a5, 9, V.z(u))
    let a7 = NativeArray.set_float(a6, 2, 0.0 -. V.x(f))
    let a8 = NativeArray.set_float(a7, 6, 0.0 -. V.y(f))
    let a9 = NativeArray.set_float(a8, 10, 0.0 -. V.z(f))
    let a10 = NativeArray.set_float(a9, 12, 0.0 -. V.dot(s, eye))
    let a11 = NativeArray.set_float(a10, 13, 0.0 -. V.dot(u, eye))
    let a12 = NativeArray.set_float(a11, 14, V.dot(f, eye))
    NativeArray.set_float(a12, 15, 1.0)
  end

  fn translation(v : CubeForge.Math.Vec3.Vec3) : NativeFloatArr do
    let a1 = NativeArray.set_float(identity(), 12, V.x(v))
    let a2 = NativeArray.set_float(a1, 13, V.y(v))
    NativeArray.set_float(a2, 14, V.z(v))
  end

  doc "Transform a point (w = 1) into a Vec4 (a variant, not a tuple — tuples leak, G29)."
  fn transform_point(a : NativeFloatArr, p : CubeForge.Math.Vec3.Vec3) : Vec4 do
    let px = V.x(p)
    let py = V.y(p)
    let pz = V.z(p)
    let c = fn r -> NativeArray.get_float(a, 0 + r) *. px +. NativeArray.get_float(a, 4 + r) *. py
                    +. NativeArray.get_float(a, 8 + r) *. pz +. NativeArray.get_float(a, 12 + r)
    Vec4(c(0), c(1), c(2), c(3))
  end

  -- out_f32[i] = (a * b)[i], written in place into a persistent NativeF32Arr.
  @[no_alloc]
  pfn mul_fill_f32(a : NativeFloatArr, b : NativeFloatArr, out : NativeF32Arr, i : Int) : NativeF32Arr do
    if i >= 16 do out
    else mul_fill_f32(a, b, NativeArray.set_f32(out, i, mul_cell(a, b, i / 4, i % 4)), i + 1) end
  end

  @[no_alloc]
  -- a * b written into [dst] (NativeF32Arr(16)) in place; no temporaries when dst is uniquely owned.
  fn mul_into_f32(a : NativeFloatArr, b : NativeFloatArr, dst : NativeF32Arr) : NativeF32Arr do
    mul_fill_f32(a, b, dst, 0)
  end

  @[no_alloc]
  -- 
  -- Write the view matrix for a camera at [eye] with orientation quaternion
  -- (qx, qy, qz, qw) into [dst] in place: view = R(q)^T * T(-eye).
  -- Takes the quaternion as four scalars so no temporary matrices are built.
  -- 
  fn write_view(qx : Float, qy : Float, qz : Float, qw : Float, ex : Float, ey : Float, ez : Float, dst : NativeFloatArr) : NativeFloatArr do
    let xx = qx *. qx
    let yy = qy *. qy
    let zz = qz *. qz
    let xy = qx *. qy
    let xz = qx *. qz
    let yz = qy *. qz
    let wx = qw *. qx
    let wy = qw *. qy
    let wz = qw *. qz
    -- R(q) column-major entries r[col][row]; view rotation is the transpose.
    let r00 = 1.0 -. 2.0 *. (yy +. zz)
    let r01 = 2.0 *. (xy +. wz)
    let r02 = 2.0 *. (xz -. wy)
    let r10 = 2.0 *. (xy -. wz)
    let r11 = 1.0 -. 2.0 *. (xx +. zz)
    let r12 = 2.0 *. (yz +. wx)
    let r20 = 2.0 *. (xz +. wy)
    let r21 = 2.0 *. (yz -. wx)
    let r22 = 1.0 -. 2.0 *. (xx +. yy)
    -- view[col][row] = R^T => view[c][r] = r[r][c]  (r<col><row> above is r[col][row])
    let d0 = NativeArray.set_float(dst, 0, r00)
    let d1 = NativeArray.set_float(d0, 1, r10)
    let d2 = NativeArray.set_float(d1, 2, r20)
    let d3 = NativeArray.set_float(d2, 3, 0.0)
    let d4 = NativeArray.set_float(d3, 4, r01)
    let d5 = NativeArray.set_float(d4, 5, r11)
    let d6 = NativeArray.set_float(d5, 6, r21)
    let d7 = NativeArray.set_float(d6, 7, 0.0)
    let d8 = NativeArray.set_float(d7, 8, r02)
    let d9 = NativeArray.set_float(d8, 9, r12)
    let d10 = NativeArray.set_float(d9, 10, r22)
    let d11 = NativeArray.set_float(d10, 11, 0.0)
    -- translation column = R^T * (-eye)
    let tx = 0.0 -. (r00 *. ex +. r01 *. ey +. r02 *. ez)
    let ty = 0.0 -. (r10 *. ex +. r11 *. ey +. r12 *. ez)
    let tz = 0.0 -. (r20 *. ex +. r21 *. ey +. r22 *. ez)
    let d12 = NativeArray.set_float(d11, 12, tx)
    let d13 = NativeArray.set_float(d12, 13, ty)
    let d14 = NativeArray.set_float(d13, 14, tz)
    NativeArray.set_float(d14, 15, 1.0)
  end

  pfn to_f32_fill(src : NativeFloatArr, dst : NativeF32Arr, i : Int) : NativeF32Arr do
    if i >= 16 do dst
    else to_f32_fill(src, NativeArray.set_f32(dst, i, NativeArray.get_float(src, i)), i + 1) end
  end

  doc "Write the 16 entries into [dst] (a NativeF32Arr of length >= 16) for GPU upload; in place at rc == 1."
  fn write_f32(m : NativeFloatArr, dst : NativeF32Arr) : NativeF32Arr do
    to_f32_fill(m, dst, 0)
  end

end
