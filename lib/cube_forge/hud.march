-- Hud — a 3x5 pixel digit font emitted as NDC quads into a reusable F32Buf.
-- Vertex layout is the shared 7-float one; uv = (1, 1) and layer = 1 make the
-- untextured shader path produce white, shade scales it.
mod CubeForge.Hud do

  alias CubeForge.F32Buf as B
  alias CubeForge.Vertex as Vx

  -- 15-bit glyph masks, row-major top to bottom, 3 columns per row (bit 14 = top-left).
  pfn glyph(d : Int) : Int do
    match d do
      0 -> 31599   -- 111 101 101 101 111
      1 -> 11415   -- 010 110 010 010 111
      2 -> 29671   -- 111 001 111 100 111
      3 -> 29391   -- 111 001 111 001 111
      4 -> 23497   -- 101 101 111 001 001
      5 -> 31183   -- 111 100 111 001 111
      6 -> 31215   -- 111 100 111 101 111
      7 -> 29257   -- 111 001 001 001 001
      8 -> 31727   -- 111 101 111 101 111
      9 -> 31695   -- 111 101 111 001 111
      _ -> 0
    end
  end

  pfn vert(b : CubeForge.F32Buf.F32Buf, x : Float, y : Float, shade : Float) : CubeForge.F32Buf.F32Buf do
    b |> B.push3(x, y, 0.0) |> B.push(1.0) |> B.push(1.0) |> B.push(1.0) |> B.push(shade) |> B.push(0.0) |> B.push(Vx.plain())
  end

  pfn rect(b : CubeForge.F32Buf.F32Buf, x0 : Float, y0 : Float, x1 : Float, y1 : Float, shade : Float) : CubeForge.F32Buf.F32Buf do
    b |> vert(x0, y0, shade) |> vert(x1, y0, shade) |> vert(x1, y1, shade)
      |> vert(x0, y0, shade) |> vert(x1, y1, shade) |> vert(x0, y1, shade)
  end

  -- Emit the lit pixels of one glyph whose top-left is (x, y); px is the pixel size in NDC.
  pfn glyph_pixels(b : CubeForge.F32Buf.F32Buf, mask : Int, i : Int, x : Float, y : Float, px : Float, py : Float) : CubeForge.F32Buf.F32Buf do
    if i >= 15 do b
    else
      let bit = int_and(mask / (1 * pow2(14 - i)), 1)
      let col = int_to_float(i % 3)
      let row = int_to_float(i / 3)
      let b1 = if bit == 1 do
        rect(b, x +. col *. px, y -. (row +. 1.0) *. py, x +. (col +. 1.0) *. px, y -. row *. py, 1.0)
      else b end
      glyph_pixels(b1, mask, i + 1, x, y, px, py)
    end
  end

  pfn pow2(n : Int) : Int do if n <= 0 do 1 else 2 * pow2(n - 1) end end

  pfn digits_of(n : Int, acc : List(Int)) : List(Int) do
    if n < 10 do Cons(n, acc) else digits_of(n / 10, Cons(n % 10, acc)) end
  end

  pfn emit_digits(b : CubeForge.F32Buf.F32Buf, ds : List(Int), x : Float, y : Float, px : Float, py : Float) : CubeForge.F32Buf.F32Buf do
    match ds do
      Nil -> b
      Cons(d, rest) -> emit_digits(glyph_pixels(b, glyph(d), 0, x, y, px, py), rest, x +. 4.0 *. px, y, px, py)
    end
  end

  -- ── Hotbar ────────────────────────────────────────────────────────────────
  -- Untextured-path colour: (u, v, layer) * shade is the RGB.
  pfn cvert(b : CubeForge.F32Buf.F32Buf, x : Float, y : Float, r : Float, g : Float, bl : Float) : CubeForge.F32Buf.F32Buf do
    b |> B.push3(x, y, 0.0) |> B.push(r) |> B.push(g) |> B.push(bl) |> B.push(1.0) |> B.push(0.0) |> B.push(Vx.plain())
  end
  pfn crect(b : CubeForge.F32Buf.F32Buf, x0 : Float, y0 : Float, x1 : Float, y1 : Float, r : Float, g : Float, bl : Float) : CubeForge.F32Buf.F32Buf do
    b |> cvert(x0, y0, r, g, bl) |> cvert(x1, y0, r, g, bl) |> cvert(x1, y1, r, g, bl)
      |> cvert(x0, y0, r, g, bl) |> cvert(x1, y1, r, g, bl) |> cvert(x0, y1, r, g, bl)
  end
  -- textured quad sampling texture layer [layer], uv 0..1
  pfn tvert(b : CubeForge.F32Buf.F32Buf, x : Float, y : Float, u : Float, v : Float, layer : Float) : CubeForge.F32Buf.F32Buf do
    b |> B.push3(x, y, 0.0) |> B.push(u) |> B.push(v) |> B.push(layer) |> B.push(1.0) |> B.push(0.0) |> B.push(Vx.plain())
  end
  pfn trect(b : CubeForge.F32Buf.F32Buf, x0 : Float, y0 : Float, x1 : Float, y1 : Float, layer : Float) : CubeForge.F32Buf.F32Buf do
    b |> tvert(x0, y0, 0.0, 0.0, layer) |> tvert(x1, y0, 1.0, 0.0, layer) |> tvert(x1, y1, 1.0, 1.0, layer)
      |> tvert(x0, y0, 0.0, 0.0, layer) |> tvert(x1, y1, 1.0, 1.0, layer) |> tvert(x0, y1, 0.0, 1.0, layer)
  end

  fn slots() : Int do 9 end
  fn slot_w() : Float do 0.115 end
  fn slot_h() : Float do 0.155 end
  -- 9 slots of pitch 0.125, centred: leftmost starts at -(9 * 0.125) / 2 + a half-gap
  fn slot_x0(i : Int) : Float do -0.5575 +. int_to_float(i) *. 0.125 end
  fn slot_y0() : Float do -0.97 end

  -- one slot: background, selection border, count digits
  pfn slot(b : CubeForge.F32Buf.F32Buf, i : Int, selected : Bool, count : Int, show_count : Bool) : CubeForge.F32Buf.F32Buf do
    let x0 = slot_x0(i)
    let y0 = slot_y0()
    let x1 = x0 +. slot_w()
    let y1 = y0 +. slot_h()
    let e = 0.012
    let b1 = if selected do crect(b, x0 -. e, y0 -. e, x1 +. e, y1 +. e, 0.95, 0.95, 0.95) else crect(b, x0 -. e, y0 -. e, x1 +. e, y1 +. e, 0.25, 0.25, 0.28) end
    let b2 = crect(b1, x0, y0, x1, y1, 0.12, 0.12, 0.14)
    if show_count do emit_digits(b2, digits_of(count, Nil), x0 +. 0.012, y1 -. 0.012, 0.006, 0.008) else b2 end
  end

  -- Untextured HUD: hotbar slots, selection, counts, crosshair, break progress. Rebuilt in place.
  fn build_hotbar(b : CubeForge.F32Buf.F32Buf, sel : Int, c1 : Int, c2 : Int, c3 : Int, c4 : Int, c5 : Int, c6 : Int, c7 : Int, c8 : Int, c9 : Int, progress : Float) : CubeForge.F32Buf.F32Buf do
    let b0 = B.clear(b)
    let b1 = slot(b0, 0, sel == 1, c1, true)
    let b2 = slot(b1, 1, sel == 2, c2, true)
    let b3 = slot(b2, 2, sel == 3, c3, true)
    let b3d = slot(b3, 3, sel == 4, c4, true)
    let b3e = slot(b3d, 4, sel == 5, c5, true)
    let b3f = slot(b3e, 5, sel == 6, c6, true)
    let b3g = slot(b3f, 6, sel == 7, c7, true)
    let b3h = slot(b3g, 7, sel == 8, c8, true)
    let b4 = slot(b3h, 8, sel == 9, c9, true)
    -- crosshair
    let b5 = crect(b4, -0.004, -0.03, 0.004, 0.03, 1.0, 1.0, 1.0)
    let b6 = crect(b5, -0.03, -0.004, 0.03, 0.004, 1.0, 1.0, 1.0)
    -- progress bar under the crosshair while breaking
    if progress > 0.0 do
      let b7 = crect(b6, -0.06, -0.075, 0.06, -0.06, 0.2, 0.2, 0.2)
      crect(b7, -0.06, -0.075, -0.06 +. 0.12 *. progress, -0.06, 1.0, 0.85, 0.2)
    else b6 end
  end

  doc "Textured HUD: one icon per slot sampling the block's texture layer."
  fn build_icons(b : CubeForge.F32Buf.F32Buf) : CubeForge.F32Buf.F32Buf do
    let pad = 0.03
    let icon = fn (bb, i, layer) -> trect(bb, slot_x0(i) +. pad, slot_y0() +. pad, slot_x0(i) +. slot_w() -. pad, slot_y0() +. slot_h() -. pad, layer)
    -- slot order: grass, dirt, stone, water, sand, snow, granite -> texture layers
    B.clear(b) |> icon(0, 0.0) |> icon(1, 2.0) |> icon(2, 3.0) |> icon(3, 1.0)
               |> icon(4, 4.0) |> icon(5, 5.0) |> icon(6, 6.0) |> icon(7, 8.0) |> icon(8, 12.0)
  end

  -- 
  -- Rebuild [b] (cleared in place) with the decimal digits of [n] right-aligned
  -- at the top-right corner. Pixel size is given in NDC units per pixel.
  -- 
  fn build_number(b : CubeForge.F32Buf.F32Buf, n : Int, px : Float, py : Float) : CubeForge.F32Buf.F32Buf do
    let ds = digits_of(if n < 0 do 0 else n end, Nil)
    let width = int_to_float(List.length(ds)) *. 4.0 *. px
    emit_digits(B.clear(b), ds, 0.98 -. width, 0.96, px, py)
  end

end
