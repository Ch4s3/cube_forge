-- The menu: a start screen and an escape menu over one state machine.
--
-- Two modes and three pages. Start mode (opened at launch) offers NEW GAME,
-- LOAD GAME, SETTINGS and QUIT; escape mode offers NEW GAME, SAVE GAME,
-- SETTINGS and QUIT. Both have the seed field on the main page, both open the
-- same slots page (five rows and BACK, where a click saves in escape mode or
-- loads in start mode), and both open the same settings hub: GRAPHICS, SOUND
-- and BACK, each of the first two a row page with one row per option, an
-- arrow button at either end of it, and BACK.
--
-- State and geometry only — no I/O and no world access, so the whole thing is
-- unit-testable. The frame loop reads the state, `Hud` draws it, and both take
-- their coordinates from the accessors here so that the drawn boxes and the
-- hit-tested boxes cannot drift apart.
mod CubeForge.Menu do

  alias CubeForge.Save as Save
  alias CubeForge.Settings as Settings
  alias CubeForge.Noise as N

  -- Menu(open?, seed under edit, item the cursor is over, mode, page,
  --      status row, status kind, frame the status was set, slot listing,
  --      settings under edit)
  -- The seed under edit is the PACKED seed (Noise.with_age): the digits the
  -- player types are its base, the age its high bits. Both are edited here and
  -- the one number is what a new game starts from and what a save records.
  type Menu = Menu(Bool, Int, Int, Int, Int, Int, Int, Int, List(CubeForge.Save.SlotInfo), CubeForge.Settings.Settings)

  doc "The world generator masks its seed to 30 bits; the digits field will not exceed that."
  fn max_seed() : Int do 1073741823 end
  doc "How far one - or = press moves the age."
  fn age_step() : Int do 5 end

  fn mode_start() : Int do 0 end
  fn mode_escape() : Int do 1 end
  fn page_main() : Int do 0 end
  fn page_slots() : Int do 1 end
  doc "The settings hub: GRAPHICS, SOUND, BACK."
  fn page_settings() : Int do 2 end
  fn page_graphics() : Int do 3 end
  fn page_sound() : Int do 4 end
  doc "A row page edits a run of settings fields, one per row."
  fn is_row_page(p : Int) : Bool do p == page_graphics() || p == page_sound() end
  fn page_field0(p : Int) : Int do if p == page_sound() do Settings.graphics_fields() else 0 end end
  fn page_rows(p : Int) : Int do if p == page_sound() do Settings.sound_fields() else Settings.graphics_fields() end end
  doc "Where BACK (and Esc) from this page lands: a row page returns to the hub, everything else to main."
  fn back_page(m : Menu) : Int do if is_row_page(page(m)) do page_settings() else page_main() end end

  -- Main page items.
  fn item_new_game() : Int do 0 end
  doc "SAVE GAME in escape mode, LOAD GAME in start mode."
  fn item_second() : Int do 1 end
  fn item_settings() : Int do 2 end
  fn item_quit() : Int do 3 end
  fn main_items() : Int do 4 end
  -- Slots page items: 0..4 are slots 1..5, then BACK.
  fn slot_of_item(i : Int) : Int do i + 1 end
  -- Hub items.
  fn hub_graphics() : Int do 0 end
  fn hub_sound() : Int do 1 end
  fn hub_items() : Int do 3 end
  -- Row page items: three per row (left arrow, body, right arrow), then BACK.
  fn part_left() : Int do 0 end
  fn part_body() : Int do 1 end
  fn part_right() : Int do 2 end
  fn settings_row(i : Int) : Int do i / 3 end
  fn settings_part(i : Int) : Int do i % 3 end
  fn settings_item(row : Int, part : Int) : Int do row * 3 + part end
  doc "The settings field item [i] of a row page edits."
  fn field_of(m : Menu, i : Int) : Int do page_field0(page(m)) + settings_row(i) end
  doc "BACK is the last item of every sub-page."
  fn item_back(m : Menu) : Int do
    if is_row_page(page(m)) do page_rows(page(m)) * 3
    else if page(m) == page_settings() do hub_items() - 1
    else Save.slots() end end
  end
  fn items(m : Menu) : Int do
    if page(m) == page_slots() do Save.slots() + 1
    else if is_row_page(page(m)) do page_rows(page(m)) * 3 + 1
    else if page(m) == page_settings() do hub_items()
    else main_items() end end end
  end

  fn status_none() : Int do 0 end
  fn status_saved() : Int do 1 end
  fn status_failed() : Int do 2 end
  doc "Frames a SAVED or FAILED row stays lit."
  fn status_frames() : Int do 60 end

  doc "An escape menu, closed."
  fn new(seed : Int, s : CubeForge.Settings.Settings) : Menu do Menu(false, seed, -1, mode_escape(), page_main(), 0, status_none(), 0, Nil, s) end
  doc "The start screen, open."
  fn new_start(seed : Int, s : CubeForge.Settings.Settings) : Menu do Menu(true, seed, -1, mode_start(), page_main(), 0, status_none(), 0, Nil, s) end

  fn is_open(m : Menu) : Bool do match m do Menu(o, _, _, _, _, _, _, _, _, _) -> o end end
  doc "The packed seed: base and age together, what a new game starts from."
  fn seed(m : Menu) : Int do match m do Menu(_, s, _, _, _, _, _, _, _, _) -> s end end
  doc "The digits the player edits: the seed with its age stripped."
  fn base_seed(m : Menu) : Int do N.base_seed(seed(m)) end
  doc "The world age under edit, 0..Noise.max_age()."
  fn age(m : Menu) : Int do N.age_of(seed(m)) end
  fn focused(m : Menu) : Int do match m do Menu(_, _, f, _, _, _, _, _, _, _) -> f end end
  fn mode(m : Menu) : Int do match m do Menu(_, _, _, md, _, _, _, _, _, _) -> md end end
  fn page(m : Menu) : Int do match m do Menu(_, _, _, _, p, _, _, _, _, _) -> p end end
  fn status_slot(m : Menu) : Int do match m do Menu(_, _, _, _, _, s, _, _, _, _) -> s end end
  fn status_kind(m : Menu) : Int do match m do Menu(_, _, _, _, _, _, k, _, _, _) -> k end end
  fn status_frame(m : Menu) : Int do match m do Menu(_, _, _, _, _, _, _, f, _, _) -> f end end
  fn slot_infos(m : Menu) : List(CubeForge.Save.SlotInfo) do match m do Menu(_, _, _, _, _, _, _, _, l, _) -> l end end
  fn settings(m : Menu) : CubeForge.Settings.Settings do match m do Menu(_, _, _, _, _, _, _, _, _, s) -> s end end
  fn is_start(m : Menu) : Bool do mode(m) == mode_start() end

  fn set_open(m : Menu, o : Bool) : Menu do match m do Menu(_, s, f, md, p, ss, sk, sf, l, st) -> Menu(o, s, f, md, p, ss, sk, sf, l, st) end end
  fn set_focus(m : Menu, f : Int) : Menu do match m do Menu(o, s, _, md, p, ss, sk, sf, l, st) -> Menu(o, s, f, md, p, ss, sk, sf, l, st) end end
  fn set_seed(m : Menu, s : Int) : Menu do match m do Menu(o, _, f, md, p, ss, sk, sf, l, st) -> Menu(o, s, f, md, p, ss, sk, sf, l, st) end end
  fn set_mode(m : Menu, md : Int) : Menu do match m do Menu(o, s, f, _, p, ss, sk, sf, l, st) -> Menu(o, s, f, md, p, ss, sk, sf, l, st) end end
  doc "Change page. A status belongs to the page it was set on, so it is dropped here."
  fn set_page(m : Menu, p : Int) : Menu do match m do Menu(o, s, f, md, _, _, _, _, l, st) -> Menu(o, s, f, md, p, 0, status_none(), 0, l, st) end end
  fn set_slots(m : Menu, l : List(CubeForge.Save.SlotInfo)) : Menu do match m do Menu(o, s, f, md, p, ss, sk, sf, _, st) -> Menu(o, s, f, md, p, ss, sk, sf, l, st) end end
  fn set_settings(m : Menu, st : CubeForge.Settings.Settings) : Menu do match m do Menu(o, s, f, md, p, ss, sk, sf, l, _) -> Menu(o, s, f, md, p, ss, sk, sf, l, st) end end
  doc "Light a row: a slot number on the slots page, a settings field on a row page."
  fn set_status(m : Menu, slot : Int, kind : Int, frame : Int) : Menu do
    match m do Menu(o, s, f, md, p, _, _, _, l, st) -> Menu(o, s, f, md, p, slot, kind, frame, l, st) end
  end
  fn clear_status(m : Menu) : Menu do set_status(m, 0, status_none(), 0) end
  doc "Drop a status once it has been shown for [status_frames]."
  fn expire_status(m : Menu, frame : Int) : Menu do
    if status_kind(m) != status_none() && frame - status_frame(m) >= status_frames() do clear_status(m) else m end
  end

  doc "Esc: a sub-page goes back a level; the escape menu closes; the start screen stays."
  fn escape(m : Menu) : Menu do
    if page(m) != page_main() do set_page(m, back_page(m))
    else if mode(m) == mode_escape() do set_open(m, false)
    else m end end
  end

  doc """
  The menu after a click on [item]. On a row page an arrow steps its
  row's field; everything else is the caller's business (start, save, load,
  page changes have side effects) and leaves the menu unchanged.
  """
  fn click(m : Menu, item : Int) : Menu do
    if !is_row_page(page(m)) || item < 0 || item >= item_back(m) do m
    else
      let part = settings_part(item)
      if part == part_body() do m
      else set_settings(m, Settings.step(settings(m), field_of(m, item), if part == part_right() do 1 else -1 end)) end
    end
  end

  -- ── Seed editing ──────────────────────────────────────────────────────────

  doc """
  Append a decimal digit to the seed. A digit that would push the value past
  [max_seed] is ignored rather than wrapping or truncating, so the field can
  never show a number the generator would not accept.
  """
  fn append_digit(m : Menu, d : Int) : Menu do
    if d < 0 || d > 9 do m
    else
      let next = base_seed(m) * 10 + d
      if next > max_seed() do m else set_seed(m, N.with_age(next, age(m))) end
    end
  end

  doc "Remove the last digit. Deleting the only digit leaves 0, not an empty field. The age stays."
  fn backspace(m : Menu) : Menu do set_seed(m, N.with_age(base_seed(m) / 10, age(m))) end

  doc "Replace the seed AND the age with fresh ones derived from [entropy] (a clock reading)."
  fn reroll(m : Menu, entropy : Int) : Menu do
    let base = int_and(entropy * 2654435761 + 40503, max_seed())
    let age = int_and(entropy * 2246822519 + 3266489917, max_seed()) % (N.max_age() + 1)
    set_seed(m, N.with_age(base, age))
  end

  doc "Move the age by [delta], clamped to 0..Noise.max_age(); the digits stay."
  fn nudge_age(m : Menu, delta : Int) : Menu do set_seed(m, N.with_age(base_seed(m), age(m) + delta)) end
  fn age_up(m : Menu) : Menu do nudge_age(m, age_step()) end
  fn age_down(m : Menu) : Menu do nudge_age(m, 0 - age_step()) end

  -- ── Geometry (NDC) ────────────────────────────────────────────────────────
  -- One source for both drawing and hit-testing. The slots and row pages
  -- are taller and tighter than the main page; everything below is a function
  -- of the page, and on a row page also of the item.

  doc "The sub-pages are wider: a slot row holds SLOT 5 SEED, a ten-digit seed and AGE 100; a settings row two arrows and a long name."
  fn panel_x0(m : Menu) : Float do
    if page(m) == page_slots() do -0.52
    else if is_row_page(page(m)) do -0.45
    else -0.36 end end
  end
  fn panel_x1(m : Menu) : Float do 0.0 -. panel_x0(m) end
  doc "The panel ends a little under its last row: the seed field on main, BACK elsewhere."
  fn panel_y0(m : Menu) : Float do
    if page(m) == page_main() do -0.74
    else if page(m) == page_settings() do -0.38
    else if is_row_page(page(m)) do 0.22 -. int_to_float(page_rows(page(m))) *. 0.14
    else -0.50 end end end
  end
  fn panel_y1(m : Menu) : Float do if is_main_style(m) do 0.36 else 0.50 end end
  doc "The main page and the hub share one layout: wide buttons, one per line."
  pfn is_main_style(m : Menu) : Bool do page(m) == page_main() || page(m) == page_settings() end

  doc "Full width of a row: the whole row on the main, hub and slots pages, arrows included on a row page."
  pfn row_w(m : Menu) : Float do
    if page(m) == page_slots() do 0.90
    else if is_row_page(page(m)) do 0.80
    else 0.44 end end
  end
  pfn row_x0(m : Menu) : Float do 0.0 -. row_w(m) /. 2.0 end
  fn item_h(m : Menu) : Float do if is_main_style(m) do 0.13 else 0.115 end end
  doc "An arrow button is a square of the row's height, with this gap to the body."
  fn arrow_gap() : Float do 0.01 end

  doc "Left edge of item [i]. Only a row page's arrows and bodies differ from the row."
  fn item_x0(m : Menu, i : Int) : Float do
    if !is_row_page(page(m)) || i >= item_back(m) do row_x0(m)
    else
      let part = settings_part(i)
      if part == part_left() do row_x0(m)
      else if part == part_body() do row_x0(m) +. item_h(m) +. arrow_gap()
      else row_x0(m) +. row_w(m) -. item_h(m) end end
    end
  end
  doc "Width of item [i]."
  fn item_w(m : Menu, i : Int) : Float do
    if !is_row_page(page(m)) || i >= item_back(m) do row_w(m)
    else if settings_part(i) == part_body() do row_w(m) -. 2.0 *. (item_h(m) +. arrow_gap())
    else item_h(m) end end
  end
  doc "Bottom edge of item [i]; rows run downward from the top of the panel."
  fn item_y0(m : Menu, i : Int) : Float do
    if page(m) == page_slots() do 0.32 -. int_to_float(i) *. 0.14
    else if is_row_page(page(m)) do
      0.32 -. int_to_float(if i >= item_back(m) do page_rows(page(m)) else settings_row(i) end) *. 0.14
    else 0.08 -. int_to_float(i) *. 0.18 end end
  end

  doc "The main page has the seed field; the sub-pages do not."
  fn has_seed_field(m : Menu) : Bool do page(m) == page_main() end
  doc "The seed field sits below the last item."
  fn seed_y0(m : Menu) : Float do item_y0(m, item_quit()) -. 0.19 end
  fn seed_x0(m : Menu) : Float do row_x0(m) end

  doc "The title drawn above the panel: the game's name on the start screen, nothing otherwise."
  fn title(m : Menu) : String do if is_start(m) do "CUBE FORGE" else "" end end
  fn title_y() : Float do 0.44 end

  doc "Which item (x, y) is over, or -1. Coordinates are NDC, y up."
  fn item_at(m : Menu, x : Float, y : Float) : Int do item_at_go(m, x, y, 0) end
  pfn item_at_go(m : Menu, x : Float, y : Float, i : Int) : Int do
    if i >= items(m) do -1
    else if x >= item_x0(m, i) && x <= item_x0(m, i) +. item_w(m, i)
            && y >= item_y0(m, i) && y <= item_y0(m, i) +. item_h(m) do i
    else item_at_go(m, x, y, i + 1) end end
  end

  -- ── Labels ────────────────────────────────────────────────────────────────

  pfn two(n : Int) : String do (if n < 10 do "0" else "" end) ++ int_to_string(n) end

  doc "The label drawn on item [i] of the current page. A settings body's label is the field's name; its value is [value_label]."
  fn label(m : Menu, i : Int) : String do
    if page(m) == page_main() do
      if i == item_new_game() do "NEW GAME"
      else if i == item_second() do (if is_start(m) do "LOAD GAME" else "SAVE GAME" end)
      else if i == item_settings() do "SETTINGS"
      else "QUIT" end end end
    else if i == item_back(m) do "BACK"
    else if page(m) == page_settings() do (if i == hub_graphics() do "GRAPHICS" else "SOUND" end)
    else if is_row_page(page(m)) do
      let part = settings_part(i)
      if part == part_left() do "<"
      else if part == part_right() do ">"
      else Settings.name(field_of(m, i)) end end
    else
      let slot = slot_of_item(i)
      if status_kind(m) != status_none() && status_slot(m) == slot do
        (if status_kind(m) == status_saved() do "SAVED" else "FAILED" end)
      else
        let info = Save.info_for(slot_infos(m), slot)
        "SLOT " ++ int_to_string(slot)
          ++ (if Save.info_is_empty(info) do " EMPTY"
              else " SEED " ++ int_to_string(N.base_seed(Save.info_seed(info))) ++ " AGE " ++ int_to_string(N.age_of(Save.info_seed(info))) end)
      end
    end end end end
  end

  doc "The right-aligned text of a row page body: the current choice, or FAILED while a write failure shows. Empty elsewhere."
  fn value_label(m : Menu, i : Int) : String do
    if !is_row_page(page(m)) || i >= item_back(m) || settings_part(i) != part_body() do ""
    else
      let f = field_of(m, i)
      if status_kind(m) == status_failed() && status_slot(m) == f do "FAILED"
      else Settings.label(settings(m), f) end
    end
  end

  doc "The second line of a used slot row: the save time as YYYY MM DD HH MM. Empty otherwise."
  fn sublabel(m : Menu, i : Int) : String do
    if page(m) != page_slots() || i >= Save.slots() do ""
    else
      let info = Save.info_for(slot_infos(m), slot_of_item(i))
      if Save.info_is_empty(info) do "" else stamp(Save.info_saved_at(info)) end
    end
  end

  doc "A unix time as YYYY MM DD HH MM (UTC)."
  fn stamp(t : Int) : String do
    match DateTime.from_timestamp(t) do
      DateTime(Date(y, mo, d), Time(h, mi, _)) ->
        int_to_string(y) ++ " " ++ two(mo) ++ " " ++ two(d) ++ " " ++ two(h) ++ " " ++ two(mi)
    end
  end

end
