-- The menu: a start screen and an escape menu over one state machine.
--
-- Two modes and four pages. Start mode (opened at launch) offers NEW GAME,
-- LOAD GAME, SETTINGS and QUIT; escape mode offers NEW GAME, SAVE GAME,
-- SETTINGS and QUIT. NEW GAME opens the new-world page: a SIZE row and an
-- AGE row with an arrow button at either end (age can be RANDOM), the seed
-- field, START and BACK. Both modes open the same slots page (five rows and
-- BACK, where a click saves in escape mode or loads in start mode), and the
-- same settings page: one row per graphics option with arrows, and BACK.
--
-- State and geometry only — no I/O and no world access, so the whole thing is
-- unit-testable. The frame loop reads the state, `Hud` draws it, and both take
-- their coordinates from the accessors here so that the drawn boxes and the
-- hit-tested boxes cannot drift apart.
mod CubeForge.Menu do

  alias CubeForge.Save as Save
  alias CubeForge.Settings as Settings
  alias CubeForge.Noise as N

  -- Menu(open?, seed under edit, item the cursor is over, mode, page,
  --      status row, status kind, frame the status was set, slot listing,
  --      settings under edit, age is random?)
  -- The seed under edit is the PACKED seed (Noise.with_age, with_size): the
  -- digits the player types are its base, the age and the size its high
  -- bytes. All three are edited here and the one number is what a new game
  -- starts from and what a save records. With the age RANDOM the start draws
  -- one from the clock (start_seed).
  type Menu = Menu(Bool, Int, Int, Int, Int, Int, Int, Int, List(CubeForge.Save.SlotInfo), CubeForge.Settings.Settings, Bool)

  doc "The world generator masks its seed to 30 bits; the digits field will not exceed that."
  fn max_seed() : Int do 1073741823 end
  doc "How far one - or = press moves the age."
  fn age_step() : Int do 5 end

  fn mode_start() : Int do 0 end
  fn mode_escape() : Int do 1 end
  fn page_main() : Int do 0 end
  fn page_slots() : Int do 1 end
  fn page_settings() : Int do 2 end
  fn page_world() : Int do 3 end

  -- Main page items.
  fn item_new_game() : Int do 0 end
  doc "SAVE GAME in escape mode, LOAD GAME in start mode."
  fn item_second() : Int do 1 end
  fn item_settings() : Int do 2 end
  fn item_quit() : Int do 3 end
  fn main_items() : Int do 4 end
  -- Slots page items: 0..4 are slots 1..5, then BACK.
  fn slot_of_item(i : Int) : Int do i + 1 end
  -- Arrow-row pages (settings, new world): three items per row (left arrow,
  -- body, right arrow), then the page's own buttons, then BACK.
  fn part_left() : Int do 0 end
  fn part_body() : Int do 1 end
  fn part_right() : Int do 2 end
  fn settings_row(i : Int) : Int do i / 3 end
  fn settings_part(i : Int) : Int do i % 3 end
  fn settings_item(row : Int, part : Int) : Int do row * 3 + part end
  doc "The new-world page's rows."
  fn world_row_size() : Int do 0 end
  fn world_row_age() : Int do 1 end
  fn world_rows() : Int do 2 end
  doc "START on the new-world page: after its two rows."
  fn item_start() : Int do world_rows() * 3 end
  doc "Pages laid out as arrow rows."
  fn is_arrow_page(m : Menu) : Bool do page(m) == page_settings() || page(m) == page_world() end
  doc "Arrow rows on the current page: the settings fields, the world's two, none elsewhere."
  fn arrow_rows(m : Menu) : Int do
    if page(m) == page_settings() do Settings.fields() else if page(m) == page_world() do world_rows() else 0 end end
  end
  doc "BACK is the last item of the slots, settings and new-world pages."
  fn item_back(m : Menu) : Int do
    if page(m) == page_settings() do Settings.fields() * 3
    else if page(m) == page_world() do item_start() + 1
    else Save.slots() end end
  end
  fn items(m : Menu) : Int do
    if page(m) == page_slots() do Save.slots() + 1
    else if is_arrow_page(m) do item_back(m) + 1
    else main_items() end end
  end

  fn status_none() : Int do 0 end
  fn status_saved() : Int do 1 end
  fn status_failed() : Int do 2 end
  doc "Frames a SAVED or FAILED row stays lit."
  fn status_frames() : Int do 60 end

  doc "An escape menu, closed."
  fn new(seed : Int, s : CubeForge.Settings.Settings) : Menu do Menu(false, seed, -1, mode_escape(), page_main(), 0, status_none(), 0, Nil, s, false) end
  doc "The start screen, open."
  fn new_start(seed : Int, s : CubeForge.Settings.Settings) : Menu do Menu(true, seed, -1, mode_start(), page_main(), 0, status_none(), 0, Nil, s, false) end

  fn is_open(m : Menu) : Bool do match m do Menu(o, _, _, _, _, _, _, _, _, _, _) -> o end end
  doc "The packed seed: base, age and size together, what a new game starts from (see start_seed for a RANDOM age)."
  fn seed(m : Menu) : Int do match m do Menu(_, s, _, _, _, _, _, _, _, _, _) -> s end end
  doc "The digits the player edits: the seed with its age and size stripped."
  fn base_seed(m : Menu) : Int do N.base_seed(seed(m)) end
  doc "The world age under edit, 0..Noise.max_age(); meaningless while random_age."
  fn age(m : Menu) : Int do N.age_of(seed(m)) end
  doc "The world side under edit, in chunks."
  fn size(m : Menu) : Int do N.size_of(seed(m)) end
  doc "Is the age to be drawn from the clock at START."
  fn random_age(m : Menu) : Bool do match m do Menu(_, _, _, _, _, _, _, _, _, _, r) -> r end end
  fn focused(m : Menu) : Int do match m do Menu(_, _, f, _, _, _, _, _, _, _, _) -> f end end
  fn mode(m : Menu) : Int do match m do Menu(_, _, _, md, _, _, _, _, _, _, _) -> md end end
  fn page(m : Menu) : Int do match m do Menu(_, _, _, _, p, _, _, _, _, _, _) -> p end end
  fn status_slot(m : Menu) : Int do match m do Menu(_, _, _, _, _, s, _, _, _, _, _) -> s end end
  fn status_kind(m : Menu) : Int do match m do Menu(_, _, _, _, _, _, k, _, _, _, _) -> k end end
  fn status_frame(m : Menu) : Int do match m do Menu(_, _, _, _, _, _, _, f, _, _, _) -> f end end
  fn slot_infos(m : Menu) : List(CubeForge.Save.SlotInfo) do match m do Menu(_, _, _, _, _, _, _, _, l, _, _) -> l end end
  fn settings(m : Menu) : CubeForge.Settings.Settings do match m do Menu(_, _, _, _, _, _, _, _, _, s, _) -> s end end
  fn is_start(m : Menu) : Bool do mode(m) == mode_start() end

  fn set_open(m : Menu, o : Bool) : Menu do match m do Menu(_, s, f, md, p, ss, sk, sf, l, st, r) -> Menu(o, s, f, md, p, ss, sk, sf, l, st, r) end end
  fn set_focus(m : Menu, f : Int) : Menu do match m do Menu(o, s, _, md, p, ss, sk, sf, l, st, r) -> Menu(o, s, f, md, p, ss, sk, sf, l, st, r) end end
  fn set_seed(m : Menu, s : Int) : Menu do match m do Menu(o, _, f, md, p, ss, sk, sf, l, st, r) -> Menu(o, s, f, md, p, ss, sk, sf, l, st, r) end end
  fn set_random_age(m : Menu, r : Bool) : Menu do match m do Menu(o, s, f, md, p, ss, sk, sf, l, st, _) -> Menu(o, s, f, md, p, ss, sk, sf, l, st, r) end end
  fn set_mode(m : Menu, md : Int) : Menu do match m do Menu(o, s, f, _, p, ss, sk, sf, l, st, r) -> Menu(o, s, f, md, p, ss, sk, sf, l, st, r) end end
  doc "Change page. A status belongs to the page it was set on, so it is dropped here."
  fn set_page(m : Menu, p : Int) : Menu do match m do Menu(o, s, f, md, _, _, _, _, l, st, r) -> Menu(o, s, f, md, p, 0, status_none(), 0, l, st, r) end end
  fn set_slots(m : Menu, l : List(CubeForge.Save.SlotInfo)) : Menu do match m do Menu(o, s, f, md, p, ss, sk, sf, _, st, r) -> Menu(o, s, f, md, p, ss, sk, sf, l, st, r) end end
  fn set_settings(m : Menu, st : CubeForge.Settings.Settings) : Menu do match m do Menu(o, s, f, md, p, ss, sk, sf, l, _, r) -> Menu(o, s, f, md, p, ss, sk, sf, l, st, r) end end
  doc "Light a row: a slot number on the slots page, a field index on the settings page."
  fn set_status(m : Menu, slot : Int, kind : Int, frame : Int) : Menu do
    match m do Menu(o, s, f, md, p, _, _, _, l, st, r) -> Menu(o, s, f, md, p, slot, kind, frame, l, st, r) end
  end
  fn clear_status(m : Menu) : Menu do set_status(m, 0, status_none(), 0) end
  doc "Drop a status once it has been shown for [status_frames]."
  fn expire_status(m : Menu, frame : Int) : Menu do
    if status_kind(m) != status_none() && frame - status_frame(m) >= status_frames() do clear_status(m) else m end
  end

  doc "Esc: a sub-page goes back to main; the escape menu closes; the start screen stays."
  fn escape(m : Menu) : Menu do
    if page(m) != page_main() do set_page(m, page_main())
    else if mode(m) == mode_escape() do set_open(m, false)
    else m end end
  end

  doc """
  The menu after a click on [item]. On the settings page an arrow steps its
  row's field; on the new-world page an arrow steps SIZE or AGE; everything
  else is the caller's business (start, save, load, page changes have side
  effects) and leaves the menu unchanged.
  """
  fn click(m : Menu, item : Int) : Menu do
    if !is_arrow_page(m) || item < 0 || item >= arrow_rows(m) * 3 do m
    else
      let part = settings_part(item)
      let dir = if part == part_right() do 1 else -1 end
      if part == part_body() do m
      else if page(m) == page_settings() do set_settings(m, Settings.step(settings(m), settings_row(item), dir))
      else if settings_row(item) == world_row_size() do step_size(m, dir)
      else step_age(m, dir) end end end
    end
  end

  -- ── The new world's size and age ──────────────────────────────────────────
  doc "Sizes step by two chunks: 64, 96, 128 blocks."
  fn size_step() : Int do 2 end
  doc "Move the size by [dir] steps, clamped to Noise.min_size()..max_size(); the digits and age stay."
  fn step_size(m : Menu, dir : Int) : Menu do set_seed(m, N.with_size(seed(m), size(m) + dir * size_step())) end
  doc """
  Move the age row by [dir]: the row runs RANDOM, 0, 5, .. 100. Below 0 is
  RANDOM; above RANDOM is 0. Past 100 stays.
  """
  fn step_age(m : Menu, dir : Int) : Menu do
    if random_age(m) do (if dir > 0 do set_random_age(set_seed(m, N.with_age(seed(m), 0)), false) else m end)
    else if dir < 0 && age(m) == 0 do set_random_age(m, true)
    else nudge_age(m, dir * age_step()) end end
  end
  doc "The seed a new game starts from: the packed seed, with an age drawn from [entropy] (a clock reading) when the age is RANDOM."
  fn start_seed(m : Menu, entropy : Int) : Int do
    if random_age(m) do N.with_age(seed(m), int_and(entropy * 2246822519 + 3266489917, max_seed()) % (N.max_age() + 1)) else seed(m) end
  end
  doc "The size row's text: blocks a side."
  fn size_label(m : Menu) : String do int_to_string(16 * size(m)) ++ " BLOCKS" end
  doc "The age row's text: RANDOM, or the age."
  fn age_label(m : Menu) : String do if random_age(m) do "RANDOM" else int_to_string(age(m)) end end

  -- ── Seed editing ──────────────────────────────────────────────────────────

  doc """
  Append a decimal digit to the seed. A digit that would push the value past
  [max_seed] is ignored rather than wrapping or truncating, so the field can
  never show a number the generator would not accept.
  """
  fn append_digit(m : Menu, d : Int) : Menu do
    if d < 0 || d > 9 do m
    else
      let next = base_seed(m) * 10 + d
      if next > max_seed() do m else set_seed(m, N.with_age(next, age(m))) end
    end
  end

  doc "Remove the last digit. Deleting the only digit leaves 0, not an empty field. The age stays."
  fn backspace(m : Menu) : Menu do set_seed(m, N.with_age(base_seed(m) / 10, age(m))) end

  doc "Replace the seed AND the age with fresh ones derived from [entropy] (a clock reading); the size stays, and the age is no longer RANDOM."
  fn reroll(m : Menu, entropy : Int) : Menu do
    let base = int_and(entropy * 2654435761 + 40503, max_seed())
    let age = int_and(entropy * 2246822519 + 3266489917, max_seed()) % (N.max_age() + 1)
    set_random_age(set_seed(m, N.with_size(N.with_age(base, age), size(m))), false)
  end

  doc "Move the age by [delta], clamped to 0..Noise.max_age(); the digits and size stay, and the age is no longer RANDOM."
  fn nudge_age(m : Menu, delta : Int) : Menu do set_random_age(set_seed(m, N.with_age(seed(m), age(m) + delta)), false) end
  fn age_up(m : Menu) : Menu do nudge_age(m, age_step()) end
  fn age_down(m : Menu) : Menu do nudge_age(m, 0 - age_step()) end

  -- ── Geometry (NDC) ────────────────────────────────────────────────────────
  -- One source for both drawing and hit-testing. The slots and settings pages
  -- are taller and tighter than the main page; everything below is a function
  -- of the page, and on the settings page also of the item.

  doc "The sub-pages are wider: a slot row holds SLOT 5 SEED, a ten-digit seed, AGE 100 and SIZE 128; a settings or world row two arrows and a long name."
  fn panel_x0(m : Menu) : Float do
    if page(m) == page_slots() do -0.56
    else if is_arrow_page(m) do -0.45
    else -0.36 end end
  end
  fn panel_x1(m : Menu) : Float do 0.0 -. panel_x0(m) end
  fn panel_y0(m : Menu) : Float do if page(m) == page_main() do -0.56 else -0.50 end end
  fn panel_y1(m : Menu) : Float do if page(m) == page_main() do 0.36 else 0.50 end end

  doc "Full width of a row: the whole row on the main and slots pages, arrows included on the arrow pages."
  pfn row_w(m : Menu) : Float do
    if page(m) == page_slots() do 0.98
    else if is_arrow_page(m) do 0.80
    else 0.44 end end
  end
  pfn row_x0(m : Menu) : Float do 0.0 -. row_w(m) /. 2.0 end
  fn item_h(m : Menu) : Float do if page(m) == page_main() do 0.13 else 0.115 end end
  doc "An arrow button is a square of the row's height, with this gap to the body."
  fn arrow_gap() : Float do 0.01 end

  doc "Left edge of item [i]. Only the arrow pages' arrows and bodies differ from the row."
  fn item_x0(m : Menu, i : Int) : Float do
    if !is_arrow_page(m) || i >= arrow_rows(m) * 3 do row_x0(m)
    else
      let part = settings_part(i)
      if part == part_left() do row_x0(m)
      else if part == part_body() do row_x0(m) +. item_h(m) +. arrow_gap()
      else row_x0(m) +. row_w(m) -. item_h(m) end end
    end
  end
  doc "Width of item [i]."
  fn item_w(m : Menu, i : Int) : Float do
    if !is_arrow_page(m) || i >= arrow_rows(m) * 3 do row_w(m)
    else if settings_part(i) == part_body() do row_w(m) -. 2.0 *. (item_h(m) +. arrow_gap())
    else item_h(m) end end
  end
  doc "The row an item sits on, on the arrow pages: its arrow row, or the buttons after them in order."
  pfn row_of(m : Menu, i : Int) : Int do
    if i < arrow_rows(m) * 3 do settings_row(i) else arrow_rows(m) + (i - arrow_rows(m) * 3) end
  end
  doc "Bottom edge of item [i]; rows run downward from the top of the panel."
  fn item_y0(m : Menu, i : Int) : Float do
    if page(m) == page_slots() do 0.32 -. int_to_float(i) *. 0.14
    else if is_arrow_page(m) do 0.32 -. int_to_float(row_of(m, i)) *. 0.14
    else 0.08 -. int_to_float(i) *. 0.18 end end
  end

  doc "The new-world page has the seed field; the other pages do not."
  fn has_seed_field(m : Menu) : Bool do page(m) == page_world() end
  doc "The seed field sits below BACK."
  fn seed_y0(m : Menu) : Float do item_y0(m, item_back(m)) -. 0.17 end
  fn seed_x0(m : Menu) : Float do row_x0(m) end

  doc "The title drawn above the panel: the game's name on the start screen, nothing otherwise."
  fn title(m : Menu) : String do if is_start(m) do "CUBE FORGE" else "" end end
  fn title_y() : Float do 0.44 end

  doc "Which item (x, y) is over, or -1. Coordinates are NDC, y up."
  fn item_at(m : Menu, x : Float, y : Float) : Int do item_at_go(m, x, y, 0) end
  pfn item_at_go(m : Menu, x : Float, y : Float, i : Int) : Int do
    if i >= items(m) do -1
    else if x >= item_x0(m, i) && x <= item_x0(m, i) +. item_w(m, i)
            && y >= item_y0(m, i) && y <= item_y0(m, i) +. item_h(m) do i
    else item_at_go(m, x, y, i + 1) end end
  end

  -- ── Labels ────────────────────────────────────────────────────────────────

  pfn two(n : Int) : String do (if n < 10 do "0" else "" end) ++ int_to_string(n) end

  doc "The label drawn on item [i] of the current page. An arrow body's label is the row's name; its value is [value_label]."
  fn label(m : Menu, i : Int) : String do
    if page(m) == page_main() do
      if i == item_new_game() do "NEW GAME"
      else if i == item_second() do (if is_start(m) do "LOAD GAME" else "SAVE GAME" end)
      else if i == item_settings() do "SETTINGS"
      else "QUIT" end end end
    else if i == item_back(m) do "BACK"
    else if page(m) == page_world() && i == item_start() do "START"
    else if is_arrow_page(m) do
      let part = settings_part(i)
      if part == part_left() do "<"
      else if part == part_right() do ">"
      else if page(m) == page_settings() do Settings.name(settings_row(i))
      else if settings_row(i) == world_row_size() do "WORLD SIZE"
      else "WORLD AGE" end end end end
    else
      let slot = slot_of_item(i)
      if status_kind(m) != status_none() && status_slot(m) == slot do
        (if status_kind(m) == status_saved() do "SAVED" else "FAILED" end)
      else
        let info = Save.info_for(slot_infos(m), slot)
        "SLOT " ++ int_to_string(slot)
          ++ (if Save.info_is_empty(info) do " EMPTY"
              else " SEED " ++ int_to_string(N.base_seed(Save.info_seed(info))) ++ " AGE " ++ int_to_string(N.age_of(Save.info_seed(info)))
                   ++ " SIZE " ++ int_to_string(16 * N.size_of(Save.info_seed(info))) end)
      end
    end end end end
  end

  doc "The right-aligned text of an arrow body: the current choice, or FAILED while a write failure shows. Empty elsewhere."
  fn value_label(m : Menu, i : Int) : String do
    if !is_arrow_page(m) || i >= arrow_rows(m) * 3 || settings_part(i) != part_body() do ""
    else
      let row = settings_row(i)
      if page(m) == page_world() do (if row == world_row_size() do size_label(m) else age_label(m) end)
      else if status_kind(m) == status_failed() && status_slot(m) == row do "FAILED"
      else Settings.label(settings(m), row) end end
    end
  end

  doc "The second line of a used slot row: the save time as YYYY MM DD HH MM. Empty otherwise."
  fn sublabel(m : Menu, i : Int) : String do
    if page(m) != page_slots() || i >= Save.slots() do ""
    else
      let info = Save.info_for(slot_infos(m), slot_of_item(i))
      if Save.info_is_empty(info) do "" else stamp(Save.info_saved_at(info)) end
    end
  end

  doc "A unix time as YYYY MM DD HH MM (UTC)."
  fn stamp(t : Int) : String do
    match DateTime.from_timestamp(t) do
      DateTime(Date(y, mo, d), Time(h, mi, _)) ->
        int_to_string(y) ++ " " ++ two(mo) ++ " " ++ two(d) ++ " " ++ two(h) ++ " " ++ two(mi)
    end
  end

end
