-- Noise — 2D value noise with fBm, scalar and 4-wide (F32x4) variants.
--
-- The lattice step (floor, integer hash) cannot be vectorized with the Simd
-- module as it stands: there is no per-lane floor and no f32x4 <-> i32x4
-- conversion (GAPS.md G32). So the 4-wide variant hashes the lattice corners
-- as scalars and vectorizes the smoothstep + bilinear blend across 4 columns.
mod CubeForge.Noise do

  -- Integer hash of a lattice point to [0, 1). Deterministic, seedable.
  fn hash2(ix : Int, iz : Int, seed : Int) : Float do
    let h0 = int_xor(ix * 374761393 + iz * 668265263 + seed * 1274126177, 0)
    let h1 = int_and(h0, 2147483647)
    let h2 = int_xor(h1, h1 / 8192)
    let h3 = int_and(h2 * 1103515245 + 12345, 2147483647)
    let h4 = int_xor(h3, h3 / 65536)
    int_to_float(int_and(h4, 65535)) /. 65536.0
  end

  fn smooth(t : Float) : Float do t *. t *. (3.0 -. 2.0 *. t) end

  fn lerp(a : Float, b : Float, t : Float) : Float do a +. (b -. a) *. t end

  doc "Value noise at (x, z), in [0, 1)."
  fn value2(x : Float, z : Float, seed : Int) : Float do
    let fx = Math.floor(x)
    let fz = Math.floor(z)
    let ix = float_to_int(fx)
    let iz = float_to_int(fz)
    let tx = smooth(x -. fx)
    let tz = smooth(z -. fz)
    let a = hash2(ix, iz, seed)
    let b = hash2(ix + 1, iz, seed)
    let c = hash2(ix, iz + 1, seed)
    let d = hash2(ix + 1, iz + 1, seed)
    lerp(lerp(a, b, tx), lerp(c, d, tx), tz)
  end

  doc "3-octave fBm in [0, 1)."
  fn fbm(x : Float, z : Float, seed : Int) : Float do
    let n0 = value2(x, z, seed)
    let n1 = value2(x *. 2.0 +. 17.3, z *. 2.0 +. 9.1, seed + 1)
    let n2 = value2(x *. 4.0 +. 31.7, z *. 4.0 +. 3.3, seed + 2)
    (n0 *. 0.6 +. n1 *. 0.3 +. n2 *. 0.1)
  end

  -- ── Layered terrain ─────────────────────────────────────────────────────────
  -- height = base (broad landmass) + hills (rolling detail) + mountains, where the
  -- mountain term is ridged noise scaled by a separate low-frequency "ruggedness"
  -- field, so sharp ridgelines appear only over mountain country and plains stay flat.

  doc "Ridged noise in [0, 1]: 1 - |2n - 1|, so peaks form creases rather than blobs."
  fn ridged(x : Float, z : Float, seed : Int) : Float do
    1.0 -. Math.abs(2.0 *. value2(x, z, seed) -. 1.0)
  end

  doc "3-octave ridged noise in [0, 1]."
  fn ridged_fbm(x : Float, z : Float, seed : Int) : Float do
    ridged(x, z, seed) *. 0.45
      +. ridged(x *. 2.0 +. 11.7, z *. 2.0 +. 5.3, seed + 3) *. 0.33
      +. ridged(x *. 4.0 +. 23.1, z *. 4.0 +. 41.9, seed + 4) *. 0.22
  end

  fn clamp01(v : Float) : Float do if v < 0.0 do 0.0 else if v > 1.0 do 1.0 else v end end end

  doc """
  How mountainous the region around (wx, wz) is, in [0, 1]: 0 over plains, 1 over
  mountain country. A low-frequency field, so it forms regions rather than noise.
  """
  fn ruggedness(wx : Int, wz : Int, seed : Int) : Float do
    -- A SINGLE octave: summing octaves (fBm) clusters values hard around 0.5 by the
    -- central-limit effect, which left almost nothing above any useful threshold.
    let r = value2(int_to_float(wx) *. 0.018, int_to_float(wz) *. 0.018, seed + 900)
    smooth(clamp01((r -. 0.50) /. 0.20))
  end

  fn sea_level() : Int do 62 end
  doc "Surface at or above this is snow-capped."
  fn snow_line() : Int do 95 end
  doc "A column whose height differs from a neighbour by at least this is a cliff face."
  fn cliff_slope() : Int do 3 end

  doc "Terrain height for a world column."
  fn height(wx : Int, wz : Int, seed : Int) : Int do
    let x = int_to_float(wx)
    let z = int_to_float(wz)
    -- Continental shape from a single broad octave (wide spread), with fBm detail on top.
    -- Frequencies are set for a 128-block world (8x8 chunks): the continental octave
    -- must span several lattice cells across the map, or every seed produces one flat
    -- elevation for the whole world.
    let cont = value2(x *. 0.022, z *. 0.022, seed)
    let detail = fbm(x *. 0.050 +. 5.1, z *. 0.050 +. 2.6, seed + 2)
    let base = 30.0 +. (cont *. 0.76 +. detail *. 0.24) *. 64.0
    let hills = fbm(x *. 0.090 +. 3.7, z *. 0.090 +. 8.2, seed + 5) *. 7.0
    let rug = ruggedness(wx, wz, seed)
    let mountains = ridged_fbm(x *. 0.035, z *. 0.035, seed + 13) *. rug *. 50.0
    let h = float_to_int(base +. hills +. mountains)
    if h < 1 do 1 else if h > 200 do 200 else h end end
  end

  -- Math has abs (Float) and max_int/min_int, but no abs_int.
  pfn abs_int(v : Int) : Int do if v < 0 do 0 - v else v end end

  doc "Largest height difference between (wx, wz) and its four neighbouring columns."
  fn slope(wx : Int, wz : Int, seed : Int) : Int do
    let h = height(wx, wz, seed)
    let d0 = abs_int(height(wx + 1, wz, seed) - h)
    let d1 = abs_int(height(wx - 1, wz, seed) - h)
    let d2 = abs_int(height(wx, wz + 1, seed) - h)
    let d3 = abs_int(height(wx, wz - 1, seed) - h)
    Math.max_int(Math.max_int(d0, d1), Math.max_int(d2, d3))
  end

  -- ── 4-wide: columns wx .. wx+3 at one z, one octave, blended in F32x4 ──
  pfn value2_x4(x0 : Float, z : Float, scale : Float, seed : Int) : F32x4 do
    -- lattice (scalar): the four columns share iz; their ix may straddle a lattice line
    let zs = z *. scale
    let fz = Math.floor(zs)
    let iz = float_to_int(fz)
    let tz = smooth(zs -. fz)
    let xs = Simd.make_f32x4(x0 *. scale, (x0 +. 1.0) *. scale, (x0 +. 2.0) *. scale, (x0 +. 3.0) *. scale)
    -- per-lane floor is unavailable: pull lanes out, floor as scalars, push back
    let f0 = Math.floor(Simd.extract_f32x4(xs, 0))
    let f1 = Math.floor(Simd.extract_f32x4(xs, 1))
    let f2 = Math.floor(Simd.extract_f32x4(xs, 2))
    let f3 = Math.floor(Simd.extract_f32x4(xs, 3))
    let fxs = Simd.make_f32x4(f0, f1, f2, f3)
    let i0 = float_to_int(f0)
    let i1 = float_to_int(f1)
    let i2 = float_to_int(f2)
    let i3 = float_to_int(f3)
    -- corner hashes (scalar), packed per lane
    let a = Simd.make_f32x4(hash2(i0, iz, seed), hash2(i1, iz, seed), hash2(i2, iz, seed), hash2(i3, iz, seed))
    let b = Simd.make_f32x4(hash2(i0 + 1, iz, seed), hash2(i1 + 1, iz, seed), hash2(i2 + 1, iz, seed), hash2(i3 + 1, iz, seed))
    let c = Simd.make_f32x4(hash2(i0, iz + 1, seed), hash2(i1, iz + 1, seed), hash2(i2, iz + 1, seed), hash2(i3, iz + 1, seed))
    let d = Simd.make_f32x4(hash2(i0 + 1, iz + 1, seed), hash2(i1 + 1, iz + 1, seed), hash2(i2 + 1, iz + 1, seed), hash2(i3 + 1, iz + 1, seed))
    -- vector part: t = smooth(x - floor x); blend
    let t = Simd.sub_f32x4(xs, fxs)
    let three = Simd.splat_f32x4(3.0)
    let two = Simd.splat_f32x4(2.0)
    let tx = Simd.mul_f32x4(Simd.mul_f32x4(t, t), Simd.sub_f32x4(three, Simd.mul_f32x4(two, t)))
    let ab = Simd.add_f32x4(a, Simd.mul_f32x4(Simd.sub_f32x4(b, a), tx))
    let cd = Simd.add_f32x4(c, Simd.mul_f32x4(Simd.sub_f32x4(d, c), tx))
    Simd.add_f32x4(ab, Simd.mul_f32x4(Simd.sub_f32x4(cd, ab), Simd.splat_f32x4(tz)))
  end

  -- Vector helpers mirroring the scalar smooth/clamp01/ridged.
  pfn smooth_x4(t : F32x4) : F32x4 do
    Simd.mul_f32x4(Simd.mul_f32x4(t, t), Simd.sub_f32x4(Simd.splat_f32x4(3.0), Simd.mul_f32x4(Simd.splat_f32x4(2.0), t)))
  end
  pfn clamp01_x4(v : F32x4) : F32x4 do
    Simd.min_f32x4(Simd.max_f32x4(v, Simd.splat_f32x4(0.0)), Simd.splat_f32x4(1.0))
  end
  -- 1 - |2n - 1|, with the absolute value as max(2n-1, 1-2n): Simd has no per-lane abs.
  pfn ridged_x4(x0 : Float, z : Float, scale : Float, seed : Int) : F32x4 do
    let n = value2_x4(x0, z, scale, seed)
    let two_n_minus_1 = Simd.sub_f32x4(Simd.mul_f32x4(Simd.splat_f32x4(2.0), n), Simd.splat_f32x4(1.0))
    let neg = Simd.sub_f32x4(Simd.splat_f32x4(0.0), two_n_minus_1)
    Simd.sub_f32x4(Simd.splat_f32x4(1.0), Simd.max_f32x4(two_n_minus_1, neg))
  end

  -- fbm/ridged_fbm offset their octaves in ALREADY-SCALED coordinates, so an offset of
  -- `o` at octave scale `s` becomes `o / s` on the unscaled coordinate value2_x4 takes.
  pfn fbm_x4(x0 : Float, z : Float, scale : Float, seed : Int) : F32x4 do
    let n0 = value2_x4(x0, z, scale, seed)
    let n1 = value2_x4(x0 +. 17.3 /. (2.0 *. scale), z +. 9.1 /. (2.0 *. scale), 2.0 *. scale, seed + 1)
    let n2 = value2_x4(x0 +. 31.7 /. (4.0 *. scale), z +. 3.3 /. (4.0 *. scale), 4.0 *. scale, seed + 2)
    Simd.add_f32x4(Simd.add_f32x4(Simd.mul_f32x4(n0, Simd.splat_f32x4(0.6)), Simd.mul_f32x4(n1, Simd.splat_f32x4(0.3))),
                   Simd.mul_f32x4(n2, Simd.splat_f32x4(0.1)))
  end

  pfn ridged_fbm_x4(x0 : Float, z : Float, scale : Float, seed : Int) : F32x4 do
    let r0 = ridged_x4(x0, z, scale, seed)
    let r1 = ridged_x4(x0 +. 11.7 /. (2.0 *. scale), z +. 5.3 /. (2.0 *. scale), 2.0 *. scale, seed + 3)
    let r2 = ridged_x4(x0 +. 23.1 /. (4.0 *. scale), z +. 41.9 /. (4.0 *. scale), 4.0 *. scale, seed + 4)
    Simd.add_f32x4(Simd.add_f32x4(Simd.mul_f32x4(r0, Simd.splat_f32x4(0.45)), Simd.mul_f32x4(r1, Simd.splat_f32x4(0.33))),
                   Simd.mul_f32x4(r2, Simd.splat_f32x4(0.22)))
  end

  doc """
  Heights for the four columns wx .. wx+3 at wz, as an F32x4 — the same value as
  `height`. The lattice and hashing stay scalar (GAPS.md G32: no per-lane floor or
  float/int convert); everything above them is vector work.
  """
  fn height_x4(wx : Int, wz : Int, seed : Int) : F32x4 do
    let x0 = int_to_float(wx)
    let z = int_to_float(wz)
    let cont = value2_x4(x0, z, 0.022, seed)
    let detail = fbm_x4(x0 +. 5.1 /. 0.050, z +. 2.6 /. 0.050, 0.050, seed + 2)
    let base = Simd.add_f32x4(Simd.splat_f32x4(30.0),
      Simd.mul_f32x4(Simd.add_f32x4(Simd.mul_f32x4(cont, Simd.splat_f32x4(0.76)),
                                    Simd.mul_f32x4(detail, Simd.splat_f32x4(0.24))), Simd.splat_f32x4(64.0)))
    let hills = Simd.mul_f32x4(fbm_x4(x0 +. 3.7 /. 0.090, z +. 8.2 /. 0.090, 0.090, seed + 5), Simd.splat_f32x4(7.0))
    let rugv = value2_x4(x0, z, 0.018, seed + 900)
    let rug = smooth_x4(clamp01_x4(Simd.div_f32x4(Simd.sub_f32x4(rugv, Simd.splat_f32x4(0.50)), Simd.splat_f32x4(0.20))))
    let mountains = Simd.mul_f32x4(Simd.mul_f32x4(ridged_fbm_x4(x0, z, 0.035, seed + 13), rug), Simd.splat_f32x4(50.0))
    let h = Simd.add_f32x4(Simd.add_f32x4(base, hills), mountains)
    Simd.min_f32x4(Simd.max_f32x4(h, Simd.splat_f32x4(1.0)), Simd.splat_f32x4(200.0))
  end

end
