-- Player — first-person camera, WASD movement, gravity, and per-axis swept
-- AABB collision against the voxel grid. Pure: takes inputs as values.
--
-- Written to run every frame; the state is a single-constructor variant so the
-- per-frame rebuild can reuse the cell. Allocation is measured, see GAPS.md.
mod CubeForge.Player do

  alias CubeForge.Math.Vec3 as V
  alias CubeForge.World as W

  -- position (feet, centre of the box), velocity, yaw, pitch, on_ground
  type Player = Player(CubeForge.Math.Vec3.Vec3, CubeForge.Math.Vec3.Vec3, Float, Float, Bool)
  -- Water physics constants
  fn water_gravity() : Float do -4.0 end
  fn swim_speed() : Float do 4.0 end
  fn water_vmax() : Float do 3.0 end

  -- Per-frame input snapshot, gathered by the caller (which holds the Input cap).
  type Input = Input(Float, Float, Float, Float, Bool)   -- move_fwd, move_right, mouse_dx, mouse_dy, jump
  -- Result of one axis sweep: position + hit flag. A variant, not a tuple (GAPS.md G29).
  type Sweep = Sweep(Float, Float, Float, Bool)

  fn input_forward(i : Input) : Float do match i do Input(mf, _, _, _, _) -> mf end end

  fn half_width() : Float do 0.3 end
  fn height() : Float do 1.8 end
  fn eye_height() : Float do 1.62 end
  fn gravity() : Float do -24.0 end
  fn jump_speed() : Float do 8.5 end
  fn walk_speed() : Float do 5.0 end
  fn mouse_sens() : Float do 0.0025 end

  fn new(x : Float, y : Float, z : Float) : Player do
    Player(V.new(x, y, z), V.zero(), 0.0, 0.0, false)
  end

  @[no_alloc]
  fn with_pitch(p : Player, pitch : Float) : Player do
    match p do Player(pos, vel, yaw, _, g) -> Player(pos, vel, yaw, pitch, g) end
  end
  fn position(p : Player) : CubeForge.Math.Vec3.Vec3 do match p do Player(pos, _, _, _, _) -> pos end end
  fn yaw(p : Player) : Float do match p do Player(_, _, y, _, _) -> y end end
  fn pitch(p : Player) : Float do match p do Player(_, _, _, pt, _) -> pt end end
  fn on_ground(p : Player) : Bool do match p do Player(_, _, _, _, g) -> g end end

  @[no_alloc]
  -- True when the block at the feet or at the eye is water.
  fn in_water(p : Player, w : CubeForge.World.World) : Bool do
    match p do
      Player(pos, _, _, _, _) ->
        let x = float_to_int(Math.floor(V.x(pos)))
        let z = float_to_int(Math.floor(V.z(pos)))
        W.water_at(w, x, float_to_int(Math.floor(V.y(pos) +. 0.1)), z)
          || W.water_at(w, x, float_to_int(Math.floor(V.y(pos) +. eye_height())), z)
    end
  end
  doc "True when the eye itself is inside water (underwater tint)."
  fn eye_in_water(p : Player, w : CubeForge.World.World) : Bool do
    match p do
      Player(pos, _, _, _, _) ->
        W.water_at(w, float_to_int(Math.floor(V.x(pos))), float_to_int(Math.floor(V.y(pos) +. eye_height())), float_to_int(Math.floor(V.z(pos))))
    end
  end

  fn eye(p : Player) : CubeForge.Math.Vec3.Vec3 do
    match p do Player(pos, _, _, _, _) -> V.new(V.x(pos), V.y(pos) +. eye_height(), V.z(pos)) end
  end

  -- Unit view direction from yaw (0 = -Z) and pitch.
  fn forward(yaw : Float, pitch : Float) : CubeForge.Math.Vec3.Vec3 do
    let cp = Math.cos(pitch)
    V.new(0.0 -. Math.sin(yaw) *. cp, Math.sin(pitch), 0.0 -. Math.cos(yaw) *. cp)
  end

  fn clamp(x : Float, lo : Float, hi : Float) : Float do
    if x < lo do lo else if x > hi do hi else x end end
  end

  -- ── Collision ──────────────────────────────────────────────────────────────
  -- The player box is [x-hw, x+hw] x [y, y+h] x [z-hw, z+hw].

  -- True if any solid voxel overlaps the box at (px, py, pz).
  @[no_alloc]
  pfn box_hits(w : CubeForge.World.World, px : Float, py : Float, pz : Float) : Bool do
    let x0 = float_to_int(Math.floor(px -. half_width()))
    let x1 = float_to_int(Math.floor(px +. half_width() -. 0.0001))
    let y0 = float_to_int(Math.floor(py))
    let y1 = float_to_int(Math.floor(py +. height() -. 0.0001))
    let z0 = float_to_int(Math.floor(pz -. half_width()))
    let z1 = float_to_int(Math.floor(pz +. half_width() -. 0.0001))
    hits_go(w, x0, x1, y0, y1, z0, z1, x0, y0, z0)
  end

  @[no_alloc]
  pfn hits_go(w : CubeForge.World.World, x0 : Int, x1 : Int, y0 : Int, y1 : Int, z0 : Int, z1 : Int, x : Int, y : Int, z : Int) : Bool do
    if y > y1 do false
    else if W.collidable_at(w, x, y, z) do true
    else
      if x < x1 do hits_go(w, x0, x1, y0, y1, z0, z1, x + 1, y, z)
      else if z < z1 do hits_go(w, x0, x1, y0, y1, z0, z1, x0, y, z + 1)
      else hits_go(w, x0, x1, y0, y1, z0, z1, x0, y + 1, z0) end end
    end end
  end

  -- Move along one axis by `d`, stepping at most a quarter block per substep so a
  -- fast body cannot tunnel. On contact, snap flush to the voxel face and report
  -- the collision (the velocity component is zeroed by the caller).
  -- axis: 0 = x, 1 = y, 2 = z.
  pfn sweep_axis(w : CubeForge.World.World, axis : Int, px : Float, py : Float, pz : Float, d : Float) : Sweep do
    if Math.abs(d) < 0.0000001 do Sweep(px, py, pz, false)
    else
      let step = if d > 0.25 do 0.25 else if d < -0.25 do -0.25 else d end end
      let nx = if axis == 0 do px +. step else px end
      let ny = if axis == 1 do py +. step else py end
      let nz = if axis == 2 do pz +. step else pz end
      if box_hits(w, nx, ny, nz) do
        -- snap: push back to the face of the block we entered
        let sx = if axis == 0 do snap(nx, half_width(), step) else px end
        let sy = if axis == 1 do (if step > 0.0 do Math.floor(ny +. height()) -. height() -. 0.0001 else Math.ceil(ny) end) else py end
        let sz = if axis == 2 do snap(nz, half_width(), step) else pz end
        Sweep(sx, sy, sz, true)
      else
        sweep_axis(w, axis, nx, ny, nz, d -. step)
      end
    end
  end

  @[no_alloc]
  pfn snap(c : Float, hw : Float, step : Float) : Float do
    if step > 0.0 do Math.floor(c +. hw) -. hw -. 0.0001 else Math.ceil(c -. hw) +. hw +. 0.0001 end
  end

  -- Advance the player by [dt] seconds under [input] against [world].
  fn update(p : Player, input : Input, w : CubeForge.World.World, dt : Float) : Player do
    match p do
      Player(pos, vel, yaw0, pitch0, _) ->
        match input do
          Input(mf, mr, mdx, mdy, jump) ->
        let yaw1 = yaw0 -. mdx *. mouse_sens()
        let pitch1 = clamp(pitch0 -. mdy *. mouse_sens(), -1.55, 1.55)
        -- horizontal wish direction in world space (yaw only)
        let fx = 0.0 -. Math.sin(yaw1)
        let fz = 0.0 -. Math.cos(yaw1)
        let rx = Math.cos(yaw1)
        let rz = 0.0 -. Math.sin(yaw1)
        let swimming = in_water(p, w)
        let speed = if swimming do walk_speed() *. 0.5 else walk_speed() end
        let wx = (fx *. mf +. rx *. mr) *. speed
        let wz = (fz *. mf +. rz *. mr) *. speed
        let g = if swimming do water_gravity() else gravity() end
        let vy0 = V.y(vel) +. g *. dt
        let grounded0 = box_hits(w, V.x(pos), V.y(pos) -. 0.002, V.z(pos))
        let vy1 = if swimming do
          clamp(if jump do vy0 +. swim_speed() *. dt *. 8.0 else vy0 end, 0.0 -. water_vmax(), water_vmax())
        else if jump && grounded0 do jump_speed() else vy0 end end
        -- sweep x, then y, then z
        let px0 = V.x(pos)
        let py0 = V.y(pos)
        let pz0 = V.z(pos)
        match sweep_axis(w, 0, px0, py0, pz0, wx *. dt) do
          Sweep(px1, py1, pz1, _) ->
            match sweep_axis(w, 1, px1, py1, pz1, vy1 *. dt) do
              Sweep(px2, py2, pz2, hit_y) ->
                match sweep_axis(w, 2, px2, py2, pz2, wz *. dt) do
                  Sweep(px3, py3, pz3, _) ->
                    let vy2 = if hit_y do 0.0 else vy1 end
                    let grounded = hit_y && vy1 < 0.0
                    Player(V.new(px3, py3, pz3), V.new(wx, vy2, wz), yaw1, pitch1, grounded)
                end
            end
        end
        end
    end
  end

end