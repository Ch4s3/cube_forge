-- Settings — the graphics options a player can change from the menu.
--
-- Five fields, each an index into a fixed list of choices, so stepping is one
-- operation for every row. `value` turns the index into the number the game
-- uses (blocks of shadow reach, a particle cap, a 0/1 flag); the file stores
-- those numbers rather than indices so a later change to a choice list does
-- not reinterpret an old file.
--
-- The file is lenient on purpose. The save header refuses a missing key so a
-- truncated header cannot half-load a world; here the worst outcome is a
-- default value, so missing keys default, unknown keys are ignored, and a
-- missing or unreadable file is just the defaults.
--
-- See docs/superpowers/specs/2026-09-05-settings-menu-design.md.
mod CubeForge.Settings do

  needs IO.FileRead
  needs IO.FileWrite

  -- fullscreen, vsync, shadow distance, soft shadows, precipitation: one choice index each
  type Settings = Settings(Int, Int, Int, Int, Int)

  fn fields() : Int do 5 end
  fn field_fullscreen() : Int do 0 end
  fn field_vsync() : Int do 1 end
  fn field_shadow_dist() : Int do 2 end
  fn field_soft_shadows() : Int do 3 end
  fn field_precip() : Int do 4 end

  fn version() : Int do 1 end

  doc "The row's name as drawn."
  fn name(f : Int) : String do
    if f == field_fullscreen() do "FULLSCREEN"
    else if f == field_vsync() do "VSYNC"
    else if f == field_shadow_dist() do "SHADOWS"
    else if f == field_soft_shadows() do "SOFT SHADOWS"
    else "PRECIPITATION" end end end end
  end

  doc "The file key of a field."
  fn key(f : Int) : String do
    if f == field_fullscreen() do "fullscreen"
    else if f == field_vsync() do "vsync"
    else if f == field_shadow_dist() do "shadow_dist"
    else if f == field_soft_shadows() do "soft_shadows"
    else "precip" end end end end
  end

  doc "How many choices a field has."
  fn choices(f : Int) : Int do
    if f == field_shadow_dist() do 5
    else if f == field_precip() do 4
    else 2 end end
  end

  doc "The label of choice [i] of field [f]."
  fn choice_label(f : Int, i : Int) : String do
    if f == field_shadow_dist() do
      (if i == 0 do "OFF" else int_to_string(choice_value(f, i)) end)
    else if f == field_precip() do
      (if i == 0 do "OFF" else if i == 1 do "LOW" else if i == 2 do "MEDIUM" else "HIGH" end end end)
    else (if i == 0 do "OFF" else "ON" end) end end
  end

  doc "The game-facing number of choice [i]: blocks, particles, or a 0/1 flag."
  fn choice_value(f : Int, i : Int) : Int do
    if f == field_shadow_dist() do
      (if i == 0 do 0 else if i == 1 do 16 else if i == 2 do 32 else if i == 3 do 64 else 128 end end end end)
    else if f == field_precip() do
      (if i == 0 do 0 else if i == 1 do 1000 else if i == 2 do 2500 else 4000 end end end)
    else i end end
  end

  doc "Windowed, vsync on, shadows 64 and soft, full precipitation: what the environment knobs defaulted to."
  fn defaults() : Settings do Settings(0, 1, 3, 1, 3) end

  fn index(s : Settings, f : Int) : Int do
    match s do
      Settings(a, b, c, d, e) ->
        if f == 0 do a else if f == 1 do b else if f == 2 do c else if f == 3 do d else e end end end end
    end
  end
  fn set_index(s : Settings, f : Int, i : Int) : Settings do
    match s do
      Settings(a, b, c, d, e) ->
        if f == 0 do Settings(i, b, c, d, e)
        else if f == 1 do Settings(a, i, c, d, e)
        else if f == 2 do Settings(a, b, i, d, e)
        else if f == 3 do Settings(a, b, c, i, e)
        else Settings(a, b, c, d, i) end end end end
    end
  end
  fn value(s : Settings, f : Int) : Int do choice_value(f, index(s, f)) end
  fn label(s : Settings, f : Int) : String do choice_label(f, index(s, f)) end

  doc "Move field [f] one choice in [dir] (+1 or -1), wrapping at either end."
  fn step(s : Settings, f : Int, dir : Int) : Settings do
    let n = choices(f)
    set_index(s, f, (index(s, f) + dir + n) % n)
  end

  pfn abs_diff(a : Int, b : Int) : Int do if a > b do a - b else b - a end end
  pfn nearest_go(f : Int, v : Int, i : Int, best : Int) : Int do
    if i >= choices(f) do best
    else nearest_go(f, v, i + 1, if abs_diff(choice_value(f, i), v) < abs_diff(choice_value(f, best), v) do i else best end) end
  end
  doc "The choice of [f] whose value is closest to [v]; ties go to the lower choice."
  fn nearest(f : Int, v : Int) : Int do nearest_go(f, v, 1, 0) end
  doc "Set a field by game value, through [nearest]."
  fn with_value(s : Settings, f : Int, v : Int) : Settings do set_index(s, f, nearest(f, v)) end

  pfn same_go(a : Settings, b : Settings, f : Int) : Bool do
    if f >= fields() do true
    else if index(a, f) != index(b, f) do false
    else same_go(a, b, f + 1) end end
  end
  doc "Field-by-field equality."
  fn same(a : Settings, b : Settings) : Bool do same_go(a, b, 0) end
  doc "The first field on which [a] and [b] differ, or -1."
  fn first_diff(a : Settings, b : Settings) : Int do first_diff_go(a, b, 0) end
  pfn first_diff_go(a : Settings, b : Settings, f : Int) : Int do
    if f >= fields() do -1
    else if index(a, f) != index(b, f) do f
    else first_diff_go(a, b, f + 1) end end
  end

  fn bit(f : Int) : Int do if f <= 0 do 1 else 2 * bit(f - 1) end end
  doc "Whether field [f] is in [mask], a set of fields as bits."
  fn in_mask(mask : Int, f : Int) : Bool do int_and(mask / bit(f), 1) == 1 end

  pfn merge_go(live : Settings, disk : Settings, mask : Int, f : Int) : Settings do
    if f >= fields() do live
    else merge_go(if in_mask(mask, f) do set_index(live, f, index(disk, f)) else live end, disk, mask, f + 1) end
  end
  doc """
  What to write: [live], except that every field in [mask] keeps the value it
  had in [disk]. An environment override is applied to the live settings but
  must never reach the file, so a scripted run cannot clobber the player's
  choices.
  """
  fn merge(live : Settings, disk : Settings, mask : Int) : Settings do merge_go(live, disk, mask, 0) end

  -- ── File ─────────────────────────────────────────────────────────────────

  pfn encode_go(s : Settings, f : Int, acc : String) : String do
    if f >= fields() do acc
    else encode_go(s, f + 1, acc ++ key(f) ++ " " ++ int_to_string(value(s, f)) ++ "\n") end
  end
  doc "The file as text: `version`, then one `key value` line per field."
  fn encode(s : Settings) : String do encode_go(s, 0, "version " ++ int_to_string(version()) ++ "\n") end

  -- The integer after [k] on the first line that starts with it, if there is one and it parses.
  pfn find_int(lines : List(String), k : String) : Result(Int, String) do
    match lines do
      Nil -> Err("missing")
      Cons(l, rest) ->
        match String.split(String.trim(l), " ") do
          Cons(key0, Cons(t, Nil)) ->
            if key0 == k do String.to_int(t) else find_int(rest, k) end
          _ -> find_int(rest, k)
        end
    end
  end
  pfn parse_go(lines : List(String), s : Settings, f : Int) : Settings do
    if f >= fields() do s
    else
      let s1 = match find_int(lines, key(f)) do
        Ok(v) -> with_value(s, f, v)
        Err(_) -> s
      end
      parse_go(lines, s1, f + 1)
    end
  end
  doc "Parse a file. Never fails: anything missing or malformed takes its default."
  fn parse(text : String) : Settings do parse_go(String.split(text, "\n"), defaults(), 0) end

  fn path(dir : String) : String do dir ++ "/settings.txt" end

  doc "The settings in [dir], or the defaults when there is no readable file."
  fn load(dir : String) : Settings do
    match File.read(path(dir)) do
      Ok(t) -> parse(t)
      Err(_) -> defaults()
    end
  end

  doc "Write the settings to [dir], creating it. True on success."
  fn store(dir : String, s : Settings) : Bool do
    match Dir.mkdir_p(dir) do
      Err(_) -> false
      Ok(_) ->
        match File.write(path(dir), encode(s)) do
          Ok(_) -> true
          Err(_) -> false
        end
    end
  end

end
