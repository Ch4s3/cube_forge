-- F32Buf — a uniquely-owned growable buffer of f32 with amortized O(1) push.
--
-- Stdlib candidate. NativeArray gives a fixed-length flat array whose `set`
-- is FBIP in place at rc == 1 (runtime/march_runtime.c native_f32_arr_set), but
-- nothing in the stdlib grows one. This wraps (storage, len, cap) and doubles.
--
-- Representation notes (measured, see GAPS.md):
--  * A single-constructor VARIANT, not a record: `F32Buf(d, n, c) -> F32Buf(d', n + 1, c)`
--    gets Perceus reuse (0 allocations per push); the record update form
--    allocated twice per push (G12).
--  * Capacity is CACHED in the constructor. Reading `NativeArray.length_f32(d)`
--    inside push, before the set, bumped d's refcount and turned every set
--    into a full copy: one allocation and a 512KB memcpy per pushed float (G21).
mod CubeForge.F32Buf do

  needs IO.Foreign
  needs Window

  type F32Buf = F32Buf(NativeF32Arr, Int, Int)

  doc "A buffer with room for [cap] floats and length 0."
  fn new(cap : {Int | _ >= 1}) : F32Buf do
    F32Buf(NativeArray.make_f32(cap, 0.0), 0, cap)
  end

  doc "Number of floats pushed so far."
  fn len(b : F32Buf) : Int do
    match b do
      F32Buf(_, n, _) -> n
    end
  end

  doc "Current capacity in floats."
  fn capacity(b : F32Buf) : Int do
    match b do
      F32Buf(_, _, c) -> c
    end
  end

  doc "The backing NativeF32Arr (only the first `len` floats are meaningful)."
  fn storage(b : F32Buf) : NativeF32Arr do
    match b do
      F32Buf(d, _, _) -> d
    end
  end

  doc "Float at index [i], or None when out of range."
  fn get(b : F32Buf, i : Int) : Option(Float) do
    match b do
      F32Buf(d, n, _) -> if i < 0 || i >= n do None else Some(NativeArray.get_f32(d, i)) end
    end
  end

  -- Copy [n] floats from src into dst (dst must be unique for in-place set).
  pfn copy_into(src : NativeF32Arr, dst : NativeF32Arr, i : Int, n : Int) : NativeF32Arr do
    if i >= n do dst
    else copy_into(src, NativeArray.set_f32(dst, i, NativeArray.get_f32(src, i)), i + 1, n) end
  end

  pfn grow(d : NativeF32Arr, n : Int, new_cap : {Int | _ >= 0}) : NativeF32Arr do
    copy_into(d, NativeArray.make_f32(new_cap, 0.0), 0, n)
  end

  doc "Append one float. Amortized O(1); in place when the buffer is uniquely owned."
  fn push(b : F32Buf, v : Float) : F32Buf do
    match b do
      F32Buf(d, n, cap) ->
        if n < cap do
          F32Buf(NativeArray.set_f32(d, n, v), n + 1, cap)
        else
          let new_cap = if cap < 16 do 32 else cap * 2 end
          F32Buf(NativeArray.set_f32(grow(d, n, new_cap), n, v), n + 1, new_cap)
        end
    end
  end

  doc "Append three floats."
  fn push3(b : F32Buf, x : Float, y : Float, z : Float) : F32Buf do
    push(push(push(b, x), y), z)
  end

  doc "Append the live prefix of [src] to [b] with one memcpy (grows first if needed)."
  fn append(b : F32Buf, src : F32Buf) : F32Buf do
    match src do
      F32Buf(sd, sn, _) ->
        match b do
          F32Buf(d, n, cap) ->
            if n + sn <= cap do
              F32Buf(CubeForge.Ffi.Window.f32_blit(d, n, sd, 0, sn), n + sn, cap)
            else
              let new_cap = grow_to(cap, n + sn)
              F32Buf(CubeForge.Ffi.Window.f32_blit(grow(d, n, new_cap), n, sd, 0, sn), n + sn, new_cap)
            end
        end
    end
  end

  pfn grow_to(cap : Int, need : Int) : Int do
    let c = if cap < 16 do 32 else cap * 2 end
    if c >= need do c else grow_to(c, need) end
  end

  doc "Reset length to 0, keeping the storage."
  fn clear(b : F32Buf) : F32Buf do
    match b do
      F32Buf(d, _, c) -> F32Buf(d, 0, c)
    end
  end

end
