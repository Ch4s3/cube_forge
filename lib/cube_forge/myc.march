-- Myc — the mycelium field, one entry per world column beside the biome field.
--
-- species: 0 for none, else a Species id.   vigour: 0..1, how established.
-- reach: hops this column may still spread.  hold: consecutive ticks the same
-- claimant has wanted this column.           claimant: that claimant's species.
-- dirty: the column changed last tick or is unsettled, so it and its eight
--        neighbours must be looked at again.
-- seen: the temperature and moisture the column was last evaluated at (two
--       f32 per column), so a climate that moved under it wakes it by itself.
-- pulls: the raw climate pull on each column (two f32: temperature, moisture)
--        from the distinct species in its 3x3, kept up to date where species
--        change, so the biome can read it without a pass over the field.
-- prow: one byte per row, set where a pull changed since the last tick began,
--       so the biome looks only at rows that moved. A tick starts it clean.
--
-- Recomputed every tick, like the biome field, but only where something can
-- change. The tick is PULL-based: each column reads its eight neighbours from
-- the previous tick's arrays and writes only its own entry into fresh arrays,
-- so no array is ever read and then written in one pass (GAPS G21/G63) and the
-- Scene's shared reference never forces a copy (GAPS G68). The fresh arrays
-- start as memcpys of the old ones, so a column that is not looked at keeps
-- its state for free.
mod CubeForge.Myc do

  alias CubeForge.Species as S
  alias CubeForge.Noise as N
  alias CubeForge.Ffi.Window as Win

  type Net = Net(NativeU8Arr, NativeF32Arr, NativeU8Arr, NativeU8Arr, NativeU8Arr, NativeU8Arr, NativeF32Arr, NativeF32Arr, NativeU8Arr)

  -- ── Tuning ────────────────────────────────────────────────────────────────
  doc "Columns a planting can spread along an axis."
  fn plant_radius() : Int do 8 end
  doc "Reach a planting starts with, in half-hops: a straight hop costs 2 and a diagonal 3, so the patch is an octagon of radius plant_radius()."
  fn plant_reach() : Int do 2 * plant_radius() end
  doc "Vigour a newly claimed or planted column starts at."
  fn seed_vigour() : Float do 0.25 end
  doc "A column spreads once its vigour reaches this."
  fn spread_vigour() : Float do 0.6 end
  doc "Minimum fitness to claim an empty column."
  fn claim_floor() : Float do 0.2 end
  doc "A challenger needs this much more fitness than the incumbent to contest."
  fn contest_margin() : Float do 0.15 end
  doc "Consecutive ticks a claim must persist before the column flips."
  fn hold_ticks() : Int do 30 end
  doc "Vigour moved per tick toward its target: the full range in ~540 ticks."
  fn default_rate() : Float do 1.0 /. 540.0 end
  doc "How much faster a contested incumbent loses vigour than it would ease."
  fn contest_factor() : Float do 3.0 end
  doc "Vigour differences below this are no difference: f32 storage against f64 targets."
  fn vigour_eps() : Float do 0.000001 end
  doc "A column this close to its vigour target is settled: below what the map or the readout can show."
  fn settle_eps() : Float do 0.002 end

  -- ── Build, plant, read ────────────────────────────────────────────────────
  doc "An empty field of n x n columns. Every column starts dirty: the first tick looks at all of them once."
  fn build(n : Int) : Net do
    Net(NativeArray.make_u8(n * n, 0), NativeArray.make_f32(n * n, 0.0), NativeArray.make_u8(n * n, 0), NativeArray.make_u8(n * n, 0), NativeArray.make_u8(n * n, 0), NativeArray.make_u8(n * n, 1), NativeArray.make_f32(2 * n * n, -1.0), NativeArray.make_f32(2 * n * n, 0.0), NativeArray.make_u8(n, 1))
  end

  -- Whole-array copies are one memcpy each in the shim.
  pfn copy_u8(a : NativeU8Arr, n : Int) : NativeU8Arr do Win.u8_blit(NativeArray.make_u8(n, 0), 0, a, 0, n) end
  pfn copy_f(a : NativeF32Arr, n : Int) : NativeF32Arr do Win.f32_blit(NativeArray.make_f32(n, 0.0), 0, a, 0, n) end

  doc "Plant species [sp] at column (x, z): seed vigour, full reach, claim cleared, dirty. Copies the arrays (the Scene shares them, GAPS G68); plantings are rare."
  fn plant(f : Net, n : Int, x : Int, z : Int, sp : Int) : Net do
    if x < 0 || z < 0 || x >= n || z >= n do f
    else
      match f do
        Net(sps, vg, rc, hd, cl, dt, cs, pl, pr) ->
          let i = x + n * z
          Net(NativeArray.set_u8(copy_u8(sps, n * n), i, sp),
                NativeArray.set_f32(copy_f(vg, n * n), i, seed_vigour()),
                NativeArray.set_u8(copy_u8(rc, n * n), i, plant_reach()),
                NativeArray.set_u8(copy_u8(hd, n * n), i, 0),
                NativeArray.set_u8(copy_u8(cl, n * n), i, 0),
                NativeArray.set_u8(copy_u8(dt, n * n), i, 1), cs,
                repull_box(NativeArray.set_u8(copy_u8(sps, n * n), i, sp), copy_f(pl, 2 * n * n), n, x - 1, z - 1, x + 1, z + 1),
                mark_rows(copy_u8(pr, n), n, z - 1, z + 1))
      end
    end
  end

  fn species_of(f : Net, n : Int, x : Int, z : Int) : Int do
    match f do Net(sps, _, _, _, _, _, cs, pl, pr) -> NativeArray.get_u8(sps, x + n * z) end
  end
  fn vigour_of(f : Net, n : Int, x : Int, z : Int) : Float do
    match f do Net(_, vg, _, _, _, _, cs, pl, pr) -> NativeArray.get_f32(vg, x + n * z) end
  end
  fn reach_of(f : Net, n : Int, x : Int, z : Int) : Int do
    match f do Net(_, _, rc, _, _, _, cs, pl, pr) -> NativeArray.get_u8(rc, x + n * z) end
  end
  fn field_species(f : Net) : NativeU8Arr do match f do Net(sps, _, _, _, _, _, cs, pl, pr) -> sps end end
  fn field_vigour(f : Net) : NativeF32Arr do match f do Net(_, vg, _, _, _, _, cs, pl, pr) -> vg end end

  doc "Is column (x, z) marked for the next tick?"
  fn is_dirty(f : Net, n : Int, x : Int, z : Int) : Bool do
    match f do Net(_, _, _, _, _, dt, cs, pl, pr) -> NativeArray.get_u8(dt, x + n * z) != 0 end
  end
  doc "Columns marked for the next tick."
  fn dirty_count(f : Net, n : Int) : Int do
    match f do Net(_, _, _, _, _, dt, cs, pl, pr) -> count_go(dt, 1, 0, n * n, 0) end
  end
  pfn dirty_rows_go(dt : NativeU8Arr, n : Int, i : Int, rows : NativeU8Arr) : NativeU8Arr do
    if i >= n * n do rows
    else if NativeArray.get_u8(dt, i) != 0 do
      let z = i / n
      let r1 = NativeArray.set_u8(rows, z, 1)
      let r2 = if z > 0 do NativeArray.set_u8(r1, z - 1, 1) else r1 end
      dirty_rows_go(dt, n, i + 1, if z < n - 1 do NativeArray.set_u8(r2, z + 1, 1) else r2 end)
    else dirty_rows_go(dt, n, i + 1, rows) end end
  end
  doc "One byte per row: 1 where the row or a row beside it holds a dirty column. What the biome tick looks at to notice a grove forming or fading, since a column's grove test reads its 3x3."
  fn dirty_rows(f : Net, n : Int) : NativeU8Arr do
    match f do Net(_, _, _, _, _, dt, cs, pl, pr) -> dirty_rows_go(dt, n, 0, NativeArray.make_u8(n, 0)) end
  end

  doc "The field with nothing marked: for tests that want to see what a change wakes."
  fn clean(f : Net, n : Int) : Net do
    match f do Net(sps, vg, rc, hd, cl, _, cs, pl, pr) -> Net(sps, vg, rc, hd, cl, NativeArray.make_u8(n * n, 0), cs, pl, pr) end
  end

  pfn u8_go(vg : NativeF32Arr, out : NativeU8Arr, i : Int, n : Int) : NativeU8Arr do
    if i >= n do out
    else u8_go(vg, NativeArray.set_u8(out, i, float_to_int(NativeArray.get_f32(vg, i) *. 255.0 +. 0.5)), i + 1, n) end
  end
  doc "Vigour as 0..255 bytes, a fresh array for the map upload."
  fn vigour_u8(f : Net, n : Int) : NativeU8Arr do
    match f do Net(_, vg, _, _, _, _, cs, pl, pr) -> u8_go(vg, NativeArray.make_u8(n * n, 0), 0, n * n) end
  end

  pfn count_go(sps : NativeU8Arr, sp : Int, i : Int, n : Int, acc : Int) : Int do
    if i >= n do acc
    else count_go(sps, sp, i + 1, n, if NativeArray.get_u8(sps, i) == sp do acc + 1 else acc end) end
  end
  doc "Columns held by species [sp]."
  fn count_species(f : Net, n : Int, sp : Int) : Int do
    match f do Net(sps, _, _, _, _, _, cs, pl, pr) -> count_go(sps, sp, 0, n * n, 0) end
  end

  pfn hash_u8(a : NativeU8Arr, n : Int, i : Int, h : Int) : Int do
    if i >= n do h
    else hash_u8(a, n, i + 1, (h * 131 + NativeArray.get_u8(a, i)) % 1073741789) end
  end
  doc "A hash of species and reach, the discrete state: an oracle for 'the field evolved the same way'."
  fn state_hash(f : Net, n : Int) : Int do
    match f do Net(sps, _, rc, _, _, _, cs, pl, pr) -> hash_u8(rc, n * n, 0, hash_u8(sps, n * n, 0, 11)) end
  end

  -- ── The tick ──────────────────────────────────────────────────────────────

  pfn ease(cur : Float, target : Float, rate : Float) : Float do
    let d = target -. cur
    if d > rate do cur +. rate else if d < 0.0 -. rate do cur -. rate else target end end
  end

  -- dx, dz for neighbour k of 8: the 3x3 ring minus the centre, row by row.
  pfn ndx(k : Int) : Int do
    let kk = if k >= 4 do k + 1 else k end
    kk % 3 - 1
  end
  pfn ndz(k : Int) : Int do
    let kk = if k >= 4 do k + 1 else k end
    kk / 3 - 1
  end

  -- The claimant search returns three numbers packed in one Int so the loop
  -- threads a single accumulator: species * 65536 + reach * 256 + round(fitness * 255).
  pfn pack_claim(sp : Int, rc : Int, fit : Float) : Int do sp * 65536 + rc * 256 + float_to_int(fit *. 255.0 +. 0.5) end
  pfn claim_sp(c : Int) : Int do c / 65536 end
  pfn claim_rc(c : Int) : Int do (c / 256) % 256 end
  pfn claim_fit(c : Int) : Float do int_to_float(c % 256) /. 255.0 end

  -- Best qualifying neighbour of column (x, z). [own] is the column's species and
  -- [ownfit] its fitness; a neighbour of the same species never claims.
  pfn claimant_go(sps : NativeU8Arr, vg : NativeF32Arr, rc : NativeU8Arr, n : Int, x : Int, z : Int,
                  t : Float, m : Float, own : Int, ownfit : Float, k : Int, best : Int) : Int do
    if k >= 8 do best
    else
      let nx = x + ndx(k)
      let nz = z + ndz(k)
      if nx < 0 || nz < 0 || nx >= n || nz >= n do claimant_go(sps, vg, rc, n, x, z, t, m, own, ownfit, k + 1, best)
      else
        let i = nx + n * nz
        let c = NativeArray.get_u8(sps, i)
        -- Reach is in half-hops: a straight hop costs 2 and a diagonal 3 (about
        -- sqrt 2), so a patch grows as an octagon rather than the square that
        -- Chebyshev spread gives or the diamond that Manhattan gives.
        let hop = if ndx(k) != 0 do (if ndz(k) != 0 do 3 else 2 end) else 2 end
        let r = NativeArray.get_u8(rc, i) - hop + 1
        let strong = if c == 0 do false else if r <= 0 do false else NativeArray.get_f32(vg, i) >= spread_vigour() end end
        if !strong do claimant_go(sps, vg, rc, n, x, z, t, m, own, ownfit, k + 1, best)
        else if c == own do claimant_go(sps, vg, rc, n, x, z, t, m, own, ownfit, k + 1, best)
        else
          let fc = S.fitness(c, t, m)
          let ok = if own == 0 do fc >= claim_floor() else fc >= ownfit +. contest_margin() end
          if !ok do claimant_go(sps, vg, rc, n, x, z, t, m, own, ownfit, k + 1, best)
          else
            -- better fitness wins; the same species at equal fitness keeps the larger reach
            let take = if best == 0 do true
                       else if fc > claim_fit(best) +. 0.002 do true
                       else if claim_sp(best) == c do r - 1 > claim_rc(best)
                       else false end end end
            claimant_go(sps, vg, rc, n, x, z, t, m, own, ownfit, k + 1, if take do pack_claim(c, r - 1, fc) else best end)
          end
        end end
      end
    end
  end

  -- Write one column's new state, and its dirty flag: set when anything
  -- changed, or when it is unsettled (vigour off its target, a claim pending).
  -- Threads the five destination arrays plus the dirty array as a Net.
  pfn put(nsps : NativeU8Arr, nvg : NativeF32Arr, nrc : NativeU8Arr, nhd : NativeU8Arr, ncl : NativeU8Arr, ndt : NativeU8Arr, ncs : NativeF32Arr, npl : NativeF32Arr, npr : NativeU8Arr, n : Int,
          i : Int, sp : Int, v : Float, r : Int, h : Int, c : Int, unsettled : Bool,
          osp : Int, ov : Float, orc : Int, oh : Int, oc : Int, t : Float, m : Float) : Net do
    -- vigour is stored as f32 and compared against f64 targets: within eps is equal,
    -- or a column whose fitness is not f32-representable would never settle
    let changed = if sp != osp do true else if r != orc do true else if h != oh do true else if c != oc do true else Math.abs(v -. ov) > vigour_eps() end end end end
    -- Neighbours read only species, reach and whether vigour clears the spread
    -- threshold: a column drifting toward its target re-evaluates itself (1)
    -- without waking its eight neighbours (2).
    let seen_by_others = if sp != osp do true else if r != orc do true else (v >= spread_vigour()) != (ov >= spread_vigour()) end end
    let nsps1 = NativeArray.set_u8(nsps, i, sp)
    -- a species change moves the pull on this column and its eight neighbours
    let npl1 = if sp != osp do repull_box(nsps1, npl, n, i % n - 1, i / n - 1, i % n + 1, i / n + 1) else npl end
    let npr1 = if sp != osp do mark_rows(npr, n, i / n - 1, i / n + 1) else npr end
    Net(nsps1, NativeArray.set_f32(nvg, i, v), NativeArray.set_u8(nrc, i, r), NativeArray.set_u8(nhd, i, h), NativeArray.set_u8(ncl, i, c),
          NativeArray.set_u8(ndt, i, if seen_by_others do 2 else if changed || unsettled do 1 else 0 end end),
          NativeArray.set_f32(NativeArray.set_f32(ncs, 2 * i, t), 2 * i + 1, m), npl1, npr1)
  end

  -- One column. Reads the old arrays, writes index i of the new ones.
  pfn tick_col(sps : NativeU8Arr, vg : NativeF32Arr, rc : NativeU8Arr, hd : NativeU8Arr, cl : NativeU8Arr,
               ta : NativeFloatArr, ma : NativeFloatArr, n : Int, rate : Float, i : Int,
               nsps : NativeU8Arr, nvg : NativeF32Arr, nrc : NativeU8Arr, nhd : NativeU8Arr, ncl : NativeU8Arr, ndt : NativeU8Arr, ncs : NativeF32Arr, npl : NativeF32Arr, npr : NativeU8Arr) : Net do
    let x = i % n
    let z = i / n
    let sp = NativeArray.get_u8(sps, i)
    let t = NativeArray.get_float(ta, i)
    let m = NativeArray.get_float(ma, i)
    let fit = S.fitness(sp, t, m)
    let claim = claimant_go(sps, vg, rc, n, x, z, t, m, sp, fit, 0, 0)
    let c = claim_sp(claim)
    let hd0 = NativeArray.get_u8(hd, i)
    let cl0 = NativeArray.get_u8(cl, i)
    let rc0 = NativeArray.get_u8(rc, i)
    let v0 = NativeArray.get_f32(vg, i)
    let hd1 = if c == 0 do 0 else if c == cl0 do hd0 + 1 else 1 end end
    let hd2 = if hd1 > 255 do 255 else hd1 end
    let matured = if c == 0 do false else hd2 >= hold_ticks() end
    if sp == 0 do
      if matured do put(nsps, nvg, nrc, nhd, ncl, ndt, ncs, npl, npr, n, i, c, seed_vigour(), claim_rc(claim), 0, 0, true, sp, v0, rc0, hd0, cl0, t, m)
      else put(nsps, nvg, nrc, nhd, ncl, ndt, ncs, npl, npr, n, i, 0, 0.0, 0, hd2, c, c != 0, sp, v0, rc0, hd0, cl0, t, m) end
    else
      let v1 = if c != 0 do v0 -. contest_factor() *. rate else ease(v0, fit, rate) end
      let dies = if v1 <= 0.0 do (if c != 0 do true else fit < S.viable() end) else false end
      if dies do
        if matured do put(nsps, nvg, nrc, nhd, ncl, ndt, ncs, npl, npr, n, i, c, seed_vigour(), claim_rc(claim), 0, 0, true, sp, v0, rc0, hd0, cl0, t, m)
        else put(nsps, nvg, nrc, nhd, ncl, ndt, ncs, npl, npr, n, i, 0, 0.0, 0, hd2, c, c != 0, sp, v0, rc0, hd0, cl0, t, m) end
      else
        let v2 = if v1 < 0.0 do 0.0 else v1 end
        -- unsettled while the vigour is still moving or someone wants the column
        -- within settle_eps of its target is settled: the target creeps under the
        -- biome's easing by less than that per tick, and the column wakes again
        -- once the climate has moved climate_eps
        let unsettled = if c != 0 do true else Math.abs(v2 -. fit) > settle_eps() end
        put(nsps, nvg, nrc, nhd, ncl, ndt, ncs, npl, npr, n, i, sp, v2, rc0, hd2, c, unsettled, sp, v0, rc0, hd0, cl0, t, m)
      end
    end
  end

  -- Is (x, z) itself dirty at all, or a 3x3 neighbour dirty for others (2)?
  pfn any_near(dt : NativeU8Arr, n : Int, x : Int, z : Int, k : Int) : Bool do
    if k >= 9 do false
    else
      let nx = x + k % 3 - 1
      let nz = z + k / 3 - 1
      if nx < 0 || nz < 0 || nx >= n || nz >= n do any_near(dt, n, x, z, k + 1)
      else if NativeArray.get_u8(dt, nx + n * nz) >= (if k == 4 do 1 else 2 end) do true
      else any_near(dt, n, x, z, k + 1) end end
    end
  end

  -- Which rows hold anything dirty or climate-moved: one byte per row, from one
  -- pass over the two flag arrays. A row with nothing in it or beside it skips
  -- the 3x3 test for all n of its columns, so a settled world's tick is 32k
  -- byte reads and the memcpys.
  doc "How far the climate must drift under a column before it is looked at again: a step this size moves a fitness on a band edge by about 0.07, and a column under the biome's day-long easing wakes every fifty ticks instead of every tick."
  fn climate_eps() : Float do 0.004 end
  -- Did the climate move under column i since it was last evaluated?
  pfn moved(cs : NativeF32Arr, ta : NativeFloatArr, ma : NativeFloatArr, i : Int) : Bool do
    if Math.abs(NativeArray.get_f32(cs, 2 * i) -. NativeArray.get_float(ta, i)) > climate_eps() do true
    else Math.abs(NativeArray.get_f32(cs, 2 * i + 1) -. NativeArray.get_float(ma, i)) > climate_eps() end
  end
  pfn rows_go(dt : NativeU8Arr, cs : NativeF32Arr, ta : NativeFloatArr, ma : NativeFloatArr, n : Int, i : Int, rows : NativeU8Arr) : NativeU8Arr do
    if i >= n * n do rows
    else if NativeArray.get_u8(dt, i) != 0 do rows_go(dt, cs, ta, ma, n, i + 1, NativeArray.set_u8(rows, i / n, 1))
    else if moved(cs, ta, ma, i) do rows_go(dt, cs, ta, ma, n, i + 1, NativeArray.set_u8(rows, i / n, 1))
    else rows_go(dt, cs, ta, ma, n, i + 1, rows) end end end
  end
  pfn row_band(rows : NativeU8Arr, n : Int, z : Int) : Bool do
    let a = if z > 0 do NativeArray.get_u8(rows, z - 1) != 0 else false end
    let b = NativeArray.get_u8(rows, z) != 0
    let c = if z < n - 1 do NativeArray.get_u8(rows, z + 1) != 0 else false end
    a || b || c
  end

  pfn tick_go(sps : NativeU8Arr, vg : NativeF32Arr, rc : NativeU8Arr, hd : NativeU8Arr, cl : NativeU8Arr, dt : NativeU8Arr, cs : NativeF32Arr, all : Bool,
              ta : NativeFloatArr, ma : NativeFloatArr, n : Int, rate : Float, rows : NativeU8Arr, i : Int,
              nsps : NativeU8Arr, nvg : NativeF32Arr, nrc : NativeU8Arr, nhd : NativeU8Arr, ncl : NativeU8Arr, ndt : NativeU8Arr, ncs : NativeF32Arr, npl : NativeF32Arr, npr : NativeU8Arr) : Net do
    if i >= n * n do Net(nsps, nvg, nrc, nhd, ncl, ndt, ncs, npl, npr)
    else if !all && !row_band(rows, n, i / n) do tick_go(sps, vg, rc, hd, cl, dt, cs, all, ta, ma, n, rate, rows, i + n, nsps, nvg, nrc, nhd, ncl, ndt, ncs, npl, npr)
    else
      let look = if all do true else if moved(cs, ta, ma, i) do true else any_near(dt, n, i % n, i / n, 0) end end
      if !look do tick_go(sps, vg, rc, hd, cl, dt, cs, all, ta, ma, n, rate, rows, i + 1, nsps, nvg, nrc, nhd, ncl, ndt, ncs, npl, npr)
      else
        match tick_col(sps, vg, rc, hd, cl, ta, ma, n, rate, i, nsps, nvg, nrc, nhd, ncl, ndt, ncs, npl, npr) do
          Net(a, b, c, d, e, g, h2, p2, r2) -> tick_go(sps, vg, rc, hd, cl, dt, cs, all, ta, ma, n, rate, rows, i + 1, a, b, c, d, e, g, h2, p2, r2)
        end
      end
    end end
  end

  doc """
  One tick against the eased climate arrays [ta] and [ma] (one entry per column,
  the biome field's `temps` and `moists`). A column is looked at when it or a
  neighbour is dirty, or when its climate differs from what it was last
  evaluated at. Every looked-at column pulls from its eight neighbours in the
  previous state and writes its own entry into fresh arrays; every other column
  keeps its state through the memcpy the fresh arrays start from.
  """
  fn tick(f : Net, n : Int, ta : NativeFloatArr, ma : NativeFloatArr, rate : Float) : Net do tick_with(f, n, ta, ma, rate, false) end

  doc "The tick with every column looked at: the oracle the active set is checked against."
  fn tick_all(f : Net, n : Int, ta : NativeFloatArr, ma : NativeFloatArr, rate : Float) : Net do tick_with(f, n, ta, ma, rate, true) end

  pfn tick_with(f : Net, n : Int, ta : NativeFloatArr, ma : NativeFloatArr, rate : Float, all : Bool) : Net do
    match f do
      Net(sps, vg, rc, hd, cl, dt, cs, pl, _) ->
        -- the pull-row flags start clean: they report this tick's changes
        tick_go(sps, vg, rc, hd, cl, dt, cs, all, ta, ma, n, rate, rows_go(dt, cs, ta, ma, n, 0, NativeArray.make_u8(n, 0)), 0,
                copy_u8(sps, n * n), copy_f(vg, n * n), copy_u8(rc, n * n), copy_u8(hd, n * n), copy_u8(cl, n * n), NativeArray.make_u8(n * n, 0), copy_f(cs, 2 * n * n), copy_f(pl, 2 * n * n), NativeArray.make_u8(n, 0))
    end
  end

  doc "Columns the next tick will look at against [ta] and [ma]: the dirty set widened by one, and the columns whose climate moved."
  fn active_count(f : Net, n : Int, ta : NativeFloatArr, ma : NativeFloatArr) : Int do
    match f do Net(_, _, _, _, _, dt, cs, pl, pr) -> active_go(dt, cs, ta, ma, n, 0, 0) end
  end
  pfn active_go(dt : NativeU8Arr, cs : NativeF32Arr, ta : NativeFloatArr, ma : NativeFloatArr, n : Int, i : Int, acc : Int) : Int do
    if i >= n * n do acc
    else
      let look = if moved(cs, ta, ma, i) do true else any_near(dt, n, i % n, i / n, 0) end
      active_go(dt, cs, ta, ma, n, i + 1, if look do acc + 1 else acc end)
    end
  end

  -- ── Save and load ─────────────────────────────────────────────────────────
  -- Three bytes per column, three arrays in a row: species, vigour (0..255),
  -- reach. Hold, claimant, climate memory and the pulls are rebuilt: the first
  -- tick after a load looks at every column.
  pfn export_go(sps : NativeU8Arr, vg : NativeF32Arr, rc : NativeU8Arr, n2 : Int, i : Int, out : NativeU8Arr, off : Int) : NativeU8Arr do
    if i >= n2 do out
    else
      let o1 = NativeArray.set_u8(out, off + i, NativeArray.get_u8(sps, i))
      let o2 = NativeArray.set_u8(o1, off + n2 + i, float_to_int(NativeArray.get_f32(vg, i) *. 255.0 +. 0.5))
      export_go(sps, vg, rc, n2, i + 1, NativeArray.set_u8(o2, off + 2 * n2 + i, NativeArray.get_u8(rc, i)), off)
    end
  end
  doc "Write species, vigour and reach into [out] at [off]: 3 * n * n bytes."
  fn to_bytes(f : Net, n : Int, out : NativeU8Arr, off : Int) : NativeU8Arr do
    match f do Net(sps, vg, rc, _, _, _, _, _, _) -> export_go(sps, vg, rc, n * n, 0, out, off) end
  end
  pfn import_go(b : NativeU8Arr, off : Int, n2 : Int, i : Int, sps : NativeU8Arr, vg : NativeF32Arr, rc : NativeU8Arr) : Net do
    if i >= n2 do Net(sps, vg, rc, NativeArray.make_u8(0, 0), NativeArray.make_u8(0, 0), NativeArray.make_u8(0, 0), NativeArray.make_f32(0, 0.0), NativeArray.make_f32(0, 0.0), NativeArray.make_u8(0, 0))
    else
      import_go(b, off, n2, i + 1, NativeArray.set_u8(sps, i, NativeArray.get_u8(b, off + i)),
                NativeArray.set_f32(vg, i, int_to_float(NativeArray.get_u8(b, off + n2 + i)) /. 255.0),
                NativeArray.set_u8(rc, i, NativeArray.get_u8(b, off + 2 * n2 + i)))
    end
  end
  doc "A field from the bytes `export` wrote at [off]: everything dirty, the pulls recomputed."
  fn of_bytes(b : NativeU8Arr, off : Int, n : Int) : Net do
    match import_go(b, off, n * n, 0, NativeArray.make_u8(n * n, 0), NativeArray.make_f32(n * n, 0.0), NativeArray.make_u8(n * n, 0)) do
      Net(sps, vg, rc, _, _, _, _, _, _) ->
        Net(sps, vg, rc, NativeArray.make_u8(n * n, 0), NativeArray.make_u8(n * n, 0), NativeArray.make_u8(n * n, 1), NativeArray.make_f32(2 * n * n, -1.0),
              repull_box(sps, NativeArray.make_f32(2 * n * n, 0.0), n, 0, 0, n - 1, n - 1), NativeArray.make_u8(n, 1))
    end
  end

  doc "Release a field the caller is done with, array by array (see Biome.release and GAPS G71)."
  fn release(f : Net) : Int do
    match f do Net(sps, vg, rc, hd, cl, dt, cs, pl, pr) -> NativeArray.length_u8(sps) + NativeArray.length_f32(vg) + NativeArray.length_u8(rc) + NativeArray.length_u8(hd) + NativeArray.length_u8(cl) + NativeArray.length_u8(dt) + NativeArray.length_f32(cs) + NativeArray.length_f32(pl) + NativeArray.length_u8(pr) end
  end

  -- ── Climate feedback: what the network does to the ground ───────────────
  doc "Largest offset the network can put on either climate axis of a column."
  fn cap() : Float do 0.3 end

  pfn clampc(v : Float) : Float do if v < 0.0 -. cap() do 0.0 -. cap() else if v > cap() do cap() else v end end end

  -- Sum the pulls of the DISTINCT species in the 3x3 of (x, z), both axes in
  -- one walk, written straight into [out]. Six species at most, so "seen" is
  -- a bitmask threaded through the walk.
  pfn bit_of(sp : Int) : Int do
    if sp == 1 do 2 else if sp == 2 do 4 else if sp == 3 do 8 else if sp == 4 do 16 else if sp == 5 do 32 else if sp == 6 do 64 else 0 end end end end end end
  end
  pfn pulls_go(sps : NativeU8Arr, out : NativeF32Arr, n : Int, x : Int, z : Int, k : Int, seen : Int, t : Float, m : Float) : NativeF32Arr do
    if k >= 9 do NativeArray.set_f32(NativeArray.set_f32(out, 2 * (x + n * z), t), 2 * (x + n * z) + 1, m)
    else
      let nx = x + k % 3 - 1
      let nz = z + k / 3 - 1
      if nx < 0 || nz < 0 || nx >= n || nz >= n do pulls_go(sps, out, n, x, z, k + 1, seen, t, m)
      else
        let sp = NativeArray.get_u8(sps, nx + n * nz)
        let bit = bit_of(sp)
        -- `||` does not short-circuit (GAPS G33): the division waits for the branch
        let already = if sp == 0 do true else (seen / bit) % 2 == 1 end
        if already do pulls_go(sps, out, n, x, z, k + 1, seen, t, m)
        else pulls_go(sps, out, n, x, z, k + 1, seen + bit, t +. S.pull_t(sp), m +. S.pull_m(sp)) end
      end
    end
  end

  -- Recompute the raw pulls of every column in the box, clipped to the field.
  pfn repull_box(sps : NativeU8Arr, out : NativeF32Arr, n : Int, x0 : Int, z0 : Int, x1 : Int, z1 : Int) : NativeF32Arr do
    repull_go(sps, out, n, x0, z0, x1, z1, x0, z0)
  end
  -- Mark the rows z0..z1 (clipped) as having moved.
  pfn mark_rows(pr : NativeU8Arr, n : Int, z0 : Int, z1 : Int) : NativeU8Arr do
    if z0 > z1 do pr
    else if z0 < 0 || z0 >= n do mark_rows(pr, n, z0 + 1, z1)
    else mark_rows(NativeArray.set_u8(pr, z0, 1), n, z0 + 1, z1) end end
  end
  doc "The raw pulls, two f32 per column, for the biome to scale and clamp per column it evaluates."
  fn pulls(f : Net) : NativeF32Arr do match f do Net(_, _, _, _, _, _, _, pl, _) -> pl end end
  doc "One byte per row: 1 where a pull changed since the last tick began."
  fn pull_rows(f : Net) : NativeU8Arr do match f do Net(_, _, _, _, _, _, _, _, pr) -> pr end end
  pfn repull_go(sps : NativeU8Arr, out : NativeF32Arr, n : Int, x0 : Int, z0 : Int, x1 : Int, z1 : Int, x : Int, z : Int) : NativeF32Arr do
    if z > z1 do out
    else if x > x1 do repull_go(sps, out, n, x0, z0, x1, z1, x0, z + 1)
    else if x < 0 || z < 0 || x >= n || z >= n do repull_go(sps, out, n, x0, z0, x1, z1, x + 1, z)
    else repull_go(sps, pulls_go(sps, out, n, x, z, 0, 0, 0.0, 0.0), n, x0, z0, x1, z1, x + 1, z) end end end
  end

  pfn scale_go(pl : NativeF32Arr, scale : Float, i : Int, n2 : Int, out : NativeF32Arr) : NativeF32Arr do
    if i >= n2 do out
    else scale_go(pl, scale, i + 1, n2, NativeArray.set_f32(out, i, clampc(NativeArray.get_f32(pl, i) *. scale))) end
  end

  doc "The network's climate offsets, two f32 per column (temperature at 2i, moisture at 2i + 1): the kept raw pulls scaled by [scale] (CF_MYC_FEEDBACK / 100) and clamped to +-cap(). One linear pass; the pulls themselves are maintained where species change."
  fn bonuses(f : Net, n : Int, scale : Float) : NativeF32Arr do
    match f do
      Net(_, _, _, _, _, _, _, pl, pr) -> scale_go(pl, scale, 0, 2 * n * n, NativeArray.make_f32(2 * n * n, 0.0))
    end
  end

  -- ── Migration: what the surface should show ──────────────────────────────
  doc "Vigour at and above which a column's surface shows its species."
  fn show_vigour() : Float do 0.15 end
  doc "Vigour at and above which a column may fruit."
  fn fruit_vigour() : Float do 0.8 end

  doc "A felled body reseeds its column: reach back to plant_reach(), so a mature patch keeps growing without replanting. An empty column is left alone."
  fn reseed(f : Net, n : Int, x : Int, z : Int) : Net do
    if x < 0 || z < 0 || x >= n || z >= n do f
    else
      match f do
        Net(sps, vg, rc, hd, cl, dt, cs, pl, pr) ->
          let i = x + n * z
          if NativeArray.get_u8(sps, i) == 0 do f
          else Net(sps, vg, NativeArray.set_u8(copy_u8(rc, n * n), i, plant_reach()), hd, cl, NativeArray.set_u8(copy_u8(dt, n * n), i, 1), cs, pl, pr) end
      end
    end
  end

  doc "The species column [i] should display: its species once vigour reaches show_vigour(), else 0."
  fn wanted(f : Net, n : Int, i : Int) : Int do
    match f do
      Net(sps, vg, _, _, _, _, cs, pl, pr) ->
        let sp = NativeArray.get_u8(sps, i)
        if sp == 0 do 0 else if NativeArray.get_f32(vg, i) >= show_vigour() do sp else 0 end end
    end
  end

  pfn migrations_go(sps : NativeU8Arr, vg : NativeF32Arr, shown : NativeU8Arr, n : Int, i : Int, left : Int, budget : Int, acc : List(Int)) : List(Int) do
    if left <= 0 || budget <= 0 do acc
    else
      let ci = i % (n * n)
      let sp = NativeArray.get_u8(sps, ci)
      let want = if sp == 0 do 0 else if NativeArray.get_f32(vg, ci) >= show_vigour() do sp else 0 end end
      if want != NativeArray.get_u8(shown, ci) do migrations_go(sps, vg, shown, n, i + 1, left - 1, budget - 1, Cons(ci, acc))
      else migrations_go(sps, vg, shown, n, i + 1, left - 1, budget, acc) end
    end
  end

  doc "Column indices whose surface should change: wanted species differs from [shown]. Scans [scan] columns from where tick [tick] leaves off (a stateless cursor), returns at most [budget]. Destructures the field once (GAPS G68)."
  fn migrations(f : Net, n : Int, shown : NativeU8Arr, tick : Int, scan : Int, budget : Int) : List(Int) do
    match f do
      Net(sps, vg, _, _, _, _, cs, pl, pr) -> migrations_go(sps, vg, shown, n, (tick * scan) % (n * n), scan, budget, Nil)
    end
  end

  -- ── Mature patches, wild fungus, spores ────────────────────────────────
  -- Octagonal distance in half-hops: straight steps cost 2, diagonal 3, the
  -- same metric the spread uses, so a patch written here is exactly the one
  -- a planting would have grown into.
  pfn oct_cost(dx : Int, dz : Int) : Int do
    let ax = if dx < 0 do 0 - dx else dx end
    let az = if dz < 0 do 0 - dz else dz end
    let hi = if ax > az do ax else az end
    let lo = if ax > az do az else ax end
    2 * hi + lo
  end

  pfn patch_go(sps : NativeU8Arr, vg : NativeF32Arr, rc : NativeU8Arr, dt : NativeU8Arr, n : Int, x : Int, z : Int, sp : Int, r : Int, i : Int) : Net do
    let span = 2 * r + 1
    if i >= span * span do Net(sps, vg, rc, NativeArray.make_u8(0, 0), NativeArray.make_u8(0, 0), dt, NativeArray.make_f32(0, 0.0), NativeArray.make_f32(0, 0.0), NativeArray.make_u8(0, 0))
    else
      let dx = i % span - r
      let dz = i / span - r
      let cx = x + dx
      let cz = z + dz
      let cost = oct_cost(dx, dz)
      if cx < 0 || cz < 0 || cx >= n || cz >= n || cost > plant_reach() do patch_go(sps, vg, rc, dt, n, x, z, sp, r, i + 1)
      else
        let j = cx + n * cz
        patch_go(NativeArray.set_u8(sps, j, sp), NativeArray.set_f32(vg, j, 1.0), NativeArray.set_u8(rc, j, plant_reach() - cost), NativeArray.set_u8(dt, j, 1), n, x, z, sp, r, i + 1)
      end
    end
  end

  doc "A mature patch of [sp] centred on (x, z): the octagon a planting grows into, at full vigour, reach falling with distance, every column dirty. Copies the arrays once."
  fn plant_patch(f : Net, n : Int, x : Int, z : Int, sp : Int) : Net do
    match f do
      Net(sps, vg, rc, hd, cl, dt, cs, pl, pr) ->
        match patch_go(copy_u8(sps, n * n), copy_f(vg, n * n), copy_u8(rc, n * n), copy_u8(dt, n * n), n, x, z, sp, plant_radius(), 0) do
          Net(s1, v1, r1, _, _, d1, _, _, _) ->
            let r = plant_radius() + 1
            Net(s1, v1, r1, hd, cl, d1, cs, repull_box(s1, copy_f(pl, 2 * n * n), n, x - r, z - r, x + r, z + r), mark_rows(copy_u8(pr, n), n, z - r, z + r))
        end
    end
  end

  -- A mature patch whose columns cycle through up to three species by (x + z)
  -- mod 3, so every column's 3x3 holds all of them: the "collection" that the
  -- climate feedback rewards, planted at once for the scripted check. Skips
  -- species 0 in the cycle by falling back to the first.
  pfn mix_go(sps : NativeU8Arr, vg : NativeF32Arr, rc : NativeU8Arr, dt : NativeU8Arr, n : Int, x : Int, z : Int, sp1 : Int, sp2 : Int, sp3 : Int, r : Int, i : Int) : Net do
    let span = 2 * r + 1
    if i >= span * span do Net(sps, vg, rc, NativeArray.make_u8(0, 0), NativeArray.make_u8(0, 0), dt, NativeArray.make_f32(0, 0.0), NativeArray.make_f32(0, 0.0), NativeArray.make_u8(0, 0))
    else
      let dx = i % span - r
      let dz = i / span - r
      let cx = x + dx
      let cz = z + dz
      let cost = oct_cost(dx, dz)
      if cx < 0 || cz < 0 || cx >= n || cz >= n || cost > plant_reach() do mix_go(sps, vg, rc, dt, n, x, z, sp1, sp2, sp3, r, i + 1)
      else
        let k = (cx + cz) % 3
        let pick = if k == 0 do sp1 else if k == 1 do (if sp2 > 0 do sp2 else sp1 end) else (if sp3 > 0 do sp3 else sp1 end) end end
        let j = cx + n * cz
        mix_go(NativeArray.set_u8(sps, j, pick), NativeArray.set_f32(vg, j, 1.0), NativeArray.set_u8(rc, j, plant_reach() - cost), NativeArray.set_u8(dt, j, 1), n, x, z, sp1, sp2, sp3, r, i + 1)
      end
    end
  end
  doc "A mature patch interleaving up to three species column by column (see mix_go)."
  fn plant_mix(f : Net, n : Int, x : Int, z : Int, sp1 : Int, sp2 : Int, sp3 : Int) : Net do
    match f do
      Net(sps, vg, rc, hd, cl, dt, cs, pl, pr) ->
        match mix_go(copy_u8(sps, n * n), copy_f(vg, n * n), copy_u8(rc, n * n), copy_u8(dt, n * n), n, x, z, sp1, sp2, sp3, plant_radius(), 0) do
          Net(s1, v1, r1, _, _, d1, _, _, _) ->
            let r = plant_radius() + 1
            Net(s1, v1, r1, hd, cl, d1, cs, repull_box(s1, copy_f(pl, 2 * n * n), n, x - r, z - r, x + r, z + r), mark_rows(copy_u8(pr, n), n, z - r, z + r))
        end
    end
  end

  doc "Fraction of 16x16 cells that hold a wild patch."
  fn wild_density() : Float do 0.12 end
  fn wild_cell() : Int do 16 end

  pfn wild_go(f : Net, n : Int, ta : NativeFloatArr, ma : NativeFloatArr, seed : Int, c : Int, cells : Int) : Net do
    if c >= cells * cells do f
    else
      let cx = c % cells
      let cz = c / cells
      if N.hash2(cx * 31, cz * 17, seed + 9001) >= wild_density() do wild_go(f, n, ta, ma, seed, c + 1, cells)
      else
        let x = cx * wild_cell() + wild_cell() / 2
        let z = cz * wild_cell() + wild_cell() / 2
        let i = x + n * z
        let sp = S.best_for(NativeArray.get_float(ta, i), NativeArray.get_float(ma, i))
        if sp == 0 do wild_go(f, n, ta, ma, seed, c + 1, cells)
        else wild_go(plant_patch(f, n, x, z, sp), n, ta, ma, seed, c + 1, cells) end
      end
    end
  end

  doc "Seed the world's wild fungus: one mature patch of the fittest species per 16x16 cell the hash picks, against the climate arrays. Seeded, so a world's wild fungus is stable across runs."
  fn wild(f : Net, n : Int, ta : NativeFloatArr, ma : NativeFloatArr, seed : Int) : Net do
    wild_go(f, n, ta, ma, seed, 0, n / wild_cell())
  end

  doc "Whether digging the mycelium block at (x, y, z) yields a spore: about one in four, by a position hash so it cannot be farmed by re-placing."
  fn dig_spore(x : Int, y : Int, z : Int, seed : Int) : Bool do
    N.hash2(x * 3 + y, z * 5 + y, seed + 77) < 0.25
  end

  pfn pct(v : Float) : String do int_to_string(float_to_int(v *. 100.0 +. 0.5)) ++ "%" end
  doc "One line for the HUD: what the column holds, or what would grow there."
  fn readout(f : Net, n : Int, x : Int, z : Int, temp : Float, moist : Float) : String do
    let sp = species_of(f, n, x, z)
    if sp != 0 do S.name(sp) ++ " " ++ pct(vigour_of(f, n, x, z))
    else
      let best = S.best_for(temp, moist)
      if best == 0 do "bare: nothing grows here"
      else "bare: " ++ S.name(best) ++ " " ++ pct(S.fitness(best, temp, moist)) ++ " would grow" end
    end
  end

end
