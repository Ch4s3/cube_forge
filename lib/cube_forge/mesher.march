-- Mesher — naive per-face mesher. For every solid voxel, emit each face whose
-- neighbour is air. Output is a flat F32Buf of 7-float vertices
-- (pos.xyz, uv, layer, shade, face), 6 vertices per face, ready for the VBO.
--
-- This module deliberately has no `needs Input`: it must not be able to reach
-- the input capability domain.
mod CubeForge.Mesher do

  alias CubeForge.F32Buf as B
  alias CubeForge.Chunk as C
  alias CubeForge.Vertex as Vx

  -- Face index, resolved in the vertex shader to a normal (for the flashlight)
  -- and to the directional multiplier that used to be baked in here.
  -- 0 +y, 1 -y, 2 +x, 3 -x, 4 +z, 5 -z — the order `d` uses in face_key.
  fn face_top() : Float do 0.0 end
  fn face_bottom() : Float do 1.0 end
  fn face_xpos() : Float do 2.0 end
  fn face_xneg() : Float do 3.0 end
  fn face_zpos() : Float do 4.0 end
  fn face_zneg() : Float do 5.0 end

  -- ── Smooth lighting: per-vertex skylight and ambient occlusion ────────────

  doc "Ambient occlusion 0..3 for one face corner, from its two edge neighbours and the diagonal. Two solid sides fully close the corner regardless of the diagonal."
  fn corner_ao(s1 : Bool, s2 : Bool, cn : Bool) : Int do
    if s1 && s2 do 0
    else 3 - ((if s1 do 1 else 0 end) + (if s2 do 1 else 0 end) + (if cn do 1 else 0 end)) end
  end

  doc "Pack one corner into ten bits: skylight 0..15 in the low nibble, AO 0..3 above it, block light 0..15 above that."
  fn pack_corner(light : Int, ao : Int, blk : Int) : Int do light + 16 * ao + 64 * blk end

  pfn ao_factor(packed : Int) : Float do 0.55 +. 0.15 *. int_to_float((packed / 16) % 4) end

  doc "Sky shade for a packed corner: skylight scaled by ambient occlusion."
  fn corner_sky(packed : Int) : Float do (int_to_float(packed % 16) /. 15.0) *. ao_factor(packed) end

  doc "Block-light shade for a packed corner: block light scaled by the same ambient occlusion."
  fn corner_blk(packed : Int) : Float do (int_to_float(packed / 64) /. 15.0) *. ao_factor(packed) end

  doc "Split the quad along c1-c3 instead of c0-c2 when the default diagonal is the darker pair; without this a lone dark corner smears across the whole quad. Compares packed shade words by total brightness."
  fn should_flip(s0 : Float, s1 : Float, s2 : Float, s3 : Float) : Bool do
    Vx.brightness_of(s0) +. Vx.brightness_of(s2) < Vx.brightness_of(s1) +. Vx.brightness_of(s3)
  end

  -- Mask key: block id in the low 8 bits, four 10-bit corners in mask (u, v)
  -- order, then the column's shown species in bits 48..55. Two faces merge only
  -- when all of it agrees: block, light at every corner, and species.
  fn key_of(id : Int, c0 : Int, c1 : Int, c2 : Int, c3 : Int, sp : Int) : Int do
    id + 256 * c0 + 262144 * c1 + 268435456 * c2 + 274877906944 * c3 + 281474976710656 * sp
  end
  fn key_sp(k : Int) : Int do (k / 281474976710656) % 256 end
  fn key_id(k : Int) : Int do k % 256 end
  fn key_c0(k : Int) : Int do (k / 256) % 1024 end
  fn key_c1(k : Int) : Int do (k / 262144) % 1024 end
  fn key_c2(k : Int) : Int do (k / 268435456) % 1024 end
  fn key_c3(k : Int) : Int do (k / 274877906944) % 1024 end

  -- Outward offset and the two tangent axes of face direction [d]. The u tangent
  -- never has a y component and the v tangent never has an x one, which is why
  -- corner_pack takes them as two partial vectors.
  pfn dir_ox(d : Int) : Int do if d == 2 do 1 else if d == 3 do -1 else 0 end end end
  pfn dir_oy(d : Int) : Int do if d == 0 do 1 else if d == 1 do -1 else 0 end end end
  pfn dir_oz(d : Int) : Int do if d == 4 do 1 else if d == 5 do -1 else 0 end end end
  pfn t1x(d : Int) : Int do if d <= 1 || d >= 4 do 1 else 0 end end
  pfn t1z(d : Int) : Int do if d == 2 || d == 3 do 1 else 0 end end
  pfn t2y(d : Int) : Int do if d >= 2 do 1 else 0 end end
  pfn t2z(d : Int) : Int do if d <= 1 do 1 else 0 end end

  pfn vert(b : CubeForge.F32Buf.F32Buf, x : Float, y : Float, z : Float, u : Float, v : Float, layer : Float, shade : Float, face : Float) : CubeForge.F32Buf.F32Buf do
    vert_fx(b, x, y, z, u, v, layer, shade, face, Vx.plain())
  end
  pfn vert_fx(b : CubeForge.F32Buf.F32Buf, x : Float, y : Float, z : Float, u : Float, v : Float, layer : Float, shade : Float, face : Float, fx : Float) : CubeForge.F32Buf.F32Buf do
    b |> B.push3(x, y, z) |> B.push(u) |> B.push(v) |> B.push(layer) |> B.push(shade) |> B.push(face) |> B.push(fx)
  end

  -- A quad carrying a flow word: water only.
  pfn quad_fx(b : CubeForge.F32Buf.F32Buf,
           x0 : Float, y0 : Float, z0 : Float, x1 : Float, y1 : Float, z1 : Float,
           x2 : Float, y2 : Float, z2 : Float, x3 : Float, y3 : Float, z3 : Float,
           layer : Float, shade : Float, face : Float, fx : Float) : CubeForge.F32Buf.F32Buf do
    b |> vert_fx(x0, y0, z0, 0.0, 0.0, layer, shade, face, fx)
      |> vert_fx(x1, y1, z1, 1.0, 0.0, layer, shade, face, fx)
      |> vert_fx(x2, y2, z2, 1.0, 1.0, layer, shade, face, fx)
      |> vert_fx(x0, y0, z0, 0.0, 0.0, layer, shade, face, fx)
      |> vert_fx(x2, y2, z2, 1.0, 1.0, layer, shade, face, fx)
      |> vert_fx(x3, y3, z3, 0.0, 1.0, layer, shade, face, fx)
  end

  -- Two triangles from four corners given counter-clockwise as seen from outside.
  pfn quad(b : CubeForge.F32Buf.F32Buf,
           x0 : Float, y0 : Float, z0 : Float, x1 : Float, y1 : Float, z1 : Float,
           x2 : Float, y2 : Float, z2 : Float, x3 : Float, y3 : Float, z3 : Float,
           layer : Float, shade : Float, face : Float) : CubeForge.F32Buf.F32Buf do
    b |> vert(x0, y0, z0, 0.0, 0.0, layer, shade, face)
      |> vert(x1, y1, z1, 1.0, 0.0, layer, shade, face)
      |> vert(x2, y2, z2, 1.0, 1.0, layer, shade, face)
      |> vert(x0, y0, z0, 0.0, 0.0, layer, shade, face)
      |> vert(x2, y2, z2, 1.0, 1.0, layer, shade, face)
      |> vert(x3, y3, z3, 0.0, 1.0, layer, shade, face)
  end

  doc "Texture-array layer for a block id (see Texture.layer_for)."
  fn layer_of(id : Int) : Float do CubeForge.Texture.layer_for(id) end
  fn layer_of_face(id : Int, d : Int) : Float do CubeForge.Texture.layer_for_face(id, d) end
  doc "Texture layer for a face of the block a greedy key describes: mycelium takes its (base, species) layer when a species is shown, everything else the block's own."
  fn layer_for_key(key : Int, d : Int) : Float do
    let id = key_id(key)
    let sp = key_sp(key)
    if C.is_myc(id) && sp > 0 do CubeForge.Texture.myc_layer(C.myc_base_index(id), sp)
    else layer_of_face(id, d) end
  end

  -- Opaque and water meshes of one chunk. A two-field variant, never a tuple (GAPS.md G29).
  type Meshes = Meshes(CubeForge.F32Buf.F32Buf, CubeForge.F32Buf.F32Buf)
  fn opaque_buf(m : Meshes) : CubeForge.F32Buf.F32Buf do match m do Meshes(o, _) -> o end end
  fn water_buf(m : Meshes) : CubeForge.F32Buf.F32Buf do match m do Meshes(_, w) -> w end end

  -- Emit the visible faces of the solid block at (x, y, z); (ox, oy, oz) is the chunk origin.
  pfn block_faces(b : CubeForge.F32Buf.F32Buf, c : CubeForge.Chunk.Chunk, x : Int, y : Int, z : Int, ox : Float, oy : Float, oz : Float) : CubeForge.F32Buf.F32Buf do
    let id = C.get(c, x, y, z)
    if id == 0 do b
    else
      let l = layer_of(id)
      let fx = ox +. int_to_float(x)
      let fy = oy +. int_to_float(y)
      let fz = oz +. int_to_float(z)
      let fx1 = fx +. 1.0
      let fy1 = fy +. 1.0
      let fz1 = fz +. 1.0
      let b1 = if C.get_or_air(c, x, y + 1, z) == 0 do
        quad(b, fx, fy1, fz, fx, fy1, fz1, fx1, fy1, fz1, fx1, fy1, fz, l, 1.0, face_top()) else b end
      let b2 = if C.get_or_air(c, x, y - 1, z) == 0 do
        quad(b1, fx, fy, fz, fx1, fy, fz, fx1, fy, fz1, fx, fy, fz1, l, 1.0, face_bottom()) else b1 end
      let b3 = if C.get_or_air(c, x + 1, y, z) == 0 do
        quad(b2, fx1, fy, fz, fx1, fy1, fz, fx1, fy1, fz1, fx1, fy, fz1, l, 1.0, face_xpos()) else b2 end
      let b4 = if C.get_or_air(c, x - 1, y, z) == 0 do
        quad(b3, fx, fy, fz1, fx, fy1, fz1, fx, fy1, fz, fx, fy, fz, l, 1.0, face_xneg()) else b3 end
      let b5 = if C.get_or_air(c, x, y, z + 1) == 0 do
        quad(b4, fx1, fy, fz1, fx1, fy1, fz1, fx, fy1, fz1, fx, fy, fz1, l, 1.0, face_zpos()) else b4 end
      if C.get_or_air(c, x, y, z - 1) == 0 do
        quad(b5, fx, fy, fz, fx, fy1, fz, fx1, fy1, fz, fx1, fy, fz, l, 1.0, face_zneg()) else b5 end
    end
  end

  pfn mesh_go(b : CubeForge.F32Buf.F32Buf, c : CubeForge.Chunk.Chunk, i : Int, ox : Float, oy : Float, oz : Float) : CubeForge.F32Buf.F32Buf do
    if i >= 65536 do b
    else
      let x = i % 16
      let z = (i / 16) % 16
      let y = i / 256
      mesh_go(block_faces(b, c, x, y, z, ox, oy, oz), c, i + 1, ox, oy, oz)
    end
  end

  doc "Mesh a whole chunk into a fresh buffer. Chunk-local coordinates are offset by the origin."
  fn mesh(c : CubeForge.Chunk.Chunk, ox : Float, oy : Float, oz : Float) : CubeForge.F32Buf.F32Buf do
    mesh_go(B.new(4096), c, 0, ox, oy, oz)
  end

  -- ── M4: neighbour-aware meshing ────────────────────────────────────────────
  -- A block lookup that falls through to the four horizontal neighbours so
  -- chunk-boundary faces are culled correctly. Missing neighbours read as air.
  -- Stage 2 of world generation: this may only run once the neighbours exist.
  pfn nb_get(c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk,
             e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk, x : Int, y : Int, z : Int) : Int do
    if y < 0 || y >= 256 do 0
    else if x < 0 do C.get(w, x + 16, y, z)
    else if x >= 16 do C.get(e, x - 16, y, z)
    else if z < 0 do C.get(n, x, y, z + 16)
    else if z >= 16 do C.get(s, x, y, z - 16)
    else C.get(c, x, y, z) end end end end end
  end

  -- One corner of a face. [nx,ny,nz] is the voxel just outside the face; [a] and
  -- [b] are the two tangent steps toward this corner, so the corner is touched
  -- by n, n+a, n+b and n+a+b. AO counts the three occluders; light is the mean
  -- over those of the four that are not opaque (n never is).
  --
  -- Occluders are read from the world occupancy field rather than the five-chunk
  -- neighbourhood. The diagonal occluder can leave the chunk on BOTH axes at
  -- once, which lands in a chunk the mesher is not given; reading it as air used
  -- to soften ambient occlusion on the four corner columns of every chunk.
  -- Occupancy is world-space, so the seam is simply gone.
  @[no_alloc]
  pfn occluded(occ : NativeU8Arr, oxi : Int, ozi : Int, x : Int, y : Int, z : Int) : Bool do
    let wx = oxi + x
    let wz = ozi + z
    if wx < 0 || wx >= 128 || y < 0 || y >= 256 || wz < 0 || wz >= 128 do false
    else NativeArray.get_u8(occ, CubeForge.Light.occ_index(wx, y, wz)) != 0 end
  end

  pfn corner_pack(la : NativeU8Arr, lb : NativeU8Arr, sps : NativeU8Arr, occ : NativeU8Arr, oxi : Int, ozi : Int, nx : Int, ny : Int, nz : Int, aux : Int, auz : Int, avy : Int, avz : Int) : Int do
    let s1x = nx + aux
    let s1z = nz + auz
    let s2y = ny + avy
    let s2z = nz + avz
    let ccx = nx + aux
    let ccy = ny + avy
    let ccz = nz + auz + avz
    let o1 = occluded(occ, oxi, ozi, s1x, ny, s1z)
    let o2 = occluded(occ, oxi, ozi, nx, s2y, s2z)
    let oc = occluded(occ, oxi, ozi, ccx, ccy, ccz)
    let ln = CubeForge.Light.get(la, oxi + nx, ny, ozi + nz)
    let l1 = if o1 do 0 else CubeForge.Light.get(la, oxi + s1x, ny, ozi + s1z) end
    let l2 = if o2 do 0 else CubeForge.Light.get(la, oxi + nx, s2y, ozi + s2z) end
    let lc = if oc do 0 else CubeForge.Light.get(la, oxi + ccx, ccy, ozi + ccz) end
    let bn = CubeForge.Light.get(lb, oxi + nx, ny, ozi + nz)
    let b1 = if o1 do 0 else CubeForge.Light.get(lb, oxi + s1x, ny, ozi + s1z) end
    let b2 = if o2 do 0 else CubeForge.Light.get(lb, oxi + nx, s2y, ozi + s2z) end
    let bc = if oc do 0 else CubeForge.Light.get(lb, oxi + ccx, ccy, ozi + ccz) end
    let cnt = 1 + (if o1 do 0 else 1 end) + (if o2 do 0 else 1 end) + (if oc do 0 else 1 end)
    pack_corner((ln + l1 + l2 + lc) / cnt, corner_ao(o1, o2, oc), (bn + b1 + b2 + bc) / cnt)
  end

  -- Opaque block at (x, y, z): emit each face whose neighbour is air or water.
  pfn opaque_faces(b : CubeForge.F32Buf.F32Buf, c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk,
                   e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk, id : Int, x : Int, y : Int, z : Int, ox : Float, oz : Float) : CubeForge.F32Buf.F32Buf do
    let l = layer_of(id)
    let fx = ox +. int_to_float(x)
    let fy = int_to_float(y)
    let fz = oz +. int_to_float(z)
    let fx1 = fx +. 1.0
    let fy1 = fy +. 1.0
    let fz1 = fz +. 1.0
    let b1 = if see_through(nb_get(c, n, s, e, w, x, y + 1, z)) do
      quad(b, fx, fy1, fz, fx, fy1, fz1, fx1, fy1, fz1, fx1, fy1, fz, l, 1.0, face_top()) else b end
    let b2 = if see_through(nb_get(c, n, s, e, w, x, y - 1, z)) do
      quad(b1, fx, fy, fz, fx1, fy, fz, fx1, fy, fz1, fx, fy, fz1, l, 1.0, face_bottom()) else b1 end
    let b3 = if see_through(nb_get(c, n, s, e, w, x + 1, y, z)) do
      quad(b2, fx1, fy, fz, fx1, fy1, fz, fx1, fy1, fz1, fx1, fy, fz1, l, 1.0, face_xpos()) else b2 end
    let b4 = if see_through(nb_get(c, n, s, e, w, x - 1, y, z)) do
      quad(b3, fx, fy, fz1, fx, fy1, fz1, fx, fy1, fz, fx, fy, fz, l, 1.0, face_xneg()) else b3 end
    let b5 = if see_through(nb_get(c, n, s, e, w, x, y, z + 1)) do
      quad(b4, fx1, fy, fz1, fx1, fy1, fz1, fx, fy1, fz1, fx, fy, fz1, l, 1.0, face_zpos()) else b4 end
    if see_through(nb_get(c, n, s, e, w, x, y, z - 1)) do
      quad(b5, fx, fy, fz, fx, fy1, fz, fx1, fy1, fz, fx1, fy, fz, l, 1.0, face_zneg()) else b5 end
  end

  -- Air and water do not hide an opaque face.
  doc "Blocks you can see past: air, water and leaves (leaves are alpha-cutout)."
  fn see_through(id : Int) : Bool do id == 0 || C.is_water(id) || C.is_cutout(id) end

  -- Mesh categories: 0 = opaque (greedy), 1 = foliage (greedy, alpha-cutout).
  fn cat_opaque() : Int do 0 end
  fn cat_foliage() : Int do 1 end
  doc "Which mesh a block belongs to: opaque, or the alpha-cutout foliage pass."
  fn category_of(id : Int) : Int do if C.is_cutout(id) do cat_foliage() else cat_opaque() end end

  -- A face exists when the neighbour is see-through AND is not the same foliage
  -- group: leaves must not draw their shared interior faces, or a canopy becomes a
  -- solid mass of quads, but a stone face behind leaves must still render.
  fn face_visible(id : Int, nb : Int) : Bool do
    see_through(nb) && !(C.is_cutout(id) && C.is_cutout(nb))
  end

  -- Water block at (x, y, z) with id [id]: top against non-water at the level height, sides against
  -- air (full height) or against lower water (the strip between the two heights), bottom against air.
  pfn water_faces(b : CubeForge.F32Buf.F32Buf, c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk,
                  e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk, id : Int, x : Int, y : Int, z : Int, ox : Float, oz : Float) : CubeForge.F32Buf.F32Buf do
    let l = layer_of(id)
    let fx = ox +. int_to_float(x)
    let fy = int_to_float(y)
    let fz = oz +. int_to_float(z)
    let fx1 = fx +. 1.0
    let h = fy +. water_height(id)
    let flow = flow_of(id, nb_get(c, n, s, e, w, x + 1, y, z), nb_get(c, n, s, e, w, x - 1, y, z), nb_get(c, n, s, e, w, x, y, z + 1), nb_get(c, n, s, e, w, x, y, z - 1), nb_get(c, n, s, e, w, x, y - 1, z))
    let fw = Vx.pack_flow(flow_effect(flow), flow_speed(flow))
    let fz1 = fz +. 1.0
    let b1 = if !C.is_water(nb_get(c, n, s, e, w, x, y + 1, z)) do
      quad_fx(b, fx, h, fz, fx, h, fz1, fx1, h, fz1, fx1, h, fz, l, 1.0, face_top(), fw) else b end
    let b2 = if nb_get(c, n, s, e, w, x, y - 1, z) == 0 do
      quad_fx(b1, fx, fy, fz, fx1, fy, fz, fx1, fy, fz1, fx, fy, fz1, l, 1.0, face_bottom(), fw) else b1 end
    let b3 = side_base(fy, id, nb_get(c, n, s, e, w, x + 1, y, z))
    let b3b = if b3 < h do quad_fx(b2, fx1, b3, fz, fx1, h, fz, fx1, h, fz1, fx1, b3, fz1, l, 1.0, face_xpos(), fw) else b2 end
    let b4 = side_base(fy, id, nb_get(c, n, s, e, w, x - 1, y, z))
    let b4b = if b4 < h do quad_fx(b3b, fx, b4, fz1, fx, h, fz1, fx, h, fz, fx, b4, fz, l, 1.0, face_xneg(), fw) else b3b end
    let b5 = side_base(fy, id, nb_get(c, n, s, e, w, x, y, z + 1))
    let b5b = if b5 < h do quad_fx(b4b, fx1, b5, fz1, fx1, h, fz1, fx, h, fz1, fx, b5, fz1, l, 1.0, face_zpos(), fw) else b4b end
    let b6 = side_base(fy, id, nb_get(c, n, s, e, w, x, y, z - 1))
    if b6 < h do quad_fx(b5b, fx, b6, fz, fx, h, fz, fx1, h, fz, fx1, b6, fz, l, 1.0, face_zneg(), fw) else b5b end
  end

  -- Bottom of the side strip to emit against neighbour [nid]: the block base for air, the neighbour's
  -- surface for lower water, and the cell's own top (= nothing to emit) for solids and equal/higher water.
  pfn side_base(fy : Float, id : Int, nid : Int) : Float do
    if nid == 0 do fy
    else if C.is_water(nid) && C.level_of(nid) < C.level_of(id) do fy +. water_height(nid)
    else fy +. water_height(id) end end
  end

  doc "Where a water cell flows and how fast, packed effect * 16 + speed. [px, mx, pz, mz] are the block ids of the four horizontal neighbours, [below] the block under it. Falling beats everything; otherwise toward the lowest neighbour by at least one level, speed the drop; else still."
  fn flow_of(id : Int, px : Int, mx : Int, pz : Int, mz : Int, below : Int) : Int do
    let l = C.level_of(id)
    if below == 0 || (C.is_water(below) && !C.is_source(below) && C.level_of(below) < 7) do Vx.fx_fall() * 16 + 7
    else
      let dpx = drop_to(l, px)
      let dmx = drop_to(l, mx)
      let dpz = drop_to(l, pz)
      let dmz = drop_to(l, mz)
      let best = Math.max_int(Math.max_int(dpx, dmx), Math.max_int(dpz, dmz))
      if best <= 0 do Vx.fx_still() * 16
      else if dpx == best do Vx.fx_dir(0) * 16 + best
      else if dmx == best do Vx.fx_dir(4) * 16 + best
      else if dpz == best do Vx.fx_dir(2) * 16 + best
      else Vx.fx_dir(6) * 16 + best end end end end
    end
  end
  -- Level drop from [l] to a neighbour block: air is level 0; solids and sources take nothing.
  pfn drop_to(l : Int, nb : Int) : Int do
    if nb == 0 do l else if C.is_water(nb) && !C.is_source(nb) do l - C.level_of(nb) else 0 end end
  end
  fn flow_effect(packed : Int) : Int do packed / 16 end
  fn flow_speed(packed : Int) : Int do packed % 16 end

  doc "Surface height of a water cell within its block: level * 0.875 / 8."
  fn water_height(id : Int) : Float do int_to_float(C.level_of(id)) *. water_top() /. 8.0 end

  doc "Height of the water surface within its block."
  fn water_top() : Float do 0.875 end

  -- Each block touches exactly one of the two buffers, so no per-block pair is built.
  pfn mesh_nb_go(o : CubeForge.F32Buf.F32Buf, wb : CubeForge.F32Buf.F32Buf, c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk,
                 s : CubeForge.Chunk.Chunk, e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk, i : Int, ox : Float, oz : Float) : Meshes do
    if i >= 65536 do Meshes(o, wb)
    else
      let x = i % 16
      let y = i / 256
      let z = (i / 16) % 16
      let id = C.get(c, x, y, z)
      if id == 0 do mesh_nb_go(o, wb, c, n, s, e, w, i + 1, ox, oz)
      else if C.is_water(id) do mesh_nb_go(o, water_faces(wb, c, n, s, e, w, id, x, y, z, ox, oz), c, n, s, e, w, i + 1, ox, oz)
      else mesh_nb_go(opaque_faces(o, c, n, s, e, w, id, x, y, z, ox, oz), wb, c, n, s, e, w, i + 1, ox, oz) end end
    end
  end

  doc "Mesh chunk [c] with its four horizontal neighbours (n = -z, s = +z, e = +x, w = -x): opaque and water buffers."
  fn mesh_with_neighbors(c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk,
                         e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk, ox : Float, oz : Float) : Meshes do
    mesh_nb_go(B.new(4096), B.new(1024), c, n, s, e, w, 0, ox, oz)
  end

  doc "Mesh the chunk at grid (cx, cz) of [world]; out-of-world neighbours are an empty chunk."
  fn mesh_world_chunk(world : CubeForge.World.World, cx : Int, cz : Int, empty : CubeForge.Chunk.Chunk) : Meshes do
    let pick = fn (x, z) -> if CubeForge.World.in_bounds(world, x, z) do CubeForge.World.chunk_at(world, x, z) else empty end
    mesh_with_neighbors(CubeForge.World.chunk_at(world, cx, cz), pick(cx, cz - 1), pick(cx, cz + 1), pick(cx + 1, cz), pick(cx - 1, cz),
                        int_to_float(16 * cx), int_to_float(16 * cz))
  end

  -- ── Sections: 16x16x16 slabs, sy = y / 16 ──────────────────────────────────

  -- A quad whose uv runs to (uw, vh) so the repeating texture tiles per block.
  -- Each corner carries its own shade, and the triangulation flips when the
  -- default c0-c2 diagonal is the darker pair (see should_flip).
  pfn quad_sized(b : CubeForge.F32Buf.F32Buf,
                 x0 : Float, y0 : Float, z0 : Float, x1 : Float, y1 : Float, z1 : Float,
                 x2 : Float, y2 : Float, z2 : Float, x3 : Float, y3 : Float, z3 : Float,
                 uw : Float, vh : Float, layer : Float,
                 s0 : Float, s1 : Float, s2 : Float, s3 : Float, face : Float) : CubeForge.F32Buf.F32Buf do
    if should_flip(s0, s1, s2, s3) do
      b |> vert(x1, y1, z1, uw, 0.0, layer, s1, face)
        |> vert(x2, y2, z2, uw, vh, layer, s2, face)
        |> vert(x3, y3, z3, 0.0, vh, layer, s3, face)
        |> vert(x1, y1, z1, uw, 0.0, layer, s1, face)
        |> vert(x3, y3, z3, 0.0, vh, layer, s3, face)
        |> vert(x0, y0, z0, 0.0, 0.0, layer, s0, face)
    else
      b |> vert(x0, y0, z0, 0.0, 0.0, layer, s0, face)
        |> vert(x1, y1, z1, uw, 0.0, layer, s1, face)
        |> vert(x2, y2, z2, uw, vh, layer, s2, face)
        |> vert(x0, y0, z0, 0.0, 0.0, layer, s0, face)
        |> vert(x2, y2, z2, uw, vh, layer, s2, face)
        |> vert(x3, y3, z3, 0.0, vh, layer, s3, face)
    end
  end

  -- Is the block at (x, y, z) an opaque block whose face in direction d is
  -- visible? Directions: 0 +y, 1 -y, 2 +x, 3 -x, 4 +z, 5 -z. Returns 0 when
  -- there is no face, else the packed key: block id plus the four corner
  -- light/AO values in mask (u, v) order.
  pfn face_key(c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk, e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk,
               la : NativeU8Arr, lb : NativeU8Arr, sps : NativeU8Arr, occ : NativeU8Arr, oxi : Int, ozi : Int, x : Int, y : Int, z : Int, d : Int, cat : Int) : Int do
    let id = C.get(c, x, y, z)
    if id == 0 || C.is_water(id) || category_of(id) != cat do 0
    -- a model block draws as a stamped template, never as cube faces
    else if is_model(c, n, s, e, w, x, y, z, id) do 0
    else
      let nb = if d == 0 do nb_get(c, n, s, e, w, x, y + 1, z) else if d == 1 do nb_get(c, n, s, e, w, x, y - 1, z)
               else if d == 2 do nb_get(c, n, s, e, w, x + 1, y, z) else if d == 3 do nb_get(c, n, s, e, w, x - 1, y, z)
               else if d == 4 do nb_get(c, n, s, e, w, x, y, z + 1) else nb_get(c, n, s, e, w, x, y, z - 1) end end end end end
      if !face_visible(id, nb) do 0
      else
        -- the voxel just outside the face, and the two tangent steps
        let nx = x + dir_ox(d)
        let ny = y + dir_oy(d)
        let nz = z + dir_oz(d)
        let ux = t1x(d)
        let uz = t1z(d)
        let vy = t2y(d)
        let vz = t2z(d)
        -- corners c0..c3 at (du, dv) = (-,-) (+,-) (+,+) (-,+) in mask order
        let k0 = corner_pack(la, lb, sps, occ, oxi, ozi, nx, ny, nz, 0 - ux, 0 - uz, 0 - vy, 0 - vz)
        let k1 = corner_pack(la, lb, sps, occ, oxi, ozi, nx, ny, nz, ux, uz, 0 - vy, 0 - vz)
        let k2 = corner_pack(la, lb, sps, occ, oxi, ozi, nx, ny, nz, ux, uz, vy, vz)
        let k3 = corner_pack(la, lb, sps, occ, oxi, ozi, nx, ny, nz, 0 - ux, 0 - uz, vy, vz)
        -- mycelium takes its texture from the column's shown species
        let sp = if C.is_myc(id) do NativeArray.get_u8(sps, oxi + x + 128 * (ozi + z)) else 0 end
        key_of(id, k0, k1, k2, k3, sp)
      end
    end end
  end

  -- Fill the 16x16 mask for slice [a] of direction [d] in section [sy]. Mask index = u + 16 * v.
  --   d 0/1: a = local y, u = x, v = z.   d 2/3: a = x, u = z, v = local y.   d 4/5: a = z, u = x, v = local y.
  -- mask[256] counts the non-zero keys so an empty slice can be skipped without a second pass.
  pfn fill_mask(mask : NativeIntArr, i : Int, c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk,
                e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk, la : NativeU8Arr, lb : NativeU8Arr, sps : NativeU8Arr, occ : NativeU8Arr, oxi : Int, ozi : Int, sy : Int, d : Int, a : Int, cnt : Int, cat : Int) : NativeIntArr do
    if i >= 256 do NativeArray.set_int(mask, 256, cnt)
    else
      let u = i % 16
      let v = i / 16
      let key = if d <= 1 do face_key(c, n, s, e, w, la, lb, sps, occ, oxi, ozi, u, sy * 16 + a, v, d, cat)
                else if d <= 3 do face_key(c, n, s, e, w, la, lb, sps, occ, oxi, ozi, a, sy * 16 + v, u, d, cat)
                else face_key(c, n, s, e, w, la, lb, sps, occ, oxi, ozi, u, sy * 16 + v, a, d, cat) end end
      fill_mask(NativeArray.set_int(mask, i, key), i + 1, c, n, s, e, w, la, lb, sps, occ, oxi, ozi, sy, d, a, if key != 0 do cnt + 1 else cnt end, cat)
    end
  end

  -- Does section [sy] contain any block of category [cat]?
  pfn section_has(c : CubeForge.Chunk.Chunk, i : Int, stop : Int, cat : Int) : Bool do
    if i >= stop do false
    else
      let id = C.get_idx(c, i)
      if id != 0 && !C.is_water(id) && category_of(id) == cat do true else section_has(c, i + 1, stop, cat) end
    end
  end

  -- `&&` does not short-circuit (GAPS.md G33): the bounds test must be a separate `if`.
  pfn run_width(mask : NativeIntArr, u : Int, v : Int, key : Int, wd : Int) : Int do
    if u + wd >= 16 do wd
    else if NativeArray.get_int(mask, u + wd + 16 * v) == key do run_width(mask, u, v, key, wd + 1) else wd end end
  end
  pfn row_matches(mask : NativeIntArr, u : Int, v : Int, key : Int, wd : Int, k : Int) : Bool do
    if k >= wd do true
    else if NativeArray.get_int(mask, u + k + 16 * v) == key do row_matches(mask, u, v, key, wd, k + 1) else false end end
  end
  pfn run_height(mask : NativeIntArr, u : Int, v : Int, key : Int, wd : Int, h : Int) : Int do
    if v + h >= 16 do h
    else if row_matches(mask, u, v + h, key, wd, 0) do run_height(mask, u, v, key, wd, h + 1) else h end end
  end
  pfn clear_rect(mask : NativeIntArr, u : Int, v : Int, wd : Int, h : Int, k : Int) : NativeIntArr do
    if k >= wd * h do mask
    else clear_rect(NativeArray.set_int(mask, u + k % wd + 16 * (v + k / wd), 0), u, v, wd, h, k + 1) end
  end

  -- Emit one merged rectangle for direction d, slice a, mask cell (u, v), size wd x h.
  -- The four corner shades come out of the key in mask (u, v) order; each branch
  -- below lists them in ITS OWN vertex order, which differs per direction — the
  -- quad corners are wound differently for each face and mapping them wrongly
  -- puts the shading on the wrong corner.
  pfn emit_rect(b : CubeForge.F32Buf.F32Buf, d : Int, sy : Int, a : Int, u : Int, v : Int, wd : Int, h : Int, key : Int,
                ox : Float, oz : Float) : CubeForge.F32Buf.F32Buf do
    let l = layer_for_key(key, d)
    let fw = int_to_float(wd)
    let fh = int_to_float(h)
    let s0 = Vx.pack_shade(corner_sky(key_c0(key)), corner_blk(key_c0(key)))
    let s1 = Vx.pack_shade(corner_sky(key_c1(key)), corner_blk(key_c1(key)))
    let s2 = Vx.pack_shade(corner_sky(key_c2(key)), corner_blk(key_c2(key)))
    let s3 = Vx.pack_shade(corner_sky(key_c3(key)), corner_blk(key_c3(key)))
    if d <= 1 do
      let x = ox +. int_to_float(u)
      let z = oz +. int_to_float(v)
      let y = int_to_float(sy * 16 + a)
      let x1 = x +. fw
      let z1 = z +. fh
      if d == 0 do quad_sized(b, x, y +. 1.0, z, x, y +. 1.0, z1, x1, y +. 1.0, z1, x1, y +. 1.0, z, fh, fw, l, s0, s3, s2, s1, face_top())
      else quad_sized(b, x, y, z, x1, y, z, x1, y, z1, x, y, z1, fw, fh, l, s0, s1, s2, s3, face_bottom()) end
    else if d <= 3 do
      let x = ox +. int_to_float(a)
      let z = oz +. int_to_float(u)
      let y = int_to_float(sy * 16 + v)
      let z1 = z +. fw
      let y1 = y +. fh
      if d == 2 do quad_sized(b, x +. 1.0, y, z, x +. 1.0, y1, z, x +. 1.0, y1, z1, x +. 1.0, y, z1, fh, fw, l, s0, s3, s2, s1, face_xpos())
      else quad_sized(b, x, y, z1, x, y1, z1, x, y1, z, x, y, z, fh, fw, l, s1, s2, s3, s0, face_xneg()) end
    else
      let x = ox +. int_to_float(u)
      let z = oz +. int_to_float(a)
      let y = int_to_float(sy * 16 + v)
      let x1 = x +. fw
      let y1 = y +. fh
      if d == 4 do quad_sized(b, x1, y, z +. 1.0, x1, y1, z +. 1.0, x, y1, z +. 1.0, x, y, z +. 1.0, fh, fw, l, s1, s2, s3, s0, face_zpos())
      else quad_sized(b, x, y, z, x, y1, z, x1, y1, z, x1, y, z, fh, fw, l, s0, s3, s2, s1, face_zneg()) end
    end end
  end

  -- Greedy merge over one filled mask. Returns the buffer; the mask is consumed (cleared).
  type Greedy = Greedy(CubeForge.F32Buf.F32Buf, NativeIntArr)
  pfn greedy_go(g : Greedy, i : Int, d : Int, sy : Int, a : Int, ox : Float, oz : Float) : Greedy do
    if i >= 256 do g
    else
      match g do
        Greedy(b, mask) ->
          let key = NativeArray.get_int(mask, i)
          if key == 0 do greedy_go(Greedy(b, mask), i + 1, d, sy, a, ox, oz)
          else
            let u = i % 16
            let v = i / 16
            let wd = run_width(mask, u, v, key, 1)
            let h = run_height(mask, u, v, key, wd, 1)
            let b1 = emit_rect(b, d, sy, a, u, v, wd, h, key, ox, oz)
            greedy_go(Greedy(b1, clear_rect(mask, u, v, wd, h, 0)), i + 1, d, sy, a, ox, oz)
          end
      end
    end
  end

  pfn slices_go(g : Greedy, c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk, e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk,
                la : NativeU8Arr, lb : NativeU8Arr, sps : NativeU8Arr, occ : NativeU8Arr, oxi : Int, ozi : Int, sy : Int, d : Int, a : Int, ox : Float, oz : Float, cat : Int) : Greedy do
    if a >= 16 do g
    else
      match g do
        Greedy(b, mask) ->
          let m1 = fill_mask(mask, 0, c, n, s, e, w, la, lb, sps, occ, oxi, ozi, sy, d, a, 0, cat)
          if NativeArray.get_int(m1, 256) == 0 do slices_go(Greedy(b, m1), c, n, s, e, w, la, lb, sps, occ, oxi, ozi, sy, d, a + 1, ox, oz, cat)
          else slices_go(greedy_go(Greedy(b, m1), 0, d, sy, a, ox, oz), c, n, s, e, w, la, lb, sps, occ, oxi, ozi, sy, d, a + 1, ox, oz, cat) end
      end
    end
  end

  pfn dirs_go(g : Greedy, c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk, e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk,
              la : NativeU8Arr, lb : NativeU8Arr, sps : NativeU8Arr, occ : NativeU8Arr, oxi : Int, ozi : Int, sy : Int, d : Int, ox : Float, oz : Float, cat : Int) : Greedy do
    if d >= 6 do g else dirs_go(slices_go(g, c, n, s, e, w, la, lb, sps, occ, oxi, ozi, sy, d, 0, ox, oz, cat), c, n, s, e, w, la, lb, sps, occ, oxi, ozi, sy, d + 1, ox, oz, cat) end
  end

  -- Greedy-meshed faces of one category in section [sy] of chunk [c] (with its 4 neighbours).
  fn mesh_section_cat(c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk, e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk,
                      la : NativeU8Arr, lb : NativeU8Arr, sps : NativeU8Arr, occ : NativeU8Arr, sy : Int, ox : Float, oz : Float, cat : Int, models : CubeForge.Model.Templates) : CubeForge.F32Buf.F32Buf do
    if !section_has(c, sy * 4096, (sy + 1) * 4096, cat) do B.new(1)
    else
      match dirs_go(Greedy(B.new(1024), NativeArray.make_int(257, 0)), c, n, s, e, w, la, lb, sps, occ, float_to_int(ox), float_to_int(oz), sy, 0, ox, oz, cat) do
        Greedy(b, _) ->
          -- the foliage pass carries the models: each model block stamped after the cubes
          if cat == cat_foliage() do stamp_go(b, models, c, n, s, e, w, la, lb, float_to_int(ox), float_to_int(oz), ox, oz, sy * 4096, (sy + 1) * 4096) else b end
      end
    end
  end

  doc "Greedy-meshed opaque faces of section [sy]."
  fn mesh_section_opaque(c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk, e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk,
                         la : NativeU8Arr, lb : NativeU8Arr, sps : NativeU8Arr, occ : NativeU8Arr, sy : Int, ox : Float, oz : Float, models : CubeForge.Model.Templates) : CubeForge.F32Buf.F32Buf do
    mesh_section_cat(c, n, s, e, w, la, lb, sps, occ, sy, ox, oz, cat_opaque(), models)
  end

  doc "Greedy-meshed alpha-cutout foliage faces of section [sy], plus the stamped models."
  fn mesh_section_foliage(c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk, e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk,
                          la : NativeU8Arr, lb : NativeU8Arr, sps : NativeU8Arr, occ : NativeU8Arr, sy : Int, ox : Float, oz : Float, models : CubeForge.Model.Templates) : CubeForge.F32Buf.F32Buf do
    mesh_section_cat(c, n, s, e, w, la, lb, sps, occ, sy, ox, oz, cat_foliage(), models)
  end

  -- ── Models: small things stamped as templates ───────────────────────────
  -- A model block is drawn as its Model template inside the cell: small
  -- mushrooms, palm fronds, and oak leaves standing on the ground (a bush --
  -- the same test Veg.has_bush uses; canopy leaves stay cubes so a forest keeps
  -- the greedy mesher). Model blocks stay see-through for their neighbours and
  -- emit no cube faces of their own (face_key).
  doc "Is the block [id] at (x, y, z) drawn as a model?"
  fn is_model(c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk, e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk,
              x : Int, y : Int, z : Int, id : Int) : Bool do
    if C.is_fruit_small(id) do true
    else if id == C.palm_frond() do true
    else if id == C.oak_leaves() do
      let below = nb_get(c, n, s, e, w, x, y - 1, z)
      if below == 0 do false else if C.is_water(below) do false else if C.is_foliage(below) do false else !C.is_log(below) end end end
    else false end end end
  end

  -- Frond direction (Model.frond's 0..7) for the blade pointing away from (sx, sz).
  pfn away_dir(sx : Int, sz : Int) : Int do
    let ax = 0 - sx
    let az = 0 - sz
    if az == 0 do (if ax > 0 do 0 else 2 end)
    else if ax == 0 do (if az > 0 do 1 else 3 end)
    else if ax > 0 && az > 0 do 4
    else if ax < 0 && az > 0 do 5
    else if ax < 0 && az < 0 do 6
    else 7 end end end end end
  end
  pfn sgn(b : Bool) : Int do if b do 1 else 0 end end

  doc "The template a model block at (x, y, z) stamps: mushrooms by species; fronds by where the trunk is; bushes by a position hash."
  fn template_of(c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk, e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk,
                 x : Int, y : Int, z : Int, id : Int, oxi : Int, ozi : Int) : Int do
    if C.is_fruit_small(id) do CubeForge.Model.t_mushroom(C.fruit_species(id))
    else if id == C.palm_frond() do
      let px = nb_get(c, n, s, e, w, x + 1, y, z)
      let mx = nb_get(c, n, s, e, w, x - 1, y, z)
      let pz = nb_get(c, n, s, e, w, x, y, z + 1)
      let mz = nb_get(c, n, s, e, w, x, y, z - 1)
      -- a palm log beside it: the blade points away from the trunk
      if px == C.palm_log() do CubeForge.Model.t_frond(2)
      else if mx == C.palm_log() do CubeForge.Model.t_frond(0)
      else if pz == C.palm_log() do CubeForge.Model.t_frond(3)
      else if mz == C.palm_log() do CubeForge.Model.t_frond(1)
      else
        -- fronds beside it: away from where they are
        let sx = sgn(px == C.palm_frond()) - sgn(mx == C.palm_frond())
        let sz = sgn(pz == C.palm_frond()) - sgn(mz == C.palm_frond())
        if sx != 0 || sz != 0 do CubeForge.Model.t_frond(away_dir(sx, sz))
        else if nb_get(c, n, s, e, w, x, y - 1, z) == C.palm_log() do CubeForge.Model.t_umbrella()
        else CubeForge.Model.t_tuft() end end
      end end end end
    else CubeForge.Model.t_bush(float_to_int(CubeForge.Noise.hash2(oxi + x, ozi + z, 4242) *. 4.0) % 4) end end
  end

  -- Append template k translated to (fx, fy, fz) with [shade] on every vertex.
  pfn stamp_verts(b : CubeForge.F32Buf.F32Buf, m : CubeForge.Model.Templates, off : Int, i : Int, nv : Int, fx : Float, fy : Float, fz : Float, shade : Float) : CubeForge.F32Buf.F32Buf do
    if i >= nv do b
    else
      let o = off + i * Vx.floats()
      let b1 = b |> B.push3(CubeForge.Model.at(m, o) +. fx, CubeForge.Model.at(m, o + 1) +. fy, CubeForge.Model.at(m, o + 2) +. fz)
                 |> B.push(CubeForge.Model.at(m, o + 3)) |> B.push(CubeForge.Model.at(m, o + 4)) |> B.push(CubeForge.Model.at(m, o + 5))
                 |> B.push(shade) |> B.push(CubeForge.Model.at(m, o + 7)) |> B.push(CubeForge.Model.at(m, o + 8))
      stamp_verts(b1, m, off, i + 1, nv, fx, fy, fz, shade)
    end
  end
  doc "Stamp template [k] into the cell whose origin is (fx, fy, fz), every vertex carrying [shade]."
  fn stamp(b : CubeForge.F32Buf.F32Buf, m : CubeForge.Model.Templates, k : Int, fx : Float, fy : Float, fz : Float, shade : Float) : CubeForge.F32Buf.F32Buf do
    stamp_verts(b, m, CubeForge.Model.offset(m, k), 0, CubeForge.Model.floats(m, k) / Vx.floats(), fx, fy, fz, shade)
  end

  -- Every model block of the section, stamped with one shade from its own cell's light.
  pfn stamp_go(b : CubeForge.F32Buf.F32Buf, m : CubeForge.Model.Templates, c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk, e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk,
               la : NativeU8Arr, lb : NativeU8Arr, oxi : Int, ozi : Int, ox : Float, oz : Float, i : Int, stop : Int) : CubeForge.F32Buf.F32Buf do
    if i >= stop do b
    else
      let id = C.get_idx(c, i)
      let x = i % 16
      let y = i / 256
      let z = (i / 16) % 16
      let model = if id == 0 do false else if !C.is_cutout(id) do false else is_model(c, n, s, e, w, x, y, z, id) end end
      if !model do stamp_go(b, m, c, n, s, e, w, la, lb, oxi, ozi, ox, oz, i + 1, stop)
      else
        let sky = int_to_float(CubeForge.Light.get(la, oxi + x, y, ozi + z)) /. 15.0
        let blk = int_to_float(CubeForge.Light.get(lb, oxi + x, y, ozi + z)) /. 15.0
        let k = template_of(c, n, s, e, w, x, y, z, id, oxi, ozi)
        stamp_go(stamp(b, m, k, ox +. int_to_float(x), int_to_float(y), oz +. int_to_float(z), Vx.pack_shade(sky, blk)), m, c, n, s, e, w, la, lb, oxi, ozi, ox, oz, i + 1, stop)
      end
    end
  end

  pfn water_section_go(b : CubeForge.F32Buf.F32Buf, c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk,
                       e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk, i : Int, stop : Int, ox : Float, oz : Float) : CubeForge.F32Buf.F32Buf do
    if i >= stop do b
    else
      let id = C.get_idx(c, i)
      if C.is_water(id) do water_section_go(water_faces(b, c, n, s, e, w, id, i % 16, i / 256, (i / 16) % 16, ox, oz), c, n, s, e, w, i + 1, stop, ox, oz)
      else water_section_go(b, c, n, s, e, w, i + 1, stop, ox, oz) end
    end
  end

  doc "Per-cell water faces of section [sy]."
  fn mesh_section_water(c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk, e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk,
                        sy : Int, ox : Float, oz : Float) : CubeForge.F32Buf.F32Buf do
    water_section_go(B.new(256), c, n, s, e, w, sy * 4096, (sy + 1) * 4096, ox, oz)
  end

  doc "Vertices in a mesh buffer (9 floats each)."
  fn vertex_count(b : CubeForge.F32Buf.F32Buf) : Int do B.len(b) / Vx.floats() end

end
