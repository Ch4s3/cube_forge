-- Mesher — naive per-face mesher. For every solid voxel, emit each face whose
-- neighbour is air. Output is a flat F32Buf of 7-float vertices
-- (pos.xyz, uv, layer, shade), 6 vertices per face, ready for the VBO.
--
-- This module deliberately has no `needs Input`: it must not be able to reach
-- the input capability domain.
mod CubeForge.Mesher do

  alias CubeForge.F32Buf as B
  alias CubeForge.Chunk as C

  -- Per-face directional multiplier: flat ambient look, no lighting.
  fn shade_top() : Float do 1.0 end
  fn shade_bottom() : Float do 0.55 end
  fn shade_x() : Float do 0.75 end
  fn shade_z() : Float do 0.85 end

  pfn vert(b : CubeForge.F32Buf.F32Buf, x : Float, y : Float, z : Float, u : Float, v : Float, layer : Float, shade : Float) : CubeForge.F32Buf.F32Buf do
    b |> B.push3(x, y, z) |> B.push(u) |> B.push(v) |> B.push(layer) |> B.push(shade)
  end

  -- Two triangles from four corners given counter-clockwise as seen from outside.
  pfn quad(b : CubeForge.F32Buf.F32Buf,
           x0 : Float, y0 : Float, z0 : Float, x1 : Float, y1 : Float, z1 : Float,
           x2 : Float, y2 : Float, z2 : Float, x3 : Float, y3 : Float, z3 : Float,
           layer : Float, shade : Float) : CubeForge.F32Buf.F32Buf do
    b |> vert(x0, y0, z0, 0.0, 0.0, layer, shade)
      |> vert(x1, y1, z1, 1.0, 0.0, layer, shade)
      |> vert(x2, y2, z2, 1.0, 1.0, layer, shade)
      |> vert(x0, y0, z0, 0.0, 0.0, layer, shade)
      |> vert(x2, y2, z2, 1.0, 1.0, layer, shade)
      |> vert(x3, y3, z3, 0.0, 1.0, layer, shade)
  end

  doc "Texture-array layer for a block id: water is layer 1, everything else layer 0."
  fn layer_of(id : Int) : Float do if C.is_water(id) do 1.0 else 0.0 end end

  -- Opaque and water meshes of one chunk. A two-field variant, never a tuple (GAPS.md G29).
  type Meshes = Meshes(CubeForge.F32Buf.F32Buf, CubeForge.F32Buf.F32Buf)
  fn opaque_buf(m : Meshes) : CubeForge.F32Buf.F32Buf do match m do Meshes(o, _) -> o end end
  fn water_buf(m : Meshes) : CubeForge.F32Buf.F32Buf do match m do Meshes(_, w) -> w end end

  -- Emit the visible faces of the solid block at (x, y, z); (ox, oy, oz) is the chunk origin.
  pfn block_faces(b : CubeForge.F32Buf.F32Buf, c : CubeForge.Chunk.Chunk, x : Int, y : Int, z : Int, ox : Float, oy : Float, oz : Float) : CubeForge.F32Buf.F32Buf do
    let id = C.get(c, x, y, z)
    if id == 0 do b
    else
      let l = layer_of(id)
      let fx = ox +. int_to_float(x)
      let fy = oy +. int_to_float(y)
      let fz = oz +. int_to_float(z)
      let fx1 = fx +. 1.0
      let fy1 = fy +. 1.0
      let fz1 = fz +. 1.0
      let b1 = if C.get_or_air(c, x, y + 1, z) == 0 do
        quad(b, fx, fy1, fz, fx, fy1, fz1, fx1, fy1, fz1, fx1, fy1, fz, l, shade_top()) else b end
      let b2 = if C.get_or_air(c, x, y - 1, z) == 0 do
        quad(b1, fx, fy, fz, fx1, fy, fz, fx1, fy, fz1, fx, fy, fz1, l, shade_bottom()) else b1 end
      let b3 = if C.get_or_air(c, x + 1, y, z) == 0 do
        quad(b2, fx1, fy, fz, fx1, fy1, fz, fx1, fy1, fz1, fx1, fy, fz1, l, shade_x()) else b2 end
      let b4 = if C.get_or_air(c, x - 1, y, z) == 0 do
        quad(b3, fx, fy, fz1, fx, fy1, fz1, fx, fy1, fz, fx, fy, fz, l, shade_x()) else b3 end
      let b5 = if C.get_or_air(c, x, y, z + 1) == 0 do
        quad(b4, fx1, fy, fz1, fx1, fy1, fz1, fx, fy1, fz1, fx, fy, fz1, l, shade_z()) else b4 end
      if C.get_or_air(c, x, y, z - 1) == 0 do
        quad(b5, fx, fy, fz, fx, fy1, fz, fx1, fy1, fz, fx1, fy, fz, l, shade_z()) else b5 end
    end
  end

  pfn mesh_go(b : CubeForge.F32Buf.F32Buf, c : CubeForge.Chunk.Chunk, i : Int, ox : Float, oy : Float, oz : Float) : CubeForge.F32Buf.F32Buf do
    if i >= 65536 do b
    else
      let x = i % 16
      let z = (i / 16) % 16
      let y = i / 256
      mesh_go(block_faces(b, c, x, y, z, ox, oy, oz), c, i + 1, ox, oy, oz)
    end
  end

  doc "Mesh a whole chunk into a fresh buffer. Chunk-local coordinates are offset by the origin."
  fn mesh(c : CubeForge.Chunk.Chunk, ox : Float, oy : Float, oz : Float) : CubeForge.F32Buf.F32Buf do
    mesh_go(B.new(4096), c, 0, ox, oy, oz)
  end

  -- ── M4: neighbour-aware meshing ────────────────────────────────────────────
  -- A block lookup that falls through to the four horizontal neighbours so
  -- chunk-boundary faces are culled correctly. Missing neighbours read as air.
  -- Stage 2 of world generation: this may only run once the neighbours exist.
  pfn nb_get(c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk,
             e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk, x : Int, y : Int, z : Int) : Int do
    if y < 0 || y >= 256 do 0
    else if x < 0 do C.get(w, x + 16, y, z)
    else if x >= 16 do C.get(e, x - 16, y, z)
    else if z < 0 do C.get(n, x, y, z + 16)
    else if z >= 16 do C.get(s, x, y, z - 16)
    else C.get(c, x, y, z) end end end end end
  end

  -- Opaque block at (x, y, z): emit each face whose neighbour is air or water.
  pfn opaque_faces(b : CubeForge.F32Buf.F32Buf, c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk,
                   e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk, id : Int, x : Int, y : Int, z : Int, ox : Float, oz : Float) : CubeForge.F32Buf.F32Buf do
    let l = layer_of(id)
    let fx = ox +. int_to_float(x)
    let fy = int_to_float(y)
    let fz = oz +. int_to_float(z)
    let fx1 = fx +. 1.0
    let fy1 = fy +. 1.0
    let fz1 = fz +. 1.0
    let b1 = if see_through(nb_get(c, n, s, e, w, x, y + 1, z)) do
      quad(b, fx, fy1, fz, fx, fy1, fz1, fx1, fy1, fz1, fx1, fy1, fz, l, shade_top()) else b end
    let b2 = if see_through(nb_get(c, n, s, e, w, x, y - 1, z)) do
      quad(b1, fx, fy, fz, fx1, fy, fz, fx1, fy, fz1, fx, fy, fz1, l, shade_bottom()) else b1 end
    let b3 = if see_through(nb_get(c, n, s, e, w, x + 1, y, z)) do
      quad(b2, fx1, fy, fz, fx1, fy1, fz, fx1, fy1, fz1, fx1, fy, fz1, l, shade_x()) else b2 end
    let b4 = if see_through(nb_get(c, n, s, e, w, x - 1, y, z)) do
      quad(b3, fx, fy, fz1, fx, fy1, fz1, fx, fy1, fz, fx, fy, fz, l, shade_x()) else b3 end
    let b5 = if see_through(nb_get(c, n, s, e, w, x, y, z + 1)) do
      quad(b4, fx1, fy, fz1, fx1, fy1, fz1, fx, fy1, fz1, fx, fy, fz1, l, shade_z()) else b4 end
    if see_through(nb_get(c, n, s, e, w, x, y, z - 1)) do
      quad(b5, fx, fy, fz, fx, fy1, fz, fx1, fy1, fz, fx1, fy, fz, l, shade_z()) else b5 end
  end

  -- Air and water do not hide an opaque face.
  pfn see_through(id : Int) : Bool do id == 0 || C.is_water(id) end

  -- Water block at (x, y, z) with id [id]: top against non-water at the level height, sides against
  -- air (full height) or against lower water (the strip between the two heights), bottom against air.
  pfn water_faces(b : CubeForge.F32Buf.F32Buf, c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk,
                  e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk, id : Int, x : Int, y : Int, z : Int, ox : Float, oz : Float) : CubeForge.F32Buf.F32Buf do
    let l = layer_of(id)
    let fx = ox +. int_to_float(x)
    let fy = int_to_float(y)
    let fz = oz +. int_to_float(z)
    let fx1 = fx +. 1.0
    let h = fy +. water_height(id)
    let fz1 = fz +. 1.0
    let b1 = if !C.is_water(nb_get(c, n, s, e, w, x, y + 1, z)) do
      quad(b, fx, h, fz, fx, h, fz1, fx1, h, fz1, fx1, h, fz, l, shade_top()) else b end
    let b2 = if nb_get(c, n, s, e, w, x, y - 1, z) == 0 do
      quad(b1, fx, fy, fz, fx1, fy, fz, fx1, fy, fz1, fx, fy, fz1, l, shade_bottom()) else b1 end
    let b3 = side_base(fy, id, nb_get(c, n, s, e, w, x + 1, y, z))
    let b3b = if b3 < h do quad(b2, fx1, b3, fz, fx1, h, fz, fx1, h, fz1, fx1, b3, fz1, l, shade_x()) else b2 end
    let b4 = side_base(fy, id, nb_get(c, n, s, e, w, x - 1, y, z))
    let b4b = if b4 < h do quad(b3b, fx, b4, fz1, fx, h, fz1, fx, h, fz, fx, b4, fz, l, shade_x()) else b3b end
    let b5 = side_base(fy, id, nb_get(c, n, s, e, w, x, y, z + 1))
    let b5b = if b5 < h do quad(b4b, fx1, b5, fz1, fx1, h, fz1, fx, h, fz1, fx, b5, fz1, l, shade_z()) else b4b end
    let b6 = side_base(fy, id, nb_get(c, n, s, e, w, x, y, z - 1))
    if b6 < h do quad(b5b, fx, b6, fz, fx, h, fz, fx1, h, fz, fx1, b6, fz, l, shade_z()) else b5b end
  end

  -- Bottom of the side strip to emit against neighbour [nid]: the block base for air, the neighbour's
  -- surface for lower water, and the cell's own top (= nothing to emit) for solids and equal/higher water.
  pfn side_base(fy : Float, id : Int, nid : Int) : Float do
    if nid == 0 do fy
    else if C.is_water(nid) && C.level_of(nid) < C.level_of(id) do fy +. water_height(nid)
    else fy +. water_height(id) end end
  end

  doc "Surface height of a water cell within its block: level * 0.875 / 8."
  fn water_height(id : Int) : Float do int_to_float(C.level_of(id)) *. water_top() /. 8.0 end

  doc "Height of the water surface within its block."
  fn water_top() : Float do 0.875 end

  -- Each block touches exactly one of the two buffers, so no per-block pair is built.
  pfn mesh_nb_go(o : CubeForge.F32Buf.F32Buf, wb : CubeForge.F32Buf.F32Buf, c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk,
                 s : CubeForge.Chunk.Chunk, e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk, i : Int, ox : Float, oz : Float) : Meshes do
    if i >= 65536 do Meshes(o, wb)
    else
      let x = i % 16
      let y = i / 256
      let z = (i / 16) % 16
      let id = C.get(c, x, y, z)
      if id == 0 do mesh_nb_go(o, wb, c, n, s, e, w, i + 1, ox, oz)
      else if C.is_water(id) do mesh_nb_go(o, water_faces(wb, c, n, s, e, w, id, x, y, z, ox, oz), c, n, s, e, w, i + 1, ox, oz)
      else mesh_nb_go(opaque_faces(o, c, n, s, e, w, id, x, y, z, ox, oz), wb, c, n, s, e, w, i + 1, ox, oz) end end
    end
  end

  doc "Mesh chunk [c] with its four horizontal neighbours (n = -z, s = +z, e = +x, w = -x): opaque and water buffers."
  fn mesh_with_neighbors(c : CubeForge.Chunk.Chunk, n : CubeForge.Chunk.Chunk, s : CubeForge.Chunk.Chunk,
                         e : CubeForge.Chunk.Chunk, w : CubeForge.Chunk.Chunk, ox : Float, oz : Float) : Meshes do
    mesh_nb_go(B.new(4096), B.new(1024), c, n, s, e, w, 0, ox, oz)
  end

  doc "Mesh the chunk at grid (cx, cz) of [world]; out-of-world neighbours are an empty chunk."
  fn mesh_world_chunk(world : CubeForge.World.World, cx : Int, cz : Int, empty : CubeForge.Chunk.Chunk) : Meshes do
    let pick = fn (x, z) -> if CubeForge.World.in_bounds(world, x, z) do CubeForge.World.chunk_at(world, x, z) else empty end
    mesh_with_neighbors(CubeForge.World.chunk_at(world, cx, cz), pick(cx, cz - 1), pick(cx, cz + 1), pick(cx + 1, cz), pick(cx - 1, cz),
                        int_to_float(16 * cx), int_to_float(16 * cz))
  end

  doc "Vertices in a mesh buffer (7 floats each)."
  fn vertex_count(b : CubeForge.F32Buf.F32Buf) : Int do B.len(b) / 7 end

end
