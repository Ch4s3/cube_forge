-- Fauna — animals as small voxel bodies.
--
-- A species is a row in this table plus one 8x8x8 grid per POSE, built the
-- procedural way CubeForge.Model builds mushrooms and bushes, and greedy-meshed
-- once by Model.template. Animation is a flip-book: a few poses, chosen per
-- animal per frame. At this resolution that reads correctly and costs a
-- template lookup, where a skeleton would cost per-vertex work every frame.
--
-- Facing is NOT baked. Palm fronds bake eight directions (Model.t_frond) and
-- that is right for a thing that never turns; an animal turns continuously, and
-- eight steps snap. The yaw and the size go through the stamp instead
-- (cf_f32_stamp_xf), which is what makes "fish of multiple sizes" a column in
-- this table rather than a second set of grids.
--
-- Every grid faces +x, so yaw 0 is facing east and the stamp's rotation is the
-- animal's heading.
--
-- The bodies ride in their OWN blob, not Model's: Model's templates are stamped
-- into cells by the section mesher and ride in the World, and animals are
-- neither. They share only the palette layer, which costs nothing because the
-- texture loop already writes all 256 texels.
mod CubeForge.Fauna do

  alias CubeForge.Model as Mdl
  alias CubeForge.F32Buf as B
  alias CubeForge.Vertex as Vx

  -- ── The table ─────────────────────────────────────────────────────────────
  -- One row per species and nothing else. The two generators below build every
  -- pose from these numbers, so adding a species is adding a line -- not a
  -- grid, not a texture, not a draw call.
  --
  -- Ids are ordered so the kind is a range rather than a list: birds 1..10,
  -- fish 11..18. `is_fish` is then a comparison, and it is asked of every
  -- animal of every flock every tick.
  doc "Species ids are 1-based; 0 is no animal."
  fn count() : Int do 18 end
  doc "Ids above this are fish."
  fn last_bird() : Int do 10 end

  fn sp_grasspipit() : Int do 1 end
  fn sp_cinderfinch() : Int do 2 end
  fn sp_pinecrest() : Int do 3 end
  fn sp_frostgull() : Int do 4 end
  fn sp_marshheron() : Int do 5 end
  fn sp_ridgehawk() : Int do 6 end
  fn sp_duskowl() : Int do 7 end
  fn sp_stoneratite() : Int do 8 end
  fn sp_mossmoa() : Int do 9 end
  fn sp_brinewaddle() : Int do 10 end
  fn sp_sunfin() : Int do 11 end
  fn sp_frostshiner() : Int do 12 end
  fn sp_reedcarp() : Int do 13 end
  fn sp_shoalback() : Int do 14 end
  fn sp_kelpjaw() : Int do 15 end
  fn sp_glasseel() : Int do 16 end
  fn sp_deepmaw() : Int do 17 end
  fn sp_bladefin() : Int do 18 end

  fn name(sp : Int) : String do
    if sp == 1 do "Grasspipit" else if sp == 2 do "Cinderfinch" else if sp == 3 do "Pinecrest"
    else if sp == 4 do "Frostgull" else if sp == 5 do "Marshheron" else if sp == 6 do "Ridgehawk"
    else if sp == 7 do "Duskowl" else if sp == 8 do "Stoneratite" else if sp == 9 do "Mossmoa"
    else if sp == 10 do "Brinewaddle" else if sp == 11 do "Sunfin" else if sp == 12 do "Frostshiner"
    else if sp == 13 do "Reedcarp" else if sp == 14 do "Shoalback" else if sp == 15 do "Kelpjaw"
    else if sp == 16 do "Glasseel" else if sp == 17 do "Deepmaw" else if sp == 18 do "Bladefin"
    else "none" end end end end end end end end end end end end end end end end end end 
  end

  doc "Fish hold a depth band; birds hold a biome. The axis a species is keyed on."
  fn is_fish(sp : Int) : Bool do sp > last_bird() end

  -- ── When it is awake ──────────────────────────────────────────────────────
  doc "Activity: 0 by day, 1 by night, 2 at dawn and dusk."
  fn act_day() : Int do 0 end
  fn act_night() : Int do 1 end
  fn act_twilight() : Int do 2 end

  doc """
  When this species feeds.

  The Duskowl shares the forest with the Pinecrest and takes the night shift,
  which is what makes the day cycle read as a shift change rather than as a
  dimmer -- the forest is never empty, it is worked by different birds. The
  twilight species are the ones you have to go out at the right hour to see.
  """
  fn activity(sp : Int) : Int do
    if sp == 2 do act_twilight() else if sp == 5 do act_twilight() else if sp == 7 do act_night()
    else if sp == 9 do act_twilight() else if sp == 13 do act_twilight() else if sp == 16 do act_night()
    else if sp == 17 do act_night()
    else act_day() end end end end end end end 
  end
  doc "Feeds by night and roosts by day."
  fn nocturnal(sp : Int) : Bool do activity(sp) == act_night() end

  doc """
  Body length in blocks: the uniform scale the stamp applies. A grid is one
  block across at scale 1.

  The spread is the point. A Cinderfinch is a fifth of a block and a Mossmoa is
  over four -- twenty to one -- so a roster read at a distance is a roster of
  recognisably different animals rather than one animal in eighteen colours. The
  small end has to stay small for the large end to mean anything.
  """
  fn body_scale(sp : Int) : Float do
    if sp == 1 do 0.34 else if sp == 2 do 0.22 else if sp == 3 do 0.52
    else if sp == 4 do 0.80 else if sp == 5 do 1.55 else if sp == 6 do 1.35
    else if sp == 7 do 0.92 else if sp == 8 do 3.20 else if sp == 9 do 4.60
    else if sp == 10 do 1.10 else if sp == 11 do 0.24 else if sp == 12 do 0.26
    else if sp == 13 do 0.78 else if sp == 14 do 0.28 else if sp == 15 do 0.98
    else if sp == 16 do 2.60 else if sp == 17 do 2.70 else if sp == 18 do 3.60
    else 1.00 end end end end end end end end end end end end end end end end end end 
  end

  -- ── Niches ────────────────────────────────────────────────────────────────
  -- Every niche is keyed on a number the world already maintains, so habitat
  -- answers a shovel without a new field anywhere. Fish are keyed on DEPTH (the
  -- surface minus the bed, so digging changes it); birds on the BIOME, which
  -- the climate field already decides and the player already moves.
  --
  -- The population tick reads these; nothing else does yet.
  doc "Shallowest water this fish will hold, in blocks below the surface."
  fn depth_lo(sp : Int) : Int do
    if sp == 11 do 1 else if sp == 12 do 1 else if sp == 13 do 2
    else if sp == 14 do 3 else if sp == 15 do 4 else if sp == 16 do 14
    else if sp == 17 do 18 else if sp == 18 do 6
    else 0 end end end end end end end end 
  end

  doc "Deepest water this fish will hold. Past this it is somebody else's water."
  fn depth_hi(sp : Int) : Int do
    if sp == 11 do 4 else if sp == 12 do 5 else if sp == 13 do 6
    else if sp == 14 do 10 else if sp == 15 do 12 else if sp == 16 do 40
    else if sp == 17 do 60 else if sp == 18 do 40
    else 0 end end end end end end end end 
  end

  doc "This fish wants a small body of water -- a pond or a lake, not a sea. Biome.water_reach_at tells the two apart."
  fn wants_small_water(sp : Int) : Bool do sp == 11 || sp == 12 || sp == 13 end

  doc """
  Whether bird [sp] lives in biome [b] (CubeForge.Biome's ids).

  0 tundra, 1 taiga, 2 grassland, 3 forest, 4 desert, 5 wetland, 6 beach,
  7 alpine, 8 oasis, 9 grove.
  """
  fn wants_biome(sp : Int, b : Int) : Bool do
    if sp == 1 do b == 2 || b == 8 else if sp == 2 do b == 4 || b == 8 else if sp == 3 do b == 1 || b == 3
    else if sp == 4 do b == 6 || b == 0 else if sp == 5 do b == 5 else if sp == 6 do b == 7 || b == 0
    else if sp == 7 do b == 3 || b == 9 else if sp == 8 do b == 2 || b == 4 else if sp == 9 do b == 3 || b == 1
    else if sp == 10 do b == 6 || b == 0
    else false end end end end end end end end end end 
  end

  doc "Poses per species: wings down/mid/up for a bird, tail centre/left/right for a fish."
  fn poses() : Int do 3 end
  doc "Template id of [sp] in pose [p]."
  fn template_of(sp : Int, p : Int) : Int do (sp - 1) * poses() + p end
  fn template_count() : Int do count() * poses() end

  doc "The quads a body may greedy-mesh to. Held by a test. It moved to 3000 when the large species moved to a 128-cell grid: the biggest is a Deepmaw at 2524 quads, about 1500 triangles, which for an animal you stand next to is cheap -- and the cap exists to catch a body that has run away, not to freeze the roster."
  fn face_cap() : Int do 3000 end

  -- ── Body plans ────────────────────────────────────────────────────────────
  -- A species does not get a hand-built grid. It gets a ROW -- how long, how
  -- tall, how far the wings reach, whether it flies -- and one of two
  -- generators builds every pose from it.
  --
  -- This is not only shorter. Every part is placed against the BODY'S OWN
  -- extent, so attachment is a property of the generator rather than of each
  -- species being typed in correctly. The first hand-built pipit had its wings
  -- two cells clear of its flank, touching nothing, and flew apart. A generator
  -- cannot make that mistake once, let alone sixteen times.
  --
  -- Every plan lays the animal along +x -- tail aft, beak or snout forward --
  -- and centres it on the grid, so yaw 0 is facing east.

  doc """
  The grid THIS species is built on: 128 for the big ones, 64 for the middling,
  32 for the small.

  Eight was tried first and every animal read as a stack of slabs: at 8 an
  eighth of a block is the THINNEST THING THAT EXISTS, so a wing, a fin, a beak
  and a leg all weigh as much as the body they hang off and nothing can be
  slender. Sixteen fixed that; going further is what lets a wing be a sixtieth
  of its body and a head have enough cells to round.

  A template is normalised to a unit cube whatever grid built it, so this costs
  nothing downstream -- and it is the only honest answer to "finer, please". A
  Cinderfinch is 0.22 blocks: one of its 64 cells is already about a screen
  pixel at five blocks, and halving it again buys a subdivision nobody can
  resolve while paying for it on the commonest animal in the world. A Mossmoa is
  four blocks, you stand next to it, and one of its cells is seventeen pixels.

  Detail belongs where it is visible. This is that rule, applied at build time.
  """
  fn grid_of(sp : Int) : Int do
    if body_scale(sp) >= 2.0 do 128
    else if body_scale(sp) >= 0.7 do 64
    else 32 end end
  end
  doc "The grid template [k] was built on."
  fn grid_of_template(k : Int) : Int do grid_of(k / poses() + 1) end

  doc """
  A plan number, in cells of the current grid.

  Every row is written in 32nds -- the resolution the roster was designed at --
  and scaled here, per species. So the grid can be raised without touching
  eighteen tables,
  and the numbers that are NOT wrapped in this are the ones that should stay one
  cell however fine the grid gets: a wing's thickness, a fin's, an eye. Those
  are what actually get finer as the grid grows.
  """
  fn cells(sp : Int, n : Int) : Int do n * grid_of(sp) / 32 end

  -- Every number below is in 32-grid cells, via cells(): the plan is written at
  -- one resolution and the grid can move under it. The body starts at
  -- body_x0(sp) and the head, beak and tail are placed off its own extent, so a
  -- row only says how big the animal is, never where any of it goes.
  doc "Body length. The head takes head_len(sp) more and the beak two beyond that."
  fn plan_len(sp : Int) : Int do
    if sp == 1 do 11 else if sp == 2 do 9 else if sp == 3 do 11
    else if sp == 4 do 13 else if sp == 5 do 11 else if sp == 6 do 13
    else if sp == 7 do 9 else if sp == 8 do 13 else if sp == 9 do 15
    else if sp == 10 do 9 else if sp == 11 do 13 else if sp == 12 do 13
    else if sp == 13 do 15 else if sp == 14 do 11 else if sp == 15 do 15
    else if sp == 16 do 16 else if sp == 17 do 16 else if sp == 18 do 16
    else 11 end end end end end end end end end end end end end end end end end end 
  end

  doc "Body height."
  fn plan_tall(sp : Int) : Int do
    if sp == 1 do 7 else if sp == 2 do 7 else if sp == 3 do 9
    else if sp == 4 do 7 else if sp == 5 do 7 else if sp == 6 do 9
    else if sp == 7 do 9 else if sp == 8 do 9 else if sp == 9 do 13
    else if sp == 10 do 15 else if sp == 11 do 7 else if sp == 12 do 5
    else if sp == 13 do 9 else if sp == 14 do 5 else if sp == 15 do 9
    else if sp == 16 do 5 else if sp == 17 do 11 else if sp == 18 do 11
    else 7 end end end end end end end end end end end end end end end end end end 
  end

  doc "Body width, always centred on the grid."
  fn plan_wide(sp : Int) : Int do
    if sp == 1 do 7 else if sp == 2 do 7 else if sp == 3 do 7
    else if sp == 4 do 7 else if sp == 5 do 5 else if sp == 6 do 7
    else if sp == 7 do 9 else if sp == 8 do 7 else if sp == 9 do 9
    else if sp == 10 do 9 else if sp == 11 do 5 else if sp == 12 do 5
    else if sp == 13 do 7 else if sp == 14 do 5 else if sp == 15 do 7
    else if sp == 16 do 5 else if sp == 17 do 9 else if sp == 18 do 7
    else 7 end end end end end end end end end end end end end end end end end end 
  end

  doc """
  How far past the body's flank a wing reaches; 0 is flightless.

  Capped at body_z0(sp): a wing reaching further would have its outer cells fall
  off the grid, and put_n drops those silently, so the bird would quietly lose
  its wingtips. A soarer gets its span from a narrow body rather than a longer
  wing. A short span on an upright bird is a FLIPPER.
  """
  fn plan_wing(sp : Int) : Int do
    if sp == 1 do 9 else if sp == 2 do 7 else if sp == 3 do 9
    else if sp == 4 do 12 else if sp == 5 do 11 else if sp == 6 do 12
    else if sp == 7 do 9 else if sp == 10 do 3
    else 0 end end end end end end end end 
  end

  doc "How far above the body's back the head sits. Capped so head_y() stays on the grid, and lower again on a crested species, which builds above its own head."
  fn plan_neck(sp : Int) : Int do
    if sp == 1 do 3 else if sp == 2 do 3 else if sp == 3 do 3
    else if sp == 4 do 3 else if sp == 5 do 8 else if sp == 6 do 2
    else if sp == 7 do 2 else if sp == 8 do 8 else if sp == 9 do 5
    else if sp == 10 do 3
    else 0 end end end end end end end end end end 
  end

  doc "Tail length, aft of the body. Capped at body_x0(sp)."
  fn plan_tail(sp : Int) : Int do
    if sp == 1 do 7 else if sp == 2 do 6 else if sp == 3 do 7
    else if sp == 4 do 6 else if sp == 5 do 6 else if sp == 6 do 7
    else if sp == 7 do 6 else if sp == 8 do 4 else if sp == 9 do 4
    else if sp == 10 do 3 else if sp == 11 do 6 else if sp == 12 do 6
    else if sp == 13 do 6 else if sp == 14 do 6 else if sp == 15 do 7
    else if sp == 16 do 9 else if sp == 17 do 8 else if sp == 18 do 8
    else 6 end end end end end end end end end end end end end end end end end end 
  end

  doc """
  Stands upright: the head goes on TOP of the body rather than in front of it.

  This is the whole of what makes a penguin a penguin here. Everything else --
  short wings, legs, a dark back and a pale front -- it already had from the
  ordinary rows.
  """
  fn plan_upright(sp : Int) : Bool do sp == 10 end

  doc "Stands on legs. A bird that does not fly needs them; so does one that stands upright, whatever its wings do."
  fn plan_legs(sp : Int) : Bool do sp == 8 || sp == 9 || sp == 10 end

  doc "A raised crest along the head and a hooked beak under it: what turns a large flightless bird from a big chicken into something you would rather not startle."
  fn plan_crest(sp : Int) : Bool do sp == 9 end

  doc "Height of the dorsal fin. Three is a fish; eight is a fin you see before you see the animal."
  fn plan_dorsal(sp : Int) : Int do
    if sp == 11 do 3 else if sp == 12 do 2 else if sp == 13 do 3
    else if sp == 14 do 2 else if sp == 15 do 3 else if sp == 16 do 1
    else if sp == 17 do 3 else if sp == 18 do 8
    else 0 end end end end end end end end 
  end

  doc "Pectoral fins on the flanks. An eel has none, which is most of why it reads as an eel."
  fn plan_pectorals(sp : Int) : Bool do sp == 11 || sp == 12 || sp == 13 || sp == 14 || sp == 15 || sp == 17 || sp == 18 end

  doc "A bird that does not fly. A penguin has wings and is one of these."
  fn flightless(sp : Int) : Bool do
    if is_fish(sp) do false else plan_wing(sp) <= 0 || plan_upright(sp) end
  end

  -- The body's own extent. Every other part is placed against these, never
  -- against a literal.
  fn body_x0(sp : Int) : Int do cells(sp, 10) end
  fn body_x1(sp : Int) : Int do body_x0(sp) + cells(sp, plan_len(sp)) - 1 end
  fn body_y0(sp : Int) : Int do cells(sp, 12) end
  fn body_y1(sp : Int) : Int do body_y0(sp) + cells(sp, plan_tall(sp)) - 1 end
  fn body_z0(sp : Int) : Int do (grid_of(sp) - cells(sp, plan_wide(sp))) / 2 end
  fn body_z1(sp : Int) : Int do body_z0(sp) + cells(sp,plan_wide(sp)) - 1 end
  doc "The head's top: the body's back plus the neck."
  fn head_y(sp : Int) : Int do body_y1(sp) + cells(sp, plan_neck(sp)) end
  doc "Head length, forward of the body (or above it, standing upright)."
  fn head_len(sp : Int) : Int do cells(sp, 4) end

  doc "The one colour a species is, red channel."
  fn base_r(sp : Int) : Int do
    if sp == 1 do 150 else if sp == 2 do 196 else if sp == 3 do 86
    else if sp == 4 do 222 else if sp == 5 do 128 else if sp == 6 do 120
    else if sp == 7 do 108 else if sp == 8 do 146 else if sp == 9 do 78
    else if sp == 10 do 52 else if sp == 11 do 226 else if sp == 12 do 176
    else if sp == 13 do 150 else if sp == 14 do 140 else if sp == 15 do 92
    else if sp == 16 do 198 else if sp == 17 do 72 else if sp == 18 do 96
    else 128 end end end end end end end end end end end end end end end end end end 
  end
  fn base_g(sp : Int) : Int do
    if sp == 1 do 112 else if sp == 2 do 120 else if sp == 3 do 116
    else if sp == 4 do 228 else if sp == 5 do 140 else if sp == 6 do 96
    else if sp == 7 do 92 else if sp == 8 do 138 else if sp == 9 do 86
    else if sp == 10 do 58 else if sp == 11 do 134 else if sp == 12 do 206
    else if sp == 13 do 140 else if sp == 14 do 176 else if sp == 15 do 132
    else if sp == 16 do 206 else if sp == 17 do 84 else if sp == 18 do 108
    else 128 end end end end end end end end end end end end end end end end end end 
  end
  fn base_b(sp : Int) : Int do
    if sp == 1 do 72 else if sp == 2 do 64 else if sp == 3 do 74
    else if sp == 4 do 236 else if sp == 5 do 150 else if sp == 6 do 74
    else if sp == 7 do 110 else if sp == 8 do 120 else if sp == 9 do 60
    else if sp == 10 do 70 else if sp == 11 do 62 else if sp == 12 do 226
    else if sp == 13 do 70 else if sp == 14 do 200 else if sp == 15 do 88
    else if sp == 16 do 214 else if sp == 17 do 112 else if sp == 18 do 124
    else 128 end end end end end end end end end end end end end end end end end end 
  end

  -- ── Colour ────────────────────────────────────────────────────────────────
  -- A species gets ONE colour. Its shading and its underside are derived, so
  -- sixteen species are sixteen lines rather than forty-eight, and no two of
  -- them can drift out of key with each other.
  doc "First palette texel of the fauna range. Model owns 0..30; CubeForge.Texture fills this range from here."
  fn palette_base() : Int do 32 end
  doc "Palette texels the fauna range takes: three a species."
  fn palette_span() : Int do 3 * count() end
  doc "Palette texel of species [sp]'s body colour; +1 is its shading, +2 its underside."
  fn c_body(sp : Int) : Int do palette_base() + 3 * (sp - 1) end
  fn c_dark(sp : Int) : Int do c_body(sp) + 1 end
  fn c_pale(sp : Int) : Int do c_body(sp) + 2 end
  -- The accent is the beak or snout. A bird's is dark and reads as a beak; a
  -- fish's is its own colour, because the eye is the only black a fish should
  -- have and a black snout beside a black eye is just a hole in the head.
  fn c_accent(sp : Int) : Int do if is_fish(sp) do c_body(sp) else Mdl.c_beak() end end

  pfn shade_of(v : Int) : Int do v * 62 / 100 end
  pfn pale_of(v : Int) : Int do v + (255 - v) * 65 / 100 end
  doc "Red of fauna palette slot [k], 0 .. palette_span() - 1. CubeForge.Texture writes these into the model palette layer."
  fn palette_r(k : Int) : Int do
    let sp = k / 3 + 1
    let which = k % 3
    if which == 0 do base_r(sp) else if which == 1 do shade_of(base_r(sp)) else pale_of(base_r(sp)) end end
  end
  fn palette_g(k : Int) : Int do
    let sp = k / 3 + 1
    let which = k % 3
    if which == 0 do base_g(sp) else if which == 1 do shade_of(base_g(sp)) else pale_of(base_g(sp)) end end
  end
  fn palette_b(k : Int) : Int do
    let sp = k / 3 + 1
    let which = k % 3
    if which == 0 do base_b(sp) else if which == 1 do shade_of(base_b(sp)) else pale_of(base_b(sp)) end end
  end

  -- ── The generators ────────────────────────────────────────────────────────
  -- Every box goes through here, so the species' own grid is applied in exactly
  -- one place. It read grid() -- a fixed 64 -- while the small species were
  -- being built on 32-cell grids, and wrote past the end of them.
  pfn bx(g : NativeU8Arr, sp : Int, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int, k : Int) : NativeU8Arr do
    Mdl.box_n(g, grid_of(sp), x0, y0, z0, x1, y1, z1, k)
  end

  -- ── The body ──────────────────────────────────────────────────────────────
  -- Built a SLICE at a time along its length, each slice drawn in from the full
  -- extent by a profile: fat through the middle, narrowing to the tail and
  -- rounded at the nose.
  --
  -- It was a box with its corners shaved before, and it read as a box with its
  -- corners shaved. Note what this is not: it is not a finer grid. At 64 cells a
  -- Cinderfinch's cell is about a screen pixel at five blocks, so resolution has
  -- nothing left to give -- the largest body is 301 quads, some six hundred
  -- triangles, which is an order of magnitude under what the frame can carry.
  -- The shapes were the limit, not the cells.
  doc "How far slice [t] of the body is drawn in from its full extent, in cells."
  fn taper_at(sp : Int, t : Int) : Int do
    let len = cells(sp, plan_len(sp))
    -- a fish draws in hard at the tail: that narrow waist before the fin is
    -- most of what makes a fish look like it swims
    let rear = if is_fish(sp) do cells(sp, 3) else cells(sp, 3) end
    let nose = cells(sp, 2)
    let rear_run = if len / 3 < 1 do 1 else len / 3 end
    let nose_run = if len / 4 < 1 do 1 else len / 4 end
    let d = if t < rear_run do rear - rear * t / rear_run
            else if t >= len - nose_run do nose * (t - (len - nose_run) + 1) / nose_run
            else 0 end end
    -- never draw in past the middle, or the slice inverts and box_n fills the
    -- box between the two bounds -- a WIDER slice than asked for
    let cap = (cells(sp, plan_wide(sp)) - 1) / 2
    if d > cap do cap else d end
  end
  doc """
  Bodies at or above this size get a ROUNDED cross-section; smaller ones stay
  square.

  Not a compromise -- a measurement. A Cinderfinch is 0.22 blocks, so one of its
  64 cells is about a screen pixel at five blocks: nothing about its silhouette
  can be seen, and rounding it costs quads on every animal of the commonest
  species. A Mossmoa is four blocks and you stand next to it.
  """
  fn round_cross(sp : Int) : Bool do body_scale(sp) >= 0.7 end

  -- One slice as a stack of rows, each row's width taken from an ellipse. This
  -- is the detail that matters: the taper above narrows a body along its
  -- LENGTH, and does nothing at all for the angle you meet an animal from --
  -- head on, where a body of stacked boxes is a rectangle.
  -- The underside is a COLOUR on the body's own lowest rows, not a slab hung
  -- beneath it. As a slab it was invisible under a square body and a rectangle
  -- sticking out under a rounded one.
  pfn under_colour(sp : Int, all_pale : Bool, ylo : Int, y : Int) : Int do
    if all_pale do c_pale(sp)
    else if y <= ylo + cells(sp, 1) do c_pale(sp)
    else c_body(sp) end end
  end
  pfn slice_rows(g : NativeU8Arr, sp : Int, x : Int, ylo : Int, yhi : Int, d : Int, all_pale : Bool, y : Int) : NativeU8Arr do
    if y > yhi do g
    else
      let ry = (yhi - ylo) / 2
      let rz = (body_z1(sp) - body_z0(sp)) / 2 - d
      let yc = (ylo + yhi) / 2
      let f = if ry <= 0 do 0.0 else int_to_float(y - yc) /. int_to_float(ry) end
      let q = 1.0 -. f *. f
      let k = Math.sqrt(if q < 0.0 do 0.0 else q end)
      let zi = rz - float_to_int(int_to_float(rz) *. k +. 0.5)
      slice_rows(bx(g, sp, x, y, body_z0(sp) + d + zi, x, y, body_z1(sp) - d - zi, under_colour(sp, all_pale, ylo, y)),
                 sp, x, ylo, yhi, d, all_pale, y + 1)
    end
  end

  doc """
  How far the body's surface is drawn in at slice [t], row [y]: the taper along
  its length plus the ellipse across it.

  Appendages attach against THIS, not against the nominal extent. A wing hung
  off body_z0 was flush with a square body and a cell or two clear of a rounded
  one -- and the rounded body is the whole point of the detail work.
  """
  fn inset_at(sp : Int, t : Int, y : Int) : Int do
    let d = taper_at(sp, t)
    if !round_cross(sp) do d
    else
      let dy = d / 2
      let ylo = body_y0(sp) + dy
      let yhi = body_y1(sp) - dy
      if y < ylo do d
      else if y > yhi do d
      else
        let ry = (yhi - ylo) / 2
        let rz = (body_z1(sp) - body_z0(sp)) / 2 - d
        let yc = (ylo + yhi) / 2
        let f = if ry <= 0 do 0.0 else int_to_float(y - yc) /. int_to_float(ry) end
        let q = 1.0 -. f *. f
        let k = Math.sqrt(if q < 0.0 do 0.0 else q end)
        d + rz - float_to_int(int_to_float(rz) *. k +. 0.5)
      end end
    end
  end
  doc "The body's -z surface at world slice [x], row [y]."
  fn edge_z0(sp : Int, x : Int, y : Int) : Int do body_z0(sp) + inset_at(sp, x - body_x0(sp), y) end
  doc "The body's +z surface at world slice [x], row [y]."
  fn edge_z1(sp : Int, x : Int, y : Int) : Int do body_z1(sp) - inset_at(sp, x - body_x0(sp), y) end
  doc "The body's top row at slice [t]: body_y1 less the taper. A part that starts at body_y1 itself starts above a tapered nose and hangs there."
  fn body_top_at(sp : Int, t : Int) : Int do body_y1(sp) - taper_at(sp, t) / 2 end
  doc "The body's bottom row at slice [t]."
  fn body_bot_at(sp : Int, t : Int) : Int do body_y0(sp) + taper_at(sp, t) / 2 end

  doc "The row where the body is widest: where anything hung off it meets the most of it."
  fn waist_y(sp : Int) : Int do (body_y0(sp) + body_y1(sp)) / 2 end

  pfn body_go(g : NativeU8Arr, sp : Int, t : Int) : NativeU8Arr do
    if t >= cells(sp, plan_len(sp)) do g
    else
      let d = taper_at(sp, t)
      -- the vertical draw-in is half the horizontal, so a body flattens toward
      -- its ends rather than coming to a needle
      let dy = d / 2
      let x = body_x0(sp) + t
      let ylo = body_y0(sp) + dy
      let yhi = body_y1(sp) - dy
      -- an upright bird's pale side is its FRONT, not its underside: that is
      -- what a penguin's white is
      let all_pale = if plan_upright(sp) do t >= cells(sp, plan_len(sp)) - cells(sp, 3) else false end
      let g1 = if round_cross(sp) do slice_rows(g, sp, x, ylo, yhi, d, all_pale, ylo)
               else
                 let gb = bx(g, sp, x, ylo, body_z0(sp) + d, x, yhi, body_z1(sp) - d, c_body(sp))
                 bx(gb, sp, x, ylo, body_z0(sp) + d, x, ylo + cells(sp, 1), body_z1(sp) - d, under_colour(sp, all_pale, ylo, ylo))
               end
      body_go(g1, sp, t + 1)
    end
  end
  -- and the long edges shaved, which rounds what the taper leaves square
  pfn round_body(g : NativeU8Arr, sp : Int) : NativeU8Arr do
    let x0 = body_x0(sp)
    let x1 = body_x1(sp)
    let z0 = body_z0(sp)
    let z1 = body_z1(sp)
    let y0 = body_y0(sp)
    let y1 = body_y1(sp)
    let r = cells(sp, 1)
    let g1 = bx(bx(g, sp, x0, y1 - r + 1, z0, x1, y1, z0 + r - 1, 0), sp, x0, y1 - r + 1, z1 - r + 1, x1, y1, z1, 0)
    bx(bx(g1, sp, x0, y0, z0, x1, y0 + r - 1, z0 + r - 1, 0), sp, x0, y0, z1 - r + 1, x1, y0 + r - 1, z1, 0)
  end

  -- The head, built the same way as the body: slices narrowing toward the face,
  -- with the crown drawn in as well. A box with two corners knocked off is what
  -- it was, and a head is the part a player actually looks at.
  -- Rows of one head slice, from the same ellipse the body uses. A rounded body
  -- under a boxed head is worse than either: the head is the part a player
  -- actually looks at.
  pfn head_rows(g : NativeU8Arr, sp : Int, x : Int, ylo : Int, yhi : Int, z0 : Int, z1 : Int, eyeslice : Bool, ey : Int, y : Int) : NativeU8Arr do
    if y > yhi do g
    else
      let ry = (yhi - ylo) / 2
      let rz = (z1 - z0) / 2
      let yc = (ylo + yhi) / 2
      let f = if ry <= 0 do 0.0 else int_to_float(y - yc) /. int_to_float(ry) end
      let q = 1.0 -. f *. f
      let k = Math.sqrt(if q < 0.0 do 0.0 else q end)
      let zi = rz - float_to_int(int_to_float(rz) *. k +. 0.5)
      let g1 = bx(g, sp, x, y, z0 + zi, x, y, z1 - zi, c_body(sp))
      -- The eye is the OUTERMOST CELL of this row, not a cell stuck to the side
      -- of the head. Stuck on, it sat at the body's flank while the head had
      -- tapered in past it, and floated clear -- and as a surface cell it costs
      -- no geometry and cannot come off.
      let g2 = if eyeslice && y == ey do Mdl.put_n(Mdl.put_n(g1, grid_of(sp), x, y, z0 + zi, Mdl.c_eye()), grid_of(sp), x, y, z1 - zi, Mdl.c_eye()) else g1 end
      head_rows(g2, sp, x, ylo, yhi, z0, z1, eyeslice, ey, y + 1)
    end
  end
  pfn head_go(g : NativeU8Arr, sp : Int, hx0 : Int, hx1 : Int, hy0 : Int, hy : Int, ex : Int, ey : Int, t : Int) : NativeU8Arr do
    let n = hx1 - hx0 + 1
    if t >= n do g
    else
      let span = if n <= 1 do 1 else n - 1 end
      let d = cells(sp, 1) * t / span
      let z0 = body_z0(sp) + cells(sp, 2) + d
      let z1 = body_z1(sp) - cells(sp, 2) - d
      -- the crown comes down toward the face; the jaw does not, or the head
      -- would come to a point in the wrong place
      let ylo = hy0 + d / 2
      let yhi = hy - d
      let x = hx0 + t
      let g1 = if round_cross(sp) do head_rows(g, sp, x, ylo, yhi, z0, z1, x == ex, ey, ylo)
               else
                 let gb = bx(g, sp, x, ylo, z0, x, yhi, z1, c_body(sp))
                 if x == ex do Mdl.put_n(Mdl.put_n(gb, grid_of(sp), x, ey, z0, Mdl.c_eye()), grid_of(sp), x, ey, z1, Mdl.c_eye()) else gb end
               end
      head_go(g1, sp, hx0, hx1, hy0, hy, ex, ey, t + 1)
    end
  end

  -- A crest along the head and a hook under the beak. Two small shapes, and
  -- between them the difference between a big flightless bird and one you would
  -- rather not startle.
  pfn crest(g : NativeU8Arr, sp : Int, bx0 : Int, bx1 : Int, hy : Int) : NativeU8Arr do
    if !plan_crest(sp) do g
    else
      let zc = (body_z0(sp) + body_z1(sp)) / 2
      let g1 = bx(g, sp, bx0, hy + 1, zc, bx1, hy + cells(sp, 2), zc, c_dark(sp))
      -- and a hook: the beak tip turned down
      bx(g1, sp, bx1 + cells(sp, 2), hy - cells(sp, 5), zc - cells(sp, 1) + 1, bx1 + cells(sp, 2), hy - cells(sp, 3), zc + cells(sp, 1) - 1, c_dark(sp))
    end
  end

  -- The trunk every plan starts from: body, underside, head, beak and eyes.
  -- An UPRIGHT bird puts its head on top of the body instead of in front of it,
  -- and that single branch is the whole of what makes a penguin.
  pfn trunk(sp : Int) : NativeU8Arr do
    let x0 = body_x0(sp)
    let x1 = body_x1(sp)
    let z0 = body_z0(sp)
    let z1 = body_z1(sp)
    let y0 = body_y0(sp)
    let y1 = body_y1(sp)
    let hy = head_y(sp)
    let up = plan_upright(sp)
    let g0 = round_body(body_go(Mdl.empty_n(grid_of(sp)), sp, 0), sp)
    -- a pale underside, inset so it is a belly and not a stripe. Standing
    -- upright it is a FRONT rather than a belly, which is what a penguin is.
    let g1 = g0
    -- the head: narrower than the body, forward of it -- or above it
    let hx0 = if up do x1 - head_len(sp) + 1 else x1 + 1 end
    let hx1 = if up do x1 else x1 + head_len(sp) end
    let hy0 = if up do y1 + 1 else hy - cells(sp, 4) end
    let g2 = head_go(g1, sp, hx0, hx1, hy0, hy, hx1 - cells(sp, 1), hy - cells(sp, 2), 0)
    -- and the back of the crown knocked off, so the skull is not a brick
    let g3 = bx(g2, sp, hx0, hy, z0 + cells(sp, 2), hx0 + cells(sp, 1) - 1, hy, z1 - cells(sp, 2), 0)
    -- a neck fills the step up to a raised head, so nothing is left hanging
    -- The neck runs from the body's TOP AT ITS LAST SLICE, not from body_y1:
    -- the nose has tapered down by then, so a neck starting at the nominal top
    -- began a cell or two above the body and hung there.
    let g4 = if plan_neck(sp) > 0 do
               bx(g3, sp, hx0, body_top_at(sp, cells(sp, plan_len(sp)) - 1), z0 + cells(sp, 2), hx0 + cells(sp, 2), hy, z1 - cells(sp, 2), c_body(sp))
             else g3 end
    -- the beak or snout, forward of the head and thinner than it
    let g5 = bx(g4, sp, hx1 + 1, hy - cells(sp, 3), z0 + cells(sp, 3), hx1 + cells(sp, 2), hy - cells(sp, 2), z1 - cells(sp, 3), c_accent(sp))
    crest(g5, sp, hx0, hx1, hy)
  end

  -- ── Birds ─────────────────────────────────────────────────────────────────
  -- A wing is built outward from the flank a cell at a time, so cell n always
  -- shares a face with cell n - 1, and cell 1 with the body. It is ONE cell
  -- thick whatever the grid is -- a sixtieth of the body it hangs off at this
  -- resolution, where at sixteen it was a fifteenth and read as a plank.
  --
  -- The flap bends it progressively; a cell stepping in both z and y at once
  -- would meet its neighbour along an edge, so each column spans from the last
  -- height to its own.
  -- The shoulder sits at the body's widest row, which is where a wing meets the
  -- most of it; a rounded body is drawn in everywhere else.
  pfn wing_y(sp : Int, p : Int, out : Int) : Int do
    if p == 1 do waist_y(sp)
    else if p == 0 do waist_y(sp) - out / 3
    else waist_y(sp) + out / 3 end end
  end
  -- A wing tapers: full length at the shoulder, shorter at the tip. On a short
  -- body with a long span the two ends of the taper meet, and past that they
  -- would cross, so the far end is held at the near one and the tip stays one
  -- cell rather than reversing.
  pfn wing_front(sp : Int, out : Int) : Int do body_x0(sp) + out / 2 end
  pfn wing_back(sp : Int, out : Int) : Int do
    let b = body_x1(sp) - 1 - out / 3
    if b < wing_front(sp, out) do wing_front(sp, out) else b end
  end
  -- One wing column, laid a slice at a time so its inner edge follows the
  -- body's surface rather than a straight line the body has curved away from.
  pfn wing_col_go(g : NativeU8Arr, sp : Int, ylo : Int, yhi : Int, out : Int, k : Int, x : Int, xhi : Int, pzl : Int, pzr : Int) : NativeU8Arr do
    if x > xhi do g
    else
      -- The surface is read at the WAIST -- the body's widest row -- and not at
      -- this column's own row. Reading it per row looked more careful and was
      -- the bug: when the flap's ramp steps to a new row, two neighbouring
      -- columns reference two different surface positions, drift apart by more
      -- than a cell, and the wingtip comes off. One reference row means
      -- consecutive columns always differ by exactly one.
      let zl = edge_z0(sp, x, waist_y(sp)) - out
      let zr = edge_z1(sp, x, waist_y(sp)) + out
      -- and each cell still spans from the LAST slice's z to its own, since the
      -- taper along the body's length steps too
      let g1 = bx(g, sp, x, ylo, pzl, x, yhi, zl, k)
      wing_col_go(bx(g1, sp, x, ylo, pzr, x, yhi, zr, k), sp, ylo, yhi, out, k, x + 1, xhi, zl, zr)
    end
  end
  pfn wing_col_start(g : NativeU8Arr, sp : Int, ylo : Int, yhi : Int, out : Int, k : Int, xlo : Int, xhi : Int) : NativeU8Arr do
    wing_col_go(g, sp, ylo, yhi, out, k, xlo, xhi, edge_z0(sp, xlo, waist_y(sp)) - out, edge_z1(sp, xlo, waist_y(sp)) + out)
  end
  pfn wing_go(g : NativeU8Arr, sp : Int, p : Int, out : Int, span : Int) : NativeU8Arr do
    if out > span do g
    else
      let y = wing_y(sp, p, out)
      let yp = wing_y(sp, p, out - 1)
      -- the outer third of the span is the dark primaries
      let k = if out * 3 > span * 2 do c_dark(sp) else c_body(sp) end
      let ylo = if y < yp do y else yp end
      let yhi = if y < yp do yp else y end
      wing_go(wing_col_start(g, sp, ylo, yhi, out, k, wing_front(sp, out), wing_back(sp, out)), sp, p, out + 1, span)
    end
  end

  -- A flipper is a wing that gave up: a thin plate down the flank of an upright
  -- body, angling back as it goes out. The pose still moves it, so a penguin
  -- still paddles.
  pfn flipper_go(g : NativeU8Arr, sp : Int, p : Int, out : Int, span : Int) : NativeU8Arr do
    if out > span do g
    else
      let lean = if p == 1 do 0 else if p == 0 do 0 - out else out end end
      let top = body_y1(sp) - cells(sp, 3) + lean
      let bot = body_y0(sp) + cells(sp, 3) + lean
      let x0 = body_x1(sp) - cells(sp, 4)
      let x1 = body_x1(sp) - cells(sp, 1)
      let k = if out * 2 > span do c_dark(sp) else c_body(sp) end
      flipper_go(wing_col_start(g, sp, bot, top, out, k, x0, x1), sp, p, out + 1, span)
    end
  end

  -- A bird's tail: a flat fan, wider than the body and one cell thick.
  pfn bird_tail(g : NativeU8Arr, sp : Int) : NativeU8Arr do
    let t = cells(sp, plan_tail(sp))
    let y = body_y0(sp) + cells(sp, 2)
    let zc = (body_z0(sp) + body_z1(sp)) / 2
    let g1 = bx(g, sp, body_x0(sp) - t, y, body_z0(sp) - cells(sp, 1), body_x0(sp) - 1, y, body_z1(sp) + cells(sp, 1), c_dark(sp))
    -- notched down the middle: a fan with a fork in it reads as a tail, and a
    -- rectangle reads as a plank
    bx(g1, sp, body_x0(sp) - t, y, zc, body_x0(sp) - t + t / 3, y, zc, 0)
  end
  -- Legs: from the floor to the body itself, not to where the belly would be.
  -- Stopping short of the body and letting the underside bridge the gap works
  -- for every bird that HAS an underside -- and an upright bird has a front
  -- instead, so its legs hung in the air a few cells below it.
  pfn legs(g : NativeU8Arr, sp : Int) : NativeU8Arr do
    let z0 = body_z0(sp)
    let z1 = body_z1(sp)
    let fx = body_x0(sp) + cells(sp, 3)
    let ax = body_x1(sp) - cells(sp, 3)
    -- an upright bird is low-slung and stands on its feet, not on stilts, so its
    -- legs are twice the thickness of a ratite's over the same drop
    let w = if plan_upright(sp) do cells(sp, 2) else cells(sp, 1) end
    -- Legs straddle the body's CENTRE LINE, not its flanks. A rounded body's
    -- lowest row is a single cell at the centre, so a leg under the flank had
    -- nothing above it -- and a bird's legs are under its middle anyway.
    let zc = (z0 + z1) / 2
    -- and legs to the body's underside at THEIR slice, for the same reason
    -- a stance, not a single column: at a fine grid two legs one cell apart
    -- merge into one thick post
    let gap = cells(sp, 2)
    -- The leg runs a little way UP INTO the body rather than stopping at its
    -- underside. A rounded body's bottom row is a few cells wide, so a leg set
    -- out to a stance stopped beside it rather than under it; buried, it cannot
    -- miss, and the buried part is not visible from anywhere.
    let ftop = body_bot_at(sp, fx - body_x0(sp)) + cells(sp, 3)
    let atop = body_bot_at(sp, ax - body_x0(sp)) + cells(sp, 3)
    let g1 = bx(g, sp, fx, 0, zc - gap - w, fx + w, ftop, zc - gap, c_dark(sp))
    let g2 = bx(g1, sp, ax, 0, zc + gap, ax + w, atop, zc + gap + w, c_dark(sp))
    -- feet: a plate forward of each leg, so the bird stands rather than balances
    let g3 = bx(g2, sp, fx, 0, zc - gap - w, fx + cells(sp, 3), 0, zc - gap, c_dark(sp))
    bx(g3, sp, ax, 0, zc + gap, ax + cells(sp, 3), 0, zc + gap + w, c_dark(sp))
  end

  doc "A bird of species [sp] in pose [p]: 0 wings down, 1 level, 2 up. An upright bird paddles its flippers instead, and a flightless one just walks."
  fn bird(sp : Int, p : Int) : NativeU8Arr do
    let g0 = if plan_upright(sp) do trunk(sp) else bird_tail(trunk(sp), sp) end
    let span = cells(sp, plan_wing(sp))
    let g1 = if span <= 0 do g0
             else if plan_upright(sp) do flipper_go(g0, sp, p, 1, span)
             else wing_go(g0, sp, p, 1, span) end end
    if plan_legs(sp) do legs(g1, sp) else g1 end
  end

  -- ── Fish ──────────────────────────────────────────────────────────────────
  -- The tail is a tall thin blade that sweeps across the poses, built from the
  -- body's aft cell outward and offset at most one cell in z a step, so a full
  -- sweep is a connected tail rather than a fin swimming alongside.
  pfn sweep(p : Int, step : Int) : Int do
    if p == 0 do 0 else if p == 1 do 0 - (step + 1) / 2 else (step + 1) / 2 end end
  end
  pfn tailfin_go(g : NativeU8Arr, sp : Int, p : Int, step : Int, span : Int) : NativeU8Arr do
    if step > span do g
    else
      let zmid = (body_z0(sp) + body_z1(sp)) / 2
      let zc = zmid + sweep(p, step)
      let zp = zmid + sweep(p, step - 1)
      -- the blade deepens toward the tip, by half a cell a step
      let spread = (step + 1) / 2
      let g1 = bx(g, sp, body_x0(sp) - step, body_y0(sp) - spread, zc, body_x0(sp) - step, body_y1(sp) + spread, zc, c_dark(sp))
      -- and spans back to where the last cell was, so the sweep stays joined
      let g2 = bx(g1, sp, body_x0(sp) - step, body_y0(sp), zp, body_x0(sp) - step, body_y1(sp), zc, c_dark(sp))
      tailfin_go(g2, sp, p, step + 1, span)
    end
  end
  -- Pectoral fins: one cell thick, on the flanks behind the head, swept back.
  -- An eel has none, which is most of why an eel reads as an eel.
  pfn pectorals(g : NativeU8Arr, sp : Int) : NativeU8Arr do
    if !plan_pectorals(sp) do g
    else
      let x = body_x1(sp) - cells(sp, 3)
      -- at the widest row, and against the surface: hung off the nominal flank
      -- they floated a cell or two clear of a rounded body
      wing_col_start(g, sp, waist_y(sp) - cells(sp, 1), waist_y(sp), 1, c_dark(sp), x - cells(sp, 3), x)
    end
  end

  -- The dorsal fin, one cell thick, built a layer at a time with its LEADING
  -- edge swept back: the trailing edge stays over the tail and the front of the
  -- fin recedes as it rises. A rectangle of the same height reads as a sail; a
  -- swept one reads as a shark, and it is the same eight cells either way.
  pfn dorsal_go(g : NativeU8Arr, sp : Int, zc : Int, j : Int, d : Int) : NativeU8Arr do
    if j >= d do g
    else
      let xb = body_x0(sp) + cells(sp, 3)
      let xf = body_x1(sp) - cells(sp, 4) - j * cells(sp, 1)
      if xf < xb do g
      else dorsal_go(bx(g, sp, xb, body_y1(sp) + 1 + j, zc, xf, body_y1(sp) + 1 + j, zc, c_dark(sp)), sp, zc, j + 1, d) end
    end
  end

  doc "A fish of species [sp] in pose [p]: 0 tail centred, 1 swept to -z, 2 swept to +z."
  fn fish(sp : Int, p : Int) : NativeU8Arr do
    let zc = (body_z0(sp) + body_z1(sp)) / 2
    tailfin_go(pectorals(dorsal_go(trunk(sp), sp, zc, 0, cells(sp, plan_dorsal(sp))), sp), sp, p, 1, cells(sp, plan_tail(sp)))
  end

  doc "The grid for template id [k]."
  fn shape(k : Int) : NativeU8Arr do
    let sp = k / poses() + 1
    let p = k % poses()
    if is_fish(sp) do fish(sp, p) else bird(sp, p) end
  end

  -- ── The bodies, greedy-meshed once ────────────────────────────────────────
  -- A float blob and template_count() + 1 offsets into it. Model.Templates
  -- carries a texture-layer table this has no use for, so this is its own type.
  type Poses = Poses(NativeF32Arr, NativeIntArr)

  pfn build_go(k : Int, blob : CubeForge.F32Buf.F32Buf, offs : NativeIntArr) : Poses do
    if k >= template_count() do
      Poses(B.storage(blob), NativeArray.set_int(offs, template_count(), B.len(blob)))
    else
      let n = B.len(blob)
      build_go(k + 1, B.append(blob, Mdl.template_n(shape(k), grid_of_template(k))), NativeArray.set_int(offs, k, n))
    end
  end
  doc "Build every body. Done once, with the world."
  fn build() : Poses do build_go(0, B.new(8192), NativeArray.make_int(template_count() + 1, 0)) end

  fn blob(s : Poses) : NativeF32Arr do match s do Poses(d, _) -> d end end
  doc "First float of template [k] in the blob."
  fn offset(s : Poses, k : Int) : Int do match s do Poses(_, o) -> NativeArray.get_int(o, k) end end
  doc "Floats in template [k]."
  fn floats(s : Poses, k : Int) : Int do match s do Poses(_, o) -> NativeArray.get_int(o, k + 1) - NativeArray.get_int(o, k) end end
  doc "Quads in template [k]."
  fn faces(s : Poses, k : Int) : Int do floats(s, k) / (6 * Vx.floats()) end

  doc """
  Quads across every body, and the biggest single one.

  Worth printing because the intuition is wrong: a finer grid does NOT cost
  more polygons. The greedy pass merges flat faces, so the same shape at twice
  the resolution meshes to the SAME quads -- only detail that is actually added
  costs anything, and only detail buys anything.
  """
  fn stats() : String do
    let s = build()
    stats_go(s, 0, 0, 0)
  end
  pfn stats_go(s : Poses, k : Int, total : Int, worst : Int) : String do
    if k >= template_count() do
      "fauna: " ++ int_to_string(template_count()) ++ " bodies on " ++ int_to_string(grid_of(1))
        ++ "/" ++ int_to_string(grid_of(4)) ++ "/" ++ int_to_string(grid_of(9)) ++ "-cell grids by size, "
        ++ int_to_string(total) ++ " quads total, " ++ int_to_string(worst) ++ " in the largest"
    else
      let f = faces(s, k)
      stats_go(s, k + 1, total + f, if f > worst do f else worst end)
    end
  end

  doc "A number over every float of template [k]: what tells two poses apart when their quad counts happen to match."
  fn blob_hash(s : Poses, k : Int) : Int do bh_go(blob(s), offset(s, k), offset(s, k) + floats(s, k), 2166136261) end
  pfn bh_go(d : NativeF32Arr, i : Int, stop : Int, acc : Int) : Int do
    if i >= stop do acc
    else bh_go(d, i + 1, stop, int_and(acc * 16777619 + float_to_int(NativeArray.get_f32(d, i) *. 256.0), 1073741823))
    end
  end

  -- ── Drawing ───────────────────────────────────────────────────────────────
  doc "Mesh slot for the fauna buffer. 192..243 are free; the chunk meshes end at 191 and the overlays start at 244."
  fn slot() : Int do 243 end

  doc "Stamp species [sp] in pose [p] with its CENTRE at (x, y, z), heading [yaw] radians (0 is +x), at [shade] (Vertex.pack_shade), at an explicit size."
  fn stamp_s(b : CubeForge.F32Buf.F32Buf, s : Poses, sp : Int, p : Int, x : Float, y : Float, z : Float, yaw : Float, shade : Float, scale : Float) : CubeForge.F32Buf.F32Buf do
    let k = template_of(sp, p)
    B.stamp_xf(b, blob(s), offset(s, k), floats(s, k), x, y, z, shade, Math.cos(yaw), Math.sin(yaw), scale)
  end

  doc "stamp_s at the species' own size."
  fn stamp(b : CubeForge.F32Buf.F32Buf, s : Poses, sp : Int, p : Int, x : Float, y : Float, z : Float, yaw : Float, shade : Float) : CubeForge.F32Buf.F32Buf do
    stamp_s(b, s, sp, p, x, y, z, yaw, shade, body_scale(sp))
  end

  doc "Vertices in the buffer."
  fn vertex_count(b : CubeForge.F32Buf.F32Buf) : Int do B.len(b) / Vx.floats() end

  -- ── The demo flock (slice 1) ──────────────────────────────────────────────
  -- A circling flock and a circling school, driven by nothing but the clock:
  -- enough to prove the stamp, the yaw, the poses and the slot before any AI
  -- exists to be blamed for what they do. CF_FAUNA_DEMO.
  fn demo_birds() : Int do 8 end
  fn demo_fish() : Int do 6 end
  fn tau() : Float do 6.283185307 end

  -- The wing goes down, level, up, level: a three-pose grid read as four steps,
  -- so the flap has no jump back to the bottom.
  pfn flap_pose(step : Int) : Int do
    let s = step % 4
    if s == 0 do 0 else if s == 1 do 1 else if s == 2 do 2 else 1 end end end
  end
  -- The clock is never negative in practice; a negative reads as the first step
  -- rather than as a negative modulus.
  pfn wrap_step(v : Float) : Int do
    let f = float_to_int(Math.floor(v))
    if f < 0 do 0 else f end
  end

  pfn birds_go(b : CubeForge.F32Buf.F32Buf, s : Poses, cx : Float, cy : Float, cz : Float, t : Float, i : Int) : CubeForge.F32Buf.F32Buf do
    if i >= demo_birds() do b
    else
      let phase = int_to_float(i) *. tau() /. int_to_float(demo_birds())
      let a = t *. 0.5 +. phase
      let r = 7.0
      let x = cx +. r *. Math.cos(a)
      let z = cz +. r *. Math.sin(a)
      -- a slow bob, out of step with the circle so the flock is not a disc
      let y = cy +. 9.0 +. 1.5 *. Math.sin(t *. 1.3 +. phase *. 2.0)
      birds_go(stamp(b, s, sp_grasspipit(), flap_pose(wrap_step(t *. 6.0 +. int_to_float(i) *. 0.7)),
                     x, y, z, a +. tau() /. 4.0, Vx.pack_shade(1.0, 0.0)), s, cx, cy, cz, t, i + 1)
    end
  end

  pfn fish_go(b : CubeForge.F32Buf.F32Buf, s : Poses, cx : Float, cy : Float, cz : Float, t : Float, i : Int) : CubeForge.F32Buf.F32Buf do
    if i >= demo_fish() do b
    else
      let phase = int_to_float(i) *. tau() /. int_to_float(demo_fish())
      let a = t *. 0.35 +. phase
      let r = 2.5
      let x = cx +. r *. Math.cos(a)
      let z = cz +. r *. Math.sin(a)
      let y = cy +. 0.4 *. Math.sin(t *. 0.9 +. phase)
      -- the tail sweeps left, centre, right, centre: the same four-step read
      fish_go(stamp(b, s, sp_sunfin(), flap_pose(wrap_step(t *. 5.0 +. int_to_float(i) *. 0.9)),
                    x, y, z, a +. tau() /. 4.0, Vx.pack_shade(1.0, 0.0)), s, cx, cy, cz, t, i + 1)
    end
  end

  doc "How far ahead of the eye the demo school swims."
  fn demo_ahead() : Float do 7.0 end

  doc "How large a specimen is drawn: big enough to read a silhouette from, whatever the species' real size."
  fn specimen_scale() : Float do 2.0 end
  doc "How far ahead a specimen stands."
  fn specimen_ahead() : Float do 15.0 end

  doc "The pose a specimen stands in: level for a bird, tail centred for a fish."
  fn rest_pose(sp : Int) : Int do if is_fish(sp) do 0 else 1 end end
  doc "Specimens across a row."
  fn specimen_cols() : Int do 6 end

  pfn specimen_go(b : CubeForge.F32Buf.F32Buf, s : Poses, cx : Float, cy : Float, cz : Float, fx : Float, fz : Float, i : Int) : CubeForge.F32Buf.F32Buf do
    if i >= count() do b
    else
      let sp = i + 1
      -- birds on the top row, fish below, in the order the table lists them
      let across = (int_to_float(i % specimen_cols()) -. int_to_float(specimen_cols() - 1) /. 2.0) *. 3.6
      let up = 7.2 -. int_to_float(i / specimen_cols()) *. 3.6
      specimen_go(stamp_s(b, s, sp, rest_pose(sp),
                          cx +. specimen_ahead() *. fx -. across *. fz,
                          cy +. up,
                          cz +. specimen_ahead() *. fz +. across *. fx,
                          -- Three quarters on, not broadside. Side-on shows the
                          -- profile and hides the wings entirely -- they run
                          -- across the body, so they are edge-on and a pixel
                          -- wide -- and the wingspan is the thing most worth
                          -- looking at on a bird.
                          Math.atan2(fx, 0.0 -. fz) +. 0.7,
                          Vx.pack_shade(1.0, 0.0), specimen_scale()),
                  s, cx, cy, cz, fx, fz, i + 1)
    end
  end

  doc "One species alone, close and large: the only way to actually judge a body, since a roster board is 25 pixels an animal."
  fn demo_one(b : CubeForge.F32Buf.F32Buf, s : Poses, sp : Int, cx : Float, cy : Float, cz : Float, fx : Float, fz : Float, t : Float) : CubeForge.F32Buf.F32Buf do
    let ahead = 6.0
    -- turning slowly, because a body that only ever faces one way hides half of
    -- whatever is wrong with it
    stamp_s(B.clear(b), s, sp, rest_pose(sp), cx +. ahead *. fx, cy +. 1.0, cz +. ahead *. fz,
            t *. 0.5, Vx.pack_shade(1.0, 0.0), 5.0)
  end

  doc """
  Every species, once, still, broadside, in two rows in front of the eye.

  Drawn at ONE size rather than at their own, which is the opposite of what the
  roster says: a Sunfin is a third of a block and a Mossmoa is two and a half,
  and at their real sizes half of them are a few pixels. This board is for
  checking the bodies; the sizes are a column in the table and are checked by
  standing next to one.
  """
  fn demo_specimens(b : CubeForge.F32Buf.F32Buf, s : Poses, cx : Float, cy : Float, cz : Float, fx : Float, fz : Float) : CubeForge.F32Buf.F32Buf do
    specimen_go(B.clear(b), s, cx, cy, cz, fx, fz, 0)
  end

  doc """
  Rebuild [b] (cleared in place) with the demo flock and school at time [t].

  The flock circles above (cx, cy, cz); the school hangs demo_ahead() blocks
  along the horizontal facing (fx, fz), so it is in front of the eye whichever
  way the spawn happens to look. A demo you have to go and find proves nothing
  when it is missing.
  """
  fn demo_build(b : CubeForge.F32Buf.F32Buf, s : Poses, cx : Float, cy : Float, cz : Float, fx : Float, fz : Float, t : Float) : CubeForge.F32Buf.F32Buf do
    fish_go(birds_go(B.clear(b), s, cx, cy, cz, t, 0), s,
            cx +. demo_ahead() *. fx, cy +. 1.5, cz +. demo_ahead() *. fz, t, 0)
  end

end
