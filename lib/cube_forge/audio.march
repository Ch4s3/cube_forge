-- Audio — the mixer policy. What should be heard, never how to make it.
--
-- This module decides six numbers per tick: four bed gains, the master filter
-- cutoff, and the music level. It also decides, once a bar, which biome the
-- score is in and how the notes `Score` lays out should be shaped -- the
-- envelopes, the gains and the stereo placement that make a melody note a
-- pluck, a pad note a pad, and a bass note the floor under both.
--
-- The synthesis that turns any of it into samples is in native/cf_audio.c,
-- running at 48 kHz on miniaudio's own thread, for the reason `Precip` gives:
-- March's per-element NativeArray writes are O(n) on a shared array (GAPS
-- G68), so a per-sample loop here would be O(n^2) and 48,000 of them a second
-- is not a thing this language will do.
--
-- Everything here is pure, so all of it is testable without a sound device.
mod CubeForge.Audio do

  alias CubeForge.Biome as Biome
  alias CubeForge.Tone as Tone
  alias CubeForge.Score as Score
  alias CubeForge.Noise as N

  -- rain, wind, leaves, underwater, cutoff Hz, music
  type Mix = Mix(Float, Float, Float, Float, Float, Float)

  fn rain_of(m : Mix) : Float do match m do Mix(v, _, _, _, _, _) -> v end end
  fn wind_of(m : Mix) : Float do match m do Mix(_, v, _, _, _, _) -> v end end
  fn leaves_of(m : Mix) : Float do match m do Mix(_, _, v, _, _, _) -> v end end
  fn water_of(m : Mix) : Float do match m do Mix(_, _, _, v, _, _) -> v end end
  fn cutoff_of(m : Mix) : Float do match m do Mix(_, _, _, _, v, _) -> v end end
  fn music_of(m : Mix) : Float do match m do Mix(_, _, _, _, _, v) -> v end end

  pfn clamp01(v : Float) : Float do if v < 0.0 do 0.0 else if v > 1.0 do 1.0 else v end end end

  -- ── The muffle ────────────────────────────────────────────────────────────

  doc "Cutoff of the master lowpass with clear air, in Hz: haze, not a filter."
  fn open_hz() : Float do 18000.0 end
  doc "Cutoff under the thickest snowfall."
  fn snow_hz() : Float do 4000.0 end
  doc "Cutoff with the eye under water."
  fn water_hz() : Float do 700.0 end

  doc "Master lowpass cutoff in Hz for [snowfall] -- how much snow is actually coming down, not how cold it is. Snow closes it; water closes it further and takes precedence rather than compounding, because a head under water hears the same dull world whatever is falling on the surface above it."
  fn cutoff(snowfall : Float, under : Bool) : Float do
    if under do water_hz()
    else open_hz() +. (snow_hz() -. open_hz()) *. clamp01(snowfall) end
  end

  doc "How much snow is actually falling: the share of the precipitation that is snow, times how much precipitation there is. Snow.mix is a property of temperature alone -- it reads 1.0 on a bright still day in the tundra -- so the muffle has to be gated on the weather as well, or a clear cold morning would sound like a blizzard."
  fn snowfall(wx : Float, snow : Float) : Float do clamp01(wx) *. clamp01(snow) end

  -- ── The beds ──────────────────────────────────────────────────────────────

  doc "Loudest each bed is allowed to be. The music sits below all of them: it is a score, not a source in the world."
  fn rain_max() : Float do 0.85 end
  fn wind_max() : Float do 0.9 end
  fn leaf_max() : Float do 0.8 end
  fn water_max() : Float do 0.75 end
  fn music_max() : Float do 0.5 end

  doc "The six numbers, from the world under the listener. [wx] weather intensity, [wind] gust strength, [snow] how much of the precipitation is snow, [exposure] open sky above times height above sea level, [leaf] the fraction of nearby blocks that are foliage."
  fn mix(biome : Int, wx : Float, wind : Float, snow : Float,
         exposure : Float, leaf : Float, under : Bool) : Mix do
    -- Under water the surface world is not merely muffled, it is gone. The
    -- filter alone would leave a thin hiss of rain audible from the lake bed.
    let surface = if under do 0.0 else 1.0 end
    -- Rain reuses the multiplier the particle count already keys on, so what
    -- you hear and what you see cannot disagree about how wet a biome is.
    let rain = surface *. rain_max() *. clamp01(wx *. Biome.precip_scale(biome)) *. (1.0 -. clamp01(snow))
    -- Both terms matter: a peak is windy, a cave at the same height is not.
    let windbed = surface *. wind_max() *. clamp01(wind) *. clamp01(exposure)
    -- Shares the wind term with the bed above, which is what stops leaves
    -- rustling on a still day or a gale passing through silent trees.
    let leaves = surface *. leaf_max() *. clamp01(wind) *. clamp01(leaf)
    let water = (1.0 -. surface) *. water_max()
    Mix(rain, windbed, leaves, water, cutoff(snowfall(wx, snow), under), music_max())
  end

  doc "Share of the sampled box that counts as a full canopy. Measured, not guessed: standing under a generated forest fills about 2.5% of the 343-point lattice with leaves, because most of a cube around a player is air and ground. Ask for a third and the bed is silent in every forest there is."
  fn full_canopy() : Float do 0.045 end

  doc "How loud the trees are, from [hits] foliage blocks out of [samples] sampled around the listener."
  fn leaf_fraction(hits : Int, samples : Int) : Float do
    if samples <= 0 do 0.0
    else clamp01(int_to_float(hits) /. (int_to_float(samples) *. full_canopy())) end
  end

  doc "How exposed the listener is to the wind: how far above sea level they stand, ramped to full at the snow line, times how much sky is over their head. Both terms matter -- a peak is windy and a cave at the same height is not."
  fn exposure(y : Int, sky : Int) : Float do
    let height = int_to_float(y - CubeForge.Noise.sea_level())
              /. int_to_float(CubeForge.Noise.snow_line() - CubeForge.Noise.sea_level())
    clamp01(height) *. clamp01(int_to_float(sky) /. int_to_float(CubeForge.Light.max_level()))
  end

  -- ── The biome table ───────────────────────────────────────────────────────
  --
  -- One row for the world; the biome chooses which face of it you hear. Form
  -- and transposition are the harmonic shift and only move at a row boundary;
  -- octave, timbre and rate are the colour and pacing and ease continuously.

  doc "The mode this biome states. Most of what makes a biome sound like itself: the flat second of phrygian is a desert, the sharp fourth of lydian is an oasis, and a pentatonic has no semitone in it to grate at all, which is why the two emptiest biomes get one."
  fn mode_of(b : Int) : Int do
    if b == Biome.b_tundra() do Score.mode_pent_major()
    else if b == Biome.b_taiga() do Score.mode_aeolian()
    else if b == Biome.b_grassland() do Score.mode_ionian()
    else if b == Biome.b_forest() do Score.mode_dorian()
    else if b == Biome.b_desert() do Score.mode_phrygian()
    else if b == Biome.b_wetland() do Score.mode_aeolian()
    else if b == Biome.b_beach() do Score.mode_mixolydian()
    else if b == Biome.b_oasis() do Score.mode_lydian()
    else if b == Biome.b_grove() do Score.mode_pent_minor()
    else Score.mode_pent_major() end end end end end end end end end
  end

  doc "Semitones this biome transposes the key by. Walking from a grassland into a forest is a modulation, and it happens at a phrase boundary so it is heard as one."
  fn transpose_of(b : Int) : Int do
    if b == Biome.b_tundra() do 0
    else if b == Biome.b_taiga() do 3
    else if b == Biome.b_grassland() do 5
    else if b == Biome.b_forest() do 7
    else if b == Biome.b_desert() do 2
    else if b == Biome.b_wetland() do 10
    else if b == Biome.b_beach() do 8
    else if b == Biome.b_oasis() do 2
    else if b == Biome.b_grove() do 10
    else 0 end end end end end end end end end
  end

  doc "Octave the melody sits in. Alpine sings above the treeline and forests sit under it. It stops at 5: this is the top of a three-voice texture now, not a lone sine, and an octave higher puts the reach of the register above 3 kHz, where a melody is a whistle."
  fn octave_of(b : Int) : Int do
    if b == Biome.b_tundra() do 5
    else if b == Biome.b_taiga() do 4
    else if b == Biome.b_grassland() do 5
    else if b == Biome.b_forest() do 4
    else if b == Biome.b_desert() do 5
    else if b == Biome.b_wetland() do 4
    else if b == Biome.b_beach() do 5
    else if b == Biome.b_oasis() do 5
    else if b == Biome.b_grove() do 4
    else 5 end end end end end end end end end
  end

  doc "Octave the chord sits in: under the melody. Wide enough apart that the pad supports the line rather than crowding it."
  fn pad_octave(b : Int) : Int do octave_of(b) - 1 end
  doc "Octave the bass root is reckoned from. Fixed, not the biome's: `Score.bass_degree` drops the chord root into the octave under the tonic inside it, and the floor of the piece then lands between about 45 and 175 Hz in every key, in every biome, on every degree the progression can reach. A biome moves the melody and the chord; the floor stays where a floor is."
  fn bass_octave() : Int do 3 end

  doc "Waveform id for the melody: 0 glass, 1 triangle, 2 filtered saw, 3 sine, 4 hollow square. Read by the synthesiser in cf_audio.c."
  fn timbre_of(b : Int) : Int do
    if b == Biome.b_tundra() do 0
    else if b == Biome.b_taiga() do 1
    else if b == Biome.b_grassland() do 1
    else if b == Biome.b_forest() do 2
    else if b == Biome.b_desert() do 3
    else if b == Biome.b_wetland() do 4
    else if b == Biome.b_beach() do 3
    else if b == Biome.b_oasis() do 3
    else if b == Biome.b_grove() do 4
    else 0 end end end end end end end end end
  end

  doc "Waveform id for the chord voice: three detuned saws under a soft lowpass."
  fn pad_timbre() : Int do 5 end
  doc "Waveform id for the bass: a sine with a soft octave over it."
  fn bass_timbre() : Int do 6 end

  doc "Ticks a bar of this biome lasts. Given in ticks rather than in beats per minute because the frame loop only reaches the score once a tick: a bar of 3.4 ticks would leave the downbeat drifting by up to a sixth of a second, and a wandering downbeat is the one thing an ear will not forgive. At six ticks a second these run from 80 down to 45 beats a minute."
  fn bar_ticks_of(b : Int) : Int do
    if b == Biome.b_tundra() do 30
    else if b == Biome.b_taiga() do 24
    else if b == Biome.b_grassland() do 20
    else if b == Biome.b_forest() do 22
    else if b == Biome.b_desert() do 30
    else if b == Biome.b_wetland() do 18
    else if b == Biome.b_beach() do 20
    else if b == Biome.b_oasis() do 20
    else if b == Biome.b_grove() do 32
    else 28 end end end end end end end end end
  end

  doc "How readily the offbeats take a note, 0..1. A desert is sparse and a wetland busy, which is the pacing half of the biome shift. It is not the whole of it: the rests are what phrase the line, so this never reaches 1."
  fn density_of(b : Int) : Float do
    if b == Biome.b_tundra() do 0.4
    else if b == Biome.b_taiga() do 0.55
    else if b == Biome.b_grassland() do 0.7
    else if b == Biome.b_forest() do 0.65
    else if b == Biome.b_desert() do 0.35
    else if b == Biome.b_wetland() do 0.8
    else if b == Biome.b_beach() do 0.6
    else if b == Biome.b_oasis() do 0.65
    else if b == Biome.b_grove() do 0.35
    else 0.4 end end end end end end end end end
  end

  -- ── The schedule ──────────────────────────────────────────────────────────
  --
  -- A bar at a time, not a note at a time. The frame loop asks once a tick; on
  -- the tick a bar is due it reads a whole bar's worth of notes out of `Score`
  -- and hands every one of them to the synthesiser at once, each with the delay
  -- that places it on its eighth. That is what buys rhythm: the pulse is no
  -- longer limited to the six-hertz grid the frame loop happens to run on.

  doc "Ticks per second: the frame loop asks once every tick_period() frames at 60 fps."
  fn ticks_per_second() : Int do 6 end

  doc "Seconds a bar of [b] lasts."
  fn bar_seconds(b : Int) : Float do Score.bar_seconds(bar_ticks_of(b), ticks_per_second()) end
  doc "Seconds an eighth note of [b] lasts."
  fn eighth_seconds(b : Int) : Float do bar_seconds(b) /. int_to_float(Score.slots()) end

  doc "Level the score is struck at. The music sits under the world, not over it."
  fn note_gain() : Float do 0.8 end

  -- The three voices, shaped. These four numbers per role -- attack, the level
  -- the held part decays to, release and gain -- are the whole difference
  -- between a melody and a held key, and the reason the synthesiser takes them
  -- as parameters instead of having one envelope baked into it.

  doc "Melody attack: a pluck. Twelve milliseconds is an edge you hear as an articulation rather than as a click."
  fn mel_attack() : Float do 0.012 end
  doc "Melody sustain: a struck note falls to about a third while it is held, the way anything struck does."
  fn mel_sustain() : Float do 0.35 end
  doc "Melody release."
  fn mel_release() : Float do 0.9 end
  doc "How much of the way to the next onset a melody note is held. Just short, so consecutive eighths are two notes and not one."
  fn mel_hold() : Float do 0.92 end
  doc "Level of a melody note at [slot] of [bar]: the metric accent."
  fn mel_gain(seed : Int, bar : Int, slot : Int) : Float do
    note_gain() *. clamp01(Score.accent(seed, bar, slot))
  end
  doc "Where in the stereo field a melody note sits. Narrow -- the line is the thing being followed and it should stay put -- but not dead centre, where the bass already is."
  fn mel_pan(seed : Int, bar : Int, slot : Int) : Float do
    0.5 *. (N.hash2(bar * 64 + slot, 71, seed) -. 0.5)
  end

  doc "Pad attack: a third of a bar, so the chord arrives under the melody instead of with it."
  fn pad_attack(b : Int) : Float do 0.35 *. bar_seconds(b) end
  doc "Pad sustain: a chord voice holds."
  fn pad_sustain() : Float do 0.85 end
  doc "Pad release: half a bar, so one chord is still fading as the next arrives and the harmony never has a seam in it. Longer and three chords are sounding at once, which is not a richer harmony, it is a blur."
  fn pad_release(b : Int) : Float do 0.55 *. bar_seconds(b) end
  doc "How long the pad is held before its release: just to the bar line, for the same reason."
  fn pad_hold(b : Int) : Float do 0.98 *. bar_seconds(b) end
  doc "Level of one of the three chord tones. Three of these sound at once and the melody has to be heard over all of them."
  fn pad_gain() : Float do note_gain() *. 0.26 end
  doc "Where chord tone [i] of three sits. Spread wide: the pad is the room the melody is in."
  fn pad_pan(i : Int) : Float do
    if i == 0 do 0.0 -. 0.6 else if i == 1 do 0.12 else 0.62 end end
  end

  doc "Bass attack: softer than the melody's, so the low end does not click."
  fn bass_attack() : Float do 0.03 end
  fn bass_sustain() : Float do 0.45 end
  fn bass_release() : Float do 0.6 end
  doc "How long the bass note is held: a little under half a bar, which leaves the second half of the bar to the chord and stops the low end droning."
  fn bass_hold(b : Int) : Float do 0.45 *. bar_seconds(b) end
  doc "Level of the bass. Dead centre, and the loudest single voice: everything else is heard against it."
  fn bass_gain() : Float do note_gain() *. 0.48 end

  doc "The bass restates on beat three when the bar is busy enough to want the push. Sparse biomes get one note a bar and the space around it."
  fn bass_twice(b : Int) : Bool do density_of(b) >= 0.55 end

  -- tick the next bar is due, bar number, mode and key transposition in force
  type Sched = Sched(Int, Int, Int, Int)

  fn next_of(s : Sched) : Int do match s do Sched(v, _, _, _) -> v end end
  fn bar_of(s : Sched) : Int do match s do Sched(_, v, _, _) -> v end end
  fn mode_of_sched(s : Sched) : Int do match s do Sched(_, _, v, _) -> v end end
  fn transpose_of_sched(s : Sched) : Int do match s do Sched(_, _, _, v) -> v end end

  doc "A schedule whose first bar falls at [tick], opening in the mode and key of [biome] -- the score should be in the world it starts in, not modulate into it four bars later."
  fn sched_start(tick : Int, biome : Int) : Sched do
    Sched(tick, 0, mode_of(biome), transpose_of(biome))
  end

  doc "Is a bar due at [tick]?"
  fn due(s : Sched, tick : Int) : Bool do tick >= next_of(s) end

  doc "Is the bar this schedule is holding the first of a phrase?"
  fn phrase_start(s : Sched) : Bool do bar_of(s) % Score.phrase_bars() == 0 end

  doc "The key the bar this schedule is holding is in: the world's own key, transposed by whatever biome was in force when the phrase began."
  fn key_of(s : Sched, seed : Int) : Int do
    (Score.key_of(seed) + transpose_of_sched(s)) % 12
  end

  doc "The key the bass reckons from: the same key, folded so it never rides most of an octave above the tonic. See Score.fold_key."
  fn bass_key(s : Sched, seed : Int) : Int do Score.fold_key(key_of(s, seed)) end

  doc "Play the held bar out and set up the next one. The biome's [want_mode] and [want_t] are adopted only at a phrase boundary, so walking into a forest never modulates halfway through a cadence -- the harmonic shift waits for the progression to come home, up to four bars later."
  fn advance(s : Sched, bt : Int, want_mode : Int, want_t : Int) : Sched do
    let b1 = bar_of(s) + 1
    let boundary = b1 % Score.phrase_bars() == 0
    let mode1 = if boundary do want_mode else mode_of_sched(s) end
    let t1 = if boundary do want_t else transpose_of_sched(s) end
    Sched(next_of(s) + bt, b1, mode1, t1)
  end

end
