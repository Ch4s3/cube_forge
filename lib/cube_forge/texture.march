-- Texture — procedurally generated RGBA8 texture-array pixels in a NativeU8Arr.
-- Layout: layer-major, then row-major, 4 bytes per texel.
mod CubeForge.Texture do

  fn size() : Int do 16 end

  -- NativeArray.set_u8 truncates mod 256 rather than saturating, so a bright base colour
  -- plus a positive speckle wraps to near-black (snow at 250 + 12 became 6). Clamp first.
  pfn byte(v : Int) : Int do if v < 0 do 0 else if v > 255 do 255 else v end end end

  pfn put_rgba(a : NativeU8Arr, off : Int, r0 : Int, g0 : Int, b0 : Int, alpha : Int) : NativeU8Arr do
    let r = byte(r0)
    let g = byte(g0)
    let b = byte(b0)
    let a1 = NativeArray.set_u8(a, off, r)
    let a2 = NativeArray.set_u8(a1, off + 1, g)
    let a3 = NativeArray.set_u8(a2, off + 2, b)
    NativeArray.set_u8(a3, off + 3, alpha)
  end

  -- M2: one 16x16 green/dark-green checkerboard layer.
  pfn checker_go(a : NativeU8Arr, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let light = (x / 2 + y / 2) % 2 == 0
      let a1 = if light do put_rgba(a, i * 4, 110, 190, 80, 255) else put_rgba(a, i * 4, 70, 140, 60, 255) end
      checker_go(a1, i + 1)
    end
  end

  -- Layer 1: translucent blue water with a faint ripple pattern.
  pfn water_go(a : NativeU8Arr, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let ripple = if (x + y) % 8 < 2 do 25 else 0 end
      water_go(put_rgba(a, 256 * 4 + i * 4, 40 + ripple, 90 + ripple, 200 + ripple, 150), i + 1)
    end
  end

  -- Layer 2: dirt (brown speckle). Layer 3: stone (grey speckle).
  pfn speckle_go(a : NativeU8Arr, layer : Int, i : Int, r : Int, g : Int, b : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let d = ((x * 7 + y * 13 + x * y) % 5) * 6 - 12
      speckle_go(put_rgba(a, layer * 1024 + i * 4, r + d, g + d, b + d, 255), layer, i + 1, r, g, b)
    end
  end

  -- Bedded rock: horizontal laminae [every] pixels apart, a shade darker, over
  -- a speckle -- sandstone's thick pale beds, shale's thin grey-blue ones.
  pfn bedded_go(a : NativeU8Arr, layer : Int, i : Int, r : Int, g : Int, b : Int, every : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let d = ((x * 7 + y * 13 + x * y) % 5) * 4 - 8
      let line = if (y + x / 6) % every == 0 do 0 - 22 else 0 end
      bedded_go(put_rgba(a, layer * 1024 + i * 4, r + d + line, g + d + line, b + d + line, 255), layer, i + 1, r, g, b, every)
    end
  end

  -- Bark: vertical streaks. The cut end: concentric rings.
  -- Bark: vertical streaks. [r], [g], [b] are the base tone, so oak and pine
  -- get visibly different trunks (they were the same layer, which made the two
  -- log hotbar slots indistinguishable).
  pfn bark_tinted_go(a : NativeU8Arr, layer : Int, i : Int, r : Int, g : Int, b : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let d = (x * 7 + (i / 16) * 3) % 24 - 12
      bark_tinted_go(put_rgba(a, layer * 1024 + i * 4, r + d, g + d, b + d, 255), layer, i + 1, r, g, b)
    end
  end

  pfn bark_go(a : NativeU8Arr, layer : Int, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let d = ((x * 5 + (y / 3) * 3) % 4) * 7 - 10
      bark_go(put_rgba(a, layer * 1024 + i * 4, 104 + d, 76 + d, 48 + d, 255), layer, i + 1)
    end
  end
  pfn rings_go(a : NativeU8Arr, layer : Int, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16 - 8
      let y = i / 16 - 8
      let r = float_to_int(Math.sqrt(int_to_float(x * x + y * y)))
      let d = if r % 2 == 0 do 12 else -6 end
      rings_go(put_rgba(a, layer * 1024 + i * 4, 156 + d, 124 + d, 84 + d, 255), layer, i + 1)
    end
  end

  -- Layer 91: the model palette. Texel k is Model.colour k, opaque; a model
  -- quad's uv points at one texel's centre (Model.palette_u/v).
  pfn palette_go(a : NativeU8Arr, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else palette_go(put_rgba(a, 91 * 1024 + i * 4, CubeForge.Model.colour_r(i), CubeForge.Model.colour_g(i), CubeForge.Model.colour_b(i), 255), i + 1) end
  end

  -- Palm fronds: the leaf cutout in a yellower green, with a lighter midrib on
  -- the two middle rows so a frond reads as a blade rather than a clump.
  pfn fronds_go(a : NativeU8Arr, layer : Int, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let h = (x * 7 + y * 13 + x * y * 3) % 11
      let d = ((x * 3 + y * 5) % 5) * 8 - 16 + (if y == 7 || y == 8 do 24 else 0 end)
      let alpha = if h < 2 do 0 else 255 end
      fronds_go(put_rgba(a, layer * 1024 + i * 4, 84 + d, 150 + d, 62 + d, alpha), layer, i + 1)
    end
  end

  -- Leaves: a cutout texture. Roughly a fifth of the texels are fully transparent,
  -- so a canopy reads as foliage rather than a solid block; the shader discards them.
  pfn leaves_go(a : NativeU8Arr, layer : Int, i : Int, r : Int, g : Int, b : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let h = (x * 7 + y * 13 + x * y * 3) % 11
      let d = ((x * 3 + y * 5) % 5) * 8 - 16
      let alpha = if h < 2 do 0 else 255 end
      leaves_go(put_rgba(a, layer * 1024 + i * 4, r + d, g + d, b + d, alpha), layer, i + 1, r, g, b)
    end
  end

  doc """
  16x16 RGBA texture array, layer-major: 0 grass, 1 water, 2 dirt, 3 stone,
  4 sand, 5 snow, 6 granite, 7 bedrock, 8 oak bark, 9 cut end, 10 oak leaves,
  11 pine leaves, 12 pine bark, 13 gravel, 14 clay, 15 spring (icon only), 16 foam,
  17 basalt, 18 ice, 19 mud, 20 glow cap, 21..62 mycelium over (grass, dirt, sand, snow,
  gravel, clay, stone) x six species, 63..68 spore icons per species, 69..86 fruit
  (small, stem, cap) x six species, 87 palm bark, 88 palm frond, 89 sandstone, 90 shale, 91 the model palette
  (texel k is Model.colour k).
  """
  fn checkerboard() : NativeU8Arr do
    let a0 = checker_go(NativeArray.make_u8(92 * 16 * 16 * 4, 0), 0)
    let a1 = water_go(a0, 0)
    let a2 = speckle_go(a1, 2, 0, 134, 96, 67)
    let a3 = speckle_go(a2, 3, 0, 128, 128, 132)
    let a4 = speckle_go(a3, 4, 0, 219, 203, 146)
    let a5 = speckle_go(a4, 5, 0, 242, 246, 250)
    let a6 = speckle_go(a5, 6, 0, 150, 141, 138)
    let a7 = speckle_go(a6, 7, 0, 46, 44, 48)
    let a8 = bark_go(a7, 8, 0)
    let a9 = rings_go(a8, 9, 0)
    let a10 = leaves_go(a9, 10, 0, 62, 128, 54)
    let a11 = leaves_go(a10, 11, 0, 38, 92, 68)
    let a12 = bark_tinted_go(a11, 12, 0, 74, 56, 42)
    let a13 = speckle_go(a12, 13, 0, 112, 110, 106)
    let a14 = speckle_go(a13, 14, 0, 158, 142, 124)
    let a15 = spring_go(a14, 0)
    let a16 = speckle_go(a15, 16, 0, 226, 236, 246)
    let a17 = speckle_go(a16, 17, 0, 40, 38, 42)
    let a18 = speckle_go(a17, 18, 0, 205, 225, 240)
    let a19 = speckle_go(a18, 19, 0, 70, 48, 38)
    let a20 = speckle_go(a19, 20, 0, 250, 214, 120)
    let a21 = bark_tinted_go(a20, 87, 0, 188, 166, 118)
    let a22 = fronds_go(a21, 88, 0)
    let a23 = bedded_go(a22, 89, 0, 206, 178, 128, 3)
    let a24 = bedded_go(a23, 90, 0, 96, 104, 118, 2)
    let a25 = palette_go(a24, 0)
    fruit_all_go(spore_all_go(myc_all_go(a25, 0), 1), 0)
  end

  -- Layer 15: the spring ITEM's icon -- water blue with a pale ring, so a spring in
  -- the hotbar does not look like a lake. Blocks never sample it (see icon_layer).
  pfn spring_go(a : NativeU8Arr, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16 - 8
      let y = i / 16 - 8
      let d2 = x * x + y * y
      let ring = if d2 >= 16 && d2 <= 30 do 70 else 0 end
      spring_go(put_rgba(a, 15 * 256 * 4 + i * 4, 40 + ring, 90 + ring, 200 + ring, 255), i + 1)
    end
  end

  doc "Texture layer for an item's HUD icon: as layer_for, except the spring item (id 4) shows its ring. The sea is also id 4 and must keep rendering as water, which is why this is not layer_for."
  fn icon_layer(id : Int) : Float do if id == 4 do 15.0 else if CubeForge.Species.is_spore(id) do spore_layer(CubeForge.Species.species_of_item(id)) else layer_for(id) end end end

  fn layers() : Int do 92 end

  -- ── The layer table for the shim's quad emitter ─────────────────────────
  pfn layer_tab_go(t : NativeF32Arr, i : Int) : NativeF32Arr do
    if i >= 1536 do t else layer_tab_go(NativeArray.set_f32(t, i, layer_for_face(i / 6, i % 6)), i + 1) end
  end
  pfn myc_tab_go(t : NativeF32Arr, j : Int) : NativeF32Arr do
    if j >= 42 do t else myc_tab_go(NativeArray.set_f32(t, 1536 + j, myc_layer(j / 6, j % 6 + 1)), j + 1) end
  end
  doc "Every block face's texture layer in one array: layer_for_face(id, d) at id * 6 + d for ids 0..255, then myc_layer(k, sp) at 1536 + k * 6 + (sp - 1). cf_mesh_quad reads it instead of calling back into layer_for per rectangle, which was a chain of boxed-Float returns."
  fn layer_table() : NativeF32Arr do myc_tab_go(layer_tab_go(NativeArray.make_f32(1536 + 42, 0.0), 0), 0) end
  fn water_layer() : Float do 1.0 end
  doc "Texture layer for a block id on face direction [d] (0 +y, 1 -y, 2 +x, 3 -x, 4 +z, 5 -z)."
  fn layer_for_face(id : Int, d : Int) : Float do
    if id == 16 do (if d <= 1 do 9.0 else 8.0 end)          -- oak log: rings on the cut ends, bark on the sides
    else if id == 18 do (if d <= 1 do 9.0 else 12.0 end)     -- pine log: darker bark
    else if id == CubeForge.Chunk.palm_log() do (if d <= 1 do 9.0 else 87.0 end)  -- palm: pale bark
    -- a small mushroom seen from above or below is its cap, not its silhouette:
    -- the cutout on every face read as a splayed shape from the air
    else if CubeForge.Chunk.is_fruit_small(id) do (if d <= 1 do fruit_layer(2, CubeForge.Chunk.fruit_species(id)) else layer_for(id) end)
    else layer_for(id) end end end end
  end

  doc "Texture layer for a block id."
  fn layer_for(id : Int) : Float do
    if id == 2 do 2.0
    else if id == 3 do 3.0
    else if id >= 4 && id <= 11 do 1.0
    else if id == 12 do 4.0
    else if id == 13 do 5.0
    else if id == 14 do 6.0
    else if id == 15 do 7.0
    else if id == 16 do 8.0
    else if id == 18 do 12.0
    else if id == 17 do 10.0
    else if id == 19 do 11.0
    else if id == 20 do 13.0
    else if id == 21 do 14.0
    else if id == 22 do 17.0
    else if id == 23 do 18.0
    else if id == 24 do 19.0
    else if id == 25 do 20.0
    else if id == CubeForge.Chunk.sandstone() do 89.0
    else if id == CubeForge.Chunk.shale() do 90.0
    else if id == CubeForge.Chunk.palm_log() do 87.0
    else if id == CubeForge.Chunk.palm_frond() do 88.0
    else if CubeForge.Chunk.is_myc(id) do layer_for(CubeForge.Chunk.myc_base(id))
    else if CubeForge.Chunk.is_fruit(id) do fruit_layer(fruit_kind(id), CubeForge.Chunk.fruit_species(id))
    else 0.0 end end end end end end end end end end end end end end end end end end end end end end end
  end


  -- ── Mycelium layers: the base's pattern with threads over it ─────────────
  -- Layer 21 + 6 * base_index + (species - 1). Each layer REPRODUCES its base
  -- from the base's formula rather than copying the base layer: reading the
  -- array while writing it would copy all 60 KB per texel (GAPS G21).
  doc "Texture layer for mycelium over base index [k] (0..6) in species [sp] (1..6)."
  fn myc_layer(k : Int, sp : Int) : Float do int_to_float(21 + 6 * k + (sp - 1)) end

  -- The base colour for base index k, by the same numbers as the plain layers:
  -- grass is the checker (handled inline), everything else a speckle.
  pfn myc_base_r(k : Int) : Int do if k == 1 do 134 else if k == 2 do 219 else if k == 3 do 242 else if k == 4 do 112 else if k == 5 do 158 else 128 end end end end end end
  pfn myc_base_g(k : Int) : Int do if k == 1 do 96 else if k == 2 do 203 else if k == 3 do 246 else if k == 4 do 110 else if k == 5 do 142 else 128 end end end end end end
  pfn myc_base_b(k : Int) : Int do if k == 1 do 67 else if k == 2 do 146 else if k == 3 do 250 else if k == 4 do 106 else if k == 5 do 124 else 132 end end end end end end

  pfn myc_go(a : NativeU8Arr, layer : Int, k : Int, sp : Int, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let light = (x / 2 + y / 2) % 2 == 0
      let d = ((x * 7 + y * 13 + x * y) % 5) * 6 - 12
      let br = if k == 0 do (if light do 110 else 70 end) else myc_base_r(k) + d end
      let bg = if k == 0 do (if light do 190 else 140 end) else myc_base_g(k) + d end
      let bb = if k == 0 do (if light do 80 else 60 end) else myc_base_b(k) + d end
      -- the threads: a sparse branching lattice, about a third of the texels
      let t = (x * 3 + y * 5 + (x * y) % 7 + sp) % 9
      let thread = t < 3
      let sr = CubeForge.Species.colour_r(sp)
      let sg = CubeForge.Species.colour_g(sp)
      let sb = CubeForge.Species.colour_b(sp)
      -- a thread texel is two-thirds species colour; the rest of the layer is
      -- the base pulled a sixth of the way toward it, so the tint reads at a distance
      let r = if thread do (br + 2 * sr) / 3 else (5 * br + sr) / 6 end
      let g = if thread do (bg + 2 * sg) / 3 else (5 * bg + sg) / 6 end
      let b = if thread do (bb + 2 * sb) / 3 else (5 * bb + sb) / 6 end
      myc_go(put_rgba(a, layer * 1024 + i * 4, r, g, b, 255), layer, k, sp, i + 1)
    end
  end

  -- All 42 layers: j runs over base index x species.
  pfn myc_all_go(a : NativeU8Arr, j : Int) : NativeU8Arr do
    if j >= 42 do a
    else myc_all_go(myc_go(a, 21 + j, j / 6, j % 6 + 1, 0), j + 1) end
  end


  -- ── Spore icons: a dark disc dusted with the species colour ─────────────
  doc "HUD icon layer for a species' spores."
  fn spore_layer(sp : Int) : Float do int_to_float(62 + sp) end
  pfn spore_go(a : NativeU8Arr, sp : Int, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16 - 8
      let y = i / 16 - 8
      let d2 = x * x + y * y
      let dust = (x * 5 + y * 3 + x * y) % 4 == 0
      let sr = CubeForge.Species.colour_r(sp)
      let sg = CubeForge.Species.colour_g(sp)
      let sb = CubeForge.Species.colour_b(sp)
      let inside = d2 <= 36
      let r = if !inside do 30 else if dust do sr else sr / 3 end end
      let g = if !inside do 30 else if dust do sg else sg / 3 end end
      let b = if !inside do 30 else if dust do sb else sb / 3 end end
      spore_go(put_rgba(a, (62 + sp) * 1024 + i * 4, r, g, b, 255), sp, i + 1)
    end
  end
  pfn spore_all_go(a : NativeU8Arr, sp : Int) : NativeU8Arr do
    if sp > 6 do a else spore_all_go(spore_go(a, sp, 0), sp + 1) end
  end


  -- ── Fruit layers: 69 + 6 * kind + (species - 1); kind 0 small, 1 stem, 2 cap ──
  fn fruit_layer(kind : Int, sp : Int) : Float do int_to_float(69 + 6 * kind + (sp - 1)) end
  pfn fruit_kind(id : Int) : Int do
    if CubeForge.Chunk.is_fruit_small(id) do 0 else if CubeForge.Chunk.is_fruit_stem(id) do 1 else 2 end end
  end

  -- Small: a mushroom silhouette on a transparent ground -- a domed cap in the
  -- species colour over a pale stem. Stem: pale, vertically streaked, faintly
  -- tinted. Cap: the species colour, speckled, darker at the rim.
  pfn fruit_go(a : NativeU8Arr, kind : Int, sp : Int, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let sr = CubeForge.Species.colour_r(sp)
      let sg = CubeForge.Species.colour_g(sp)
      let sb = CubeForge.Species.colour_b(sp)
      let d = ((x * 7 + y * 13 + x * y) % 5) * 6 - 12
      let layer = 69 + 6 * kind + (sp - 1)
      if kind == 0 do
        -- cap: rows 2..7 as a dome; stem: rows 8..15, columns 6..9; else clear
        let cx = if x >= 8 do x - 8 else 8 - x end
        let in_cap = y >= 2 && y <= 7 && cx <= y - 1
        let in_stem = y >= 8 && x >= 6 && x <= 9
        if in_cap do fruit_go(put_rgba(a, layer * 1024 + i * 4, sr + d, sg + d, sb + d, 255), kind, sp, i + 1)
        else if in_stem do fruit_go(put_rgba(a, layer * 1024 + i * 4, 225 + d / 2, 215 + d / 2, 195 + d / 2, 255), kind, sp, i + 1)
        else fruit_go(put_rgba(a, layer * 1024 + i * 4, 0, 0, 0, 0), kind, sp, i + 1) end end
      else if kind == 1 do
        let s = (x * 7 + (y / 3) * 3) % 24 - 12
        fruit_go(put_rgba(a, layer * 1024 + i * 4, (5 * 220 + sr) / 6 + s, (5 * 210 + sg) / 6 + s, (5 * 190 + sb) / 6 + s, 255), kind, sp, i + 1)
      else
        let rim = if x == 0 || x == 15 || y == 0 || y == 15 do 0 - 30 else 0 end
        fruit_go(put_rgba(a, layer * 1024 + i * 4, sr + d + rim, sg + d + rim, sb + d + rim, 255), kind, sp, i + 1)
      end end
    end
  end
  pfn fruit_all_go(a : NativeU8Arr, j : Int) : NativeU8Arr do
    if j >= 18 do a else fruit_all_go(fruit_go(a, j / 6, j % 6 + 1, 0), j + 1) end
  end

end
