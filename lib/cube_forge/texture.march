-- Texture — procedurally generated RGBA8 texture-array pixels in a NativeU8Arr.
-- Layout: layer-major, then row-major, 4 bytes per texel.
mod CubeForge.Texture do

  fn size() : Int do 16 end

  -- NativeArray.set_u8 truncates mod 256 rather than saturating, so a bright base colour
  -- plus a positive speckle wraps to near-black (snow at 250 + 12 became 6). Clamp first.
  pfn byte(v : Int) : Int do if v < 0 do 0 else if v > 255 do 255 else v end end end

  pfn put_rgba(a : NativeU8Arr, off : Int, r0 : Int, g0 : Int, b0 : Int, alpha : Int) : NativeU8Arr do
    let r = byte(r0)
    let g = byte(g0)
    let b = byte(b0)
    let a1 = NativeArray.set_u8(a, off, r)
    let a2 = NativeArray.set_u8(a1, off + 1, g)
    let a3 = NativeArray.set_u8(a2, off + 2, b)
    NativeArray.set_u8(a3, off + 3, alpha)
  end

  -- M2: one 16x16 green/dark-green checkerboard layer.
  pfn checker_go(a : NativeU8Arr, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let light = (x / 2 + y / 2) % 2 == 0
      let a1 = if light do put_rgba(a, i * 4, 110, 190, 80, 255) else put_rgba(a, i * 4, 70, 140, 60, 255) end
      checker_go(a1, i + 1)
    end
  end

  -- Layer 1: translucent blue water with a faint ripple pattern.
  pfn water_go(a : NativeU8Arr, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let ripple = if (x + y) % 8 < 2 do 25 else 0 end
      water_go(put_rgba(a, 256 * 4 + i * 4, 40 + ripple, 90 + ripple, 200 + ripple, 150), i + 1)
    end
  end

  -- Layer 2: dirt (brown speckle). Layer 3: stone (grey speckle).
  pfn speckle_go(a : NativeU8Arr, layer : Int, i : Int, r : Int, g : Int, b : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let d = ((x * 7 + y * 13 + x * y) % 5) * 6 - 12
      speckle_go(put_rgba(a, layer * 1024 + i * 4, r + d, g + d, b + d, 255), layer, i + 1, r, g, b)
    end
  end

  -- Bark: vertical streaks. The cut end: concentric rings.
  -- Bark: vertical streaks. [r], [g], [b] are the base tone, so oak and pine
  -- get visibly different trunks (they were the same layer, which made the two
  -- log hotbar slots indistinguishable).
  pfn bark_tinted_go(a : NativeU8Arr, layer : Int, i : Int, r : Int, g : Int, b : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let d = (x * 7 + (i / 16) * 3) % 24 - 12
      bark_tinted_go(put_rgba(a, layer * 1024 + i * 4, r + d, g + d, b + d, 255), layer, i + 1, r, g, b)
    end
  end

  pfn bark_go(a : NativeU8Arr, layer : Int, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let d = ((x * 5 + (y / 3) * 3) % 4) * 7 - 10
      bark_go(put_rgba(a, layer * 1024 + i * 4, 104 + d, 76 + d, 48 + d, 255), layer, i + 1)
    end
  end
  pfn rings_go(a : NativeU8Arr, layer : Int, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16 - 8
      let y = i / 16 - 8
      let r = float_to_int(Math.sqrt(int_to_float(x * x + y * y)))
      let d = if r % 2 == 0 do 12 else -6 end
      rings_go(put_rgba(a, layer * 1024 + i * 4, 156 + d, 124 + d, 84 + d, 255), layer, i + 1)
    end
  end

  -- Leaves: a cutout texture. Roughly a fifth of the texels are fully transparent,
  -- so a canopy reads as foliage rather than a solid block; the shader discards them.
  pfn leaves_go(a : NativeU8Arr, layer : Int, i : Int, r : Int, g : Int, b : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let h = (x * 7 + y * 13 + x * y * 3) % 11
      let d = ((x * 3 + y * 5) % 5) * 8 - 16
      let alpha = if h < 2 do 0 else 255 end
      leaves_go(put_rgba(a, layer * 1024 + i * 4, r + d, g + d, b + d, alpha), layer, i + 1, r, g, b)
    end
  end

  doc """
  16x16 RGBA texture array, layer-major: 0 grass, 1 water, 2 dirt, 3 stone,
  4 sand, 5 snow, 6 granite, 7 bedrock, 8 oak bark, 9 cut end, 10 oak leaves,
  11 pine leaves, 12 pine bark, 13 gravel, 14 clay, 15 spring (icon only), 16 foam,
  17 glow cap, 18..59 mycelium over (grass, dirt, sand, snow, gravel, clay, stone) x six species.
  """
  fn checkerboard() : NativeU8Arr do
    let a0 = checker_go(NativeArray.make_u8(60 * 16 * 16 * 4, 0), 0)
    let a1 = water_go(a0, 0)
    let a2 = speckle_go(a1, 2, 0, 134, 96, 67)
    let a3 = speckle_go(a2, 3, 0, 128, 128, 132)
    let a4 = speckle_go(a3, 4, 0, 219, 203, 146)
    let a5 = speckle_go(a4, 5, 0, 242, 246, 250)
    let a6 = speckle_go(a5, 6, 0, 150, 141, 138)
    let a7 = speckle_go(a6, 7, 0, 46, 44, 48)
    let a8 = bark_go(a7, 8, 0)
    let a9 = rings_go(a8, 9, 0)
    let a10 = leaves_go(a9, 10, 0, 62, 128, 54)
    let a11 = leaves_go(a10, 11, 0, 38, 92, 68)
    let a12 = bark_tinted_go(a11, 12, 0, 74, 56, 42)
    let a13 = speckle_go(a12, 13, 0, 112, 110, 106)
    let a14 = speckle_go(a13, 14, 0, 158, 142, 124)
    let a15 = spring_go(a14, 0)
    let a16 = speckle_go(a15, 16, 0, 226, 236, 246)
    let a17 = speckle_go(a16, 17, 0, 250, 214, 120)
    myc_all_go(a17, 0)
  end

  -- Layer 15: the spring ITEM's icon -- water blue with a pale ring, so a spring in
  -- the hotbar does not look like a lake. Blocks never sample it (see icon_layer).
  pfn spring_go(a : NativeU8Arr, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16 - 8
      let y = i / 16 - 8
      let d2 = x * x + y * y
      let ring = if d2 >= 16 && d2 <= 30 do 70 else 0 end
      spring_go(put_rgba(a, 15 * 256 * 4 + i * 4, 40 + ring, 90 + ring, 200 + ring, 255), i + 1)
    end
  end

  doc "Texture layer for an item's HUD icon: as layer_for, except the spring item (id 4) shows its ring. The sea is also id 4 and must keep rendering as water, which is why this is not layer_for."
  fn icon_layer(id : Int) : Float do if id == 4 do 15.0 else layer_for(id) end end

  fn layers() : Int do 60 end
  fn water_layer() : Float do 1.0 end
  doc "Texture layer for a block id on face direction [d] (0 +y, 1 -y, 2 +x, 3 -x, 4 +z, 5 -z)."
  fn layer_for_face(id : Int, d : Int) : Float do
    if id == 16 do (if d <= 1 do 9.0 else 8.0 end)          -- oak log: rings on the cut ends, bark on the sides
    else if id == 18 do (if d <= 1 do 9.0 else 12.0 end)     -- pine log: darker bark
    else layer_for(id) end end
  end

  doc "Texture layer for a block id."
  fn layer_for(id : Int) : Float do
    if id == 2 do 2.0
    else if id == 3 do 3.0
    else if id >= 4 && id <= 11 do 1.0
    else if id == 12 do 4.0
    else if id == 13 do 5.0
    else if id == 14 do 6.0
    else if id == 15 do 7.0
    else if id == 16 do 8.0
    else if id == 18 do 12.0
    else if id == 17 do 10.0
    else if id == 19 do 11.0
    else if id == 20 do 13.0
    else if id == 21 do 14.0
    else if id == 22 do 17.0
    else if CubeForge.Chunk.is_myc(id) do layer_for(CubeForge.Chunk.myc_base(id))
    else 0.0 end end end end end end end end end end end end end end end
  end


  -- ── Mycelium layers: the base's pattern with threads over it ─────────────
  -- Layer 18 + 6 * base_index + (species - 1). Each layer REPRODUCES its base
  -- from the base's formula rather than copying the base layer: reading the
  -- array while writing it would copy all 60 KB per texel (GAPS G21).
  doc "Texture layer for mycelium over base index [k] (0..6) in species [sp] (1..6)."
  fn myc_layer(k : Int, sp : Int) : Float do int_to_float(18 + 6 * k + (sp - 1)) end

  -- The base colour for base index k, by the same numbers as the plain layers:
  -- grass is the checker (handled inline), everything else a speckle.
  pfn myc_base_r(k : Int) : Int do if k == 1 do 134 else if k == 2 do 219 else if k == 3 do 242 else if k == 4 do 112 else if k == 5 do 158 else 128 end end end end end end
  pfn myc_base_g(k : Int) : Int do if k == 1 do 96 else if k == 2 do 203 else if k == 3 do 246 else if k == 4 do 110 else if k == 5 do 142 else 128 end end end end end end
  pfn myc_base_b(k : Int) : Int do if k == 1 do 67 else if k == 2 do 146 else if k == 3 do 250 else if k == 4 do 106 else if k == 5 do 124 else 132 end end end end end end

  pfn myc_go(a : NativeU8Arr, layer : Int, k : Int, sp : Int, i : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let x = i % 16
      let y = i / 16
      let light = (x / 2 + y / 2) % 2 == 0
      let d = ((x * 7 + y * 13 + x * y) % 5) * 6 - 12
      let br = if k == 0 do (if light do 110 else 70 end) else myc_base_r(k) + d end
      let bg = if k == 0 do (if light do 190 else 140 end) else myc_base_g(k) + d end
      let bb = if k == 0 do (if light do 80 else 60 end) else myc_base_b(k) + d end
      -- the threads: a sparse branching lattice, about a third of the texels
      let t = (x * 3 + y * 5 + (x * y) % 7 + sp) % 9
      let thread = t < 3
      let sr = CubeForge.Species.colour_r(sp)
      let sg = CubeForge.Species.colour_g(sp)
      let sb = CubeForge.Species.colour_b(sp)
      -- a thread texel is two-thirds species colour; the rest of the layer is
      -- the base pulled a sixth of the way toward it, so the tint reads at a distance
      let r = if thread do (br + 2 * sr) / 3 else (5 * br + sr) / 6 end
      let g = if thread do (bg + 2 * sg) / 3 else (5 * bg + sg) / 6 end
      let b = if thread do (bb + 2 * sb) / 3 else (5 * bb + sb) / 6 end
      myc_go(put_rgba(a, layer * 1024 + i * 4, r, g, b, 255), layer, k, sp, i + 1)
    end
  end

  -- All 42 layers: j runs over base index x species.
  pfn myc_all_go(a : NativeU8Arr, j : Int) : NativeU8Arr do
    if j >= 42 do a
    else myc_all_go(myc_go(a, 18 + j, j / 6, j % 6 + 1, 0), j + 1) end
  end

end
