-- cube_forge — a minimal voxel renderer, written to find March's rough edges.
-- Spreading water: per-chunk WaterChunk actors, finite-level flow, cross-chunk spills.
mod CubeForge do

  needs IO
  needs IO.Foreign
  needs Window
  needs Input
  needs IO.Spawn
  needs IO.Clock
  needs IO.Process

  alias CubeForge.Ffi.Window as Win
  alias CubeForge.Ffi.Input as In
  alias CubeForge.F32Buf as F32Buf
  alias CubeForge.Math.Vec3 as V
  alias CubeForge.Math.Mat4 as M
  alias CubeForge.Math.Quat as Q
  alias CubeForge.Chunk as Chunk
  alias CubeForge.Mesher as Mesher
  alias CubeForge.Texture as Texture
  alias CubeForge.World as World
  alias CubeForge.Player as Player
  alias CubeForge.Hud as Hud
  alias CubeForge.Menu as Menu
  alias CubeForge.Raycast as Ray
  alias CubeForge.Outline as Outline
  alias CubeForge.Marker as Marker
  alias CubeForge.Water as Water
  alias CubeForge.ChunkMesh as CM
  alias CubeForge.Inventory as Inv
  alias CubeForge.Vertex as Vx
  alias CubeForge.Precip as Precip
  alias CubeForge.Weather as Weather
  alias CubeForge.Biome as Biome
  alias CubeForge.Veg as Veg
  alias CubeForge.Audio as Audio
  alias CubeForge.Tone as Tone
  alias CubeForge.Wind as Wind
  alias CubeForge.Ffi.Audio as Aud

  fn ms(seconds : Float) : String do float_to_string(seconds *. 1000.0) ++ "ms" end

  -- Everything the frame loop threads through. A variant so the per-frame
  -- rebuild can reuse the cell (see GAPS.md G12).
  -- frame, last_time, player, alloc_sample, view scratch, vp upload buffer, map-view toggle, marker buffer, flashlight, cached weather intensity, cached lightning bolt
  -- The weather actor's answer for one tick: intensity and lightning bolt.
  type Wx = Wx(Float, Float)
  pfn pair_a(w : Wx) : Float do match w do Wx(a, _) -> a end end
  pfn pair_b(w : Wx) : Float do match w do Wx(_, b) -> b end end

  type Frame = Frame(Int, Float, CubeForge.Player.Player, Int, NativeFloatArr, NativeF32Arr, Bool, CubeForge.F32Buf.F32Buf, Bool, Float, Float, Bool, Int, CubeForge.Menu.Menu, CubeForge.F32Buf.F32Buf, Int, Float, Int, CubeForge.Audio.Sched)   -- ..., inventory open, slot a stack was lifted from (-1 = not dragging), escape menu, its vertex buffer, seed of the session to start next (-1 = keep playing), worst frame seen after warmup, the frame it was, and the note schedule
  -- Frames before this are not counted toward the worst frame: the first few
  -- carry one-time costs (the first draw of each buffer, the first time down
  -- every path) that no steady-state budget should be measured against.
  fn warmup_frames() : Int do 60 end
  -- Mutable-per-edit world state: world, per-slot vertex counts (opaque 0..63, water 64..127), outline buffer, current hit,
  -- selected block id, water actor pids (Array, one per chunk), per-chunk "has dirty cells" flags
  -- `p` is the water-actor Pid type: Pid(state) cannot be written in an annotation (GAPS.md G45), so it is a parameter.
  -- ... and the per-chunk section meshes
  type Scene(p) = Scene(CubeForge.World.World, NativeIntArr, CubeForge.F32Buf.F32Buf, CubeForge.Raycast.Hit, Ui, Array.PVec(p), NativeIntArr, Array.PVec(CubeForge.ChunkMesh.ChunkMesh), CubeForge.Biome.Field, NativeIntArr)   -- ..., and the sections whose mesh is owed a rebuild (pass bitmask per section slot)
  -- inventory + hotbar buffers (untextured, textured icons) + last built HUD key
  type Ui = Ui(CubeForge.Inventory.Inv, CubeForge.F32Buf.F32Buf, CubeForge.F32Buf.F32Buf, Int)
  fn ui_inv(u : Ui) : CubeForge.Inventory.Inv do match u do Ui(i, _, _, _) -> i end end
  @[no_alloc]
  fn ui_with_inv(u : Ui, i : CubeForge.Inventory.Inv) : Ui do match u do Ui(_, a, b, k) -> Ui(i, a, b, k) end end

  -- Rebuild + upload the hotbar buffers when the inventory's HUD key changed.
  -- While the inventory is open the icons follow the cursor, so the key check is
  -- skipped and both buffers are rebuilt every frame. Closed, it rebuilds only
  -- when the inventory actually changed, as before.
  pfn refresh_hud(u : Ui, open : Bool, drag_from : Int, nx : Float, ny : Float) : Ui do
    match u do
      Ui(inv, hb, ic, key) ->
        let k = Inv.hud_key(inv) * 4 + (if open do 2 else 0 end) + (if drag_from >= 0 do 1 else 0 end)
        if k == key && !open do u
        else
          let hb1 = Hud.build_hotbar(hb, inv, Inv.progress(inv), open, drag_from)
          Win.gfx_upload(252, F32Buf.storage(hb1), F32Buf.len(hb1))
          let ic1 = Hud.build_icons(ic, inv, open, drag_from, nx, ny)
          Win.gfx_upload(251, F32Buf.storage(ic1), F32Buf.len(ic1))
          Ui(inv, hb1, ic1, k)
        end
    end
  end
  pfn hud_verts(u : Ui) : Int do match u do Ui(_, hb, _, _) -> F32Buf.len(hb) / Vx.floats() end end
  pfn icon_verts(u : Ui) : Int do match u do Ui(_, _, ic, _) -> F32Buf.len(ic) / Vx.floats() end end
  -- VBO slot map. 0..63 opaque chunks, 64..127 water, 128..191 foliage, and the
  -- named slots below. They are all one array in the shim (CF_MAX_MESHES = 256),
  -- so a slot used twice silently overwrites; keep this list complete.
  --   247 escape menu   248 biome map   249 precipitation   250 map marker
  --   251 hotbar icons  252 hotbar      253 underwater tint 254 selection outline
  --   255 fps counter
  fn menu_slot() : Int do 247 end
  fn water_slot_base() : Int do 64 end
  fn foliage_slot_base() : Int do 128 end
  fn tick_period() : Int do 10 end
  -- Which frame of the period each phase of the world tick runs on. Spread so
  -- that no frame carries more than one of them; see the frame loop. The
  -- retexture runs twice at half budget rather than once at full: it is the one
  -- phase whose work is a batch of independent columns, so it is the one that
  -- can be halved without being restructured.
  fn water_slot() : Int do 0 end
  fn field_slot() : Int do 2 end
  fn veg_slot() : Int do 6 end
  -- The retexture runs in halves, on two frames of the period. Quarters were
  -- measured and are worse: four batches remesh overlapping sections four
  -- times, and 131 fps against 137.
  fn migrate_slots() : Int do 2 end
  pfn is_migrate_slot(phase : Int) : Bool do
    if phase == 4 do true else phase == 8 end
  end

  -- ── Water actors ────────────────────────────────────────────────────────────
  -- Create the chunk-actor pool. The actors are spawned empty; `reload_water`
  -- gives each one its chunk, and does so again for every later session, so the
  -- pool is created exactly once per process.
  pfn spawn_water(i : Int, n : Int, acc) do
    if i < 0 do acc
    else spawn_water(i - 1, n, Cons(Water.spawn_chunk(), acc)) end
  end

  -- Tell the water actor about a player edit (and its neighbour when the cell is on a border).
  pfn notify_edit(sc, x : Int, y : Int, z : Int, id : Int) do
    match sc do
      Scene(w, counts, outline, hit, ui, pids, flags, meshes, bio, pend) ->
        let n = World.side(w)
        let cx = World.floor_div16(x)
        let cz = World.floor_div16(z)
        if !World.in_bounds(w, cx, cz) do sc
        else
          let ci = cx + n * cz
          let lx = World.mod16(x)
          let lz = World.mod16(z)
          Water.send_edited(Array.get(pids, ci), Water.idx(lx, y, lz), id)
          let f1 = NativeArray.set_int(flags, ci, 1)
          -- mirrors in the 4 neighbours: an edge cell changed
          let f2 = edge_notify(w, pids, f1, cx, cz, lx, y, lz, id)
          Scene(w, counts, outline, hit, ui, pids, f2, meshes, bio, pend)
        end
    end
  end

  -- If (lx, y, lz) is on a border, send WEdgeCell to the neighbour across it and flag that neighbour.
  pfn edge_notify(w : CubeForge.World.World, pids, flags : NativeIntArr, cx : Int, cz : Int, lx : Int, y : Int, lz : Int, id : Int) : NativeIntArr do
    let f1 = if lz == 0 do send_edge(w, pids, flags, cx, cz - 1, 1, Water.edge_slot(0, lx, y, lz), id) else flags end
    let f2 = if lz == 15 do send_edge(w, pids, f1, cx, cz + 1, 0, Water.edge_slot(1, lx, y, lz), id) else f1 end
    let f3 = if lx == 15 do send_edge(w, pids, f2, cx + 1, cz, 3, Water.edge_slot(2, lx, y, lz), id) else f2 end
    if lx == 0 do send_edge(w, pids, f3, cx - 1, cz, 2, Water.edge_slot(3, lx, y, lz), id) else f3 end
  end

  pfn send_edge(w : CubeForge.World.World, pids, flags : NativeIntArr, cx : Int, cz : Int, dir : Int, slot : Int, id : Int) : NativeIntArr do
    if !World.in_bounds(w, cx, cz) do flags
    else
      let ci = cx + World.side(w) * cz
      Water.send_edge_cell(Array.get(pids, ci), dir, slot, id)
      NativeArray.set_int(flags, ci, 1)
    end
  end

  pfn send_spill(w : CubeForge.World.World, pids, flags : NativeIntArr, cx : Int, cz : Int, dir : Int, slot : Int, level : Int) : NativeIntArr do
    if !World.in_bounds(w, cx, cz) do flags
    else
      let ci = cx + World.side(w) * cz
      Water.send_spill(Array.get(pids, ci), dir, slot, level)
      NativeArray.set_int(flags, ci, 1)
    end
  end

  -- Neighbour grid coordinates for a direction from (cx, cz).
  pfn nb_cx(cx : Int, dir : Int) : Int do if dir == 2 do cx + 1 else if dir == 3 do cx - 1 else cx end end end
  pfn nb_cz(cz : Int, dir : Int) : Int do if dir == 0 do cz - 1 else if dir == 1 do cz + 1 else cz end end end

  pfn flagged(flags : NativeIntArr, i : Int, n : Int, acc : List(Int)) : List(Int) do
    if i < 0 do acc else flagged(flags, i - 1, n, if NativeArray.get_int(flags, i) == 1 do Cons(i, acc) else acc end) end
  end

  -- Result of applying one reply: world and flags are both threaded (a NativeIntArr update
  -- returns the array — discarding it loses the write when the array is shared, GAPS.md G47).
  type Rep = Rep(CubeForge.World.World, NativeIntArr)

  -- Apply one actor's reply: cell writes are batched per chunk, edge/spill entries become
  -- messages to neighbours (flagging them), a pending marker keeps the chunk flagged.
  pfn apply_reply(w : CubeForge.World.World, pids, flags : NativeIntArr, ci : Int, out : List(Int), cells : List(Int)) : Rep do
    let n = World.side(w)
    let cx = ci % n
    let cz = ci / n
    match out do
      Nil -> Rep(World.set_cells(w, cx, cz, cells), flags)
      Cons(v, rest) ->
        let kind = v / 4294967296
        let payload = v % 4294967296
        if kind == 0 do apply_reply(w, pids, flags, ci, rest, Cons(payload, cells))
        else
          let dir = payload / 1048576
          let slot = (payload % 1048576) / 256
          let val = payload % 256
          if kind == 1 do
            apply_reply(w, pids, send_edge(w, pids, flags, nb_cx(cx, dir), nb_cz(cz, dir), Water.opposite(dir), slot, val), ci, rest, cells)
          else if kind == 2 do
            apply_reply(w, pids, send_spill(w, pids, flags, nb_cx(cx, dir), nb_cz(cz, dir), Water.opposite(dir), slot, val), ci, rest, cells)
          else if kind == 4 do
            -- a drop's foot: spray there
            Win.spray_at(16 * cx + payload % 16, payload / 256, 16 * cz + (payload / 16) % 16, 3)
            apply_reply(w, pids, flags, ci, rest, cells)
          else
            apply_reply(w, pids, NativeArray.set_int(flags, ci, 1), ci, rest, cells)
          end end end
        end
    end
  end

  pfn has_cells(out : List(Int)) : Bool do
    match out do
      Nil -> false
      Cons(v, rest) -> if v / 4294967296 == 0 do true else has_cells(rest) end
    end
  end
  -- Bitmask of edge directions present in a reply (bit d set when an edge-cell change in direction d occurred).
  pfn edge_mask(out : List(Int), acc : Int) : Int do
    match out do
      Nil -> acc
      Cons(v, rest) ->
        if v / 4294967296 == 1 do
          let dir = (v % 4294967296) / 1048576
          edge_mask(rest, int_or(acc, pow2(dir)))
        else edge_mask(rest, acc) end
    end
  end
  pfn pow2(n : Int) : Int do pow2_go(n, 1) end
  pfn pow2_go(n : Int, acc : Int) : Int do if n <= 0 do acc else pow2_go(n - 1, 2 * acc) end end

  type Applied = Applied(CubeForge.World.World, NativeIntArr, NativeIntArr, Array.PVec(CubeForge.ChunkMesh.ChunkMesh), Int, NativeIntArr)   -- world, counts, flags, meshes, sections owed, pending

  -- Owe the water pass on the sections of [smask] in chunk (cx, cz).
  pfn owe_sections(pend : NativeIntArr, cx : Int, cz : Int, smask : Int, sy : Int, n : Int) : NativeIntArr do
    if sy >= 16 do pend
    else if cx < 0 || cz < 0 || cx >= n || cz >= n do pend
    else if int_and(smask, pow2(sy)) != 0 do
      let slot = CubeForge.Light.mark_slot(cx, cz, sy)
      owe_sections(NativeArray.set_int(pend, slot, int_or(NativeArray.get_int(pend, slot), pass_water())), cx, cz, smask, sy + 1, n)
    else owe_sections(pend, cx, cz, smask, sy + 1, n) end end end
  end
  -- ... and on the neighbours named by [mask] (bits: 1 = -z, 2 = +z, 4 = +x, 8 = -x),
  -- whose culling a changed border cell also moves.
  pfn owe_neighbours(pend : NativeIntArr, cx : Int, cz : Int, smask : Int, mask : Int, n : Int) : NativeIntArr do
    let p1 = if int_and(mask, 4) != 0 do owe_sections(pend, cx + 1, cz, smask, 0, n) else pend end
    let p2 = if int_and(mask, 8) != 0 do owe_sections(p1, cx - 1, cz, smask, 0, n) else p1 end
    let p3 = if int_and(mask, 2) != 0 do owe_sections(p2, cx, cz + 1, smask, 0, n) else p2 end
    if int_and(mask, 1) != 0 do owe_sections(p3, cx, cz - 1, smask, 0, n) else p3 end
  end

  -- Bitmask (bit sy) of the sections touched by the cell changes in a reply.
  pfn section_mask(out : List(Int), acc : Int) : Int do
    match out do
      Nil -> acc
      Cons(v, rest) ->
        if v / 4294967296 == 0 do section_mask(rest, int_or(acc, pow2((v % 4294967296) / 256 / 4096)))
        else section_mask(rest, acc) end
    end
  end

  -- Rebuild every section named in [mask] (bit sy) of chunk (cx, cz); concat+upload once. Returns Remeshed and the count of rebuilt sections.
  -- ── The mesh oracle ──────────────────────────────────────────────────
  -- Every vertex of every section of every chunk, hashed. The state hash covers
  -- blocks and the biome field, which is the wrong oracle for a remesh change: a
  -- rebuild that skips a pass it should have rebuilt leaves the world identical
  -- and the screen stale. Verified against that failure: pointing the retexture
  -- rebuild at a no-op moved this hash and left the other two untouched.
  pfn hash_f32(a : NativeF32Arr, i : Int, n : Int, h : Int) : Int do
    if i >= n do h
    else hash_f32(a, i + 1, n, (h * 131 + float_to_int(NativeArray.get_f32(a, i) *. 64.0) + 8388608) % 1073741789) end
  end
  pfn hash_buf(b : CubeForge.F32Buf.F32Buf, h : Int) : Int do
    hash_f32(F32Buf.storage(b), 0, F32Buf.len(b), (h * 131 + F32Buf.len(b)) % 1073741789)
  end
  pfn hash_secs(secs : Array.PVec(CubeForge.F32Buf.F32Buf), sy : Int, h : Int) : Int do
    if sy >= 16 do h else hash_secs(secs, sy + 1, hash_buf(Array.get(secs, sy), h)) end
  end
  pfn mesh_hash_go(meshes, ci : Int, n : Int, h : Int) : Int do
    if ci >= n * n do h
    else
      let m = Array.get(meshes, ci)
      mesh_hash_go(meshes, ci + 1, n,
                   hash_secs(CM.foliage_sections(m), 0, hash_secs(CM.water_sections(m), 0, hash_secs(CM.opaque_sections(m), 0, h))))
    end
  end
  fn mesh_hash(meshes, n : Int) : Int do mesh_hash_go(meshes, 0, n, 7) end

  -- Which passes of a section a remesh has to rebuild, as a bitmask so that the
  -- pending queue can OR two edits' demands together. An edit that cannot move a
  -- water cell or a leaf need not pay for those passes: the greedy mesh and its
  -- per-vertex light lookups are the cost, and they are per pass.
  fn pass_opaque() : Int do 1 end
  fn pass_water() : Int do 2 end
  fn pass_foliage() : Int do 4 end
  doc "All three: a player's edit, which can change anything."
  fn pass_all() : Int do 7 end
  doc "Opaque and foliage, no water: growing or felling a tree."
  fn pass_solid() : Int do 5 end

  pfn rebuild_for(m : CubeForge.ChunkMesh.ChunkMesh, world : CubeForge.World.World, cx : Int, cz : Int, sy : Int, empty : CubeForge.Chunk.Chunk, passes : Int) : CubeForge.ChunkMesh.ChunkMesh do
    CM.rebuild_section_sel(m, world, cx, cz, sy, empty,
                           int_and(passes, pass_opaque()) != 0, int_and(passes, pass_water()) != 0, int_and(passes, pass_foliage()) != 0)
  end

  pfn remesh_sections(world : CubeForge.World.World, cx : Int, cz : Int, mask : Int, sy : Int, m : CubeForge.ChunkMesh.ChunkMesh, empty : CubeForge.Chunk.Chunk, passes : Int) : CubeForge.ChunkMesh.ChunkMesh do
    if sy >= 16 do m
    else
      -- a changed cell on a section boundary changes the adjacent section's culling too
      let hit = int_and(mask, pow2(sy)) != 0
      let m1 = if hit do rebuild_for(m, world, cx, cz, sy, empty, passes) else m end
      remesh_sections(world, cx, cz, mask, sy + 1, m1, empty, passes)
    end
  end

  pfn widen_mask(mask : Int, sy : Int, acc : Int) : Int do
    if sy >= 16 do acc
    else if int_and(mask, pow2(sy)) != 0 do widen_mask(mask, sy + 1, int_or(int_or(acc, pow2(sy)), int_or(if sy > 0 do pow2(sy - 1) else 0 end, if sy < 15 do pow2(sy + 1) else 0 end)))
    else widen_mask(mask, sy + 1, acc) end end
  end

  pfn count_bits(mask : Int, sy : Int, acc : Int) : Int do
    if sy >= 16 do acc else count_bits(mask, sy + 1, if int_and(mask, pow2(sy)) != 0 do acc + 1 else acc end) end
  end

  pfn apply_all(w : CubeForge.World.World, pids, flags : NativeIntArr, counts : NativeIntArr, meshes, cis : List(Int), replies, empty : CubeForge.Chunk.Chunk, remeshed : Int, pend : NativeIntArr) : Applied do
    match cis do
      Nil -> Applied(w, counts, flags, meshes, remeshed, pend)
      Cons(ci, rest) ->
        match replies do
          Nil -> Applied(w, counts, flags, meshes, remeshed, pend)
          Cons(r, rrest) ->
            match r do
              Err(e) ->
                println("water tick error for chunk " ++ int_to_string(ci) ++ ": " ++ e)
                apply_all(w, pids, flags, counts, meshes, rest, rrest, empty, remeshed, pend)
              Ok(out) ->
                let n = World.side(w)
                match apply_reply(w, pids, flags, ci, out, Nil) do
                  Rep(w1, flags1) ->
                    if has_cells(out) do
                      let cx = ci % n
                      let cz = ci / n
                      let smask = widen_mask(section_mask(out, 0), 0, 0)
                      -- The cells are in the world; the water pass of those
                      -- sections is owed, and so is that of the neighbours whose
                      -- culling a changed border cell moves. The queue pays it.
                      let p1 = owe_sections(pend, cx, cz, smask, 0, n)
                      apply_all(w1, pids, flags1, counts, meshes, rest, rrest, empty, remeshed + count_bits(smask, 0, 0),
                                owe_neighbours(p1, cx, cz, smask, edge_mask(out, 0), n))
                    else apply_all(w1, pids, flags1, counts, meshes, rest, rrest, empty, remeshed, pend) end
                end
            end
        end
    end
  end

  -- Remesh every section any chunk marked dirty. Per-vertex light is baked into
  -- the mesh, so a section whose light moved shows stale lighting until it is
  -- rebuilt -- and a relight reaches much further than the edited cell.
  -- ── The deferred remesh queue ────────────────────────────────────────────
  -- The world tick's phases change blocks in bursts -- a retexture batch, a
  -- tree -- and rebuilding every section they touch in the same frame is what
  -- makes that frame long. The world changes at once, as it always did; the
  -- MESH is owed, and paid off at a fixed number of sections a frame. That is
  -- what bounds the frame, rather than a schedule tuned per phase.
  --
  -- The player's own edits do NOT go through here: mining has to be immediate,
  -- and one edit is one section's worth of work anyway.
  doc "Sections rebuilt per frame while the queue is not empty."
  fn remesh_budget() : Int do 4 end

  -- Owe [passes] on every section [marks] touched.
  pfn stage_go(pend : NativeIntArr, marks : NativeIntArr, i : Int, passes : Int) : NativeIntArr do
    if i >= 1024 do pend
    else if NativeArray.get_int(marks, i) != 0 do
      stage_go(NativeArray.set_int(pend, i, int_or(NativeArray.get_int(pend, i), passes)), marks, i + 1, passes)
    else stage_go(pend, marks, i + 1, passes) end end
  end

  -- The OR of what a chunk's sections owe (0 when it owes nothing), and how many owe something.
  pfn owed_mask(pend : NativeIntArr, cx : Int, cz : Int, sy : Int, acc : Int) : Int do
    if sy >= 16 do acc
    else owed_mask(pend, cx, cz, sy + 1, int_or(acc, NativeArray.get_int(pend, CubeForge.Light.mark_slot(cx, cz, sy)))) end
  end
  pfn owed_count(pend : NativeIntArr, cx : Int, cz : Int, sy : Int, acc : Int) : Int do
    if sy >= 16 do acc
    else owed_count(pend, cx, cz, sy + 1, if NativeArray.get_int(pend, CubeForge.Light.mark_slot(cx, cz, sy)) != 0 do acc + 1 else acc end) end
  end
  pfn drain_sections(world : CubeForge.World.World, cx : Int, cz : Int, pend : NativeIntArr, sy : Int,
                     m : CubeForge.ChunkMesh.ChunkMesh, empty : CubeForge.Chunk.Chunk) : CubeForge.ChunkMesh.ChunkMesh do
    if sy >= 16 do m
    else
      let want = NativeArray.get_int(pend, CubeForge.Light.mark_slot(cx, cz, sy))
      let m1 = if want != 0 do rebuild_for(m, world, cx, cz, sy, empty, want) else m end
      drain_sections(world, cx, cz, pend, sy + 1, m1, empty)
    end
  end
  pfn clear_chunk(pend : NativeIntArr, cx : Int, cz : Int, sy : Int) : NativeIntArr do
    if sy >= 16 do pend
    else clear_chunk(NativeArray.set_int(pend, CubeForge.Light.mark_slot(cx, cz, sy), 0), cx, cz, sy + 1) end
  end

  type Drained = Drained(NativeIntArr, Array.PVec(CubeForge.ChunkMesh.ChunkMesh), NativeIntArr)   -- counts, meshes, pending

  -- A chunk at a time, so each one uploads once however many of its sections it
  -- owed. The budget is checked before a chunk is started, so a frame can
  -- overshoot by at most the sections of one chunk.
  pfn drain_go(w : CubeForge.World.World, pend : NativeIntArr, ci : Int, n : Int, counts : NativeIntArr,
               meshes, empty : CubeForge.Chunk.Chunk, budget : Int) : Drained do
    if ci >= n * n do Drained(counts, meshes, pend)
    else if budget <= 0 do Drained(counts, meshes, pend)
    else
      let cx = ci % n
      let cz = ci / n
      let mask = owed_mask(pend, cx, cz, 0, 0)
      if mask == 0 do drain_go(w, pend, ci + 1, n, counts, meshes, empty, budget)
      else
        let done = owed_count(pend, cx, cz, 0, 0)
        let m1 = drain_sections(w, cx, cz, pend, 0, Array.get(meshes, ci), empty)
        drain_go(w, clear_chunk(pend, cx, cz, 0), ci + 1, n, upload_chunk_passes(m1, ci, counts, mask),
                 Array.set(meshes, ci, m1), empty, budget - done)
      end
    end end
  end

  doc "Pay off at most [budget] sections of the mesh the world owes."
  pfn drain(sc, budget : Int) do
    match sc do
      Scene(w, counts, outline, hit, ui, pids, flags, meshes, bio, pend) ->
        match drain_go(w, pend, 0, World.side(w), counts, meshes, Chunk.new(), budget) do
          Drained(c1, m1, pend1) -> Scene(w, c1, outline, hit, ui, pids, flags, m1, bio, pend1)
        end
    end
  end

  pfn remesh_marked(w : CubeForge.World.World, marks : NativeIntArr, ci : Int, n : Int,
                    counts : NativeIntArr, meshes, empty : CubeForge.Chunk.Chunk, passes : Int) : Remeshed do
    if ci >= n * n do Remeshed(counts, meshes)
    else
      let smask = CubeForge.Light.section_mask(marks, ci % n, ci / n)
      if smask == 0 do remesh_marked(w, marks, ci + 1, n, counts, meshes, empty, passes)
      else
        match remesh_chunk_sections(w, ci % n, ci / n, smask, counts, meshes, empty, passes) do
          Remeshed(c1, m1) -> remesh_marked(w, marks, ci + 1, n, c1, m1, empty, passes)
        end
      end
    end
  end

  -- The edited cell's own geometry changes even when its light does not: its
  -- faces, the section above or below when it sits on a section boundary, and
  -- the neighbouring chunk's culling when it sits on a chunk boundary.
  pfn mark_geometry(marks : NativeIntArr, x : Int, y : Int, z : Int, n : Int) : NativeIntArr do
    let cx = World.floor_div16(x)
    let cz = World.floor_div16(z)
    let sy = y / 16
    let ly = y % 16
    let m1 = NativeArray.set_int(marks, CubeForge.Light.mark_slot(cx, cz, sy), 1)
    let m2 = if ly == 0 && sy > 0 do NativeArray.set_int(m1, CubeForge.Light.mark_slot(cx, cz, sy - 1), 1) else m1 end
    let m3 = if ly == 15 && sy < 15 do NativeArray.set_int(m2, CubeForge.Light.mark_slot(cx, cz, sy + 1), 1) else m2 end
    let lx = World.mod16(x)
    let lz = World.mod16(z)
    let m4 = if lx == 0 && cx > 0 do NativeArray.set_int(m3, CubeForge.Light.mark_slot(cx - 1, cz, sy), 1) else m3 end
    let m5 = if lx == 15 && cx < n - 1 do NativeArray.set_int(m4, CubeForge.Light.mark_slot(cx + 1, cz, sy), 1) else m4 end
    let m6 = if lz == 0 && cz > 0 do NativeArray.set_int(m5, CubeForge.Light.mark_slot(cx, cz - 1, sy), 1) else m5 end
    if lz == 15 && cz < n - 1 do NativeArray.set_int(m6, CubeForge.Light.mark_slot(cx, cz + 1, sy), 1) else m6 end
  end

  pfn remesh_chunk_sections(w : CubeForge.World.World, cx : Int, cz : Int, smask : Int, counts : NativeIntArr, meshes, empty : CubeForge.Chunk.Chunk, passes : Int) : Remeshed do
    if !World.in_bounds(w, cx, cz) do Remeshed(counts, meshes)
    else
      let ci = cx + World.side(w) * cz
      let m1 = remesh_sections(w, cx, cz, smask, 0, Array.get(meshes, ci), empty, passes)
      Remeshed(upload_chunk_passes(m1, ci, counts, passes), Array.set(meshes, ci, m1))
    end
  end

  -- One water tick: call every flagged chunk actor in parallel, apply the replies, remesh what changed.
  -- Cells still queued across every chunk after a tick: the kind-3 markers' payloads summed.
  pfn active_cells(replies, acc : Int) : Int do
    match replies do
      Nil -> acc
      Cons(r, rest) -> active_cells(rest, acc + reply_pending(r))
    end
  end
  pfn reply_pending(r) : Int do
    match r do
      Ok(out) -> pending_of(out, 0)
      _ -> 0
    end
  end
  pfn pending_of(out : List(Int), acc : Int) : Int do
    match out do
      Nil -> acc
      Cons(v, rest) -> pending_of(rest, if v / 4294967296 == 3 do acc + v % 4294967296 else acc end)
    end
  end

  pfn water_tick(sc, workers : Int, verbose : Bool) do
    match sc do
      Scene(w, counts, outline, hit, sel, pids, flags, meshes, bio, pend) ->
        let n = World.side(w)
        let cis = flagged(flags, n * n - 1, n, Nil)
        match cis do
          Nil -> sc
          _ ->
            let t0 = Win.time()
            -- clear flags first; replies (pending markers, spills) re-flag as needed
            let flags1 = clear_flags(flags, cis)
            let replies = List.pmap_n(cis, fn ci -> Water.call_tick(Array.get(pids, ci)), workers)
            let t1 = Win.time()
            match apply_all(w, pids, flags1, counts, meshes, cis, replies, Chunk.new(), 0, pend) do
              Applied(w1, counts1, flags2, meshes1, remeshed, pend1) ->
                let t2 = Win.time()
                if verbose do
                  println("water tick: " ++ int_to_string(List.length(cis)) ++ " chunks, calls " ++ ms(t1 -. t0) ++ ", apply " ++ ms(t2 -. t1) ++ " (" ++ int_to_string(remeshed) ++ " sections owed), active cells " ++ int_to_string(active_cells(replies, 0)) ++ ", reply sizes " ++ reply_sizes(replies))
                else () end
                Scene(w1, counts1, outline, hit, sel, pids, flags2, meshes1, bio, pend1)
            end
        end
    end
  end

  pfn reply_sizes(replies) : String do reply_sizes_go(replies, "") end

  pfn reply_sizes_go(replies, acc : String) : String do
    match replies do
      Nil -> acc
      Cons(r, rest) ->
        let sz = match r do
          Ok(out) -> int_to_string(List.length(out))
          Err(_) -> "err"
        end
        reply_sizes_go(rest, acc ++ sz ++ " ")
    end
  end

  pfn clear_flags(flags : NativeIntArr, cis : List(Int)) : NativeIntArr do
    match cis do
      Nil -> flags
      Cons(ci, rest) -> clear_flags(NativeArray.set_int(flags, ci, 0), rest)
    end
  end

  pfn scene_water_count(sc, cx : Int, cz : Int) : Int do
    match sc do Scene(w, _, _, _, _, _, _, _, _, _) -> Chunk.count_water(World.chunk_at(w, cx, cz)) end
  end

  fn reach() : Float do 8.0 end

  -- Upload a chunk mesh's two buffers into chunk slot [slot] and record their vertex counts.
  pfn upload_sections(slot : Int, secs : Array.PVec(CubeForge.F32Buf.F32Buf), i : Int, offset : Int) : Unit do
    if i >= 16 do ()
    else
      let b = Array.get(secs, i)
      Win.gfx_upload_part(slot, offset, F32Buf.storage(b), F32Buf.len(b))
      upload_sections(slot, secs, i + 1, offset + F32Buf.len(b))
    end
  end
  pfn upload_chunk(m : CubeForge.ChunkMesh.ChunkMesh, slot : Int, counts : NativeIntArr) : NativeIntArr do
    upload_chunk_passes(m, slot, counts, pass_all())
  end

  -- Upload only the passes that were rebuilt. Every remesh used to push all
  -- three passes of all sixteen sections of the chunk whichever one it had
  -- touched, so a water cell moving re-sent that chunk's terrain and leaves as
  -- well. The vertex counts are still written for all three -- they are three
  -- array stores, and a pass that was not rebuilt has the count it already had.
  pfn upload_chunk_passes(m : CubeForge.ChunkMesh.ChunkMesh, slot : Int, counts : NativeIntArr, passes : Int) : NativeIntArr do
    let os = CM.opaque_sections(m)
    let ws = CM.water_sections(m)
    let fs = CM.foliage_sections(m)
    if int_and(passes, pass_opaque()) != 0 do
      Win.gfx_upload_begin(slot, CM.total_floats(os))
      upload_sections(slot, os, 0, 0)
    else () end
    if int_and(passes, pass_water()) != 0 do
      Win.gfx_upload_begin(water_slot_base() + slot, CM.total_floats(ws))
      upload_sections(water_slot_base() + slot, ws, 0, 0)
    else () end
    if int_and(passes, pass_foliage()) != 0 do
      Win.gfx_upload_begin(foliage_slot_base() + slot, CM.total_floats(fs))
      upload_sections(foliage_slot_base() + slot, fs, 0, 0)
    else () end
    NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(counts, slot, CM.opaque_vertices(m)),
                                            water_slot_base() + slot, CM.water_vertices(m)),
                        foliage_slot_base() + slot, CM.foliage_vertices(m))
  end

  -- counts + meshes after a remesh
  type Remeshed = Remeshed(NativeIntArr, Array.PVec(CubeForge.ChunkMesh.ChunkMesh))

  -- Rebuild section [sy] (and sy±1 when [also_adjacent]) of chunk (cx, cz), re-concatenate and upload.
  pfn remesh_section(world : CubeForge.World.World, cx : Int, cz : Int, sy : Int, also_adjacent : Bool,
                     counts : NativeIntArr, meshes, empty : CubeForge.Chunk.Chunk) : Remeshed do
    if !World.in_bounds(world, cx, cz) do Remeshed(counts, meshes)
    else
      let ci = cx + World.side(world) * cz
      let m0 = Array.get(meshes, ci)
      let m1 = CM.rebuild_section(m0, world, cx, cz, sy, empty)
      let m2 = if also_adjacent do CM.rebuild_section(CM.rebuild_section(m1, world, cx, cz, sy - 1, empty), world, cx, cz, sy + 1, empty) else m1 end
      Remeshed(upload_chunk(m2, ci, counts), Array.set(meshes, ci, m2))
    end
  end

  -- Apply a block edit at (x, y, z): set the block, remesh its chunk, and a
  -- neighbour chunk when the block sits on a chunk boundary (its faces are
  -- culled against the neighbour, so the neighbour's mesh changes too).
  pfn edit_block(sc, x : Int, y : Int, z : Int, id : Int) do
    match sc do
      Scene(world, counts, outline, hit, ui, pids, flags, meshes, bio, pend) ->
        let t0 = Win.time()
        let w0 = World.set_occupied(World.set_block(world, x, y, z, id), x, y, z, CubeForge.Light.occludes(id))
        let bio1 = Biome.note_edit(bio, w0, x, y, z, id)
        let was_spring = y > Chunk.sea_level() && Chunk.is_source(World.block_at(world, x, y, z))
        let is_spring = y > Chunk.sea_level() && Chunk.is_source(id)
        if was_spring != is_spring do Win.spring_set(x, y, z, is_spring) else () end
        if is_spring && !was_spring do Win.spray_at(x, y, z, 40) else () end
        Win.gfx_set_voxel(x, y, z, CubeForge.Light.occludes(id))
        let n = World.side(w0)
        -- accessors, not a match: a dotted constructor pattern does not parse (GAPS.md G24/G25)
        let relit = CubeForge.Light.relight_marked(World.light(w0), w0, x, y, z)
        let world1 = World.set_light(w0, CubeForge.Light.relit_field(relit))
        let marks = mark_geometry(CubeForge.Light.relit_marks(relit), x, y, z, n)
        match remesh_marked(world1, marks, 0, n, counts, meshes, Chunk.new(), pass_all()) do
          Remeshed(c1, m1) ->
            let t1 = Win.time()
            println((if id == 0 do "broke" else "placed" end) ++ " block at " ++ int_to_string(x) ++ "," ++ int_to_string(y) ++ "," ++ int_to_string(z)
                    ++ " — edit + section remesh " ++ ms(t1 -. t0))
            notify_edit(Scene(world1, c1, outline, hit, ui, pids, flags, m1, bio1, pend), x, y, z, id)
        end
    end
  end

  -- Scripted: remove every source block within 3 cells of the player's feet (the one CF_AUTOFLOW placed).
  -- Grow or fell every tree in the batch, then remesh ONCE. Each tree: its
  -- blocks, a relight at the trunk's middle (reach 15 covers any tree), the
  -- occupancy texture for its box, and section marks for exactly the sections
  -- its 9x9 box touches. remesh_region's fixed 3x3 chunks per tree was the
  -- cost -- two trees at ~60 ms each -- when a tree touches one or two.
  pfn veg_go(w : CubeForge.World.World, bio : CubeForge.Biome.Field, marks : NativeIntArr, seed : Int, n : Int, entries : List(Int)) : Migrated do
    match entries do
      Nil -> Migrated(w, bio, marks)
      Cons(e, rest) ->
        let ci = Veg.column_of(e)
        let x = ci % (n * 16)
        let z = ci / (n * 16)
        let h = Biome.height_of(bio, x, z)
        let bush = Veg.is_bush(e)
        -- a bush's leaf is the surface the heightmap sees; a tree's ground is under its trunk
        let base = if !Veg.is_decay(e) do h else if bush do h - 1 else Veg.trunk_base(w, x, z, h) end end
        let b = Biome.biome_of(bio, x, z)
        -- the box above ground the edit can touch: a trunk and canopy, or one layer of leaves
        let trunk = if bush do 0 - 1 else if Veg.pine_for(b) do 7 else 5 end end
        let w1 = if bush do
          if Veg.is_decay(e) do Veg.unbush(w, x, z, base) else Veg.plant_bush(w, x, z, base) end
        else
          if Veg.is_decay(e) do Veg.fell(w, x, z, base) else Veg.plant(w, x, z, base, trunk, Veg.pine_for(b)) end
        end
        -- relight_marked, not relight_at: the relight can change baked light in
        -- sections the tree's box never touched, and a section whose light moved
        -- but whose mesh was not rebuilt renders stale. The relight reports
        -- exactly which sections it changed; those join the geometry marks.
        let relit = CubeForge.Light.relight_marked(World.light(w1), w1, x, base + (if bush do 1 else 4 end), z)
        let w2 = World.set_light(w1, CubeForge.Light.relit_field(relit))
        sync_occupancy(w2, x, z, base, base + trunk + 2)
        let marks1 = or_marks(mark_box(marks, x - 4, base, z - 4, x + 4, base + trunk + 2, z + 4, n, 0), CubeForge.Light.relit_marks(relit), 0)
        veg_go(w2, Biome.rescan_box(bio, w2, x, z, Veg.decay_radius() + 1, base + trunk + 2), marks1, seed, n, rest)
    end
  end
  pfn or_marks(a : NativeIntArr, b : NativeIntArr, i : Int) : NativeIntArr do
    if i >= 1024 do a
    else or_marks(if NativeArray.get_int(b, i) != 0 do NativeArray.set_int(a, i, 1) else a end, b, i + 1) end
  end
  -- Mark every section a box touches: the box's corners at each section row it spans.
  pfn mark_box(marks : NativeIntArr, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int, n : Int, i : Int) : NativeIntArr do
    let rows = y1 / 16 - y0 / 16 + 1
    if i >= 4 * rows do marks
    else
      let y = (y0 / 16 + i / 4) * 16
      let x = if i % 2 == 0 do x0 else x1 end
      let z = if (i / 2) % 2 == 0 do z0 else z1 end
      let xc = if x < 0 do 0 else if x >= n * 16 do n * 16 - 1 else x end end
      let zc = if z < 0 do 0 else if z >= n * 16 do n * 16 - 1 else z end end
      mark_box(mark_geometry(marks, xc, if y > y1 do y1 else y end, zc, n), x0, y0, z0, x1, y1, z1, n, i + 1)
    end
  end

  pfn count_bush(entries : List(Int), acc : Int) : Int do
    match entries do
      Nil -> acc
      Cons(e, rest) -> count_bush(rest, if Veg.is_bush(e) do acc + 1 else acc end)
    end
  end
  pfn vegetate(sc, seed : Int, entries : List(Int)) do
    match entries do
      Nil -> sc
      _ ->
        match sc do
          Scene(world, counts, outline, hit, ui, pids, flags, meshes, bio, pend) ->
            let n = World.side(world)
            match veg_go(world, bio, CubeForge.Light.marks_new(), seed, n, entries) do
              Migrated(w1, bio1, marks) ->
                -- The tree stands in the world now; its sections are owed a
                -- rebuild of opaque (the trunk) and foliage (the canopy).
                Scene(w1, counts, outline, hit, ui, pids, flags, meshes, bio1, stage_go(pend, marks, 0, pass_solid()))
            end
        end
    end
  end

  -- The shadow occupancy texture is per-voxel on the GPU; push the tree's box.
  pfn sync_occupancy(w : CubeForge.World.World, x : Int, z : Int, y0 : Int, y1 : Int) : Unit do sync_go(w, x, z, y0, y1, 0) end
  pfn sync_go(w : CubeForge.World.World, x : Int, z : Int, y0 : Int, y1 : Int, i : Int) : Unit do
    if i >= 81 * (y1 - y0 + 1) do ()
    else
      let bx = x - 4 + i % 9
      let bz = z - 4 + (i / 9) % 9
      let yy = y0 + i / 81   -- not `by`: reserved (GAPS G65)
      Win.gfx_set_voxel(bx, yy, bz, CubeForge.Light.occludes(World.block_at(w, bx, yy, bz)))
      sync_go(w, x, z, y0, y1, i + 1)
    end
  end

  -- Retexture a batch of columns as ONE edit: every pick is a palette block
  -- replacing a palette block, so opacity never changes and no relight is
  -- needed; the touched sections are collected into one marks array and
  -- remeshed once. Doing it through edit_block cost ~7 ms per column, almost
  -- all of it a relight and a per-column section remesh.
  -- The field update is batched (Biome.note_edits) rather than one note_edit per
  -- column: each column's height and water flag depend only on that column, so
  -- noting them all against the finished world is the same answer for two array
  -- copies instead of sixty-four.
  pfn migrate_go(w : CubeForge.World.World, bio : CubeForge.Biome.Field, marks : NativeIntArr, n : Int, cols : List(Int), edits : List(Int)) : Migrated do
    match cols do
      Nil -> Migrated(w, Biome.note_edits(bio, w, edits), marks)
      Cons(ci, rest) ->
        let x = ci % (n * 16)
        let z = ci / (n * 16)
        let h = Biome.height_of(bio, x, z)
        let id = Biome.palette(Biome.biome_of(bio, x, z))
        migrate_go(World.set_block(w, x, h, z, id), bio, mark_geometry(marks, x, h, z, n), n, rest,
                   Cons(Biome.pack_edit(x, h, z, id), edits))
    end
  end
  type Migrated = Migrated(CubeForge.World.World, CubeForge.Biome.Field, NativeIntArr)

  -- Ground truth: every section of every chunk from the current world and light.
  pfn remesh_everything(sc) do
    match sc do
      Scene(world, counts, outline, hit, ui, pids, flags, meshes, bio, pend) ->
        let n = World.side(world)
        match remesh_marked(world, all_marks(0, NativeArray.make_int(1024, 0)), 0, n, counts, meshes, Chunk.new(), pass_all()) do
          Remeshed(c1, m1) -> Scene(world, c1, outline, hit, ui, pids, flags, m1, bio, pend)
        end
    end
  end
  pfn all_marks(i : Int, m : NativeIntArr) : NativeIntArr do if i >= 1024 do m else all_marks(i + 1, NativeArray.set_int(m, i, 1)) end end

  pfn migrate(sc, cols : List(Int)) do
    match cols do
      Nil -> sc
      _ ->
        match sc do
          Scene(world, counts, outline, hit, ui, pids, flags, meshes, bio, pend) ->
            let n = World.side(world)
            match migrate_go(world, bio, CubeForge.Light.marks_new(), n, cols, Nil) do
              Migrated(w1, bio1, marks) ->
                Scene(w1, counts, outline, hit, ui, pids, flags, meshes, bio1, stage_go(pend, marks, 0, pass_opaque()))
            end
        end
    end
  end

  -- Water on the surface at (px+3, pz+dz) for dz in [k, 4]: nine columns east of the player.
  -- Every source above sea level: told to the shim, and its chunk flagged so the
  -- water actor ticks from the first frame (a chunk with a spring is always live).
  pfn spring_flags(w : CubeForge.World.World, f : CubeForge.Biome.Field, i : Int, n : Int, flags : NativeIntArr) : NativeIntArr do
    if i >= n * n * 256 do
      println("springs: " ++ int_to_string(Win.spring_count()))
      flags
    else
      let x = i % (n * 16)
      let z = i / (n * 16)
      let h = Biome.height_of(f, x, z)
      if h > Chunk.sea_level() && Chunk.is_source(World.block_at(w, x, h, z)) do
        Win.spring_set(x, h, z, true)
        println("  spring at " ++ int_to_string(x) ++ "," ++ int_to_string(h) ++ "," ++ int_to_string(z))
        spring_flags(w, f, i + 1, n, NativeArray.set_int(flags, World.floor_div16(x) + n * World.floor_div16(z), 1))
      else spring_flags(w, f, i + 1, n, flags) end
    end
  end

  pfn dig_canal(sc, p : CubeForge.Player.Player, k : Int) do
    if k > 4 do sc
    else
      let cx = float_to_int(V.x(Player.position(p))) + 3
      let cz = float_to_int(V.z(Player.position(p))) + k
      let h = Biome.height_of(scene_biome(sc), cx, cz)
      dig_canal(edit_block(sc, cx, h + 1, cz, Chunk.id_of_level(7)), p, k + 1)
    end
  end

  pfn break_sources_near(sc, p : CubeForge.Player.Player) do
    let pos = Player.position(p)
    let px = float_to_int(Math.floor(V.x(pos)))
    let py = float_to_int(Math.floor(V.y(pos)))
    let pz = float_to_int(Math.floor(V.z(pos)))
    break_sources_go(sc, px - 3, py - 3, pz - 3, px, py, pz, 0)
  end
  pfn break_sources_go(sc, x : Int, y : Int, z : Int, px : Int, py : Int, pz : Int, i : Int) do
    if i >= 343 do sc
    else
      let cx = x + i % 7
      let cy = y + (i / 7) % 7
      let cz = z + i / 49
      let sc1 = if Chunk.is_source(World.block_at(scene_world(sc), cx, cy, cz)) do edit_block(sc, cx, cy, cz, 0) else sc end
      break_sources_go(sc1, x, y, z, px, py, pz, i + 1)
    end
  end

  -- Scripted: break the topmost collidable block strictly below the player's feet.
  -- Always hits terrain regardless of where the camera points, so the edit cost is
  -- comparable run to run.
  pfn break_under(sc, p : CubeForge.Player.Player) do
    let pos = Player.position(p)
    let px = float_to_int(Math.floor(V.x(pos)))
    let pz = float_to_int(Math.floor(V.z(pos)))
    let y = World.surface_y(scene_world(sc), px, pz)
    if y < 0 || !World.breakable_at(scene_world(sc), px, y, pz) do sc
    else
      -- Collect it too, so the scripted break follows the same path as a real
      -- one: a benchmark that skipped the pickup would not exercise it.
      let id = World.block_at(scene_world(sc), px, y, pz)
      set_inv(edit_block(sc, px, y, pz, 0), Inv.harvest(ui_inv(scene_ui(sc)), id))
    end
  end

  doc "Blocks either side of the listener the leaf sample reaches."
  fn leaf_radius() : Int do 6 end
  doc "Stride of the leaf lattice. Every second block: a full per-voxel sweep of this box would be 2197 World.block_at calls a tick, which is exactly the cost GAPS G64 warns about, and the answer wanted here is one gain."
  fn leaf_stride() : Int do 2 end

  -- Foliage blocks on a coarse lattice around (x, y, z). Deliberately sparse:
  -- the result is a gain, not geometry, so a sample is as good as a census.
  pfn leaf_scan(w : CubeForge.World.World, x : Int, y : Int, z : Int, i : Int, n : Int, hits : Int) : Int do
    if i >= n do hits
    else
      let side = 2 * leaf_radius() / leaf_stride() + 1
      let dx = (i % side) * leaf_stride() - leaf_radius()
      let dy = (i / side % side) * leaf_stride() - leaf_radius()
      let dz = (i / (side * side)) * leaf_stride() - leaf_radius()
      let hit = if Chunk.is_foliage(World.block_at(w, x + dx, y + dy, z + dz)) do 1 else 0 end
      leaf_scan(w, x, y, z, i + 1, n, hits + hit)
    end
  end

  doc "How much of the canopy is around the listener, 0..1."
  fn leaf_amount(w : CubeForge.World.World, x : Int, y : Int, z : Int) : Float do
    let side = 2 * leaf_radius() / leaf_stride() + 1
    let n = side * side * side
    Audio.leaf_fraction(leaf_scan(w, x, y, z, 0, n, 0), n)
  end

  doc "Radius searched for orphaned leaves when a log is broken."
  fn decay_radius() : Int do 4 end

  -- Remove the leaves a broken log was holding up, then remesh the affected
  -- region ONCE: the decay touches up to a 9x9x9 box, so remeshing per removed
  -- leaf would mean dozens of chunk-section rebuilds for a single chop.
  pfn chop(sc, x : Int, y : Int, z : Int) do
    match sc do
      Scene(world, counts, outline, hit, ui, pids, flags, meshes, bio, pend) ->
        let world1 = World.decay_leaves(world, x, y, z, decay_radius())
        let world2 = World.relight_at(world1, x, y, z)
        match remesh_region(world2, x, y, z, counts, meshes, Chunk.new(), 0) do
          Remeshed(c1, m1) -> Scene(world2, c1, outline, hit, ui, pids, flags, m1, Biome.rescan_box(bio, world2, x, z, decay_radius(), 0), pend)
        end
    end
  end

  -- Rebuild every chunk section the decay box can touch: the 3x3 chunk columns
  -- around (x, z) and the sections spanning y +- decay_radius().
  pfn remesh_region(world : CubeForge.World.World, x : Int, y : Int, z : Int, counts : NativeIntArr, meshes, empty : CubeForge.Chunk.Chunk, i : Int) : Remeshed do
    if i >= 9 do Remeshed(counts, meshes)
    else
      let cx = World.floor_div16(x) - 1 + i % 3
      let cz = World.floor_div16(z) - 1 + i / 3
      let sy = y / 16
      match remesh_section(world, cx, cz, sy, true, counts, meshes, empty) do
        Remeshed(c1, m1) -> remesh_region(world, x, y, z, c1, m1, empty, i + 1)
      end
    end
  end

  -- Would placing a block at (x, y, z) overlap the player's box?
  pfn overlaps_player(p : CubeForge.Player.Player, x : Int, y : Int, z : Int) : Bool do
    let pos = Player.position(p)
    let px = V.x(pos)
    let py = V.y(pos)
    let pz = V.z(pos)
    let fx = int_to_float(x)
    let fy = int_to_float(y)
    let fz = int_to_float(z)
    fx < px +. Player.half_width() && fx +. 1.0 > px -. Player.half_width()
      && fy < py +. Player.height() && fy +. 1.0 > py
      && fz < pz +. Player.half_width() && fz +. 1.0 > pz -. Player.half_width()
  end

  -- Per-frame: raycast from the eye, refresh the outline, apply the break-hold and placement.
  -- [break_held] is the button level (or scripted), [place_now] an edge, [new_sel] a slot 1..4 or 0.
  -- [place_id] > 0 forces a block id for scripted edits.
  pfn interact(sc, p : CubeForge.Player.Player, break_held : Bool, place_now : Bool, place_id : Int, new_sel : Int, dt : Float) do
    match sc do
      Scene(world, counts, outline, _, ui0, pids, flags, meshes, bio, pend) ->
        let inv0 = if new_sel > 0 do Inv.select(ui_inv(ui0), new_sel) else ui_inv(ui0) end
        let e = Player.eye(p)
        let d = Player.forward(Player.yaw(p), Player.pitch(p))
        -- water is only a target while a water item is held (to place against / scoop);
        -- otherwise the ray passes through it so the bed can be worked from the surface or
        -- underwater. Keyed on the held item, not the slot: slots hold whatever was dropped
        -- in them since the inventory window, and the hotbar starts empty. Springs stop the
        -- ray regardless (see Raycast.blocks_ray), so they can be mined with an empty hand.
        let hit = Ray.cast(world, V.x(e), V.y(e), V.z(e), V.x(d), V.y(d), V.z(d), reach(), !Chunk.is_water(Inv.selected_id(inv0)))
        let outline1 = if Ray.is_hit(hit) do Outline.build(outline, Ray.bx(hit), Ray.by_(hit), Ray.bz(hit)) else F32Buf.clear(outline) end
        if Ray.is_hit(hit) do CubeForge.Ffi.Window.gfx_upload(254, F32Buf.storage(outline1), F32Buf.len(outline1)) else () end
        -- breaking: hold accumulates on the same target; release, a miss, or an
        -- unbreakable block (bedrock: the world floor) resets, so no progress shows.
        let can_break = break_held && Ray.is_hit(hit) && World.breakable_at(world, Ray.bx(hit), Ray.by_(hit), Ray.bz(hit))
        let inv1 = if can_break do Inv.hold(inv0, Ray.bx(hit), Ray.by_(hit), Ray.bz(hit), dt) else Inv.release(inv0) end
        let sc1 = Scene(world, counts, outline1, hit, ui_with_inv(ui0, inv1), pids, flags, meshes, bio, pend)
        if Inv.is_complete(inv1) do
          let id = World.block_at(world, Ray.bx(hit), Ray.by_(hit), Ray.bz(hit))
          let sc2 = edit_block(sc1, Ray.bx(hit), Ray.by_(hit), Ray.bz(hit), 0)
          -- chopping a trunk drops the canopy it was holding up
          let sc3 = if Chunk.is_log(id) do chop(sc2, Ray.bx(hit), Ray.by_(hit), Ray.bz(hit)) else sc2 end
          set_inv(sc3, Inv.release(Inv.harvest(inv1, id)))
        else if place_now && Ray.is_hit(hit) do
          let px = Ray.bx(hit) + Ray.nx(hit)
          let py = Ray.by_(hit) + Ray.ny(hit)
          let pz = Ray.bz(hit) + Ray.nz(hit)
          let forced = place_id > 0
          let id = if forced do place_id else Inv.selected_id(inv1) end
          let allowed = forced || Inv.can_place(inv1)
          if !allowed do sc1
          else if id != Chunk.water() && overlaps_player(p, px, py, pz) do sc1
          else
            let sc2 = edit_block(sc1, px, py, pz, id)
            if forced do sc2 else set_inv(sc2, Inv.consume(inv1)) end
          end end
        else sc1 end end
    end
  end

  @[no_alloc]
  pfn set_inv(sc, inv : CubeForge.Inventory.Inv) do
    match sc do Scene(w, c, o, h, u, p, f, m, b, q) -> Scene(w, c, o, h, ui_with_inv(u, inv), p, f, m, b, q) end
  end
  pfn scene_ui(sc) : Ui do match sc do Scene(_, _, _, _, u, _, _, _, _, _) -> u end end
  @[no_alloc]
  pfn scene_with_ui(sc, u : Ui) do match sc do Scene(w, c, o, h, _, p, f, m, b, q) -> Scene(w, c, o, h, u, p, f, m, b, q) end end
  pfn scene_biome(sc) : CubeForge.Biome.Field do match sc do Scene(_, _, _, _, _, _, _, _, b, _) -> b end end
  pfn scene_with_biome(sc, b : CubeForge.Biome.Field) do match sc do Scene(w, c, o, h, u, p, f, m, _, q) -> Scene(w, c, o, h, u, p, f, m, b, q) end end
  fn inv_string(sc) : String do
    let i = ui_inv(scene_ui(sc))
    "inv " ++ slots_string(i, 0, "") ++ "sel=" ++ int_to_string(Inv.sel(i)) ++ " progress=" ++ float_to_string(Inv.progress(i))
  end
  -- Non-empty slots as "slot:item x count", so the debug line follows items
  -- around rather than assuming a fixed block per slot.
  pfn slots_string(i : CubeForge.Inventory.Inv, s : Int, acc : String) : String do
    if s >= Inv.slots() do acc
    else
      let acc1 = if Inv.count_at(i, s) > 0 do
        acc ++ int_to_string(s) ++ ":" ++ int_to_string(Inv.item_at(i, s)) ++ "x" ++ int_to_string(Inv.count_at(i, s)) ++ " "
      else acc end
      slots_string(i, s + 1, acc1)
    end
  end

  pfn scene_counts(sc) : NativeIntArr do match sc do Scene(_, c, _, _, _, _, _, _, _, _) -> c end end
  pfn scene_world(sc) : CubeForge.World.World do match sc do Scene(w, _, _, _, _, _, _, _, _, _) -> w end end
  pfn scene_meshes(sc) do match sc do Scene(_, _, _, _, _, _, _, m, _, _) -> m end end
  pfn scene_has_hit(sc) : Bool do match sc do Scene(_, _, _, h, _, _, _, _, _, _) -> Ray.is_hit(h) end end
  fn scene_hit_string(sc) : String do
    match sc do
      Scene(_, _, _, h, _, _, _, _, _, _) -> if Ray.is_hit(h) do int_to_string(Ray.bx(h)) ++ "," ++ int_to_string(Ray.by_(h)) ++ "," ++ int_to_string(Ray.bz(h)) ++ " face " ++ int_to_string(Ray.nx(h)) ++ "," ++ int_to_string(Ray.ny(h)) ++ "," ++ int_to_string(Ray.nz(h)) else "none" end
    end
  end
  -- FPS meter: window start time, frames in window, last displayed fps, HUD vertex buffer
  type Fps = Fps(Float, Int, Int, CubeForge.F32Buf.F32Buf)

  -- Update the FPS meter every 0.25 s and rebuild + upload the HUD digits when it changes.
  pfn tick_fps(f : Fps, now : Float) : Fps do
    match f do
      Fps(t0, n, shown, hud) ->
        if now -. t0 >= 0.25 do
          let fps = float_to_int(int_to_float(n + 1) /. (now -. t0) +. 0.5)
          let hud1 = Hud.build_number(hud, fps, 0.006, 0.008)
          Win.gfx_upload(255, F32Buf.storage(hud1), F32Buf.len(hud1))
          Fps(now, 0, fps, hud1)
        else
          Fps(t0, n + 1, shown, hud)
        end
    end
  end
  pfn fps_hud_verts(f : Fps) : Int do match f do Fps(_, _, _, hud) -> F32Buf.len(hud) / Vx.floats() end end

  pfn axis(neg : Bool, pos : Bool) : Float do
    if pos && !neg do 1.0 else if neg && !pos do -1.0 else 0.0 end end
  end

  doc "Sun level 0..1 = the height of the sun's arc, clamped at the horizon. The day starts at noon (cosine, not sine); night is the clamped half of the cycle. A day is CF_DAY seconds, 1800 (30 minutes) by default."
  fn sun_level_at(a : Float) : Float do
    let phase = Math.cos(a)
    if phase < 0.0 do 0.0 else phase end
  end

  doc "Sunlight intensity 0..1. Full while the sun is above roughly 13 degrees, falling to 0 at the horizon. Deliberately NOT the sun's height: a low sun is still bright, it just strikes surfaces at a glancing angle, which the N.L term handles. Mirrors SET_AT in the fragment shader."
  fn sun_intensity(sun : Float) : Float do
    if sun >= 0.22 do 1.0 else sun /. 0.22 end
  end

  doc "How far into dusk the sky is, 0..1: 0 with the sun high, 1 at the horizon."
  fn dusk_amount(sun : Float) : Float do
    if sun >= 0.55 do 0.0 else (0.55 -. sun) /. 0.55 end
  end

  doc "Fog density for weather intensity [w] 0..1. Clear weather is haze, not nothing, so distance always reads; a storm is roughly fifteen times denser. Squared so the first half of the range stays subtle."
  fn fog_density(w : Float) : Float do 0.002 +. 0.028 *. w *. w end

  doc "Overcast 0..1 from weather intensity: cloud builds faster than rain does, so the sky greys before it pours."
  fn overcast_of(w : Float) : Float do
    let o = w *. 1.4
    if o > 1.0 do 1.0 else o end
  end

  doc "Weather intensity 0..1: CF_WEATHER (0..100) when pinned, otherwise the actor's value."
  fn weather_now(pin : Int, actor_value : Float) : Float do
    if pin < 0 do actor_value else int_to_float(pin) /. 100.0 end
  end

  doc "Blend a sky channel toward the overcast grey. The 0.85 is what makes cloud read as duller rather than merely greyer."
  fn overcast_sky(c : Float, lum : Float, ov : Float) : Float do c +. (lum *. 0.85 -. c) *. ov end

  doc "Moonlight 0..1: full through the night, fading out as the sun climbs. Matches the ramp the fragment shader uses so the sky and the ground agree."
  fn moon_level(sun : Float) : Float do
    if sun >= 0.25 do 0.0 else (0.25 -. sun) /. 0.25 end
  end

  -- The sun rides a great circle: straight up at noon, on the horizon at dawn
  -- and dusk, below it at night. `sun_level` is exactly this arc's height
  -- clamped at zero, so the two never disagree about when it is dark.
  -- The z tilt keeps the arc off a perfectly vertical plane, so north and south
  -- faces are not lit identically all day.
  fn sun_arc_angle(t : Float, day : Float) : Float do t *. 6.283185307 /. day end

  doc "The arc angle to use this frame: the clock, or CF_SUN degrees when it is set (>= 0). 0 is noon, 90 sunset, 180 midnight, 270 sunrise."
  fn arc_angle(t : Float, day : Float, sun_deg : Int) : Float do
    if sun_deg < 0 do sun_arc_angle(t, day)
    else int_to_float(sun_deg) *. 0.01745329252 end
  end
  doc "Direction to the sun: +x at dusk, -x at dawn, +y at noon."
  fn sun_dir_x(a : Float) : Float do Math.sin(a) end
  fn sun_dir_y(a : Float) : Float do Math.cos(a) end
  fn sun_dir_z() : Float do 0.35 end

  -- Gather this frame's input into a value the (Input-cap-free) Player module can consume.
  -- Block selection: keys 1-4; 0 when none is pressed this frame.
  -- Seed editing while the menu is open: digits append, Backspace deletes, R
  -- rerolls. All edges, so holding a key does not repeat.
  pfn menu_digit(m : CubeForge.Menu.Menu, code : Int, d : Int) : CubeForge.Menu.Menu do
    if In.key_pressed(code) do Menu.append_digit(m, d) else m end
  end
  pfn menu_keys(m : CubeForge.Menu.Menu) : CubeForge.Menu.Menu do
    let m0 = menu_digit(menu_digit(menu_digit(menu_digit(menu_digit(
             menu_digit(menu_digit(menu_digit(menu_digit(menu_digit(m,
             In.key_0(), 0), In.key_1(), 1), In.key_2(), 2), In.key_3(), 3), In.key_4(), 4),
             In.key_5(), 5), In.key_6(), 6), In.key_7(), 7), In.key_8(), 8), In.key_9(), 9)
    let m1 = if In.key_pressed(In.key_backspace()) do Menu.backspace(m0) else m0 end
    if In.key_pressed(In.key_r()) do Menu.reroll(m1, float_to_int(Win.time() *. 1000000.0)) else m1 end
  end

  doc "The seed CF_AUTOMENU starts its second session with; fixed so the run is reproducible."
  fn automenu_seed() : Int do 424242 end

  pfn selected_key() : Int do
    if In.key(In.key_1()) do 1
    else if In.key(In.key_2()) do 2
    else if In.key(In.key_3()) do 3
    else if In.key(In.key_4()) do 4
    else if In.key(In.key_5()) do 5
    else if In.key(In.key_6()) do 6
    else if In.key(In.key_7()) do 7
    else if In.key(In.key_8()) do 8
    else if In.key(In.key_9()) do 9
    else 0 end end end end end end end end end
  end

  @[no_alloc(assume)]
  pfn read_input(autowalk : Bool, autospin : Float, autoswim : Bool, autodive : Bool) : CubeForge.Player.Input do
    -- CF_AUTOWALK=1: scripted forward walk for headless collision verification.
    let mf = if autowalk do 1.0 else axis(In.key(In.key_s()), In.key(In.key_w())) end
    let mr = axis(In.key(In.key_a()), In.key(In.key_d()))
    -- CF_AUTODIVE=1 is CF_AUTOSWIM's opposite: it spawns over the same water
    -- column and holds the sink key instead of the swim key, so the eye ends up
    -- under the surface. Without it there is no headless way to reach the
    -- underwater state at all, and the bed that plays there cannot be checked.
    CubeForge.Player.Input(mf, mr, In.mouse_dx() +. autospin, In.mouse_dy(),
                           In.key(In.key_space()) || autoswim, In.key(In.key_shift()) || autodive)
  end

  -- View matrix for the player's eye, written into the persistent scratch array in place.
  pfn write_view(p : CubeForge.Player.Player, view : NativeFloatArr) : NativeFloatArr do
    let q = Q.from_yaw_pitch(Player.yaw(p), Player.pitch(p))
    let e = Player.eye(p)
    M.write_view(Q.x(q), Q.y(q), Q.z(q), Q.w(q), V.x(e), V.y(e), V.z(e), view)
  end

  -- Half-width, in blocks, of the area the map camera shows (a local overhead view, not the
  -- whole world at once — the camera follows the player, see map_view below).
  fn map_half_extent() : Float do 32.0 end
  -- Orthographic projection has no perspective, so the camera's altitude does not affect zoom
  -- (map_half_extent alone does) — it only has to clear the marker's height (Marker.y()) and the
  -- tallest possible terrain (255), or the marker falls behind the camera and never renders.
  fn map_altitude() : Float do 300.0 end

  -- Top-down view-projection centred on the player's (x, z). Rebuilt fresh each map-view frame
  -- (unlike the steady first-person camera, which updates a persistent buffer in place) since
  -- map view is an occasional toggle, not part of the @[no_alloc] frame-loop hot path.
  pfn map_view(map_proj : NativeFloatArr, p : CubeForge.Player.Player) : NativeF32Arr do
    let pos = Player.position(p)
    let eye = V.new(V.x(pos), map_altitude(), V.z(pos))
    let target = V.new(V.x(pos), 0.0, V.z(pos))
    let view_m = M.look_at(eye, target, V.new(0.0, 0.0, -1.0))
    M.write_f32(M.mul(map_proj, view_m), NativeArray.make_f32(16, 0.0))
  end

  -- (kept for the allocation bisect) the temporary-matrix version
  pfn view_proj(proj : NativeFloatArr, p : CubeForge.Player.Player, dst : NativeF32Arr) : NativeF32Arr do
    let q = Q.from_yaw_pitch(Player.yaw(p), Player.pitch(p))
    let rot = Q.to_mat4(Q.conjugate(q))
    let view = M.mul(rot, M.translation(V.scale(Player.eye(p), -1.0)))
    M.write_f32(M.mul(proj, view), dst)
  end

  pfn repeat_view_inplace(proj : NativeFloatArr, p : CubeForge.Player.Player, view : NativeFloatArr, dst : NativeF32Arr, i : Int) : NativeF32Arr do
    if i == 0 do dst else
      let view1 = write_view(p, view)
      repeat_view_inplace(proj, p, view1, M.mul_into_f32(proj, view1, dst), i - 1)
    end
  end

  -- Frame loop. `max_frames < 0` means run until the window closes.
  -- Run-time knobs read once, outside the frame loop (an Env read allocates).
  type Knobs = Knobs(Int, Int, String, Bool, Float, Int, Bool, Int, Int, Int, Float, Int, Float, Bool, Int, Int, Int, Int, Int, Bool, Int, Int, Int, Int, Int, Int, Int, Bool, Bool)   -- max_frames, dump_frame, dump_path, autowalk, autospin, autoedit frame (<0 = off), autoswim, autoflow frame (<0 = off), workers, automap frame (<0 = off; forces map view on from this frame, for headless verification), day length in seconds, sun angle override in degrees (<0 = follow the clock), shadow reach in blocks (0 = off), soft shadow edges, autobreak frame (<0 = off): break the column under the player every 20 frames, for a repeatable edit benchmark, weather pin 0..100 (<0 = follow the actor), precipitation pool capacity, biome ease rate in percent (100 = one CF_DAY per full swing), draw the biome map in map view, autocanal frame (<0 = off): lay a 9-block line of water three columns east of the player, aim-independent, for the biome end-to-end test, biome migration budget: surface columns retextured per tick, vegetation budget: trees grown or felled per tick, time pin in seconds (<0 = live clock) for the water animation, remesh-all frame (<0 = off): rebuild every section of every chunk at that frame, a ground truth for stale-mesh hunts, automenu frame (<0 = off): open the escape menu at that frame and start a new game five frames later, for the restart test, audio mode (0 off, 1 device, 2 null device -- render a tick per push straight into the WAV, for reproducible headless dumps), audio log, autodive

  fn frame_loop(f : Frame, k : Knobs, sc, nchunks : Int, proj : NativeFloatArr, map_proj : NativeFloatArr, fps : Fps, wxpid, seed : Int) : Frame do
    match f do
      Frame(frame, last_t, player, sample, view, vp, map_mode, marker, flash, wcache, bcache, inv_open, drag_from, menu, menubuf, next_seed, worst, worst_at, sched) ->
        match k do
        Knobs(max_frames, dump_frame, dump_path, autowalk, autospin, autoedit, autoswim, autoflow, workers, automap, day_len, sun_deg, shadow_dist, soft_shadows, autoinv, autobreak, weather_pin, precip_cap, biome_rate, biome_map, autocanal, biome_budget, veg_budget, time_pin, remesh_all_at, automenu, audio_mode, audio_log, autodive) ->
        if Win.should_close() || (max_frames >= 0 && frame >= max_frames) || next_seed >= 0 do
          Frame(frame, last_t, player, sample, view, vp, map_mode, marker, flash, wcache, bcache, inv_open, drag_from, menu, menubuf, next_seed, worst, worst_at, sched)
        else
          In.poll()
          -- I toggles the inventory. While it is open the cursor is released and no
          -- input reaches the player; the world keeps ticking, as in the map view.
          -- I is ignored while the menu is up, so the two panels can never be open together.
          let i_key = In.key_pressed(In.key_i()) && !Menu.is_open(menu)
          let inv_open1 = if i_key do !inv_open else inv_open end
          if i_key do CubeForge.Ffi.Input.capture_cursor(!inv_open1) else () end
          -- Esc closes the inventory if it is open, and otherwise toggles the menu.
          -- It is read as an edge, not a level: a held key would toggle every frame.
          let esc = In.key_pressed(In.key_escape())
          let inv_open2 = if autoinv >= 0 && frame >= autoinv do true
                          else if esc do false else inv_open1 end end
          let menu0 = if esc && !inv_open1 do Menu.set_open(menu, !Menu.is_open(menu)) else menu end
          -- CF_AUTOMENU=<frame>: open the menu at that frame, put `automenu_seed`
          -- in the field and start a new game five frames later. It fires only
          -- while the session's own seed differs from the target, so the restart
          -- happens exactly once however long the run is.
          let scripted_menu = automenu >= 0 && seed != automenu_seed()
          let menu1 = if scripted_menu && frame == automenu do Menu.set_seed(Menu.set_open(menu0, true), automenu_seed()) else menu0 end
          -- Either panel releases the cursor; with both closed the mouse looks around again.
          let ui_open = inv_open2 || Menu.is_open(menu1)
          if esc do CubeForge.Ffi.Input.capture_cursor(!ui_open) else () end
          if In.button_pressed(In.button_left()) && !ui_open do CubeForge.Ffi.Input.capture_cursor(true) else () end
          let map_mode0 = if In.key_pressed(In.key_m()) do !map_mode else map_mode end
          let map_mode1 = if automap >= 0 && frame >= automap do true else map_mode0 end
          let now = Win.time()
          let dt = if now -. last_t > 0.1 do 0.1 else now -. last_t end
          -- The frame that just ended, for the frame-budget gauge. Not dt: dt is
          -- clamped for the physics, and a clamped spike is exactly the one worth
          -- seeing. Uncapped runs (CF_VSYNC=0) measure the work; with vsync on
          -- this measures the wait as well, so a budget is checked uncapped.
          let elapsed = now -. last_t
          let worst1 = if frame > warmup_frames() && elapsed > worst do elapsed else worst end
          let worst_at1 = if frame > warmup_frames() && elapsed > worst do frame - 1 else worst_at end
          -- Cursor in NDC. The shim hands back framebuffer pixels, so the only
          -- conversion here is pixels to NDC, with y flipped (screen y grows down).
          -- Read only while the window is open: each of these extern calls returns
          -- a Float, which costs an allocation, and the frame loop is meant to hold
          -- at one live object per frame.
          let ndc_x = if ui_open do 2.0 *. In.mouse_x() /. int_to_float(Win.fb_width()) -. 1.0 else 0.0 end
          let ndc_y = if ui_open do 1.0 -. 2.0 *. In.mouse_y() /. int_to_float(Win.fb_height()) else 0.0 end
          -- Press lifts a non-empty slot onto the cursor; release drops it on
          -- whatever slot is under the cursor, or returns it home on a miss.
          let hovered = if inv_open2 do Hud.slot_at(ndc_x, ndc_y, true) else -1 end
          -- One line a second while the window is open: the cursor's raw pixels,
          -- the NDC they map to, and the slot under it. If the window-to-
          -- framebuffer scale were wrong the NDC would run outside [-1, 1] with
          -- the pointer still over the window, which is the failure this catches.
          if autoinv >= 0 && inv_open2 && frame % 60 == 0 do
            println("cursor px (" ++ float_to_string(In.mouse_x()) ++ ", " ++ float_to_string(In.mouse_y())
                    ++ ") fb " ++ int_to_string(Win.fb_width()) ++ "x" ++ int_to_string(Win.fb_height())
                    ++ " -> ndc (" ++ float_to_string(ndc_x) ++ ", " ++ float_to_string(ndc_y)
                    ++ ") slot " ++ int_to_string(hovered))
          else () end
          let drag1 = if !inv_open2 do -1
                      else if drag_from < 0 && In.button_pressed(In.button_left()) && hovered >= 0
                              && !Inv.is_empty_at(ui_inv(scene_ui(sc)), hovered) do hovered
                      else drag_from end end
          let dropped = inv_open2 && drag1 >= 0 && In.button_released(In.button_left())
          if dropped do
            println("drag " ++ int_to_string(drag1) ++ " -> " ++ (if hovered >= 0 do int_to_string(hovered) else "nothing (returned)" end))
          else () end
          let sc_drag = if dropped && hovered >= 0 do
                          set_inv(sc, Inv.move_stack(ui_inv(scene_ui(sc)), drag1, hovered))
                        else sc end
          let drag2 = if dropped do -1 else drag1 end
          -- ── Menu ────────────────────────────────────────────────────────────
          let m_hover = if Menu.is_open(menu1) do Menu.item_at(ndc_x, ndc_y) else -1 end
          let menu2 = if Menu.is_open(menu1) do menu_keys(Menu.set_focus(menu1, m_hover)) else menu1 end
          let m_click = Menu.is_open(menu2) && In.button_pressed(In.button_left()) && m_hover >= 0
          if m_click && m_hover == Menu.item_quit() do Win.request_close() else () end
          -- Enter starts too, so the seed can be typed and committed without the mouse.
          let start = (m_click && m_hover == Menu.item_new_game())
                      || (Menu.is_open(menu2) && In.key_pressed(In.key_enter()))
                      || (scripted_menu && frame == automenu + 5 && Menu.is_open(menu2))
          let next_seed1 = if start do Menu.seed(menu2) else next_seed end
          if start do println("new game, seed " ++ int_to_string(Menu.seed(menu2))) else () end
          let menubuf1 = if Menu.is_open(menu2) do
                           let mb = Hud.build_menu(menubuf, menu2)
                           Win.gfx_upload(menu_slot(), F32Buf.storage(mb), F32Buf.len(mb))
                           mb
                         else menubuf end
          let player1 = if ui_open do player
                        else Player.update(player, read_input(autowalk, autospin, autoswim && frame >= 320, autodive && frame >= 320), scene_world(sc_drag), dt) end
          let view1 = write_view(player1, view)
          let vp1 = M.mul_into_f32(proj, view1, vp)
          -- The map camera follows the player (x, z) so it reads as a local overhead view, not a
          -- fixed satellite shot of the whole world; it recomputes a fresh matrix each frame this
          -- is shown, unlike the steady per-frame camera above (map view is an occasional toggle).
          let render_vp = if map_mode1 do map_view(map_proj, player1) else vp1 end
          -- CF_AUTOEDIT=<frame>: scripted break at that frame and place 60 frames later (headless verification)
          -- scripted: hold break for 60 frames from `autoedit`, place the harvested block at +120, water at +180
          let scripted_hold = autoedit >= 0 && ((frame >= autoedit && frame < autoedit + 60) || (frame >= autoedit + 240 && frame < autoedit + 300))
          let scripted_sel = if autoedit >= 0 && frame >= autoedit + 240 && frame < autoedit + 300 do 4 else 0 end
          let scripted_place = autoedit >= 0 && frame == autoedit + 120
          let place_water = (autoedit >= 0 && frame == autoedit + 180) || (autoflow >= 0 && frame == autoflow)
          -- No breaking or placing while the inventory is open: those clicks are drags.
          let sc0 = if ui_open do sc_drag
                    else interact(sc_drag, player1, In.button(In.button_left()) || scripted_hold, In.button_pressed(In.button_right()) || scripted_place || place_water,
                                  if place_water do Chunk.id_of_level(7) else -1 end, if scripted_place do 1 else if scripted_sel > 0 do scripted_sel else selected_key() end end, dt) end
          -- CF_AUTOFLOW: break the source again 600 frames after placing it
          let sc0b = if autoflow >= 0 && frame == autoflow + 600 do break_sources_near(sc0, player1) else sc0 end
          -- CF_AUTOBREAK=<frame>: from that frame, mine straight down one block every 20 frames.
          -- A repeatable, aim-independent edit benchmark: every break hits real terrain.
          let sc0c = if autobreak >= 0 && frame >= autobreak && (frame - autobreak) % 20 == 0 do break_under(sc0b, player1) else sc0b end
          -- CF_AUTOCANAL=<frame>: a line of water beside the player, placed through
          -- edit_block so the biome field sees it the way a real edit would.
          let sc0d = if autocanal >= 0 && frame == autocanal do dig_canal(sc0c, player1, -4) else sc0c end
          -- The world tick, spread over three frames of the period rather than
          -- landing in one. The phases were already sequential and each is a
          -- whole step on its own; running them in the same frame only ever
          -- meant one frame carrying all of it. Together they cost ~25 ms, which
          -- is a stall at any frame rate; apart they are ~8, ~8 and ~9.
          --
          -- The order within a period is unchanged -- water, then the field and
          -- its retexturing, then vegetation -- and every rolling cursor still
          -- advances once per period, since they are keyed on frame / tick_period().
          -- What does change is that vegetation reads a field three frames older
          -- than the retexture left it, which is why this moves the state hash
          -- where every other step in this sequence held it.
          let phase = frame % tick_period()
          -- water simulation tick
          let scw = if phase == water_slot() do water_tick(sc0d, workers, autoflow >= 0) else sc0d end
          -- The climate field.
          let scb = if phase == field_slot() do
            let tb0 = Win.time()
            let f1 = scene_with_biome(scw, Biome.tick(scene_biome(scw), scene_world(scw), seed, Biome.default_rate() *. int_to_float(biome_rate) /. 100.0))
            if autoflow >= 0 && frame % 100 == field_slot() do println("biome tick: " ++ ms(Win.time() -. tb0)) else () end
            f1
          else scw end
          -- Retexturing: the surface migrates toward the biome's palette, each
          -- column a real edit so relight, remesh and the water actors all see
          -- it. Half the budget on each of two frames. Both halves read the same
          -- window of the rolling cursor, which is keyed on the period, and the
          -- first half's columns are no longer candidates by the time the second
          -- runs -- so a period still retextures up to biome_budget columns from
          -- the same window, in two smaller pieces.
          let scm = if is_migrate_slot(phase) do
            let tm0 = Win.time()
            let picks = Biome.migrations(scene_biome(scb), scene_world(scb), frame / tick_period(), 2048, biome_budget / migrate_slots())
            let m1 = migrate(scb, picks)
            if autoflow >= 0 && frame % 100 == 4 do println("biome migrate: " ++ int_to_string(List.length(picks)) ++ " columns in " ++ ms(Win.time() -. tm0)) else () end
            m1
          else scb end
          -- One tree every other period, not every one. Growing a tree is the
          -- one phase that is a single indivisible edit -- its relight and its
          -- remesh are for one trunk -- so it cannot be halved by splitting the
          -- batch the way the retexture is. Halving how often it runs is the
          -- only lever it has, and trees grow half as fast for it.
          let sc1pre = if if phase == veg_slot() do (frame / tick_period()) % 2 == 0 else false end do
            -- Vegetation: grow where the biome wants a tree and the cell says so,
            -- fell where it no longer does. Each one is a chop-sized edit.
            let tv0 = Win.time()
            let vpicks = Veg.candidates(scene_biome(scm), scene_world(scm), seed, frame / tick_period(), 2048, veg_budget)
            let scv = vegetate(scm, seed, vpicks)
            if autoflow >= 0 && frame % 100 == veg_slot() do println("biome veg: " ++ int_to_string(List.length(vpicks) - count_bush(vpicks, 0)) ++ " trees, " ++ int_to_string(count_bush(vpicks, 0)) ++ " bushes in " ++ ms(Win.time() -. tv0)) else () end
            scv
          else scm end
          -- Pay off the mesh the world owes, a bounded number of sections a
          -- frame. This is what holds the frame time down: the phases above
          -- change blocks in bursts, and the rebuild is spread behind them.
          --
          -- On the frames BETWEEN the phases. Every phase sits on an even frame
          -- of the period, so draining on the odd ones stops the rebuild from
          -- stacking on top of the work that asked for it -- which was the whole
          -- of the difference between a 14 ms frame and a 5 ms one. Five drain
          -- frames a period is more throughput than the phases can generate.
          let sc1 = if phase % 2 == 1 do drain(sc1pre, remesh_budget()) else sc1pre end
          if autoflow >= 0 && frame >= autoflow && (frame - autoflow) % 100 == 0 do
            let cx = World.floor_div16(float_to_int(Math.floor(V.x(Player.position(player1)))))
            let cz = World.floor_div16(float_to_int(Math.floor(V.z(Player.position(player1)))))
            println("frame " ++ int_to_string(frame) ++ " water cells: chunk(" ++ int_to_string(cx) ++ "," ++ int_to_string(cz) ++ ")=" ++ int_to_string(scene_water_count(sc1, cx, cz))
                    ++ " chunk(" ++ int_to_string(cx - 1) ++ "," ++ int_to_string(cz) ++ ")=" ++ int_to_string(scene_water_count(sc1, cx - 1, cz))
                    ++ " chunk(" ++ int_to_string(cx) ++ "," ++ int_to_string(cz - 1) ++ ")=" ++ int_to_string(scene_water_count(sc1, cx, cz - 1)))
          else () end
          if autoedit >= 0 && (frame == autoedit - 1 || frame == autoedit + 20 || frame == autoedit + 40 || frame == autoedit + 61 || frame == autoedit + 121 || frame == autoedit + 181 || frame == autoedit + 241 || frame == autoedit + 301) do
            println("frame " ++ int_to_string(frame) ++ " looking at " ++ scene_hit_string(sc1) ++ "; block there = " ++ int_to_string(match sc1 do Scene(w, _, _, h, _, _, _, _, _, _) -> World.block_at(w, Ray.bx(h), Ray.by_(h), Ray.bz(h)) end) ++ "; " ++ inv_string(sc1)
                    ++ "; water cells in player chunk = " ++ int_to_string(scene_water_count(sc1, World.floor_div16(float_to_int(Math.floor(V.x(Player.position(player1))))), World.floor_div16(float_to_int(Math.floor(V.z(Player.position(player1))))))))
          else () end
          if autoswim && frame % 20 == 0 && frame <= 400 do
            println("frame " ++ int_to_string(frame) ++ " y=" ++ float_to_string(V.y(Player.position(player1))) ++ " in_water=" ++ (if Player.in_water(player1, scene_world(sc1)) do "true" else "false" end) ++ " eye_in_water=" ++ (if Player.eye_in_water(player1, scene_world(sc1)) do "true" else "false" end))
          else () end
          let flash1 = if In.key_pressed(In.key_f()) do !flash else flash end
          let eye = Player.eye(player1)
          let look = Player.forward(Player.yaw(player1), Player.pitch(player1))
          -- The map view is a diagnostic overhead view: hold it at full daylight
          -- and out of the flashlight beam, the same way the underwater tint is
          -- suppressed there. Otherwise it would be unreadable at night.
          let arc = arc_angle(now, day_len, sun_deg)
          let sun = if map_mode1 do 1.0 else sun_level_at(arc) end
          let moon = if map_mode1 do 0.0 else moon_level(sun) end
          let flash_now = if map_mode1 do false else flash1 end
          -- The moon rides the opposite side of the same arc, so it climbs as the
          -- sun sets. In map mode the light is pinned overhead: that view is a
          -- diagnostic, and a low sun would leave half of it in shadow.
          let sdx = if map_mode1 do 0.0 else sun_dir_x(arc) end
          let sdy = if map_mode1 do 1.0 else sun_dir_y(arc) end
          let sdz = if map_mode1 do 0.0 else sun_dir_z() end
          -- Sky: day blue swinging toward a warm horizon as the sun sets, scaled
          -- by the same intensity ramp the ground uses, plus the moon underneath.
          let inten = sun_intensity(sun)
          let da = dusk_amount(sun)
          -- Weather. The map view is a diagnostic, so it stays clear and unfogged.
          -- One call per tick_period(), not per frame, and the cached value is
          -- eased in between, so the actor costs one message per ten frames.
          let asked = if frame % tick_period() == 0 do
            match Weather.call_tick(wxpid) do
              Ok(Cons(iv, Cons(bv, _))) -> Wx(int_to_float(iv) /. 1000.0, int_to_float(bv) /. 1000.0)
              _ -> Wx(wcache, bcache)
            end
          else Wx(wcache, bcache) end
          let wnow = pair_a(asked)
          let bnow = pair_b(asked)
          let wx = if map_mode1 do 0.0 else weather_now(weather_pin, wnow) end
          let ov = overcast_of(wx)
          let bolt = if map_mode1 do 0.0 else (if weather_pin < 0 do bnow else 0.0 end) end
          let sr = (0.55 +. 0.40 *. da) *. inten +. 0.030 *. moon
          let sg = (0.75 -. 0.38 *. da) *. inten +. 0.045 *. moon
          let sb = (0.95 -. 0.70 *. da) *. inten +. 0.110 *. moon
          let lum = 0.30 *. sr +. 0.59 *. sg +. 0.11 *. sb
          Win.gfx_begin_frame(overcast_sky(sr, lum, ov), overcast_sky(sg, lum, ov), overcast_sky(sb, lum, ov))
          Win.gfx_set_sky(sdx, sdy, sdz, 0.0 -. sdx, 0.0 -. sdy, 0.0 -. sdz)
          -- Must follow begin_frame: the fog colour is the clear colour it stashed.
          Win.gfx_set_weather(fog_density(wx), ov, bolt)
          -- Precipitation. Under CF_FRAMES the integration uses a fixed step so
          -- headless dumps replay identically; the pool is the first stateful
          -- renderer-side simulation and that is what keeps it reproducible.
          let pdt = if max_frames > 0 do 1.0 /. 60.0 else dt end
          -- Weather is one global storm; the biome under the camera decides how much
          -- of it falls here and whether it is snow.
          let bcx = float_to_int(V.x(Player.position(player1)))
          let bcz = float_to_int(V.z(Player.position(player1)))
          let pscale = Biome.precip_scale(Biome.biome_of(scene_biome(sc1), bcx, bcz))
          let live0 = float_to_int(int_to_float(precip_cap) *. wx *. pscale)
          let live = if live0 > precip_cap do precip_cap else live0 end
          let snowmix = Precip.snow_mix(Biome.temp_of(scene_biome(sc1), bcx, bcz))
          let snowing = snowmix > 0.5
          -- Camera right, flattened to the horizontal plane and normalised.
          let rlen = Math.sqrt(V.z(look) *. V.z(look) +. V.x(look) *. V.x(look))
          let rl = if rlen < 0.0001 do 1.0 else rlen end
          if live > 0 do
            Win.precip_frame(World.light(scene_world(sc1)), live, snowing,
                             V.x(Player.eye(player1)), V.y(Player.eye(player1)), V.z(Player.eye(player1)),
                             (0.0 -. V.z(look)) /. rl, V.x(look) /. rl, pdt, frame)
          else () end
          -- Audio. One push per tick_period(), the cadence Weather already runs
          -- at; nine frames in ten cost nothing. Everything below is pure until
          -- the two extern calls at the end, and the synthesiser it hands to
          -- runs on miniaudio's own thread -- the render thread never waits on
          -- it. The note goes first so a note and its mix land in the same tick
          -- under CF_AUDIO=2, where set_mix is what renders the samples.
          let sched1 = if audio_mode == 0 do sched
            else if frame % tick_period() != 0 do sched
            else
              let tick = frame / tick_period()
              let bid = Biome.biome_of(scene_biome(sc1), bcx, bcz)
              let under = Player.eye_in_water(player1, scene_world(sc1))
              let py = float_to_int(V.y(Player.eye(player1)))
              let expo = Audio.exposure(py, World.light_at(scene_world(sc1), bcx, py, bcz))
              let leafy = leaf_amount(scene_world(sc1), bcx, py, bcz)
              let m = Audio.mix(bid, wx, Wind.at(tick, seed, wx), snowmix, expo, leafy, under)
              let fired = if Audio.due(sched, tick) do
                let gap = Audio.gap_ticks(Audio.rate_of(bid), tick, seed)
                let pc = Audio.pitch_class(sched, seed)
                Aud.note(Tone.hz(Tone.midi(pc, Audio.octave_of(bid))),
                         Audio.note_seconds(gap), Audio.timbre_of(bid), Audio.note_gain())
                if audio_log do
                  println("note t" ++ int_to_string(tick) ++ " row[" ++ int_to_string(Audio.index_of(sched))
                          ++ "] pc " ++ int_to_string(pc) ++ " form " ++ int_to_string(Audio.form_of_sched(sched))
                          ++ "+" ++ int_to_string(Audio.transpose_of_sched(sched))
                          ++ " oct " ++ int_to_string(Audio.octave_of(bid))
                          ++ " " ++ float_to_string(Tone.hz(Tone.midi(pc, Audio.octave_of(bid)))) ++ " Hz for "
                          ++ float_to_string(Audio.note_seconds(gap)) ++ "s")
                else () end
                Audio.advance(sched, tick, Audio.rate_of(bid), Audio.form_of(bid), Audio.transpose_of(bid), seed)
              else sched end
              Aud.set_mix(Audio.rain_of(m), Audio.wind_of(m), Audio.leaves_of(m),
                          Audio.water_of(m), Audio.cutoff_of(m), Audio.music_of(m))
              -- CF_AUDIO_LOG=1: one line a second. What each bed is actually
              -- being asked for beats inferring it back out of the spectrum.
              if audio_log && tick % Audio.ticks_per_second() == 0 do
                println("audio t" ++ int_to_string(tick) ++ " " ++ Biome.name(bid)
                        ++ " rain " ++ float_to_string(Audio.rain_of(m))
                        ++ " wind " ++ float_to_string(Audio.wind_of(m))
                        ++ " leaves " ++ float_to_string(Audio.leaves_of(m))
                        ++ " water " ++ float_to_string(Audio.water_of(m))
                        ++ " cutoff " ++ float_to_string(Audio.cutoff_of(m))
                        ++ " | wx " ++ float_to_string(wx) ++ " gust " ++ float_to_string(Wind.at(tick, seed, wx))
                        ++ " snow " ++ float_to_string(snowmix) ++ " expo " ++ float_to_string(expo)
                        ++ " leafy " ++ float_to_string(leafy) ++ " y " ++ int_to_string(py))
              else () end
              fired
            end end
          -- The map view is an overhead diagnostic; shadows there would only
          -- obscure the terrain it exists to show.
          Win.gfx_set_shadow(if map_mode1 do 0.0 else shadow_dist end, soft_shadows)
          Win.gfx_set_light(sun, V.x(eye), V.y(eye), V.z(eye), V.x(look), V.y(look), V.z(look), flash_now)
          Win.gfx_set_time(if time_pin >= 0 do int_to_float(time_pin) else now end)
          Win.gfx_set_view_proj(render_vp)
          draw_chunks(scene_counts(sc1), 0, nchunks)
          draw_foliage(scene_counts(sc1), 0, nchunks)
          draw_water(scene_counts(sc1), 0, nchunks)
          if live > 0 do Win.gfx_draw_precip(Precip.slot(), Precip.vertex_count(live)) else () end
          let spray_verts = Win.spray_frame(pdt, frame)
          if spray_verts > 0 do Win.gfx_draw_precip(247, spray_verts) else () end
          if scene_has_hit(sc1) do CubeForge.Ffi.Window.gfx_draw_lines(254, Outline.vertex_count()) else () end
          -- the underwater screen tint only makes sense from the real first-person eye
          if map_mode1 do ()
          else if Player.eye_in_water(player1, scene_world(sc1)) do CubeForge.Ffi.Window.gfx_draw_hud(253, 6, true) else () end end
          let marker1 = if map_mode1 do Marker.build(marker, V.x(Player.position(player1)), V.z(Player.position(player1))) else marker end
          if map_mode1 do
            Win.gfx_upload(Marker.slot(), F32Buf.storage(marker1), F32Buf.len(marker1))
            CubeForge.Ffi.Window.gfx_draw_marker(Marker.slot(), Marker.vertex_count())
            if biome_map do
              let bn = World.side(scene_world(sc1)) * 16
              if frame % tick_period() == 0 do Win.biome_map_upload(Biome.field_biomes(scene_biome(sc1)), bn) else () end
              CubeForge.Ffi.Window.gfx_draw_marker(248, bn * bn * 6)
            else () end
          else () end
          let fps1 = tick_fps(fps, now)
          Win.gfx_draw_hud(255, fps_hud_verts(fps1), false)
          let sc2 = scene_with_ui(sc1, refresh_hud(scene_ui(sc1), inv_open2, drag2, ndc_x, ndc_y))
          Win.gfx_draw_hud(252, hud_verts(scene_ui(sc2)), false)
          Win.gfx_draw_hud(251, icon_verts(scene_ui(sc2)), true)
          -- Untextured, like the hotbar: build_menu emits colour-in-uv vertices.
          if Menu.is_open(menu2) do Win.gfx_draw_hud(menu_slot(), F32Buf.len(menubuf1) / Vx.floats(), false) else () end
          let sc1 = if remesh_all_at >= 0 && frame == remesh_all_at do remesh_everything(sc1) else sc1 end
          if frame == dump_frame do
            if dump_path != "" do
              if Win.gfx_dump_bmp(dump_path) == 0 do println("dump failed") else () end
            else () end
            println("player at " ++ V.to_string(Player.position(player1)) ++ " on_ground=" ++ (if Player.on_ground(player1) do "true" else "false" end))
            println(inv_string(sc2))
            println("  sun level " ++ float_to_string(sun) ++ " dir (" ++ float_to_string(sdx) ++ ", " ++ float_to_string(sdy) ++ ", " ++ float_to_string(sdz) ++ ")  moon " ++ float_to_string(moon))
            println("  framebuffer " ++ int_to_string(Win.fb_width()) ++ "x" ++ int_to_string(Win.fb_height()) ++ " (" ++ int_to_string(Win.fb_width() * Win.fb_height() / 1000) ++ "k fragments)")
            let pcx = float_to_int(V.x(Player.position(player1)))
            let pcz = float_to_int(V.z(Player.position(player1)))
            println("  biome at player column (" ++ int_to_string(pcx) ++ "," ++ int_to_string(pcz) ++ "): " ++ Biome.name(Biome.biome_of(scene_biome(sc1), pcx, pcz)) ++ " height " ++ int_to_string(Biome.height_of(scene_biome(sc1), pcx, pcz)) ++ " " ++ Biome.debug_axes(scene_biome(sc1), pcx, pcz))
            println("  weather " ++ float_to_string(wx) ++ " (overcast " ++ float_to_string(ov) ++ ", fog " ++ float_to_string(fog_density(wx)) ++ ", bolt " ++ float_to_string(bolt) ++ ", live " ++ int_to_string(live) ++ (if snowing do " snow" else " rain" end) ++ ")")
            -- Behaviour oracle for refactors: the discrete field state and every
            -- voxel, hashed. Resolution-independent, unlike a frame dump, and it
            -- covers the columns the camera cannot see.
            -- Drained to empty first: with a bounded queue the invariant is not
            -- "the mesh always equals a full rebuild" but "what the queue
            -- finishes equals a full rebuild", so the oracle settles it first.
            let scq = drain(sc1, 4096)
            println("  state: biome " ++ int_to_string(Biome.state_hash(scene_biome(scq), World.side(scene_world(scq)) * 16))
                    ++ " world " ++ int_to_string(World.state_hash(scene_world(scq)))
                    ++ " mesh " ++ int_to_string(mesh_hash(scene_meshes(scq), World.side(scene_world(scq)))))
          else () end
          if frame % 60 == 0 && autowalk do
            println("frame " ++ int_to_string(frame) ++ " player at " ++ V.to_string(Player.position(player1)) ++ " on_ground=" ++ (if Player.on_ground(player1) do "true" else "false" end))
          else () end
          Win.swap()
          -- allocation gauge: sample the live-object delta over frames 100..200
          let sample1 = if frame == 100 do Win.live_allocs() else sample end
          if frame == 200 do
            println("live-object delta over frames 100..200: " ++ int_to_string(Win.live_allocs() - sample1) ++ " (" ++ int_to_string((Win.live_allocs() - sample1) / 100) ++ " per frame)")
          else () end
          frame_loop(Frame(frame + 1, now, player1, sample1, view1, vp1, map_mode1, marker1, flash1, wnow, bnow, inv_open2, drag2, menu2, menubuf1, next_seed1, worst1, worst_at1, sched1), k, sc2, nchunks, proj, map_proj, fps1, wxpid, seed)
        end
        end
    end
  end

  -- Allocation bisect: run each per-frame piece N times and print the live-object delta.
  pfn repeat_update(p : CubeForge.Player.Player, w : CubeForge.World.World, i : Int) : CubeForge.Player.Player do
    if i == 0 do p else repeat_update(Player.update(p, CubeForge.Player.Input(0.3, 0.0, 1.0, 0.5, false, false), w, 0.016), w, i - 1) end
  end
  pfn repeat_view(proj : NativeFloatArr, p : CubeForge.Player.Player, dst : NativeF32Arr, i : Int) : NativeF32Arr do
    if i == 0 do dst else repeat_view(proj, p, view_proj(proj, p, dst), i - 1) end
  end
  pfn repeat_quat(i : Int, acc : Float) : Float do
    if i == 0 do acc else repeat_quat(i - 1, acc +. V.x(Q.rotate(Q.from_yaw_pitch(0.3, 0.2), V.new(1.0, 0.0, 0.0)))) end
  end
  pfn repeat_mul(m : NativeFloatArr, i : Int) : NativeFloatArr do
    if i == 0 do m else repeat_mul(M.mul(m, M.identity()), i - 1) end
  end
  pfn repeat_forward(i : Int, acc : Float) : Float do
    if i == 0 do acc else repeat_forward(i - 1, acc +. V.x(Player.forward(0.3, 0.2))) end
  end
  pfn repeat_input(i : Int, acc : Float) : Float do
    if i == 0 do acc else
      repeat_input(i - 1, acc +. Player.input_forward(read_input(false, 0.0, false, false)))
    end
  end
  pfn measure(name : String, f) : Unit do
    let a = Win.live_allocs()
    let _r = f(())
    println("  " ++ name ++ ": live delta over 100 iterations = " ++ int_to_string(Win.live_allocs() - a))
  end
  pfn repeat_time(i : Int, acc : Float) : Float do
    if i == 0 do acc else repeat_time(i - 1, acc +. Win.time() +. In.mouse_dx()) end
  end
  pfn repeat_poll(i : Int) : Int do
    if i == 0 do 0 else
      In.poll()
      repeat_poll(i - 1)
    end
  end
  pfn repeat_write_view(p : CubeForge.Player.Player, view : NativeFloatArr, i : Int) : NativeFloatArr do
    if i == 0 do view else repeat_write_view(p, write_view(p, view), i - 1) end
  end
  pfn repeat_mul_into(proj : NativeFloatArr, view : NativeFloatArr, dst : NativeF32Arr, i : Int) : NativeF32Arr do
    if i == 0 do dst else repeat_mul_into(proj, view, M.mul_into_f32(proj, view, dst), i - 1) end
  end
  pfn repeat_eye(p : CubeForge.Player.Player, i : Int, acc : Float) : Float do
    if i == 0 do acc else repeat_eye(p, i - 1, acc +. V.y(Player.eye(p))) end
  end
  pfn repeat_fyp(i : Int, acc : Float) : Float do
    if i == 0 do acc else repeat_fyp(i - 1, acc +. Q.w(Q.from_yaw_pitch(0.3, 0.2))) end
  end
  pfn repeat_hud_key(i : Int, inv : CubeForge.Inventory.Inv, acc : Int) : Int do
    if i == 0 do acc else repeat_hud_key(i - 1, inv, acc + Inv.hud_key(inv)) end
  end
  pfn repeat_item_at(i : Int, inv : CubeForge.Inventory.Inv, acc : Int) : Int do
    if i == 0 do acc else repeat_item_at(i - 1, inv, acc + Inv.item_at(inv, i % 36)) end
  end
  pfn repeat_slot_at(i : Int, acc : Int) : Int do
    if i == 0 do acc else repeat_slot_at(i - 1, acc + Hud.slot_at(0.1, -0.9, true)) end
  end
  pfn repeat_key_pressed(i : Int, acc : Int) : Int do
    if i == 0 do acc else repeat_key_pressed(i - 1, acc + (if In.key_pressed(In.key_i()) do 1 else 0 end)) end
  end

  -- Build a two-float aggregate in one branch of an if and read both fields.
  pfn repeat_wx(i : Int, acc : Float) : Float do
    if i == 0 do acc
    else
      let w = if i % 2 == 0 do Wx(1.0, 2.0) else Wx(3.0, 4.0) end
      repeat_wx(i - 1, acc +. pair_a(w) +. pair_b(w))
    end
  end

  pfn alloc_probe(world : CubeForge.World.World, proj : NativeFloatArr) : Unit do
    println("allocation bisect (net live objects; >0 means a leak):")
    measure("extern Float returns (time, mouse_dx)", fn _ -> repeat_time(100, 0.0))
    measure("In.poll", fn _ -> repeat_poll(100))
    measure("read_input", fn _ -> repeat_input(100, 0.0))
    measure("Player.forward", fn _ -> repeat_forward(100, 0.0))
    measure("Quat from_yaw_pitch+rotate", fn _ -> repeat_quat(100, 0.0))
    measure("Mat4.mul", fn _ -> M.get(repeat_mul(M.identity(), 100), 0, 0))
    measure("Player.update", fn _ -> V.x(Player.position(repeat_update(Player.new(8.0, 70.0, 8.0), world, 100))))
    measure("view_proj (temporaries)", fn _ -> NativeArray.get_f32(repeat_view(proj, Player.new(8.0, 70.0, 8.0), NativeArray.make_f32(16, 0.0), 100), 0))
    measure("write_view only", fn _ -> NativeArray.get_float(repeat_write_view(Player.new(8.0, 70.0, 8.0), NativeArray.make_float(16, 0.0), 100), 0))
    measure("mul_into_f32 only", fn _ -> NativeArray.get_f32(repeat_mul_into(proj, NativeArray.make_float(16, 0.0), NativeArray.make_f32(16, 0.0), 100), 0))
    measure("Player.eye only", fn _ -> repeat_eye(Player.new(8.0, 70.0, 8.0), 100, 0.0))
    measure("Quat.from_yaw_pitch only", fn _ -> repeat_fyp(100, 0.0))
    measure("Wx(Float, Float) built in a branch", fn _ -> repeat_wx(100, 0.0))
    measure("Inv.hud_key", fn _ -> repeat_hud_key(100, Inv.harvest(Inv.new(), 3), 0))
    measure("Inv.item_at", fn _ -> repeat_item_at(100, Inv.harvest(Inv.new(), 3), 0))
    measure("Hud.slot_at", fn _ -> repeat_slot_at(100, 0))
    measure("In.key_pressed", fn _ -> repeat_key_pressed(100, 0))
    measure("view_proj (in place)", fn _ -> NativeArray.get_f32(repeat_view_inplace(proj, Player.new(8.0, 70.0, 8.0), NativeArray.make_float(16, 0.0), NativeArray.make_f32(16, 0.0), 100), 0))
  end

  -- Draw every chunk slot; counts holds the vertex count per slot.
  @[no_alloc(assume)]
  pfn draw_chunks(counts : NativeIntArr, i : Int, n : Int) : Unit do
    if i >= n do ()
    else
      Win.gfx_draw(i, NativeArray.get_int(counts, i))
      draw_chunks(counts, i + 1, n)
    end
  end

  -- Foliage is alpha-cutout, not blended, so it can be drawn before water.
  pfn draw_foliage(counts : NativeIntArr, i : Int, n : Int) : Unit do
    if i >= n do ()
    else
      Win.gfx_draw_cutout(foliage_slot_base() + i, NativeArray.get_int(counts, foliage_slot_base() + i))
      draw_foliage(counts, i + 1, n)
    end
  end

  pfn draw_water(counts : NativeIntArr, i : Int, n : Int) : Unit do
    if i >= n do ()
    else
      Win.gfx_draw_translucent(water_slot_base() + i, NativeArray.get_int(counts, water_slot_base() + i))
      draw_water(counts, i + 1, n)
    end
  end

  -- Full-screen quad in NDC for the underwater tint: layer 1 (water), shade 0.6. Built once.
  pfn underwater_quad() : CubeForge.F32Buf.F32Buf do
    let v = fn (b, x, y, u, t) -> b |> F32Buf.push3(x, y, 0.0) |> F32Buf.push(u) |> F32Buf.push(t) |> F32Buf.push(Texture.water_layer()) |> F32Buf.push(0.6) |> F32Buf.push(0.0) |> F32Buf.push(Vx.plain())
    F32Buf.new(64) |> v(-1.0, -1.0, 0.0, 0.0) |> v(1.0, -1.0, 4.0, 0.0) |> v(1.0, 1.0, 4.0, 3.0)
                   |> v(-1.0, -1.0, 0.0, 0.0) |> v(1.0, 1.0, 4.0, 3.0) |> v(-1.0, 1.0, 0.0, 3.0)
  end

  -- Stage 2 of world generation: mesh every chunk (each needs its 4 neighbours, which
  -- stage 1 guarantees), upload each mesh into its slot, record vertex counts.
  pfn upload_meshes(meshes : List(CubeForge.ChunkMesh.ChunkMesh), i : Int, counts : NativeIntArr) : NativeIntArr do
    match meshes do
      Nil -> counts
      Cons(m, rest) -> upload_meshes(rest, i + 1, upload_chunk(m, i, counts))
    end
  end

  pfn count_verts(meshes : List(CubeForge.ChunkMesh.ChunkMesh), acc : Int) : Int do
    match meshes do
      Nil -> acc
      Cons(m, rest) -> count_verts(rest, acc + CM.opaque_vertices(m) + CM.water_vertices(m))
    end
  end

  pfn count_water_verts(meshes : List(CubeForge.ChunkMesh.ChunkMesh), acc : Int) : Int do
    match meshes do
      Nil -> acc
      Cons(m, rest) -> count_water_verts(rest, acc + CM.water_vertices(m))
    end
  end

  pfn mesh_reps(world : CubeForge.World.World, n : Int, workers : Int, reps : Int, acc : Int) : Int do
    if reps <= 0 do acc
    else mesh_reps(world, n, workers, reps - 1, acc + count_verts(mesh_all(world, n, workers), 0)) end
  end

  fn mesh_all(world : CubeForge.World.World, n : Int, workers : Int) : List(CubeForge.ChunkMesh.ChunkMesh) do
    let empty = Chunk.new()
    List.pmap_n(World.coords(n), fn i -> CM.build(world, i % n, i / n, empty), workers)
  end

  -- The naive whole-chunk mesher, kept for the headless timing comparison.
  fn mesh_all_naive(world : CubeForge.World.World, n : Int, workers : Int) : Int do
    let empty = Chunk.new()
    let ms = List.pmap_n(World.coords(n), fn i -> Mesher.mesh_world_chunk(world, i % n, i / n, empty), workers)
    List.fold_left(ms, 0, fn (acc, m) -> acc + Mesher.vertex_count(Mesher.opaque_buf(m)) + Mesher.vertex_count(Mesher.water_buf(m)))
  end

  -- CF_TERRAIN_STATS=1: sample the generator over the world and report height and
  -- surface-material distributions, so terrain tuning is measured rather than eyeballed.
  pfn stats_go(n : Int, i : Int, seed : Int, lo : Int, hi : Int, sum : Int,
               grass : Int, sand : Int, snow : Int, granite : Int, under : Int) : Unit do
    let span = 16 * n
    if i >= span * span / 16 do
      let cols = span * span / 16
      println("  height min=" ++ int_to_string(lo) ++ " max=" ++ int_to_string(hi) ++ " mean=" ++ int_to_string(sum / cols)
              ++ "  (sea level " ++ int_to_string(Chunk.sea_level()) ++ ", snow line " ++ int_to_string(CubeForge.Noise.snow_line()) ++ ")")
      println("  surface: grass " ++ int_to_string(grass * 100 / cols) ++ "%  sand " ++ int_to_string(sand * 100 / cols)
              ++ "%  granite " ++ int_to_string(granite * 100 / cols) ++ "%  snow " ++ int_to_string(snow * 100 / cols)
              ++ "%  underwater " ++ int_to_string(under * 100 / cols) ++ "%")
    else
      -- sample every 4th column in each direction
      let wx = (i % (span / 4)) * 4
      let wz = (i / (span / 4)) * 4
      let h = CubeForge.Noise.height(wx, wz, seed)
      let sfc = Chunk.surface_id(h, CubeForge.Noise.slope(wx, wz, seed))
      stats_go(n, i + 1, seed,
               if h < lo do h else lo end, if h > hi do h else hi end, sum + h,
               if sfc == 1 do grass + 1 else grass end,
               if sfc == Chunk.sand() do sand + 1 else sand end,
               if sfc == Chunk.snow() do snow + 1 else snow end,
               if sfc == Chunk.granite() do granite + 1 else granite end,
               if h < Chunk.sea_level() do under + 1 else under end)
    end
  end

  -- Pick a spawn column near the world centre: the HIGHEST flat, above-water column in a
  -- 32x32 box. Flat alone is not enough — the floor of a pit is flat, and spawning there
  -- boxes the camera in; the highest such column is open ground. Returns x + 4096 * z.
  pfn find_spawn_go(n : Int, i : Int, seed : Int, best : Int, best_h : Int) : Int do
    let centre = 8 * n
    if i >= 1024 do if best_h > 0 do best else centre + 4096 * centre end
    else
      let cx = centre - 16 + i % 32
      let cz = centre - 16 + i / 32
      let h = CubeForge.Noise.height(cx, cz, seed)
      let ok = h > Chunk.sea_level() + 1 && CubeForge.Noise.slope(cx, cz, seed) <= 1 && h > best_h
      if ok do find_spawn_go(n, i + 1, seed, cx + 4096 * cz, h)
      else find_spawn_go(n, i + 1, seed, best, best_h) end
    end
  end

  fn main(cap : Cap(IO)) : Unit do
    let max_frames = Env.get_int("CF_FRAMES", -1)
    let n = World.size()
    let workers = Env.get_int("CF_WORKERS", System.cpu_count())
    -- CF_SEED unset: a new world each run, seeded from the clock. The seed is always
    -- printed, so any world can be reproduced with CF_SEED=<n>.
    let seed_env = Env.get_int("CF_SEED", -1)
    let seed = if seed_env >= 0 do seed_env else int_and(System.monotonic_time() * 2654435761 + unix_time_ms(), 1073741823) end
    let headless = Env.get_int("CF_HEADLESS", 0) == 1
    -- `&&` does not short-circuit (GAPS.md G33), so the window open is gated with a nested if.
    let opened = if headless do 1 else Win.open(Env.get_int("CF_WIDTH", 800), Env.get_int("CF_HEIGHT", 600), "cube_forge") end
    if opened == 0 do
      println("failed to open window")
    else
      if !headless do (if Win.gfx_init() == 0 do println("gfx init failed") else () end) else () end
      if !headless do Win.precip_init(Env.get_int("CF_PRECIP", 4000)) else () end
      -- Session-invariant GL state: uploaded once and reused by every session.
      if !headless do
        Win.spray_init(Env.get_int("CF_SPRAY", 512))
        Win.gfx_upload_texture(Texture.checkerboard(), Texture.size(), Texture.size(), Texture.layers())
        let uq = underwater_quad()
        Win.gfx_upload(253, F32Buf.storage(uq), F32Buf.len(uq))
      else () end
      let proj = M.perspective(70.0 *. Math.pi() /. 180.0, 800.0 /. 600.0, 0.1, 500.0)
      -- top-down map camera (M toggles it): orthographic, follows the player, zoomed to a local
      -- area rather than the whole world (map_view builds the per-frame view matrix).
      let map_proj = M.orthographic(0.0 -. map_half_extent(), map_half_extent(), 0.0 -. map_half_extent(), map_half_extent(), 0.1, 400.0)
      let autoswim = Env.get_int("CF_AUTOSWIM", 0) == 1
      -- Audio. The device is opened once and outlives a session: starting a new
      -- game reseeds the world, not the sound card. CF_AUDIO: 0 off, 1 a real
      -- device, 2 no device at all -- each mix push then renders its own tick of
      -- samples straight into the WAV, so a scripted run dumps the same file
      -- every time. CF_AUDIO_DUMP=<path> tees the mix either way.
      let audio_mode = Env.get_int("CF_AUDIO", 1)
      if audio_mode > 0 do
        if Aud.start(if audio_mode == 2 do 1 else 0 end) == 0 do println("audio: no device, running silent")
        else println("audio: " ++ (if audio_mode == 2 do "null device (dump only)" else "device open" end)) end
      else () end
      let dump_wav = Env.get("CF_AUDIO_DUMP", "")
      if audio_mode > 0 do
        if dump_wav != "" do
          if Aud.dump_begin(dump_wav) == 1 do println("audio: teeing to " ++ dump_wav) else println("audio: could not open " ++ dump_wav) end
        else () end
      else () end
      let knobs = Knobs(max_frames, Env.get_int("CF_DUMP_FRAME", 30), Env.get("CF_DUMP", ""), Env.get_int("CF_AUTOWALK", 0) == 1,
                        int_to_float(Env.get_int("CF_AUTOSPIN", 0)) /. 1000.0 /. Player.mouse_sens(), Env.get_int("CF_AUTOEDIT", -1), autoswim, Env.get_int("CF_AUTOFLOW", -1), workers, Env.get_int("CF_AUTOMAP", -1), int_to_float(Env.get_int("CF_DAY", 1800)), Env.get_int("CF_SUN", -1), int_to_float(Env.get_int("CF_SHADOW_DIST", 64)), Env.get_int("CF_SHADOW_SOFT", 1) == 1, Env.get_int("CF_AUTOINV", -1), Env.get_int("CF_AUTOBREAK", -1), Env.get_int("CF_WEATHER", -1), Env.get_int("CF_PRECIP", 4000), Env.get_int("CF_BIOME_RATE", 100), Env.get_int("CF_BIOME_MAP", 0) == 1, Env.get_int("CF_AUTOCANAL", -1), Env.get_int("CF_BIOME_BUDGET", 32), Env.get_int("CF_VEG_BUDGET", 1), Env.get_int("CF_TIME", -1), Env.get_int("CF_REMESH_ALL_AT", -1), Env.get_int("CF_AUTOMENU", -1), audio_mode, Env.get_int("CF_AUDIO_LOG", 0) == 1, Env.get_int("CF_AUTODIVE", 0) == 1)
      let pids = Array.from_list(spawn_water(n * n - 1, n, Nil))
      let wxpid = Weather.spawn_weather()
      session_loop(seed, n, workers, headless, seed_env >= 0, knobs, proj, map_proj, pids, wxpid, autoswim)
      if audio_mode > 0 do Aud.close() else () end
      Win.close()
    end
  end

  -- Reseed every water actor for a new world. The pool is created once, in
  -- `main`, and reused across sessions.
  pfn reload_water(pids, i : Int, n : Int, seed : Int) : Unit do
    if i < 0 do ()
    else
      Water.send_load(Array.get(pids, i), i % n, i / n, n, seed)
      reload_water(pids, i - 1, n, seed)
    end
  end

  doc """
  Generate a world from [seed], play it, and return the seed of the session to
  start next — or -1 to stop. The window, GL context, uploaded texture, camera
  projections, knobs and the actor pool are all created once by `main` and
  handed in, so a new game rebuilds only the world, the meshes and the player.
  """
  pfn run_session(seed : Int, n : Int, workers : Int, headless : Bool, from_env : Bool, k : Knobs,
                  proj : NativeFloatArr, map_proj : NativeFloatArr, pids, wxpid, autoswim : Bool) : Int do
    -- stage 1: terrain (independent chunks)
    let t0 = System.monotonic_time()
    let world_scalar = World.generate_scalar(n, seed, workers)
    let t1 = System.monotonic_time()
    let world_dark = World.generate(n, seed, workers)
    let t2 = System.monotonic_time()
    -- stage 1b: skylight (needs the finished terrain, including neighbours)
    let world_lit = World.relight_all(world_dark)
    let t2b = System.monotonic_time()
    println("  skylight flood: " ++ int_to_string(t2b - t2) ++ " ms")
    -- The shadow ray-marcher's view of the world. Built once and handed over;
    -- March keeps no copy, since a block edit only needs one texel.
    let to0 = System.monotonic_time()
    let world = World.rebuild_occupancy(world_lit)
    if !headless do Win.gfx_upload_occupancy(World.occupancy(world), 128, 256, 128) else () end
    println("  occupancy: " ++ int_to_string(System.monotonic_time() - to0) ++ " ms")
    -- stage 2: meshing (needs neighbours; runs only after stage 1 completed)
    -- CF_MESH_REPS>0 re-meshes the whole world that many extra times, purely
    -- to widen the sampling window for the G37 scaling investigation.
    let reps = Env.get_int("CF_MESH_REPS", 0)
    if reps > 0 do
      let tr0 = System.monotonic_time()
      let rv = mesh_reps(world, n, workers, reps, 0)
      println("  mesh reps: " ++ int_to_string(reps) ++ " x, " ++ int_to_string(System.monotonic_time() - tr0) ++ " ms total, verts " ++ int_to_string(rv))
    else () end
    let meshes = mesh_all(world, n, workers)
    let t3 = System.monotonic_time()
    let nverts = count_verts(meshes, 0)
    if Env.get_int("CF_TERRAIN_STATS", 0) == 1 do stats_go(n, 0, seed, 999, 0, 0, 0, 0, 0, 0, 0) else () end
    if headless do
      let tn0 = System.monotonic_time()
      let naive_verts = mesh_all_naive(world, n, workers)
      println("  naive mesher for comparison: " ++ int_to_string(System.monotonic_time() - tn0) ++ " ms wall, " ++ int_to_string(naive_verts) ++ " vertices")
    else () end
    println("seed " ++ int_to_string(seed) ++ (if from_env do " (CF_SEED)" else " (set CF_SEED to reproduce)" end))
    println("world " ++ int_to_string(n) ++ "x" ++ int_to_string(n) ++ " chunks, " ++ int_to_string(workers) ++ " workers, "
            ++ int_to_string(Env.get_int("MARCH_NUM_SCHEDULERS", 4)) ++ " scheduler threads (MARCH_NUM_SCHEDULERS)")
    println("  terrain scalar noise: " ++ int_to_string(t1 - t0) ++ " ms   terrain F32x4 noise: " ++ int_to_string(t2 - t1) ++ " ms")
    println("  mesh all (greedy sections): " ++ int_to_string(t3 - t2) ++ " ms wall, " ++ float_to_string(int_to_float(t3 - t2) /. int_to_float(n * n)) ++ " ms per chunk (wall / chunks), " ++ int_to_string(nverts) ++ " vertices (" ++ int_to_string(count_water_verts(meshes, 0)) ++ " water)")
    if headless do -1
    else
      let counts = upload_meshes(meshes, 0, NativeArray.make_int(3 * water_slot_base(), 0))
      let water_col = World.find_water(world)
      let spawn_col = find_spawn_go(n, 0, seed, 0, 0)
      let spawn_x = spawn_col % 4096
      let spawn_z = spawn_col / 4096
      let ground_y = int_to_float(World.surface_y(world, spawn_x, spawn_z) + 1)
      -- CF_AUTODIVE spawns over the same column CF_AUTOSWIM does; the
      -- difference is which key the scripted input holds once it lands.
      let autodive = Env.get_int("CF_AUTODIVE", 0) == 1
      let player = if (autoswim || autodive) && water_col >= 0 do
        println("autoswim: spawning over water column " ++ int_to_string(water_col % 4096) ++ "," ++ int_to_string(water_col / 4096))
        Player.with_pitch(Player.new(int_to_float(water_col % 4096) +. 0.5, 90.0, int_to_float(water_col / 4096) +. 0.5), -1.4)
      else
        -- CF_SPAWN_Y=<y>: start at a chosen height (inspection aid, e.g. to look at the bedrock floor)
        let forced_y = Env.get_int("CF_SPAWN_Y", -1)
        let y0 = if forced_y >= 0 do int_to_float(forced_y) else ground_y end
        Player.with_pitch(Player.new(int_to_float(spawn_x) +. 0.5, y0, int_to_float(spawn_z) +. 0.5), -0.25)
      end
      if Env.get_int("CF_ALLOC_PROBE", 0) == 1 do alloc_probe(world, proj) else () end
      let t4 = Win.time()
      -- The actor pool outlives a session: a new game reseeds the existing chunk
      -- actors rather than killing and respawning them. `kill(pid)` does exist,
      -- so this is a cost choice (64 messages, not 64 kills + 64 spawns + 64
      -- loads) and not a workaround.
      let tw0 = Win.time()
      reload_water(pids, n * n - 1, n, seed)
      println("reloaded " ++ int_to_string(n * n) ++ " water actors in " ++ ms(Win.time() -. tw0) ++ " (loads run asynchronously)")
      let biome0 = Biome.build(world, seed)
      let scene = Scene(world, counts, F32Buf.new(256), Ray.miss(), Ui(Inv.new(), F32Buf.new(2048), F32Buf.new(256), -1), pids, spring_flags(world, biome0, 0, n, NativeArray.make_int(n * n, 0)), Array.from_list(meshes), biome0, CubeForge.Light.marks_new())
      let fps0 = Fps(t4, 0, 0, F32Buf.new(4096))
      Weather.send_seed(wxpid, seed)
      match frame_loop(Frame(0, t4, player, 0, NativeArray.make_float(16, 0.0), NativeArray.make_f32(16, 0.0), false, F32Buf.new(64), Env.get_int("CF_FLASH", 0) == 1, 0.0, 0.0, false, -1, Menu.new(seed), F32Buf.new(2048), -1, 0.0, -1, Audio.sched_start(0)), k, scene, n * n, proj, map_proj, fps0, wxpid, seed) do
        Frame(frames, _, p, _, _, _, _, _, _, _, _, _, _, _, _, ns, worst, worst_at, _) ->
          let t5 = Win.time()
          println("ran " ++ int_to_string(frames) ++ " frames in " ++ ms(t5 -. t4) ++ " (" ++ float_to_string(int_to_float(frames) /. (t5 -. t4)) ++ " fps, vsync on); player ended at " ++ V.to_string(Player.position(p)))
          println("worst frame after warmup: " ++ ms(worst) ++ " at frame " ++ int_to_string(worst_at))
          ns
      end
    end
  end

  -- Run sessions until one asks to stop.
  pfn session_loop(seed : Int, n : Int, workers : Int, headless : Bool, from_env : Bool, k : Knobs,
                   proj : NativeFloatArr, map_proj : NativeFloatArr, pids, wxpid, autoswim : Bool) : Unit do
    let next = run_session(seed, n, workers, headless, from_env, k, proj, map_proj, pids, wxpid, autoswim)
    if next < 0 do ()
    else session_loop(next, n, workers, headless, false, k, proj, map_proj, pids, wxpid, autoswim) end
  end

end