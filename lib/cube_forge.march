-- cube_forge — a minimal voxel renderer, written to find March's rough edges.
-- Spreading water: per-chunk WaterChunk actors, finite-level flow, cross-chunk spills.
mod CubeForge do

  needs IO
  needs IO.Foreign
  needs Window
  needs Input
  needs IO.Spawn
  needs IO.Clock
  needs IO.Process

  alias CubeForge.Ffi.Window as Win
  alias CubeForge.Ffi.Input as In
  alias CubeForge.F32Buf as F32Buf
  alias CubeForge.Math.Vec3 as V
  alias CubeForge.Math.Mat4 as M
  alias CubeForge.Math.Quat as Q
  alias CubeForge.Chunk as Chunk
  alias CubeForge.Mesher as Mesher
  alias CubeForge.Texture as Texture
  alias CubeForge.World as World
  alias CubeForge.Player as Player
  alias CubeForge.Hud as Hud
  alias CubeForge.Raycast as Ray
  alias CubeForge.Outline as Outline
  alias CubeForge.Water as Water
  alias CubeForge.ChunkMesh as CM
  alias CubeForge.Inventory as Inv

  fn ms(seconds : Float) : String do float_to_string(seconds *. 1000.0) ++ "ms" end

  -- Everything the frame loop threads through. A variant so the per-frame
  -- rebuild can reuse the cell (see GAPS.md G12).
  -- frame, last_time, player, alloc_sample, view scratch (NativeFloatArr 16), vp upload buffer (NativeF32Arr 16)
  type Frame = Frame(Int, Float, CubeForge.Player.Player, Int, NativeFloatArr, NativeF32Arr)
  -- Mutable-per-edit world state: world, per-slot vertex counts (opaque 0..63, water 64..127), outline buffer, current hit,
  -- selected block id, water actor pids (Array, one per chunk), per-chunk "has dirty cells" flags
  -- `p` is the water-actor Pid type: Pid(state) cannot be written in an annotation (GAPS.md G45), so it is a parameter.
  -- ... and the per-chunk section meshes
  type Scene(p) = Scene(CubeForge.World.World, NativeIntArr, CubeForge.F32Buf.F32Buf, CubeForge.Raycast.Hit, Ui, Array.PVec(p), NativeIntArr, Array.PVec(CubeForge.ChunkMesh.ChunkMesh))
  -- inventory + hotbar buffers (untextured, textured icons) + last built HUD key
  type Ui = Ui(CubeForge.Inventory.Inv, CubeForge.F32Buf.F32Buf, CubeForge.F32Buf.F32Buf, Int)
  fn ui_inv(u : Ui) : CubeForge.Inventory.Inv do match u do Ui(i, _, _, _) -> i end end
  @[no_alloc]
  fn ui_with_inv(u : Ui, i : CubeForge.Inventory.Inv) : Ui do match u do Ui(_, a, b, k) -> Ui(i, a, b, k) end end

  -- Rebuild + upload the hotbar buffers when the inventory's HUD key changed.
  pfn refresh_hud(u : Ui) : Ui do
    match u do
      Ui(inv, hb, ic, key) ->
        let k = Inv.hud_key(inv)
        if k == key do u
        else
          let hb1 = Hud.build_hotbar(hb, Inv.sel(inv), Inv.count(inv, 1), Inv.count(inv, 2), Inv.count(inv, 3), Inv.progress(inv))
          Win.gfx_upload(252, F32Buf.storage(hb1), F32Buf.len(hb1))
          let ic1 = if key == -1 do
            let i1 = Hud.build_icons(ic)
            Win.gfx_upload(251, F32Buf.storage(i1), F32Buf.len(i1))
            i1
          else ic end
          Ui(inv, hb1, ic1, k)
        end
    end
  end
  pfn hud_verts(u : Ui) : Int do match u do Ui(_, hb, _, _) -> F32Buf.len(hb) / 7 end end
  pfn icon_verts(u : Ui) : Int do match u do Ui(_, _, ic, _) -> F32Buf.len(ic) / 7 end end
  fn water_slot_base() : Int do 64 end
  fn tick_period() : Int do 10 end

  -- ── Water actors ────────────────────────────────────────────────────────────
  pfn spawn_water(i : Int, n : Int, seed : Int, acc) do
    if i < 0 do acc
    else
      let p = Water.spawn_chunk()
      Water.send_load(p, i % n, i / n, n, seed)
      spawn_water(i - 1, n, seed, Cons(p, acc))
    end
  end

  -- Tell the water actor about a player edit (and its neighbour when the cell is on a border).
  pfn notify_edit(sc, x : Int, y : Int, z : Int, id : Int) do
    match sc do
      Scene(w, counts, outline, hit, ui, pids, flags, meshes) ->
        let n = World.side(w)
        let cx = World.floor_div16(x)
        let cz = World.floor_div16(z)
        if !World.in_bounds(w, cx, cz) do sc
        else
          let ci = cx + n * cz
          let lx = World.mod16(x)
          let lz = World.mod16(z)
          Water.send_edited(Array.get(pids, ci), Water.idx(lx, y, lz), id)
          let f1 = NativeArray.set_int(flags, ci, 1)
          -- mirrors in the 4 neighbours: an edge cell changed
          let f2 = edge_notify(w, pids, f1, cx, cz, lx, y, lz, id)
          Scene(w, counts, outline, hit, ui, pids, f2, meshes)
        end
    end
  end

  -- If (lx, y, lz) is on a border, send WEdgeCell to the neighbour across it and flag that neighbour.
  pfn edge_notify(w : CubeForge.World.World, pids, flags : NativeIntArr, cx : Int, cz : Int, lx : Int, y : Int, lz : Int, id : Int) : NativeIntArr do
    let f1 = if lz == 0 do send_edge(w, pids, flags, cx, cz - 1, 1, Water.edge_slot(0, lx, y, lz), id) else flags end
    let f2 = if lz == 15 do send_edge(w, pids, f1, cx, cz + 1, 0, Water.edge_slot(1, lx, y, lz), id) else f1 end
    let f3 = if lx == 15 do send_edge(w, pids, f2, cx + 1, cz, 3, Water.edge_slot(2, lx, y, lz), id) else f2 end
    if lx == 0 do send_edge(w, pids, f3, cx - 1, cz, 2, Water.edge_slot(3, lx, y, lz), id) else f3 end
  end

  pfn send_edge(w : CubeForge.World.World, pids, flags : NativeIntArr, cx : Int, cz : Int, dir : Int, slot : Int, id : Int) : NativeIntArr do
    if !World.in_bounds(w, cx, cz) do flags
    else
      let ci = cx + World.side(w) * cz
      Water.send_edge_cell(Array.get(pids, ci), dir, slot, id)
      NativeArray.set_int(flags, ci, 1)
    end
  end

  pfn send_spill(w : CubeForge.World.World, pids, flags : NativeIntArr, cx : Int, cz : Int, dir : Int, slot : Int, level : Int) : NativeIntArr do
    if !World.in_bounds(w, cx, cz) do flags
    else
      let ci = cx + World.side(w) * cz
      Water.send_spill(Array.get(pids, ci), dir, slot, level)
      NativeArray.set_int(flags, ci, 1)
    end
  end

  -- Neighbour grid coordinates for a direction from (cx, cz).
  pfn nb_cx(cx : Int, dir : Int) : Int do if dir == 2 do cx + 1 else if dir == 3 do cx - 1 else cx end end end
  pfn nb_cz(cz : Int, dir : Int) : Int do if dir == 0 do cz - 1 else if dir == 1 do cz + 1 else cz end end end

  pfn flagged(flags : NativeIntArr, i : Int, n : Int, acc : List(Int)) : List(Int) do
    if i < 0 do acc else flagged(flags, i - 1, n, if NativeArray.get_int(flags, i) == 1 do Cons(i, acc) else acc end) end
  end

  -- Result of applying one reply: world and flags are both threaded (a NativeIntArr update
  -- returns the array — discarding it loses the write when the array is shared, GAPS.md G47).
  type Rep = Rep(CubeForge.World.World, NativeIntArr)

  -- Apply one actor's reply: cell writes are batched per chunk, edge/spill entries become
  -- messages to neighbours (flagging them), a pending marker keeps the chunk flagged.
  pfn apply_reply(w : CubeForge.World.World, pids, flags : NativeIntArr, ci : Int, out : List(Int), cells : List(Int)) : Rep do
    let n = World.side(w)
    let cx = ci % n
    let cz = ci / n
    match out do
      Nil -> Rep(World.set_cells(w, cx, cz, cells), flags)
      Cons(v, rest) ->
        let kind = v / 4294967296
        let payload = v % 4294967296
        if kind == 0 do apply_reply(w, pids, flags, ci, rest, Cons(payload, cells))
        else
          let dir = payload / 1048576
          let slot = (payload % 1048576) / 256
          let val = payload % 256
          if kind == 1 do
            apply_reply(w, pids, send_edge(w, pids, flags, nb_cx(cx, dir), nb_cz(cz, dir), Water.opposite(dir), slot, val), ci, rest, cells)
          else if kind == 2 do
            apply_reply(w, pids, send_spill(w, pids, flags, nb_cx(cx, dir), nb_cz(cz, dir), Water.opposite(dir), slot, val), ci, rest, cells)
          else
            apply_reply(w, pids, NativeArray.set_int(flags, ci, 1), ci, rest, cells)
          end end
        end
    end
  end

  pfn has_cells(out : List(Int)) : Bool do
    match out do
      Nil -> false
      Cons(v, rest) -> if v / 4294967296 == 0 do true else has_cells(rest) end
    end
  end
  -- Bitmask of edge directions present in a reply (bit d set when an edge-cell change in direction d occurred).
  pfn edge_mask(out : List(Int), acc : Int) : Int do
    match out do
      Nil -> acc
      Cons(v, rest) ->
        if v / 4294967296 == 1 do
          let dir = (v % 4294967296) / 1048576
          edge_mask(rest, int_or(acc, pow2(dir)))
        else edge_mask(rest, acc) end
    end
  end
  pfn pow2(n : Int) : Int do if n <= 0 do 1 else 2 * pow2(n - 1) end end

  type Applied = Applied(CubeForge.World.World, NativeIntArr, NativeIntArr, Array.PVec(CubeForge.ChunkMesh.ChunkMesh), Int)   -- world, counts, flags, meshes, sections remeshed

  -- Bitmask (bit sy) of the sections touched by the cell changes in a reply.
  pfn section_mask(out : List(Int), acc : Int) : Int do
    match out do
      Nil -> acc
      Cons(v, rest) ->
        if v / 4294967296 == 0 do section_mask(rest, int_or(acc, pow2((v % 4294967296) / 256 / 4096)))
        else section_mask(rest, acc) end
    end
  end

  -- Rebuild every section named in [mask] (bit sy) of chunk (cx, cz); concat+upload once. Returns Remeshed and the count of rebuilt sections.
  pfn remesh_sections(world : CubeForge.World.World, cx : Int, cz : Int, mask : Int, sy : Int, m : CubeForge.ChunkMesh.ChunkMesh, empty : CubeForge.Chunk.Chunk, done : Int) : CubeForge.ChunkMesh.ChunkMesh do
    if sy >= 16 do m
    else
      -- a changed cell on a section boundary changes the adjacent section's culling too
      let hit = int_and(mask, pow2(sy)) != 0
      let m1 = if hit do CM.rebuild_section(m, world, cx, cz, sy, empty) else m end
      remesh_sections(world, cx, cz, mask, sy + 1, m1, empty, done)
    end
  end

  pfn widen_mask(mask : Int, sy : Int, acc : Int) : Int do
    if sy >= 16 do acc
    else if int_and(mask, pow2(sy)) != 0 do widen_mask(mask, sy + 1, int_or(int_or(acc, pow2(sy)), int_or(if sy > 0 do pow2(sy - 1) else 0 end, if sy < 15 do pow2(sy + 1) else 0 end)))
    else widen_mask(mask, sy + 1, acc) end end
  end

  pfn count_bits(mask : Int, sy : Int, acc : Int) : Int do
    if sy >= 16 do acc else count_bits(mask, sy + 1, if int_and(mask, pow2(sy)) != 0 do acc + 1 else acc end) end
  end

  pfn apply_all(w : CubeForge.World.World, pids, flags : NativeIntArr, counts : NativeIntArr, meshes, cis : List(Int), replies, empty : CubeForge.Chunk.Chunk, remeshed : Int) : Applied do
    match cis do
      Nil -> Applied(w, counts, flags, meshes, remeshed)
      Cons(ci, rest) ->
        match replies do
          Nil -> Applied(w, counts, flags, meshes, remeshed)
          Cons(r, rrest) ->
            match r do
              Err(e) ->
                println("water tick error for chunk " ++ int_to_string(ci) ++ ": " ++ e)
                apply_all(w, pids, flags, counts, meshes, rest, rrest, empty, remeshed)
              Ok(out) ->
                let n = World.side(w)
                match apply_reply(w, pids, flags, ci, out, Nil) do
                  Rep(w1, flags1) ->
                    if has_cells(out) do
                      let cx = ci % n
                      let cz = ci / n
                      let smask = widen_mask(section_mask(out, 0), 0, 0)
                      let m1 = remesh_sections(w1, cx, cz, smask, 0, Array.get(meshes, ci), empty, 0)
                      let c1 = upload_chunk(m1, ci, counts)
                      let meshes1 = Array.set(meshes, ci, m1)
                      -- a changed border cell changes that neighbour's culling too: remesh those neighbours' same sections
                      match remesh_neighbors(w1, cx, cz, c1, meshes1, empty, edge_mask(out, 0), smask) do
                        Remeshed(c2, meshes2) -> apply_all(w1, pids, flags1, c2, meshes2, rest, rrest, empty, remeshed + count_bits(smask, 0, 0))
                      end
                    else apply_all(w1, pids, flags1, counts, meshes, rest, rrest, empty, remeshed) end
                end
            end
        end
    end
  end

  -- Remesh the sections in [smask] of the neighbour chunks named by [mask] (bits: 1 = -z, 2 = +z, 4 = +x, 8 = -x).
  pfn remesh_neighbors(w : CubeForge.World.World, cx : Int, cz : Int, counts : NativeIntArr, meshes, empty : CubeForge.Chunk.Chunk, mask : Int, smask : Int) : Remeshed do
    let r1 = if int_and(mask, 4) != 0 do remesh_chunk_sections(w, cx + 1, cz, smask, counts, meshes, empty) else Remeshed(counts, meshes) end
    match r1 do
      Remeshed(c1, m1) ->
        let r2 = if int_and(mask, 8) != 0 do remesh_chunk_sections(w, cx - 1, cz, smask, c1, m1, empty) else Remeshed(c1, m1) end
        match r2 do
          Remeshed(c2, m2) ->
            let r3 = if int_and(mask, 2) != 0 do remesh_chunk_sections(w, cx, cz + 1, smask, c2, m2, empty) else Remeshed(c2, m2) end
            match r3 do
              Remeshed(c3, m3) -> if int_and(mask, 1) != 0 do remesh_chunk_sections(w, cx, cz - 1, smask, c3, m3, empty) else Remeshed(c3, m3) end
            end
        end
    end
  end

  pfn remesh_chunk_sections(w : CubeForge.World.World, cx : Int, cz : Int, smask : Int, counts : NativeIntArr, meshes, empty : CubeForge.Chunk.Chunk) : Remeshed do
    if !World.in_bounds(w, cx, cz) do Remeshed(counts, meshes)
    else
      let ci = cx + World.side(w) * cz
      let m1 = remesh_sections(w, cx, cz, smask, 0, Array.get(meshes, ci), empty, 0)
      Remeshed(upload_chunk(m1, ci, counts), Array.set(meshes, ci, m1))
    end
  end

  -- One water tick: call every flagged chunk actor in parallel, apply the replies, remesh what changed.
  pfn water_tick(sc, workers : Int, verbose : Bool) do
    match sc do
      Scene(w, counts, outline, hit, sel, pids, flags, meshes) ->
        let n = World.side(w)
        let cis = flagged(flags, n * n - 1, n, Nil)
        match cis do
          Nil -> sc
          _ ->
            let t0 = Win.time()
            -- clear flags first; replies (pending markers, spills) re-flag as needed
            let flags1 = clear_flags(flags, cis)
            let replies = List.pmap_n(cis, fn ci -> Water.call_tick(Array.get(pids, ci)), workers)
            let t1 = Win.time()
            match apply_all(w, pids, flags1, counts, meshes, cis, replies, Chunk.new(), 0) do
              Applied(w1, counts1, flags2, meshes1, remeshed) ->
                let t2 = Win.time()
                if verbose do
                  println("water tick: " ++ int_to_string(List.length(cis)) ++ " chunks, calls " ++ ms(t1 -. t0) ++ ", apply+remesh " ++ ms(t2 -. t1) ++ " (" ++ int_to_string(remeshed) ++ " sections remeshed), reply sizes " ++ reply_sizes(replies))
                else () end
                Scene(w1, counts1, outline, hit, sel, pids, flags2, meshes1)
            end
        end
    end
  end

  pfn reply_sizes(replies) : String do
    match replies do
      Nil -> ""
      Cons(r, rest) ->
        let sz = match r do
          Ok(out) -> int_to_string(List.length(out))
          Err(_) -> "err"
        end
        sz ++ " " ++ reply_sizes(rest)
    end
  end

  pfn clear_flags(flags : NativeIntArr, cis : List(Int)) : NativeIntArr do
    match cis do
      Nil -> flags
      Cons(ci, rest) -> clear_flags(NativeArray.set_int(flags, ci, 0), rest)
    end
  end

  pfn scene_water_count(sc, cx : Int, cz : Int) : Int do
    match sc do Scene(w, _, _, _, _, _, _, _) -> Chunk.count_water(World.chunk_at(w, cx, cz)) end
  end

  fn reach() : Float do 8.0 end

  -- Upload a chunk mesh's two buffers into chunk slot [slot] and record their vertex counts.
  pfn upload_sections(slot : Int, secs : Array.PVec(CubeForge.F32Buf.F32Buf), i : Int, offset : Int) : Unit do
    if i >= 16 do ()
    else
      let b = Array.get(secs, i)
      Win.gfx_upload_part(slot, offset, F32Buf.storage(b), F32Buf.len(b))
      upload_sections(slot, secs, i + 1, offset + F32Buf.len(b))
    end
  end
  pfn upload_chunk(m : CubeForge.ChunkMesh.ChunkMesh, slot : Int, counts : NativeIntArr) : NativeIntArr do
    let os = CM.opaque_sections(m)
    let ws = CM.water_sections(m)
    Win.gfx_upload_begin(slot, CM.total_floats(os))
    upload_sections(slot, os, 0, 0)
    Win.gfx_upload_begin(water_slot_base() + slot, CM.total_floats(ws))
    upload_sections(water_slot_base() + slot, ws, 0, 0)
    NativeArray.set_int(NativeArray.set_int(counts, slot, CM.opaque_vertices(m)), water_slot_base() + slot, CM.water_vertices(m))
  end

  -- counts + meshes after a remesh
  type Remeshed = Remeshed(NativeIntArr, Array.PVec(CubeForge.ChunkMesh.ChunkMesh))

  -- Rebuild section [sy] (and sy±1 when [also_adjacent]) of chunk (cx, cz), re-concatenate and upload.
  pfn remesh_section(world : CubeForge.World.World, cx : Int, cz : Int, sy : Int, also_adjacent : Bool,
                     counts : NativeIntArr, meshes, empty : CubeForge.Chunk.Chunk) : Remeshed do
    if !World.in_bounds(world, cx, cz) do Remeshed(counts, meshes)
    else
      let ci = cx + World.side(world) * cz
      let m0 = Array.get(meshes, ci)
      let m1 = CM.rebuild_section(m0, world, cx, cz, sy, empty)
      let m2 = if also_adjacent do CM.rebuild_section(CM.rebuild_section(m1, world, cx, cz, sy - 1, empty), world, cx, cz, sy + 1, empty) else m1 end
      Remeshed(upload_chunk(m2, ci, counts), Array.set(meshes, ci, m2))
    end
  end

  -- Remesh around a single edited world cell: its section (plus the adjacent section when on a
  -- section boundary) and the same section of a neighbour chunk when on a chunk border.
  pfn remesh_cell(world : CubeForge.World.World, x : Int, y : Int, z : Int, counts : NativeIntArr, meshes, empty : CubeForge.Chunk.Chunk) : Remeshed do
    let cx = World.floor_div16(x)
    let cz = World.floor_div16(z)
    let sy = y / 16
    let ly = y % 16
    let lx = World.mod16(x)
    let lz = World.mod16(z)
    match remesh_section(world, cx, cz, sy, ly == 0 || ly == 15, counts, meshes, empty) do
      Remeshed(c1, m1) ->
        let r2 = if lx == 0 do remesh_section(world, cx - 1, cz, sy, false, c1, m1, empty) else if lx == 15 do remesh_section(world, cx + 1, cz, sy, false, c1, m1, empty) else Remeshed(c1, m1) end end
        match r2 do
          Remeshed(c2, m2) ->
            if lz == 0 do remesh_section(world, cx, cz - 1, sy, false, c2, m2, empty) else if lz == 15 do remesh_section(world, cx, cz + 1, sy, false, c2, m2, empty) else Remeshed(c2, m2) end end
        end
    end
  end

  -- Apply a block edit at (x, y, z): set the block, remesh its chunk, and a
  -- neighbour chunk when the block sits on a chunk boundary (its faces are
  -- culled against the neighbour, so the neighbour's mesh changes too).
  pfn edit_block(sc, x : Int, y : Int, z : Int, id : Int) do
    match sc do
      Scene(world, counts, outline, hit, ui, pids, flags, meshes) ->
        let t0 = Win.time()
        let world1 = World.set_block(world, x, y, z, id)
        match remesh_cell(world1, x, y, z, counts, meshes, Chunk.new()) do
          Remeshed(c1, m1) ->
            let t1 = Win.time()
            println((if id == 0 do "broke" else "placed" end) ++ " block at " ++ int_to_string(x) ++ "," ++ int_to_string(y) ++ "," ++ int_to_string(z)
                    ++ " — edit + section remesh " ++ ms(t1 -. t0))
            notify_edit(Scene(world1, c1, outline, hit, ui, pids, flags, m1), x, y, z, id)
        end
    end
  end

  -- Scripted: remove every source block within 3 cells of the player's feet (the one CF_AUTOFLOW placed).
  pfn break_sources_near(sc, p : CubeForge.Player.Player) do
    let pos = Player.position(p)
    let px = float_to_int(Math.floor(V.x(pos)))
    let py = float_to_int(Math.floor(V.y(pos)))
    let pz = float_to_int(Math.floor(V.z(pos)))
    break_sources_go(sc, px - 3, py - 3, pz - 3, px, py, pz, 0)
  end
  pfn break_sources_go(sc, x : Int, y : Int, z : Int, px : Int, py : Int, pz : Int, i : Int) do
    if i >= 343 do sc
    else
      let cx = x + i % 7
      let cy = y + (i / 7) % 7
      let cz = z + i / 49
      let sc1 = if Chunk.is_source(World.block_at(scene_world(sc), cx, cy, cz)) do edit_block(sc, cx, cy, cz, 0) else sc end
      break_sources_go(sc1, x, y, z, px, py, pz, i + 1)
    end
  end

  -- Would placing a block at (x, y, z) overlap the player's box?
  pfn overlaps_player(p : CubeForge.Player.Player, x : Int, y : Int, z : Int) : Bool do
    let pos = Player.position(p)
    let px = V.x(pos)
    let py = V.y(pos)
    let pz = V.z(pos)
    let fx = int_to_float(x)
    let fy = int_to_float(y)
    let fz = int_to_float(z)
    fx < px +. Player.half_width() && fx +. 1.0 > px -. Player.half_width()
      && fy < py +. Player.height() && fy +. 1.0 > py
      && fz < pz +. Player.half_width() && fz +. 1.0 > pz -. Player.half_width()
  end

  -- Per-frame: raycast from the eye, refresh the outline, apply the break-hold and placement.
  -- [break_held] is the button level (or scripted), [place_now] an edge, [new_sel] a slot 1..4 or 0.
  -- [place_id] > 0 forces a block id for scripted edits.
  pfn interact(sc, p : CubeForge.Player.Player, break_held : Bool, place_now : Bool, place_id : Int, new_sel : Int, dt : Float) do
    match sc do
      Scene(world, counts, outline, _, ui0, pids, flags, meshes) ->
        let inv0 = if new_sel > 0 do Inv.select(ui_inv(ui0), new_sel) else ui_inv(ui0) end
        let e = Player.eye(p)
        let d = Player.forward(Player.yaw(p), Player.pitch(p))
        let hit = Ray.cast(world, V.x(e), V.y(e), V.z(e), V.x(d), V.y(d), V.z(d), reach())
        let outline1 = if Ray.is_hit(hit) do Outline.build(outline, Ray.bx(hit), Ray.by_(hit), Ray.bz(hit)) else F32Buf.clear(outline) end
        if Ray.is_hit(hit) do CubeForge.Ffi.Window.gfx_upload(254, F32Buf.storage(outline1), F32Buf.len(outline1)) else () end
        -- breaking: hold accumulates on the same target; release or a miss resets
        let inv1 = if break_held && Ray.is_hit(hit) do Inv.hold(inv0, Ray.bx(hit), Ray.by_(hit), Ray.bz(hit), dt) else Inv.release(inv0) end
        let sc1 = Scene(world, counts, outline1, hit, ui_with_inv(ui0, inv1), pids, flags, meshes)
        if Inv.is_complete(inv1) do
          let id = World.block_at(world, Ray.bx(hit), Ray.by_(hit), Ray.bz(hit))
          let sc2 = edit_block(sc1, Ray.bx(hit), Ray.by_(hit), Ray.bz(hit), 0)
          set_inv(sc2, Inv.release(Inv.harvest(inv1, id)))
        else if place_now && Ray.is_hit(hit) do
          let px = Ray.bx(hit) + Ray.nx(hit)
          let py = Ray.by_(hit) + Ray.ny(hit)
          let pz = Ray.bz(hit) + Ray.nz(hit)
          let forced = place_id > 0
          let id = if forced do place_id else Inv.selected_id(inv1) end
          let allowed = forced || Inv.can_place(inv1)
          if !allowed do sc1
          else if id != Chunk.water() && overlaps_player(p, px, py, pz) do sc1
          else
            let sc2 = edit_block(sc1, px, py, pz, id)
            if forced do sc2 else set_inv(sc2, Inv.consume(inv1)) end
          end end
        else sc1 end end
    end
  end

  @[no_alloc]
  pfn set_inv(sc, inv : CubeForge.Inventory.Inv) do
    match sc do Scene(w, c, o, h, u, p, f, m) -> Scene(w, c, o, h, ui_with_inv(u, inv), p, f, m) end
  end
  pfn scene_ui(sc) : Ui do match sc do Scene(_, _, _, _, u, _, _, _) -> u end end
  @[no_alloc]
  pfn scene_with_ui(sc, u : Ui) do match sc do Scene(w, c, o, h, _, p, f, m) -> Scene(w, c, o, h, u, p, f, m) end end
  fn inv_string(sc) : String do
    let i = ui_inv(scene_ui(sc))
    "inv grass=" ++ int_to_string(Inv.count(i, 1)) ++ " dirt=" ++ int_to_string(Inv.count(i, 2)) ++ " stone=" ++ int_to_string(Inv.count(i, 3)) ++ " sel=" ++ int_to_string(Inv.sel(i)) ++ " progress=" ++ float_to_string(Inv.progress(i))
  end

  pfn scene_counts(sc) : NativeIntArr do match sc do Scene(_, c, _, _, _, _, _, _) -> c end end
  pfn scene_world(sc) : CubeForge.World.World do match sc do Scene(w, _, _, _, _, _, _, _) -> w end end
  pfn scene_has_hit(sc) : Bool do match sc do Scene(_, _, _, h, _, _, _, _) -> Ray.is_hit(h) end end
  fn scene_hit_string(sc) : String do
    match sc do
      Scene(_, _, _, h, _, _, _, _) -> if Ray.is_hit(h) do int_to_string(Ray.bx(h)) ++ "," ++ int_to_string(Ray.by_(h)) ++ "," ++ int_to_string(Ray.bz(h)) ++ " face " ++ int_to_string(Ray.nx(h)) ++ "," ++ int_to_string(Ray.ny(h)) ++ "," ++ int_to_string(Ray.nz(h)) else "none" end
    end
  end
  -- FPS meter: window start time, frames in window, last displayed fps, HUD vertex buffer
  type Fps = Fps(Float, Int, Int, CubeForge.F32Buf.F32Buf)

  -- Update the FPS meter every 0.25 s and rebuild + upload the HUD digits when it changes.
  pfn tick_fps(f : Fps, now : Float) : Fps do
    match f do
      Fps(t0, n, shown, hud) ->
        if now -. t0 >= 0.25 do
          let fps = float_to_int(int_to_float(n + 1) /. (now -. t0) +. 0.5)
          let hud1 = Hud.build_number(hud, fps, 0.006, 0.008)
          Win.gfx_upload(255, F32Buf.storage(hud1), F32Buf.len(hud1))
          Fps(now, 0, fps, hud1)
        else
          Fps(t0, n + 1, shown, hud)
        end
    end
  end
  pfn fps_hud_verts(f : Fps) : Int do match f do Fps(_, _, _, hud) -> F32Buf.len(hud) / 7 end end

  pfn axis(neg : Bool, pos : Bool) : Float do
    if pos && !neg do 1.0 else if neg && !pos do -1.0 else 0.0 end end
  end

  -- Gather this frame's input into a value the (Input-cap-free) Player module can consume.
  -- Block selection: keys 1-4; 0 when none is pressed this frame.
  pfn selected_key() : Int do
    if In.key(In.key_1()) do 1 else if In.key(In.key_2()) do 2 else if In.key(In.key_3()) do 3 else if In.key(In.key_4()) do 4 else 0 end end end end
  end

  @[no_alloc(assume)]
  pfn read_input(autowalk : Bool, autospin : Float, autoswim : Bool) : CubeForge.Player.Input do
    -- CF_AUTOWALK=1: scripted forward walk for headless collision verification.
    let mf = if autowalk do 1.0 else axis(In.key(In.key_s()), In.key(In.key_w())) end
    let mr = axis(In.key(In.key_a()), In.key(In.key_d()))
    CubeForge.Player.Input(mf, mr, In.mouse_dx() +. autospin, In.mouse_dy(), In.key(In.key_space()) || autoswim)
  end

  -- View matrix for the player's eye, written into the persistent scratch array in place.
  pfn write_view(p : CubeForge.Player.Player, view : NativeFloatArr) : NativeFloatArr do
    let q = Q.from_yaw_pitch(Player.yaw(p), Player.pitch(p))
    let e = Player.eye(p)
    M.write_view(Q.x(q), Q.y(q), Q.z(q), Q.w(q), V.x(e), V.y(e), V.z(e), view)
  end

  -- (kept for the allocation bisect) the temporary-matrix version
  pfn view_proj(proj : NativeFloatArr, p : CubeForge.Player.Player, dst : NativeF32Arr) : NativeF32Arr do
    let q = Q.from_yaw_pitch(Player.yaw(p), Player.pitch(p))
    let rot = Q.to_mat4(Q.conjugate(q))
    let view = M.mul(rot, M.translation(V.scale(Player.eye(p), -1.0)))
    M.write_f32(M.mul(proj, view), dst)
  end

  pfn repeat_view_inplace(proj : NativeFloatArr, p : CubeForge.Player.Player, view : NativeFloatArr, dst : NativeF32Arr, i : Int) : NativeF32Arr do
    if i == 0 do dst else
      let view1 = write_view(p, view)
      repeat_view_inplace(proj, p, view1, M.mul_into_f32(proj, view1, dst), i - 1)
    end
  end

  -- Frame loop. `max_frames < 0` means run until the window closes.
  -- Run-time knobs read once, outside the frame loop (an Env read allocates).
  type Knobs = Knobs(Int, Int, String, Bool, Float, Int, Bool, Int, Int)   -- max_frames, dump_frame, dump_path, autowalk, autospin, autoedit frame (<0 = off), autoswim, autoflow frame (<0 = off), workers

  fn frame_loop(f : Frame, k : Knobs, sc, nchunks : Int, proj : NativeFloatArr, fps : Fps) : Frame do
    match f do
      Frame(frame, last_t, player, sample, view, vp) ->
        match k do
        Knobs(max_frames, dump_frame, dump_path, autowalk, autospin, autoedit, autoswim, autoflow, workers) ->
        if Win.should_close() || (max_frames >= 0 && frame >= max_frames) do
          Frame(frame, last_t, player, sample, view, vp)
        else
          In.poll()
          if In.key(In.key_escape()) do Win.request_close() else () end
          if In.button_pressed(In.button_left()) do CubeForge.Ffi.Input.capture_cursor(true) else () end
          let now = Win.time()
          let dt = if now -. last_t > 0.1 do 0.1 else now -. last_t end
          let player1 = Player.update(player, read_input(autowalk, autospin, autoswim && frame >= 320), scene_world(sc), dt)
          let view1 = write_view(player1, view)
          let vp1 = M.mul_into_f32(proj, view1, vp)
          -- CF_AUTOEDIT=<frame>: scripted break at that frame and place 60 frames later (headless verification)
          -- scripted: hold break for 60 frames from `autoedit`, place the harvested block at +120, water at +180
          let scripted_hold = autoedit >= 0 && frame >= autoedit && frame < autoedit + 60
          let scripted_place = autoedit >= 0 && frame == autoedit + 120
          let place_water = (autoedit >= 0 && frame == autoedit + 180) || (autoflow >= 0 && frame == autoflow)
          let sc0 = interact(sc, player1, In.button(In.button_left()) || scripted_hold, In.button_pressed(In.button_right()) || scripted_place || place_water,
                             if place_water do Chunk.water() else -1 end, if scripted_place do 1 else selected_key() end, dt)
          -- CF_AUTOFLOW: break the source again 600 frames after placing it
          let sc0b = if autoflow >= 0 && frame == autoflow + 600 do break_sources_near(sc0, player1) else sc0 end
          -- water simulation tick
          let sc1 = if frame % tick_period() == 0 do water_tick(sc0b, workers, autoflow >= 0) else sc0b end
          if autoflow >= 0 && frame >= autoflow && (frame - autoflow) % 100 == 0 do
            let cx = World.floor_div16(float_to_int(Math.floor(V.x(Player.position(player1)))))
            let cz = World.floor_div16(float_to_int(Math.floor(V.z(Player.position(player1)))))
            println("frame " ++ int_to_string(frame) ++ " water cells: chunk(" ++ int_to_string(cx) ++ "," ++ int_to_string(cz) ++ ")=" ++ int_to_string(scene_water_count(sc1, cx, cz))
                    ++ " chunk(" ++ int_to_string(cx - 1) ++ "," ++ int_to_string(cz) ++ ")=" ++ int_to_string(scene_water_count(sc1, cx - 1, cz))
                    ++ " chunk(" ++ int_to_string(cx) ++ "," ++ int_to_string(cz - 1) ++ ")=" ++ int_to_string(scene_water_count(sc1, cx, cz - 1)))
          else () end
          if autoedit >= 0 && (frame == autoedit - 1 || frame == autoedit + 20 || frame == autoedit + 40 || frame == autoedit + 61 || frame == autoedit + 121 || frame == autoedit + 181) do
            println("frame " ++ int_to_string(frame) ++ " looking at " ++ scene_hit_string(sc1) ++ "; block there = " ++ int_to_string(match sc1 do Scene(w, _, _, h, _, _, _, _) -> World.block_at(w, Ray.bx(h), Ray.by_(h), Ray.bz(h)) end) ++ "; " ++ inv_string(sc1))
          else () end
          if autoswim && frame % 20 == 0 && frame <= 400 do
            println("frame " ++ int_to_string(frame) ++ " y=" ++ float_to_string(V.y(Player.position(player1))) ++ " in_water=" ++ (if Player.in_water(player1, scene_world(sc1)) do "true" else "false" end) ++ " eye_in_water=" ++ (if Player.eye_in_water(player1, scene_world(sc1)) do "true" else "false" end))
          else () end
          Win.gfx_begin_frame(0.55, 0.75, 0.95)
          Win.gfx_set_view_proj(vp1)
          draw_chunks(scene_counts(sc1), 0, nchunks)
          draw_water(scene_counts(sc1), 0, nchunks)
          if scene_has_hit(sc1) do CubeForge.Ffi.Window.gfx_draw_lines(254, Outline.vertex_count()) else () end
          if Player.eye_in_water(player1, scene_world(sc1)) do CubeForge.Ffi.Window.gfx_draw_hud(253, 6, true) else () end
          let fps1 = tick_fps(fps, now)
          Win.gfx_draw_hud(255, fps_hud_verts(fps1), false)
          let sc2 = scene_with_ui(sc1, refresh_hud(scene_ui(sc1)))
          Win.gfx_draw_hud(252, hud_verts(scene_ui(sc2)), false)
          Win.gfx_draw_hud(251, icon_verts(scene_ui(sc2)), true)
          if frame == dump_frame do
            if dump_path != "" do
              if Win.gfx_dump_bmp(dump_path) == 0 do println("dump failed") else () end
            else () end
            println("player at " ++ V.to_string(Player.position(player1)) ++ " on_ground=" ++ (if Player.on_ground(player1) do "true" else "false" end))
          else () end
          if frame % 60 == 0 && autowalk do
            println("frame " ++ int_to_string(frame) ++ " player at " ++ V.to_string(Player.position(player1)) ++ " on_ground=" ++ (if Player.on_ground(player1) do "true" else "false" end))
          else () end
          Win.swap()
          -- allocation gauge: sample the live-object delta over frames 100..200
          let sample1 = if frame == 100 do Win.live_allocs() else sample end
          if frame == 200 do
            println("live-object delta over frames 100..200: " ++ int_to_string(Win.live_allocs() - sample1) ++ " (" ++ int_to_string((Win.live_allocs() - sample1) / 100) ++ " per frame)")
          else () end
          frame_loop(Frame(frame + 1, now, player1, sample1, view1, vp1), k, sc2, nchunks, proj, fps1)
        end
        end
    end
  end

  -- Allocation bisect: run each per-frame piece N times and print the live-object delta.
  pfn repeat_update(p : CubeForge.Player.Player, w : CubeForge.World.World, i : Int) : CubeForge.Player.Player do
    if i == 0 do p else repeat_update(Player.update(p, CubeForge.Player.Input(0.3, 0.0, 1.0, 0.5, false), w, 0.016), w, i - 1) end
  end
  pfn repeat_view(proj : NativeFloatArr, p : CubeForge.Player.Player, dst : NativeF32Arr, i : Int) : NativeF32Arr do
    if i == 0 do dst else repeat_view(proj, p, view_proj(proj, p, dst), i - 1) end
  end
  pfn repeat_quat(i : Int, acc : Float) : Float do
    if i == 0 do acc else repeat_quat(i - 1, acc +. V.x(Q.rotate(Q.from_yaw_pitch(0.3, 0.2), V.new(1.0, 0.0, 0.0)))) end
  end
  pfn repeat_mul(m : NativeFloatArr, i : Int) : NativeFloatArr do
    if i == 0 do m else repeat_mul(M.mul(m, M.identity()), i - 1) end
  end
  pfn repeat_forward(i : Int, acc : Float) : Float do
    if i == 0 do acc else repeat_forward(i - 1, acc +. V.x(Player.forward(0.3, 0.2))) end
  end
  pfn repeat_input(i : Int, acc : Float) : Float do
    if i == 0 do acc else
      repeat_input(i - 1, acc +. Player.input_forward(read_input(false, 0.0, false)))
    end
  end
  pfn measure(name : String, f) : Unit do
    let a = Win.live_allocs()
    let _r = f(())
    println("  " ++ name ++ ": live delta over 100 iterations = " ++ int_to_string(Win.live_allocs() - a))
  end
  pfn repeat_time(i : Int, acc : Float) : Float do
    if i == 0 do acc else repeat_time(i - 1, acc +. Win.time() +. In.mouse_dx()) end
  end
  pfn repeat_poll(i : Int) : Int do
    if i == 0 do 0 else
      In.poll()
      repeat_poll(i - 1)
    end
  end
  pfn repeat_write_view(p : CubeForge.Player.Player, view : NativeFloatArr, i : Int) : NativeFloatArr do
    if i == 0 do view else repeat_write_view(p, write_view(p, view), i - 1) end
  end
  pfn repeat_mul_into(proj : NativeFloatArr, view : NativeFloatArr, dst : NativeF32Arr, i : Int) : NativeF32Arr do
    if i == 0 do dst else repeat_mul_into(proj, view, M.mul_into_f32(proj, view, dst), i - 1) end
  end
  pfn repeat_eye(p : CubeForge.Player.Player, i : Int, acc : Float) : Float do
    if i == 0 do acc else repeat_eye(p, i - 1, acc +. V.y(Player.eye(p))) end
  end
  pfn repeat_fyp(i : Int, acc : Float) : Float do
    if i == 0 do acc else repeat_fyp(i - 1, acc +. Q.w(Q.from_yaw_pitch(0.3, 0.2))) end
  end
  pfn alloc_probe(world : CubeForge.World.World, proj : NativeFloatArr) : Unit do
    println("allocation bisect (net live objects; >0 means a leak):")
    measure("extern Float returns (time, mouse_dx)", fn _ -> repeat_time(100, 0.0))
    measure("In.poll", fn _ -> repeat_poll(100))
    measure("read_input", fn _ -> repeat_input(100, 0.0))
    measure("Player.forward", fn _ -> repeat_forward(100, 0.0))
    measure("Quat from_yaw_pitch+rotate", fn _ -> repeat_quat(100, 0.0))
    measure("Mat4.mul", fn _ -> M.get(repeat_mul(M.identity(), 100), 0, 0))
    measure("Player.update", fn _ -> V.x(Player.position(repeat_update(Player.new(8.0, 70.0, 8.0), world, 100))))
    measure("view_proj (temporaries)", fn _ -> NativeArray.get_f32(repeat_view(proj, Player.new(8.0, 70.0, 8.0), NativeArray.make_f32(16, 0.0), 100), 0))
    measure("write_view only", fn _ -> NativeArray.get_float(repeat_write_view(Player.new(8.0, 70.0, 8.0), NativeArray.make_float(16, 0.0), 100), 0))
    measure("mul_into_f32 only", fn _ -> NativeArray.get_f32(repeat_mul_into(proj, NativeArray.make_float(16, 0.0), NativeArray.make_f32(16, 0.0), 100), 0))
    measure("Player.eye only", fn _ -> repeat_eye(Player.new(8.0, 70.0, 8.0), 100, 0.0))
    measure("Quat.from_yaw_pitch only", fn _ -> repeat_fyp(100, 0.0))
    measure("view_proj (in place)", fn _ -> NativeArray.get_f32(repeat_view_inplace(proj, Player.new(8.0, 70.0, 8.0), NativeArray.make_float(16, 0.0), NativeArray.make_f32(16, 0.0), 100), 0))
  end

  -- Draw every chunk slot; counts holds the vertex count per slot.
  @[no_alloc(assume)]
  pfn draw_chunks(counts : NativeIntArr, i : Int, n : Int) : Unit do
    if i >= n do ()
    else
      Win.gfx_draw(i, NativeArray.get_int(counts, i))
      draw_chunks(counts, i + 1, n)
    end
  end

  pfn draw_water(counts : NativeIntArr, i : Int, n : Int) : Unit do
    if i >= n do ()
    else
      Win.gfx_draw_translucent(water_slot_base() + i, NativeArray.get_int(counts, water_slot_base() + i))
      draw_water(counts, i + 1, n)
    end
  end

  -- Full-screen quad in NDC for the underwater tint: layer 1 (water), shade 0.6. Built once.
  pfn underwater_quad() : CubeForge.F32Buf.F32Buf do
    let v = fn (b, x, y, u, t) -> b |> F32Buf.push3(x, y, 0.0) |> F32Buf.push(u) |> F32Buf.push(t) |> F32Buf.push(Texture.water_layer()) |> F32Buf.push(0.6)
    F32Buf.new(64) |> v(-1.0, -1.0, 0.0, 0.0) |> v(1.0, -1.0, 4.0, 0.0) |> v(1.0, 1.0, 4.0, 3.0)
                   |> v(-1.0, -1.0, 0.0, 0.0) |> v(1.0, 1.0, 4.0, 3.0) |> v(-1.0, 1.0, 0.0, 3.0)
  end

  -- Stage 2 of world generation: mesh every chunk (each needs its 4 neighbours, which
  -- stage 1 guarantees), upload each mesh into its slot, record vertex counts.
  pfn upload_meshes(meshes : List(CubeForge.ChunkMesh.ChunkMesh), i : Int, counts : NativeIntArr) : NativeIntArr do
    match meshes do
      Nil -> counts
      Cons(m, rest) -> upload_meshes(rest, i + 1, upload_chunk(m, i, counts))
    end
  end

  pfn count_verts(meshes : List(CubeForge.ChunkMesh.ChunkMesh), acc : Int) : Int do
    match meshes do
      Nil -> acc
      Cons(m, rest) -> count_verts(rest, acc + CM.opaque_vertices(m) + CM.water_vertices(m))
    end
  end

  pfn count_water_verts(meshes : List(CubeForge.ChunkMesh.ChunkMesh), acc : Int) : Int do
    match meshes do
      Nil -> acc
      Cons(m, rest) -> count_water_verts(rest, acc + CM.water_vertices(m))
    end
  end

  fn mesh_all(world : CubeForge.World.World, n : Int, workers : Int) : List(CubeForge.ChunkMesh.ChunkMesh) do
    let empty = Chunk.new()
    List.pmap_n(World.coords(n), fn i -> CM.build(world, i % n, i / n, empty), workers)
  end

  -- The naive whole-chunk mesher, kept for the headless timing comparison.
  fn mesh_all_naive(world : CubeForge.World.World, n : Int, workers : Int) : Int do
    let empty = Chunk.new()
    let ms = List.pmap_n(World.coords(n), fn i -> Mesher.mesh_world_chunk(world, i % n, i / n, empty), workers)
    List.fold_left(ms, 0, fn (acc, m) -> acc + Mesher.vertex_count(Mesher.opaque_buf(m)) + Mesher.vertex_count(Mesher.water_buf(m)))
  end

  fn main(cap : Cap(IO)) : Unit do
    let max_frames = Env.get_int("CF_FRAMES", -1)
    let n = World.size()
    let workers = Env.get_int("CF_WORKERS", System.cpu_count())
    let seed = Env.get_int("CF_SEED", 7)
    let headless = Env.get_int("CF_HEADLESS", 0) == 1
    -- `&&` does not short-circuit (GAPS.md G33), so the window open is gated with a nested if.
    let opened = if headless do 1 else Win.open(800, 600, "cube_forge") end
    if opened == 0 do
      println("failed to open window")
    else
      if !headless do (if Win.gfx_init() == 0 do println("gfx init failed") else () end) else () end
      -- stage 1: terrain (independent chunks)
      let t0 = System.monotonic_time()
      let world_scalar = World.generate_scalar(n, seed, workers)
      let t1 = System.monotonic_time()
      let world = World.generate(n, seed, workers)
      let t2 = System.monotonic_time()
      -- stage 2: meshing (needs neighbours; runs only after stage 1 completed)
      let meshes = mesh_all(world, n, workers)
      let t3 = System.monotonic_time()
      let nverts = count_verts(meshes, 0)
      if headless do
        let tn0 = System.monotonic_time()
        let naive_verts = mesh_all_naive(world, n, workers)
        println("  naive mesher for comparison: " ++ int_to_string(System.monotonic_time() - tn0) ++ " ms wall, " ++ int_to_string(naive_verts) ++ " vertices")
      else () end
      println("world " ++ int_to_string(n) ++ "x" ++ int_to_string(n) ++ " chunks, " ++ int_to_string(workers) ++ " workers, "
              ++ int_to_string(Env.get_int("MARCH_NUM_SCHEDULERS", 4)) ++ " scheduler threads (MARCH_NUM_SCHEDULERS)")
      println("  terrain scalar noise: " ++ int_to_string(t1 - t0) ++ " ms   terrain F32x4 noise: " ++ int_to_string(t2 - t1) ++ " ms")
      println("  mesh all (greedy sections): " ++ int_to_string(t3 - t2) ++ " ms wall, " ++ float_to_string(int_to_float(t3 - t2) /. int_to_float(n * n)) ++ " ms per chunk (wall / chunks), " ++ int_to_string(nverts) ++ " vertices (" ++ int_to_string(count_water_verts(meshes, 0)) ++ " water)")
      if headless do ()
      else
        let counts = upload_meshes(meshes, 0, NativeArray.make_int(2 * water_slot_base(), 0))
        let uq = underwater_quad()
        Win.gfx_upload(253, F32Buf.storage(uq), F32Buf.len(uq))
        Win.gfx_upload_texture(Texture.checkerboard(), Texture.size(), Texture.size(), Texture.layers())
        let proj = M.perspective(70.0 *. Math.pi() /. 180.0, 800.0 /. 600.0, 0.1, 500.0)
        let autoswim = Env.get_int("CF_AUTOSWIM", 0) == 1
        let water_col = World.find_water(world)
        let spawn_pos = int_to_float(8 * n)
        let player = if autoswim && water_col >= 0 do
          println("autoswim: spawning over water column " ++ int_to_string(water_col % 4096) ++ "," ++ int_to_string(water_col / 4096))
          Player.with_pitch(Player.new(int_to_float(water_col % 4096) +. 0.5, 90.0, int_to_float(water_col / 4096) +. 0.5), -0.6)
        else Player.with_pitch(Player.new(spawn_pos, 100.0, spawn_pos), -0.6) end
        if Env.get_int("CF_ALLOC_PROBE", 0) == 1 do alloc_probe(world, proj) else () end
        let t4 = Win.time()
        let knobs = Knobs(max_frames, Env.get_int("CF_DUMP_FRAME", 30), Env.get("CF_DUMP", ""), Env.get_int("CF_AUTOWALK", 0) == 1,
                          int_to_float(Env.get_int("CF_AUTOSPIN", 0)) /. 1000.0 /. Player.mouse_sens(), Env.get_int("CF_AUTOEDIT", -1), autoswim, Env.get_int("CF_AUTOFLOW", -1), workers)
        let tw0 = Win.time()
        let pids = Array.from_list(spawn_water(n * n - 1, n, seed, Nil))
        println("spawned " ++ int_to_string(n * n) ++ " water actors in " ++ ms(Win.time() -. tw0) ++ " (loads run asynchronously)")
        let scene = Scene(world, counts, F32Buf.new(256), Ray.miss(), Ui(Inv.new(), F32Buf.new(2048), F32Buf.new(256), -1), pids, NativeArray.make_int(n * n, 0), Array.from_list(meshes))
        let fps0 = Fps(t4, 0, 0, F32Buf.new(4096))
        match frame_loop(Frame(0, t4, player, 0, NativeArray.make_float(16, 0.0), NativeArray.make_f32(16, 0.0)), knobs, scene, n * n, proj, fps0) do
          Frame(frames, _, p, _, _, _) ->
            let t5 = Win.time()
            println("ran " ++ int_to_string(frames) ++ " frames in " ++ ms(t5 -. t4) ++ " (" ++ float_to_string(int_to_float(frames) /. (t5 -. t4)) ++ " fps, vsync on); player ended at " ++ V.to_string(Player.position(p)))
        end
        Win.close()
      end
    end
  end

end